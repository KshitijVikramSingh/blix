<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Blix.Render\Blix.Render.csproj" />
    <ProjectReference Include="..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
    <ProjectReference Include="..\Blix.Tools.Shader\Blix.Tools.Shader.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Demos.VulkanLit</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
  </PropertyGroup>

  <ItemGroup>
    <GlslShader Include="Shaders\shadow.vert" />
    <GlslShader Include="Shaders\shadow.frag" />
    <GlslShader Include="Shaders\skinned_shadow.vert" />
    <GlslShader Include="Shaders\point_shadow.vert" />
    <GlslShader Include="Shaders\point_shadow.frag" />
    <GlslShader Include="Shaders\point_skinned_shadow.vert" />
    <GlslShader Include="Shaders\lit.vert" />
    <GlslShader Include="Shaders\lit.frag" />
    <GlslShader Include="Shaders\skinned_lit.vert" />
    <GlslShader Include="Shaders\present.vert" />
    <GlslShader Include="Shaders\present.frag" />
    <GlslShader Include="Shaders\present_depth.frag" />
    <GlslShader Include="Shaders\bloom_bright.frag" />
    <GlslShader Include="Shaders\bloom_blur.frag" />
  </ItemGroup>

  <!-- Shader library files. NOT entry points (no main()); only included
       via #include "foo.glsl" from the GlslShader entry shaders. Listed
       here so CompileSpirV's Inputs picks up edits and rebuilds the
       dependent .spv. Blix.Tools.Shader resolves includes relative to the
       including file before invoking glslc. -->
  <ItemGroup>
    <GlslInclude Include="Shaders\brdf.glsl" />
    <GlslInclude Include="Shaders\shadows.glsl" />
    <GlslInclude Include="Shaders\normal_mapping.glsl" />
    <GlslInclude Include="Shaders\ibl.glsl" />
    <GlslInclude Include="Shaders\debug_channels.glsl" />
    <!-- Shared GLSL library (src/Blix.Shaders), resolved by Blix.Tools.Shader.
         Listed so edits retrigger the cook. -->
    <GlslInclude Include="..\Blix.Shaders\fullscreen.glsl" />
    <GlslInclude Include="..\Blix.Shaders\bloom.glsl" />
    <GlslInclude Include="..\Blix.Shaders\tonemap.glsl" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CompileSpirV"
          AfterTargets="CopyFilesToOutputDirectory"
          Inputs="@(GlslShader);@(GlslInclude);$(BlixShaderCompilerDll)"
          Outputs="@(GlslShader -> '$(OutDir)Shaders\%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(OutDir)Shaders" />
    <Message Text="Compiling SPIR-V: %(GlslShader.Identity)" Importance="high" />
    <Exec Command="dotnet &quot;$(BlixShaderCompilerDll)&quot; --glslc &quot;$(Glslc)&quot; --input &quot;%(GlslShader.FullPath)&quot; --output &quot;$(OutDir)Shaders\%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; --include &quot;$(MSBuildProjectDirectory)/../Blix.Shaders&quot;" />
  </Target>

</Project>
