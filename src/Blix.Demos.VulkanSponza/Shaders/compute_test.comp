#version 450

// Phase-1 compute smoke test: write a UV gradient into a storage image. Proves
// the end-to-end compute path (program + pipeline + dispatch + storage-image
// descriptor in GENERAL layout + barriers). Nothing samples the result yet —
// the froxel-fog grid will be the first real consumer.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D uOut;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uOut);
    if (p.x >= size.x || p.y >= size.y) return;
    vec2 uv = vec2(p) / vec2(size);
    imageStore(uOut, p, vec4(uv, 0.0, 1.0));
}
