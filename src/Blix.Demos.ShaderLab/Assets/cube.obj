# cube.obj
# Unit cube centred at the origin: 8 positions, 6 per-face normals, 4 corner UVs,
# 6 quads (12 triangles). Front faces are wound CCW from outside (matches
# RasterizerState.BackFaceCulling with FrontFace.CounterClockwise).

# Positions
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v  0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5

# Texture coordinates (face-corner UVs; flipped image convention in the engine
# means V=0 lands at the top of the source image).
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0

# Normals — one per face, pointing outward.
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# Faces (v/vt/vn). Each face is a quad, fan-triangulated by the importer.
# Front  (+Z)
f 1/1/1 2/2/1 3/3/1 4/4/1
# Back   (-Z)
f 5/1/2 6/2/2 7/3/2 8/4/2
# Left   (-X)
f 6/1/3 1/2/3 4/3/3 7/4/3
# Right  (+X)
f 2/1/4 5/2/4 8/3/4 3/4/4
# Top    (+Y)
f 4/1/5 3/2/5 8/3/5 7/4/5
# Bottom (-Y)
f 6/1/6 5/2/6 2/3/6 1/4/6
