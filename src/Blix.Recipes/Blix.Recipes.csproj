<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Blix's own recipes, and NOT part of the engine.

       This project exists so that "Blix ships three recipes" is a list rather
       than a privilege. Before it, the mesh cook lived inside Blix/ next to the
       format it wrote, which made Blix's own cooking engine code and a project's
       own cooking something structurally different — blessed by location. Now
       both are the same kind of thing: a file with a [Recipe] method, in an
       assembly that references the engine rather than being it.

       The test that it is honest: this project uses only PUBLIC engine API. No
       InternalsVisibleTo, because an internals grant would let Blix's recipes do
       what a project's recipe cannot, which is the same blessing wearing a
       different hat.

       A grant runs the other way, once: this project's own tests see its
       internals (the glTF readers in GltfVertices, GltfSkin, GltfUnread),
       because those are the cook's, and are tested as the cook's. That gives
       a test what a recipe author does not need, not a recipe what the engine
       withholds. -->

  <ItemGroup>
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\Blix.Cooked\Blix.Cooked.csproj" />
    <ProjectReference Include="..\Blix.Geometry\Blix.Geometry.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Images\Blix.Graphics.Images.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blix.Test.Recipes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
    <PackageReference Include="BCnEncoder.Net" Version="2.1.0" />
  </ItemGroup>


  <!-- The vendored natives build HERE now, because this is where the P/Invoke
       lives. They followed Bc7Native and MeshoptNative out of the cook tool: a
       recipe that calls a native capability has to be able to carry it, or
       "Blix's recipes and a project's recipes are the same kind of thing" stops
       being true the moment one of them needs a dylib.

       Consequence, named rather than discovered: this project has a clang++
       build step and the engine does not. -->
  <!-- The vendored natives build HERE now, because this is where the P/Invoke lives.
       They followed Bc7Native and MeshoptNative out of the cook tool: a recipe that
       calls a native capability has to be able to carry it, or "Blix's recipes and a
       project's recipes are the same kind of thing" stops being true the moment one of
       them needs a dylib.

       Consequence, named rather than discovered: this project has a clang++ build step
       and the engine does not.

       They build into obj/ and are staged as ContentWithTargetPath rather than dropped
       straight into $(TargetDir). That is the difference between a dylib that exists for
       this project and one that REACHES its consumers — the cook tool and the recipes
       suite both P/Invoke through this assembly, and a native that only lands in one
       output directory resolves for exactly one of them. It is also why the staging
       happens inside a target rather than as a top-level glob: a glob is evaluated at
       project load, before the dylibs exist on a clean build, which is the same trap the
       shader pipeline hit when consumers silently got no .spv. -->

  <PropertyGroup>
    <MeshoptSrc>$(MSBuildProjectDirectory)/../../third_party/meshoptimizer/src</MeshoptSrc>
    <Bc7Src>$(MSBuildProjectDirectory)/../../third_party/bc7enc</Bc7Src>
    <MikkSrc>$(MSBuildProjectDirectory)/../../third_party/mikktspace</MikkSrc>
    <XatlasSrc>$(MSBuildProjectDirectory)/../../third_party/xatlas</XatlasSrc>
    <BlixNativeDir>$(MSBuildProjectDirectory)/obj/native/</BlixNativeDir>
  </PropertyGroup>

  <!-- What a shared library is called, and how this platform's clang is asked to make one.
       The C# twin is Blix.Recipes/NativeLibraries.FileName, and the two MUST agree: one
       names the file the build writes, the other names the file the loader opens. They were
       a single spelling each of the same fact for as long as one platform was the only
       platform, which is how a mismatch would have gone unnoticed. Blix.Test.Graphics
       Section BI pins the C# half; the build failing to find its own output pins this one.

       Windows: clang is the image-provided compiler on GitHub's runners and takes the same
       flags as everywhere else, which is the whole reason not to reach for MSVC here.
       Exports need saying out loud on Windows: MESHOPTIMIZER_API is an empty macro by
       default and blix_bc7.cpp carries its own switch. -->
  <PropertyGroup>
    <BlixLibPrefix Condition="!$([MSBuild]::IsOSPlatform(Windows))">lib</BlixLibPrefix>
    <BlixLibExt Condition="$([MSBuild]::IsOSPlatform(Windows))">.dll</BlixLibExt>
    <BlixLibExt Condition="$([MSBuild]::IsOSPlatform(OSX))">.dylib</BlixLibExt>
    <BlixLibExt Condition="'$(BlixLibExt)' == ''">.so</BlixLibExt>

    <BlixSharedFlag Condition="$([MSBuild]::IsOSPlatform(OSX))">-dynamiclib</BlixSharedFlag>
    <BlixSharedFlag Condition="'$(BlixSharedFlag)' == ''">-shared</BlixSharedFlag>
    <BlixPicFlag Condition="!$([MSBuild]::IsOSPlatform(Windows))">-fPIC</BlixPicFlag>
    <!-- C's maths library: its own -lm on Linux and macOS; on Windows it is part of the C runtime and there
         is no m.lib, so asking for one fails the link (LNK1181). -->
    <BlixMathLib Condition="!$([MSBuild]::IsOSPlatform(Windows))">-lm</BlixMathLib>
    <BlixMeshoptExport Condition="$([MSBuild]::IsOSPlatform(Windows))">-DMESHOPTIMIZER_API=__declspec(dllexport)</BlixMeshoptExport>

    <BlixMeshoptLib>$(BlixNativeDir)$(BlixLibPrefix)meshoptimizer$(BlixLibExt)</BlixMeshoptLib>
    <BlixBc7Lib>$(BlixNativeDir)$(BlixLibPrefix)blix_bc7$(BlixLibExt)</BlixBc7Lib>
    <BlixMikkLib>$(BlixNativeDir)$(BlixLibPrefix)blix_mikk$(BlixLibExt)</BlixMikkLib>
    <BlixXatlasLib>$(BlixNativeDir)$(BlixLibPrefix)blix_xatlas$(BlixLibExt)</BlixXatlasLib>
  </PropertyGroup>

  <ItemGroup>
    <MeshoptCpp Include="$(MeshoptSrc)/*.cpp" />
    <Bc7Cpp Include="$(Bc7Src)/bc7enc.c;$(Bc7Src)/blix_bc7.cpp" />
    <MikkC Include="$(MikkSrc)/mikktspace.c;$(MikkSrc)/blix_mikk.c" />
  </ItemGroup>

  <!-- Rebuilds only when a source is newer than the library. -->
  <Target Name="BuildMeshopt" BeforeTargets="StageBlixNatives"
          Inputs="@(MeshoptCpp);$(MeshoptSrc)/meshoptimizer.h"
          Outputs="$(BlixMeshoptLib)">
    <MakeDir Directories="$(BlixNativeDir)" />
    <Message Text="Building $(BlixLibPrefix)meshoptimizer$(BlixLibExt) (clang++)" Importance="high" />
    <Exec Command="clang++ -O2 -std=c++14 $(BlixSharedFlag) $(BlixPicFlag) $(BlixMeshoptExport) @(MeshoptCpp->'&quot;%(FullPath)&quot;', ' ') -o &quot;$(BlixMeshoptLib)&quot;"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="BlixMeshoptExit" />
    </Exec>
    <Warning Condition="'$(BlixMeshoptExit)' != '0'"
             Text="Could not build the meshoptimizer native. LOD generation will fail at cook time with a message naming this target." />
  </Target>

  <!-- bc7enc.c compiles cleanly as C++, hence -Wno-deprecated for clang's
       "treating .c as C++" note. -->
  <Target Name="BuildBc7" BeforeTargets="StageBlixNatives"
          Inputs="@(Bc7Cpp);$(Bc7Src)/bc7enc.h"
          Outputs="$(BlixBc7Lib)">
    <MakeDir Directories="$(BlixNativeDir)" />
    <Message Text="Building $(BlixLibPrefix)blix_bc7$(BlixLibExt) (clang++)" Importance="high" />
    <Exec Command="clang++ -O2 -std=c++17 -Wno-deprecated $(BlixSharedFlag) $(BlixPicFlag) @(Bc7Cpp->'&quot;%(FullPath)&quot;', ' ') -o &quot;$(BlixBc7Lib)&quot;"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="BlixBc7Exit" />
    </Exec>
    <Warning Condition="'$(BlixBc7Exit)' != '0'"
             Text="Could not build the BC7 native. Texture cooking falls back to the managed encoder, which is correct and slower." />
  </Target>

  <!-- MikkTSpace is C, and built as C: the reference implementation is C89 and not written to
       compile as C++. No fallback: tangent generation is part of what a cooked mesh IS, so a
       missing library refuses the cook (MikkTSpaceNative says which file) rather than quietly
       writing a mesh with a worse frame. -->
  <Target Name="BuildMikk" BeforeTargets="StageBlixNatives"
          Inputs="@(MikkC);$(MikkSrc)/mikktspace.h"
          Outputs="$(BlixMikkLib)">
    <MakeDir Directories="$(BlixNativeDir)" />
    <Message Text="Building $(BlixLibPrefix)blix_mikk$(BlixLibExt) (clang)" Importance="high" />
    <Exec Command="clang -O2 -std=c99 $(BlixSharedFlag) $(BlixPicFlag) @(MikkC->'&quot;%(FullPath)&quot;', ' ') -o &quot;$(BlixMikkLib)&quot; $(BlixMathLib)"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="BlixMikkExit" />
    </Exec>
    <Warning Condition="'$(BlixMikkExit)' != '0'"
             Text="Could not build the MikkTSpace native. Cooking a mesh that needs generated tangents will fail with a message naming this target." />
  </Target>

  <!-- xatlas (lightmap unwrapping), through its own C API: XATLAS_C_API compiles it in, XATLAS_EXPORT_API exports
       it. No fallback: a lightmap needs an unwrap, so a missing library refuses that cook (XatlasNative says
       which file) and nothing else. -->
  <Target Name="BuildXatlas" BeforeTargets="StageBlixNatives"
          Inputs="$(XatlasSrc)/xatlas.cpp;$(XatlasSrc)/xatlas.h;$(XatlasSrc)/xatlas_c.h"
          Outputs="$(BlixXatlasLib)">
    <MakeDir Directories="$(BlixNativeDir)" />
    <Message Text="Building $(BlixLibPrefix)blix_xatlas$(BlixLibExt) (clang++)" Importance="high" />
    <Exec Command="clang++ -O2 -std=c++17 -DXATLAS_C_API=1 -DXATLAS_EXPORT_API=1 $(BlixSharedFlag) $(BlixPicFlag) &quot;$(XatlasSrc)/xatlas.cpp&quot; -o &quot;$(BlixXatlasLib)&quot; -lpthread"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="BlixXatlasExit" />
    </Exec>
    <Warning Condition="'$(BlixXatlasExit)' != '0'"
             Text="Could not build the xatlas native. Cooking a lightmap unwrap will fail with a message naming this target." />
  </Target>

  <!-- ContentWithTargetPath is the item MSBuild carries across a ProjectReference, so
       this is what puts the dylibs beside every consumer's assembly rather than only
       beside this one. -->
  <Target Name="StageBlixNatives" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <ContentWithTargetPath Include="$(BlixMeshoptLib)"
                             Condition="Exists('$(BlixMeshoptLib)')"
                             TargetPath="$(BlixLibPrefix)meshoptimizer$(BlixLibExt)"
                             CopyToOutputDirectory="PreserveNewest" />
      <ContentWithTargetPath Include="$(BlixBc7Lib)"
                             Condition="Exists('$(BlixBc7Lib)')"
                             TargetPath="$(BlixLibPrefix)blix_bc7$(BlixLibExt)"
                             CopyToOutputDirectory="PreserveNewest" />
      <ContentWithTargetPath Include="$(BlixMikkLib)"
                             Condition="Exists('$(BlixMikkLib)')"
                             TargetPath="$(BlixLibPrefix)blix_mikk$(BlixLibExt)"
                             CopyToOutputDirectory="PreserveNewest" />
      <ContentWithTargetPath Include="$(BlixXatlasLib)"
                             Condition="Exists('$(BlixXatlasLib)')"
                             TargetPath="$(BlixLibPrefix)blix_xatlas$(BlixLibExt)"
                             CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
