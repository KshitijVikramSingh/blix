<Project Sdk="Microsoft.NET.Sdk">

  <!-- References the runtime as well as the core, because half of what this suite judges is the
       SEAM: Blix.Core owns the state machine and Blix.Runtime.Silk owns the translation from a
       backend's vocabulary into it. A suite that could only see one of them would pass while the
       two disagreed, which is the failure this arc exists to remove. -->
  <ItemGroup>
    <ProjectReference Include="..\Blix.Verify\Blix.Verify.csproj" />
    <ProjectReference Include="..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
