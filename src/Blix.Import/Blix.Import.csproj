<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Reading glTF sources, for the cook — and NOT part of the engine.

       The engine reads cooked models only (.blixmesh, through ModelData), so parsing a source is the
       cook's job, and it lives here with SharpGLTF. Blix.Recipes and anything else that turns a
       source into a cooked file references this; a game does not. Like Blix.Recipes, it uses only
       public engine API. -->

  <ItemGroup>
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\Blix.Cooked\Blix.Cooked.csproj" />
    <ProjectReference Include="..\Blix.Geometry\Blix.Geometry.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Images\Blix.Graphics.Images.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
  </ItemGroup>

</Project>
