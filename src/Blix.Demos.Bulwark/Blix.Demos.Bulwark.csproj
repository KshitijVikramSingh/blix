<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\Blix.Audio\Blix.Audio.csproj" />
    <ProjectReference Include="..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <!-- InstancedBatch + its instanced.*.spv ship from Blix.Render via content
         propagation (same as VulkanInstanced). -->
    <ProjectReference Include="..\Blix.Render\Blix.Render.csproj" />
    <ProjectReference Include="..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Demos.Bulwark</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Font asset (+ manifest) for the HUD; SpriteBatch's sprite.*.spv ship from
         Blix.Render via content propagation. -->
    <None Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <GlslShader Include="Shaders\cube.vert" />
    <GlslShader Include="Shaders\cube.frag" />
    <GlslShader Include="Shaders\particle.vert" />
    <GlslShader Include="Shaders\particle.frag" />
    <GlslShader Include="Shaders\shadow_caster.vert" />
    <GlslShader Include="Shaders\shadow_caster.frag" />
    <GlslShader Include="Shaders\sky.vert" />
    <GlslShader Include="Shaders\sky.frag" />
    <GlslShader Include="Shaders\present.vert" />
    <GlslShader Include="Shaders\present.frag" />
    <GlslShader Include="Shaders\skinned_instanced.vert" />
    <GlslShader Include="Shaders\skinned_shadow_instanced.vert" />
    <!-- Shared GLSL library (src/Blix.Shaders), resolved via the -I path below; listed
         so editing a lib file retriggers the cook. -->
    <GlslInclude Include="..\Blix.Shaders\shadow.glsl" />
  </ItemGroup>

  <Target Name="CompileSpirV"
          AfterTargets="CopyFilesToOutputDirectory"
          Inputs="@(GlslShader);@(GlslInclude)"
          Outputs="@(GlslShader -> '$(OutDir)Shaders\%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(OutDir)Shaders" />
    <Message Text="Compiling SPIR-V: %(GlslShader.Identity)" Importance="high" />
    <Exec Command="&quot;$(Glslc)&quot; -I &quot;$(MSBuildProjectDirectory)\..\Blix.Shaders&quot; -o &quot;$(OutDir)Shaders\%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; &quot;%(GlslShader.Identity)&quot;" />
  </Target>

</Project>
