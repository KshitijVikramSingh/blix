<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Roslyn source generator: loaded into the compiler of every project with shaders, never
       shipped with one. netstandard2.0 because that is what the compiler hosts. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Not an app, and has no shaders of its own. -->
    <BlixSkipAppIndex>true</BlixSkipAppIndex>
    <!-- Release tracking is for analyzers shipped as packages; this one ships with the source. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
