<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\Blix.Geometry\Blix.Geometry.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <!-- Vulkan is the sole backend post-GL-sunset. SpriteBatch owns its shader
         + pipeline (SPIR-V, ShaderInterface, set-0 binding), so Blix.Render
         depends on the Vulkan backend directly. -->
    <ProjectReference Include="..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Blix.Tools.Shader\Blix.Tools.Shader.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Pre-compile the SpriteBatch shaders to SPIR-V at build time and ship them
       as content next to the assembly; consumers (demo executables) pick them up
       via CopyToOutputDirectory propagation. Mirrors Blix.Runtime.Silk's imgui
       shader shipping. -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
  </PropertyGroup>

  <ItemGroup>
    <GlslShader Include="Shaders\sprite.vert" />
    <GlslShader Include="Shaders\sprite.frag" />
  </ItemGroup>

  <Target Name="CompileSpirV"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(GlslShader);$(BlixShaderCompilerDll)"
          Outputs="@(GlslShader -> '$(MSBuildThisFileDirectory)Shaders\%(Filename)%(Extension).spv')">
    <Message Text="Compiling SPIR-V (lib): %(GlslShader.Identity)" Importance="high" />
    <Exec Command="dotnet &quot;$(BlixShaderCompilerDll)&quot; --glslc &quot;$(Glslc)&quot; --input &quot;%(GlslShader.FullPath)&quot; --output &quot;$(MSBuildThisFileDirectory)Shaders\%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; --include &quot;$(MSBuildProjectDirectory)/../Blix.Shaders&quot;" />
  </Target>

  <ItemGroup>
    <None Include="Shaders\*.spv">
      <Pack>false</Pack>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Shaders\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
