<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The render graph's backend is realised in the Vulkan assembly, which reads the graph's declared
         tables; the graph tests build deviceless graphs through the internal constructor. -->
    <InternalsVisibleTo Include="Blix.Graphics.Vulkan" />
    <InternalsVisibleTo Include="Blix.Test.Graphics" />
  </ItemGroup>

</Project>
