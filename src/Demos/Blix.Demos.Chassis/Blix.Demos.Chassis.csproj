<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE WHOLE PROJECT FILE. Compare it to the ~80 lines a Blix executable used to
    need, about half of which restated how to compile a shader. This one declares
    no shaders at all, which is the point: an application should describe what it
    is, not how the engine works.
  -->
  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <ProjectReference Include="..\..\Blix\Blix.csproj" />
    <ProjectReference Include="..\..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Demos.Chassis</RootNamespace>
  </PropertyGroup>

</Project>
