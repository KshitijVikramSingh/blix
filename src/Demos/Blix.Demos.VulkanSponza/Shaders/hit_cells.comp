#version 450
// Hit cells (SponzaLoop.HitCells.cs): which patch a gather ray's hit lies among, cooked per triangle row instead of
// searched per hit (its sun is the Metal trace's own shadow ray from the hit: hit flag 8). The shade (texel_nodes_shade.glsl) found it by probing the cook's hash at the hit's 8 cells (up to 2 normal bins)
// and reading every candidate texel, then the nearest patch: ~25 ms of a 39 ms shade pass of 1 M rays, and the random
// reads slowed the Metal trace beside it 4x (2026-10-16). Each row's barycentric square is cut into r x r cells (r from
// its longest edge over the cell size; the lower triangle only, r(r+1)/2 cells), each a cell's answer for its centre --
// the same lookup the shade made, made once -- and the shade reads the hit's row and barycentrics (the Metal trace
// writes both) to its cell: two words.
// One buffer (HitCells, so the shade takes one binding more): word 0 the rows, then two words a row, then two a cell.
//   a cell   word 0: its front side's patch + 1 (low 24 bits; 0: none), the top 8 its sun -- the visibility of the side
//            facing the sun, 0-255; word 1: its back side's patch + 1 (a sheet's two sides see different patches), bit 31
//            a contact across the cell (mode 0), bit 30 a sun edge across it (mode 1): their hits take the search
//   a row    two words: its first cell, r (up to 1,023: cells of the size on a 100 m edge -- at 6 bits, 64 a side, a
//            large triangle's cells were 30 cm and more, sunlit at the centre and shaded where a ray met them,
//            and the transfer, tracing every ray to its cell, lit the crevices' corners from them, 2026-10-16)
//   mode 0   a thread a work item (a row's up to 256 cells): their patches, the shade's lookup at each cell's centre for either side
//   mode 1   the same, at each sun change: the cells' sun -- the shade's own blend of the texels' sun bits around the
//            centre (or the sun points' among none), on the side facing the sun. The hit's own shadow ray in its place
//            (exact, 0 or 1 a hit) mottled the walls: the crevices' |error| 0.043 -> 0.063 (2026-10-16), where the
//            blend of up to eight texels' bits filters it. Buried texels answer nothing, so a centre inside a solid
//            takes its visible neighbours' -- a single shadow ray from the centre escaped from inside one.
//            With the transfer (uRows.w), each side's outgoing light too, per column (CellLight, 4 words a cell: front
//            sky, front sun, back sky, back sun, rgb9e5): albedo x (its patch's light + on the side facing the sun, the
//            sun x n.l x that visibility) -- what a gather ray meeting it gathered (texel_nodes_shade.glsl's hit).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform HitCellsParams {
    vec4 uRows;        // x the rows in the dispatch, y its first row
    vec4 uTexelGrid;
    vec4 uShade;       // z the cook hash's slots, w the sun points' hash's
    vec4 uLookup;      // x, y the shade's lookup (texel_nodes.glsl); z 1: mark the cells a contact or a sun edge crosses (--cell-marks)
    vec4 uToSun;       // xyz toward the sun; w the sun's column (its bit)
    vec4 uSunBits;     // x the bit words a texel (and a sun point), y the visibility among no texel nor sun point
    vec4 uColumns;     // x the columns (patch light's), y the sky's column, z the sun's
    vec4 uIrr;         // rgb the sun's irradiance
    vec4 uCookedGrid;
    vec4 uCookedDims;
} u;

layout(std430, set = 0, binding = 1) readonly buffer RayTriangles { uvec4 triangles[]; };
layout(std430, set = 0, binding = 2) readonly buffer RayPositions { vec4 positions[]; };
layout(std430, set = 0, binding = 3) readonly buffer RayOwners { uvec2 owners[]; };
layout(std430, set = 0, binding = 4) buffer HitCells { uint hitCells[]; };
layout(std430, set = 0, binding = 5) readonly buffer Texels { vec4 texels[]; };
layout(std430, set = 0, binding = 6) readonly buffer SunNodeHash { uint cookHash[]; };
layout(std430, set = 0, binding = 7) readonly buffer TexelPatch { int texelPatch[]; };
layout(std430, set = 0, binding = 8) readonly buffer FoliagePoints { vec4 foliagePoints[]; };
layout(std430, set = 0, binding = 9) readonly buffer FoliageHash { uint foliageHash[]; };
layout(std430, set = 0, binding = 18) readonly buffer HitCellWork { uvec2 work[]; };   // (row, its first cell)
#define ITEM_CELLS 256
layout(std430, set = 0, binding = 13) readonly buffer SunNodeBits { uint sunBits[]; };
layout(std430, set = 0, binding = 14) readonly buffer FoliageBits { uint foliageBits[]; };
layout(std430, set = 0, binding = 15) readonly buffer SunNodePatchLight { uvec2 patchLight[]; };   // [patch][column]: half rgb
layout(std430, set = 0, binding = 16) readonly buffer RaySurfaces { uint surfaces[]; };            // a row: sRGB albedo, coverage
layout(std430, set = 0, binding = 17) writeonly buffer CellLight { uint cellLight[]; };

uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

vec3 patchColumn(int p, uint column) {
    if (p < 0) return vec3(0.0);
    uvec2 w = patchLight[uint(p) * uint(u.uColumns.x) + column];
    return vec3(unpackHalf2x16(w.x), unpackHalf2x16(w.y).x);
}

#define COOKED_BINDING 10
#define COOKED_GRID u.uCookedGrid
#define COOKED_DIMS u.uCookedDims
#include "cooked_patches.glsl"
#define NODE_LOOKUP
#include "texel_nodes.glsl"

// The shade's answer for a point on a side: the patch its likeliest texel sees, else the nearest on its placement
// facing; among no texel, the nearest anywhere.
int cellPatch(vec3 p, vec3 n, uint placement) {
    int ids[NODE_CANDIDATES];
    float weights[NODE_CANDIDATES];
    float total = nodeSetAt(0, p, n, u.uTexelGrid, uint(u.uShade.z), u.uLookup.xy, ids, weights);
    if (total <= 0.0) return cookedNearest(p, n);
    int likeliest = -1;
    float most = 0.0;
    for (int c = 0; c < NODE_CANDIDATES; ++c) if (ids[c] >= 0 && weights[c] > most) { most = weights[c]; likeliest = ids[c]; }
    int patchIndex = max(texelPatch[likeliest], -1);
    if (patchIndex < 0) patchIndex = cookedNearestOn(p, n, placement);
    return patchIndex;
}

// The shade's blend of a point's sun: the texels' around it weighed (or, among none, the sun points'), each 1 where its
// bit for the sun is set.
float cellSun(vec3 p, vec3 n) {
    int ids[NODE_CANDIDATES];
    float weights[NODE_CANDIDATES];
    bool foliage = false;
    float total = nodeSetAt(0, p, n, u.uTexelGrid, uint(u.uShade.z), u.uLookup.xy, ids, weights);
    if (total <= 0.0 && u.uShade.w > 0.5) {
        total = nodeSetAt(1, p, n, u.uTexelGrid, uint(u.uShade.w), u.uLookup.xy, ids, weights);
        foliage = total > 0.0;
    }
    if (total <= 0.0) return u.uSunBits.y;
    uint words = uint(u.uSunBits.x);
    uint bit = uint(u.uToSun.w);
    float visible = 0.0;
    for (int c = 0; c < NODE_CANDIDATES; ++c) {
        if (ids[c] < 0) continue;
        uint w = foliage ? foliageBits[uint(ids[c]) * words + bit / 32u] : sunBits[uint(ids[c]) * words + bit / 32u];
        if ((w & (1u << (bit % 32u))) != 0u) visible += weights[c];
    }
    return visible / total;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uRows.x)) return;
    // A work item: a row and its first cell of up to ITEM_CELLS (a large triangle's cells span many items: a thread a
    // row looped over half a million for one, 2026-10-16).
    uvec2 item = work[uint(u.uRows.y) + t];
    uint row = item.x;
    uint cellBase = 1u + 2u * hitCells[0];
    uint first = hitCells[1u + 2u * row];
    uint r = hitCells[2u + 2u * row];
    uint total = r * (r + 1u) / 2u;
    uint start = item.y, end = min(start + uint(ITEM_CELLS), total);
    uvec4 tri = triangles[row];
    vec3 p0 = positions[tri.x].xyz, p1 = positions[tri.y].xyz, p2 = positions[tri.z].xyz;
    vec3 face = cross(p1 - p0, p2 - p0);
    if (dot(face, face) < 1e-20) return;
    face = normalize(face);
    uint placement = owners[tri.w].x;
    // The start's (i, j): row i of the lower triangle holds r - i cells.
    uint i = 0u, j = start;
    while (j >= r - i) { j -= r - i; i++; }
    for (uint c = start; c < end; ++c, ++j) {
        if (j + i >= r) { i++; j = 0u; }
        uint cell = first + c;
        {
            vec2 b = (vec2(i, j) + 1.0 / 3.0) / float(r);
            vec3 p = (1.0 - b.x - b.y) * p0 + b.x * p1 + b.y * p2;
            // The cell's corners, a sixth of the way in: where its centre's answer may not hold.
            vec3 corners[3];
            for (uint k = 0u; k < 3u; ++k) {
                vec2 bk = (vec2(i, j) + vec2(k == 1u ? 1.0 : 0.0, k == 2u ? 1.0 : 0.0)) / float(r);
                bk = mix(bk, b, 1.0 / 6.0);
                corners[k] = (1.0 - bk.x - bk.y) * p0 + bk.x * p1 + bk.y * p2;
            }
            if (u.uRows.z > 0.5) {
                float facing = dot(face, u.uToSun.xyz);
                vec3 lit = facing > 0.0 ? face : -face;
                float sun = abs(facing) > 1e-6 ? cellSun(p, lit) : 0.0;
                // A sun edge across it (its corners' visibility over half apart): its hits take the search, at the hit
                // (word 1's bit 30, this sun's).
                float lo = sun, hi = sun;
                if (abs(facing) > 1e-6 && u.uLookup.z > 0.5) for (uint k = 0u; k < 3u; ++k) { float v = cellSun(corners[k], lit); lo = min(lo, v); hi = max(hi, v); }
                uint at = cellBase + 2u * cell;
                hitCells[at] = (hitCells[at] & 0xFFFFFFu) | (uint(clamp(sun, 0.0, 1.0) * 255.0 + 0.5) << 24);
                hitCells[at + 1u] = (hitCells[at + 1u] & ~0x40000000u) | (hi - lo > 0.5 ? 0x40000000u : 0u);
                if (u.uRows.w > 0.5) {
                    vec3 srgb = unpackUnorm4x8(surfaces[row]).rgb;
                    vec3 albedo = mix(srgb / 12.92, pow((srgb + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), srgb));
                    uint skyColumn = uint(u.uColumns.y), sunColumn = uint(u.uColumns.z);
                    for (uint side = 0u; side < 2u; ++side) {
                        int p = int(hitCells[at + side] & 0xFFFFFFu) - 1;
                        float nl = max(dot(side == 0u ? face : -face, u.uToSun.xyz), 0.0);
                        vec3 direct = u.uIrr.rgb * nl * sun;
                        cellLight[4u * cell + 2u * side] = packRgb9e5(albedo * patchColumn(p, skyColumn));
                        cellLight[4u * cell + 2u * side + 1u] = packRgb9e5(albedo * (patchColumn(p, sunColumn) + direct));
                    }
                }
                continue;
            }
            int front = cellPatch(p, face, placement), back = cellPatch(p, -face, placement);
            // A contact across it (a corner's patch on either side not its centre's: a crease, a box on a floor): its
            // hits take the search, at the hit (word 1's bit 31). One patch a cell side read the creases' light from
            // across them (crevices' seams 0.83 of the reference against the search's 0.86, 2026-10-19).
            // Only where the surface turns: a corner's patch facing over 30 degrees off the centre's, or one where the centre
            // has none (or none where it has one). A different patch alone is no contact -- patches 25 cm apart split every
            // flat wall's cells, and Sponza's marked cells held most hits to the search (shade 62 ms a 1 M rays, 2026-10-19).
            bool contact = false;
            for (uint k = 0u; k < 3u && u.uLookup.z > 0.5; ++k) {
                for (uint side = 0u; side < 2u; ++side) {
                    int centre = side == 0u ? front : back;
                    int there = cellPatch(corners[k], side == 0u ? face : -face, placement);
                    if (there == centre) continue;
                    if ((there < 0) != (centre < 0)) { contact = true; continue; }
                    if (there >= 0 && dot(cookedPatch[3 * there + 1].xyz, cookedPatch[3 * centre + 1].xyz) < 0.866) contact = true;
                }
            }
            hitCells[cellBase + 2u * cell] = uint(front + 1) & 0xFFFFFFu;
            hitCells[cellBase + 2u * cell + 1u] = (uint(back + 1) & 0xFFFFFFu) | (contact ? 0x80000000u : 0u);
        }
}
}
