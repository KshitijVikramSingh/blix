#version 450
// Light-free lists (SponzaLoop.Lists.cs, --lists): a texel's light at a light change as a sum over what its rays reached
// when the lists were cooked (--list-cook), with no ray traced -- tools/gi-model/light_lists.py, light_lists_change.py and
// list_packing.py the model. A thread a texel of the dispatch; its list, packed (SponzaLoop.Lists.cs, PackLists): two
// header words (x the sky bins | the texels << 16, y the cells), then a word an entry -- its bin or id in the top 10 bits
// (an id as the step from the last of its kind; 1023: the id whole in the next word), its rgb in the low 22 (luminance
// on a log scale, 12 bits over the stage's range uPack.xy; r and g over r + g + b, 5 bits each). By kind:
//   a sky bin     the cook's rays that missed into it (8 x 8 octahedral, the world's): rgb the sky's light they took (x
//                 weight; the sky is fixed: a probe, or one baked once)
//   a texel       a near hit's: rgb (albedo x weight / pi, summed) x (its light, the last iteration's parts, + on the sun's
//                 column the sun x its n.l x its sun bit -- the hit's sun light-free, texel by texel)
//   a cell side   a far hit's: rgb (albedo x weight / pi, summed: the rays' own albedos) x hit_cells.comp's CellLight (its
//                 patch blend averaged over its area, and its sun: the side's bits' blend x n.l x the sun)
// The sums over the texel's cook rays (each its own share: 1 / rays) times its scale (the remainder: what its rays met
// that no list keeps -- among no texel, the foliage's -- in the light it carried at the cook). Read from Prev*, written
// to Split* (a texel's light from the last iteration's, never this one's: the same answer whatever order threads run).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform Lists {
    vec4 uLists;    // x the texels in the dispatch, y the first; w < 0 --list-debug
    vec4 uToSun;    // xyz toward the sun; w the sun's bit in a texel's sun bits
    vec4 uIrr;      // rgb the sun's irradiance; w the sun bits' words a texel
    vec4 uPack;     // x, y the luminance's log2 range (the stage's)
} u;

layout(std430, set = 0, binding = 2) readonly buffer ListTexels { uint listTexels[]; };    // the texel each list is
layout(std430, set = 0, binding = 3) readonly buffer ListStart { uint listStart[]; };      // its first word
layout(std430, set = 0, binding = 4) readonly buffer ListWords { uint words[]; };
layout(std430, set = 0, binding = 5) readonly buffer ListNorm { vec2 listNorm[]; };       // 1 / its rays, its scale
layout(std430, set = 0, binding = 6) readonly buffer Texels { vec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 7) readonly buffer SunNodeBits { uint sunBits[]; };
layout(std430, set = 0, binding = 8) readonly buffer CellLight { uint cellLight[]; };
layout(std430, set = 0, binding = 9) readonly buffer PrevSky { uvec2 prevSky[]; };
layout(std430, set = 0, binding = 10) readonly buffer PrevSun { uvec2 prevSun[]; };
layout(std430, set = 0, binding = 11) buffer SplitSky { uvec2 skyPart[]; };
layout(std430, set = 0, binding = 12) buffer SplitSun { uvec2 sunPart[]; };
// --list-debug: per list, the light (luminance, both columns, sun absolute) by kind: x the sky, y texels, z cells, w the
// remainder's share added (scale - 1 of the kept).
layout(std430, set = 0, binding = 13) buffer ListDebug { vec4 listDebug[]; };
layout(std430, set = 0, binding = 14) buffer TexelProvenance { uint provenance[]; };
#include "provenance.glsl"

uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

vec3 unpackRgb9e5(uint p) {
    float scale = exp2(float(int(p >> 27) - 15 - 9));
    return vec3(p & 511u, (p >> 9) & 511u, (p >> 18) & 511u) * scale;
}

const vec3 lumW = vec3(0.2126, 0.7152, 0.0722);

// An entry's rgb (SponzaLoop.Lists.cs, PackRgb22): 0 none; else luminance step q - 1 of 4094 over the range.
vec3 entryRgb(uint w) {
    uint q = (w >> 10) & 4095u;
    if (q == 0u) return vec3(0.0);
    float l = exp2(u.uPack.x + (float(q) - 1.0) * (u.uPack.y - u.uPack.x) / 4094.0);
    vec2 rg = vec2(float((w >> 5) & 31u), float(w & 31u)) / 31.0;
    vec3 c = vec3(rg, max(1.0 - rg.x - rg.y, 0.0));
    return c * (l / max(dot(c, lumW), 1e-6));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u.uLists.x)) return;
    uint li = uint(u.uLists.y) + i;
    uint id = listTexels[li];
    uint sunWords = uint(u.uIrr.w);
    uint bit = uint(u.uToSun.w);
    vec3 sky = vec3(0.0), sun = vec3(0.0);
    vec3 dbg = vec3(0.0);
    uint at = listStart[li];
    uint h0 = words[at], h1 = words[at + 1u];
    at += 2u;
    uint nSky = h0 & 0xFFFFu, nTexels = h0 >> 16, nCells = h1;
    for (uint k = 0u; k < nSky; ++k) sky += entryRgb(words[at++]);
    dbg.x = dot(sky, lumW);
    uint t = 0u;
    for (uint k = 0u; k < nTexels; ++k) {
        uint w = words[at++];
        uint step = w >> 22;
        t = step == 1023u ? words[at++] : t + step;
        vec3 rgb = entryRgb(w);
        vec3 n = TEXEL_NORMAL(t).xyz;
        float nl = dot(n, n) > 1e-12 ? max(dot(normalize(n), u.uToSun.xyz), 0.0) : 0.0;
        float lit = (sunBits[t * sunWords + bit / 32u] >> (bit % 32u)) & 1u;
        vec3 s = rgb * unpackRgb9e5(prevSky[t].x);
        vec3 l = rgb * (unpackRgb9e5(prevSun[t].x) * u.uIrr.rgb + u.uIrr.rgb * nl * lit);
        sky += s; sun += l;
        dbg.y += dot(s + l, lumW);
    }
    uint c = 0u;
    for (uint k = 0u; k < nCells; ++k) {
        uint w = words[at++];
        uint step = w >> 22;
        c = step == 1023u ? words[at++] : c + step;
        vec3 rgb = entryRgb(w);
        uint cell = c >> 1u, side = c & 1u;
        vec3 s = rgb * unpackRgb9e5(cellLight[4u * cell + 2u * side]);
        vec3 l = rgb * unpackRgb9e5(cellLight[4u * cell + 2u * side + 1u]);
        sky += s; sun += l;
        dbg.z += dot(s + l, lumW);
    }
    vec2 norm = listNorm[li];
    if (u.uLists.w < 0.0) listDebug[li] = vec4(dbg * norm.x, dot(sky + sun, lumW) * norm.x * (norm.y - 1.0));
    skyPart[id] = uvec2(packRgb9e5(sky * norm.x * norm.y), 0xFFFFu | 0x10000u);
    sunPart[id] = uvec2(packRgb9e5(sun * norm.x * norm.y / max(u.uIrr.rgb, vec3(1e-6))), 0xFFFFu | 0x10000u);
    // A gather's answer: a later gather's near hits read it (texel_nodes_shade.glsl, texelPartLight) -- left as the instant
    // layer's (6), the live gathers after landing took the patches' instead.
    provenanceMark(id, 10u, true, true);
}
