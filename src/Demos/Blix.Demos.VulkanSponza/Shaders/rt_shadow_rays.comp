#version 450

// --rt-shadows: one sun shadow ray per traced pixel, from the pre-pass's depth and normal, for the Metal shadow pass
// that follows (SponzaLoop.RtShadows). At half resolution (uSize.z = 2) a traced pixel is one of its 2x2 block's
// four, rotating every frame (uSample), so the TAA history sees all four.
//
// Each origin is a vec4: the surface point, lifted off the surface along its shading normal, and how far its ray goes
// toward the sun; 0 where there is no surface (lit), and -1 where the surface faces away from the sun (in its own
// shadow, not traced: its ray would leave through the surface it starts on). Each mask word gets the surface's
// distance from the camera (float bits, sign clear) for lit.frag's upsampling; the Metal pass sets the top bit where
// the sun is blocked.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform RtShadowRays {
    mat4 uInvViewProj;   // inverse of the jittered view-projection the pre-pass drew with
    vec4 uSize;          // xy: traced pixels; z: full pixels per traced pixel (1 or 2); w unused
    vec4 uCamera;        // xyz: position
    vec4 uSun;           // xyz: toward the sun, unit; w: how far a ray goes
    vec4 uSample;        // xy: which full pixel of its block a traced pixel reads this frame; zw: full pixels
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) writeonly buffer RtShadowOrigins { vec4 origins[]; };
// The mask lit.frag reads: a header (width, height, live, scale) then one word per traced pixel.
layout(std430, set = 0, binding = 4) buffer RtShadowMask { uvec4 header; uint words[]; } mask;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= uint(u.uSize.x) || p.y >= uint(u.uSize.y)) return;
    uint index = p.y * uint(u.uSize.x) + p.x;
    ivec2 texel = min(ivec2(p) * int(u.uSize.z) + ivec2(u.uSample.xy), ivec2(u.uSample.zw) - 1);
    float raw = texelFetch(uSceneDepth, texel, 0).r;
    vec4 nSample = texelFetch(uPrepassNormal, texel, 0);
    if (raw >= 1.0 - 1e-6 || dot(nSample.xyz, nSample.xyz) < 1e-6) {
        origins[index] = vec4(0.0);
        mask.words[index] = floatBitsToUint(1e30);
        return;
    }
    vec2 ndc = (vec2(texel) + 0.5) / u.uSample.zw * 2.0 - 1.0;
    vec4 world = u.uInvViewProj * vec4(ndc, raw, 1.0);
    vec3 position = world.xyz / world.w;
    float distance = length(position - u.uCamera.xyz);
    mask.words[index] = floatBitsToUint(distance);
    // The pre-pass normal faces the camera (lit.frag's back-face convention).
    vec3 n = normalize(nSample.xyz);
    if (dot(n, u.uSun.xyz) <= 0.0) {
        origins[index] = vec4(position, -1.0);
        return;
    }
    // The lift grows with distance, as depth precision shrinks: 1 cm plus 0.1% of the distance.
    origins[index] = vec4(position + n * (0.01 + 0.001 * distance), u.uSun.w);
}
