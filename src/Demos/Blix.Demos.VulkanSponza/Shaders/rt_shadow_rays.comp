#version 450

// --rt-shadows: one sun shadow ray per pixel, from the pre-pass's depth and normal, for the Metal shadow pass that
// follows (SponzaLoop.RtShadows). Each origin is a vec4: the surface point at the pixel's centre, lifted off the
// surface, and how far its ray goes toward the sun; 0 where the pixel has no surface (lit).
//
// Lifted to the side the sun is on. Facing the sun, that is along the shading normal (the camera's side), and the ray
// answers whether the surface is lit. Facing away, lit.frag uses the answer only for diffuse transmission, the sun
// arriving on the sheet's far side: so the ray starts there (lifted against the normal) and answers that. Lifted
// along the normal instead, it would always leave through the sheet it starts on and find it in shadow, which
// darkened every fold of a curtain turned from the sun. An opaque surface's far-side answer is computed and unused.
//
// With uSky.x (the isolated traced path), each surface pixel also gets a sky ray, two vec4s: its origin (lifted along the
// normal, the side the camera sees, whatever the sun's) and length, then a direction drawn cosine-weighted over the
// normal's hemisphere, a new one every frame, so the Metal pass answers whether the point sees the sky that way and
// TAA averages the answers into its sky visibility.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform RtShadowRays {
    mat4 uInvViewProj;   // inverse of the jittered view-projection the pre-pass drew with
    vec4 uSize;          // xy: pixels
    vec4 uCamera;        // xyz: position
    vec4 uSun;           // xyz: toward the sun, unit; w: how far a ray goes
    vec4 uSky;           // x: 1 to write sky rays; y: the frame's number (exact: below 2^24)
    vec4 uHalf;          // x 1: one ray per half-res pixel (uSize the half grid), from the full-res pixel 2p + yz of its
                         // 2x2 (RenderSettings.HalfResLighting: the incident pass's pixel, lighting_upsample.frag)
    vec4 uDisc;          // the sun's disc (ShadowsSettings.SunDiscDegrees): x the tangent of its angular radius (0: a point,
                         // no directions written), y the frame's number
    vec4 uLightlet;      // the sun records (SponzaLoop.LightletBake, RenderSettings.LightletSun): xy the sun in the band's fine
                         // node coordinates, z 1 when they answer, w tau (degrees): a record under it is not certain
    vec4 uLightmap;      // the atlas (texel.glsl): x 1 when on, yz its size
    vec4 uCompact;       // x 1: the traced rays packed (below); y which of the two counters is this frame's; z 1: the
                         // per-pixel origins and directions written too (unpacked, or a census reads them)
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) writeonly buffer RtShadowOrigins { vec4 origins[]; };
layout(std430, set = 0, binding = 4) writeonly buffer RtShadowSky { vec4 skyRays[]; };
// Each ray's own direction (with uDisc.x): toward a point of the sun's disc, uniform over its area, a different one per
// pixel and per frame -- the Metal pass traces each its own way (hwx_encode_shadow's directions), so a penumbra is a
// mix of rays that reached and rays that did not, which lighting_upsample.frag and TAA average.
layout(std430, set = 0, binding = 5) writeonly buffer RtShadowDirections { vec4 directions[]; };
// Lightlets: a pixel whose four atlas texels' sun records all answer, and agree, takes the baked answer and traces no
// ray (0 lit, 1 shadowed); >= 2 where it traces. lighting_upsample.frag reads it beside the traced mask.
layout(std430, set = 0, binding = 6) writeonly buffer RtShadowBaked { uint baked[]; };
layout(set = 0, binding = 7) uniform usampler2D uLightmapTexel;
layout(std430, set = 0, binding = 8) readonly buffer LightmapIndexMap { uint lightmapIndexMap[]; };
layout(std430, set = 0, binding = 9) readonly buffer Texels { vec4 texels[]; };
layout(std430, set = 0, binding = 10) readonly buffer LightletIndex { uint lightletIndex[]; };
layout(std430, set = 0, binding = 11) readonly buffer LightletPool { uint lightletPool[]; };
// uCompact.x: the rays that trace, packed -- origin, direction, and the pixel each answers -- counted into
// counters[uCompact.y] (the other zeroed for the slot's next frame). The Metal pass traces only the packed ones, each
// SIMD group full (one thread a pixel spread the traced over every group: 27.5% traced cost what 100% did), and
// writes their words; this pass writes every other pixel's word itself (no ray: lit; a record's shadow: 1).
layout(std430, set = 0, binding = 12) writeonly buffer RtShadowPacked { vec4 packedRays[]; };
layout(std430, set = 0, binding = 13) writeonly buffer RtShadowPixelOf { uint pixelOf[]; };
layout(std430, set = 0, binding = 14) buffer RtShadowCounters { uint counters[]; };
layout(std430, set = 0, binding = 15) writeonly buffer RtShadowMaskWords { uvec4 maskHeader; uint maskWords[]; };
#define TEXEL_INDEX_MAP(i) lightmapIndexMap[i]
#define TEXEL_HASH(i) uvec4(0u)
#define TEXEL_POSITION(i) texels[2 * (i)]
#define TEXEL_NORMAL(i) texels[2 * (i) + 1]
#include "texel.glsl"
#define LIGHTLET_INDEX(i) lightletIndex[i]
#define LIGHTLET_POOL(i) lightletPool[i]
#include "lightlet.glsl"

// 0 lit, 1 shadowed by the four texels' records; otherwise a ray, and why: 2 a record under tau or the four disagree,
// 3 no atlas texel at the pixel (foliage, what the atlas leaves out), 4 a texel missing or buried.
// Facing the sun the pixel's own side answers. Facing away, a single-sided surface gets no direct sun (1, no ray); a
// double-sided sheet's ray answers the sun on its FAR side (transmission) -- which is what the far side's own record
// holds (the pair's other record, its normal turned: facing the sun), so that record answers.
uint bakedSun(ivec2 q, vec3 n) {
    if (u.uLightlet.z < 0.5 || u.uLightmap.x < 0.5) return 2u;
    vec2 atlas;
    if (!texelLightmapUnpack(texelFetch(uLightmapTexel, q, 0).r, atlas)) return 3u;
    bool away = dot(n, u.uSun.xyz) <= 0.0;
    ivec2 size = ivec2(u.uLightmap.yz);
    ivec2 base = ivec2(floor(atlas - 0.5));
    int agreed = -1;
    for (int k = 0; k < 4; ++k) {
        ivec2 at = base + ivec2(k & 1, k >> 1);
        if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, size))) return 4u;
        uint front = lightmapIndexMap[at.y * size.x + at.x];
        if (front == 0xFFFFFFFFu) return 4u;
        bool pair = TEXEL_POSITION(front).w < 0.0;
        // The side the pixel shows (texelsAroundLightmap's rule), and the one that answers the sun.
        uint shown = pair && dot(TEXEL_NORMAL(front).xyz, n) < 0.0 ? front + 1u : front;
        uint answering = shown;
        if (away) {
            if (!pair) return 1u;
            answering = shown == front ? front + 1u : front;
        }
        if (abs(TEXEL_POSITION(answering).w) < 2.0) return 4u;
        float d = lightletDistance(answering, u.uLightlet.xy);
        if (abs(d) < u.uLightlet.w) return 2u;
        int s = d > 0.0 ? 0 : 1;
        if (agreed >= 0 && s != agreed) return 2u;
        agreed = s;
    }
    return uint(agreed);
}

uint hash32(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= uint(u.uSize.x) || p.y >= uint(u.uSize.y)) return;
    uint index = p.y * uint(u.uSize.x) + p.x;
    bool packing = u.uCompact.x > 0.5;
    bool perPixel = u.uCompact.z > 0.5;
    // The header's z back to 1 (traced; rt_shadow_filter.comp sets 2 when it filters this frame's mask).
    if (index == 0u) maskHeader.z = 1u;
    if (packing && index == 0u) counters[1u - uint(u.uCompact.y)] = 0u;
    // The full-res pixel this ray starts from.
    ivec2 fullSize = textureSize(uSceneDepth, 0);
    ivec2 q = u.uHalf.x > 0.5 ? min(ivec2(p) * 2 + ivec2(u.uHalf.yz), fullSize - 1) : ivec2(p);
    float raw = texelFetch(uSceneDepth, q, 0).r;
    vec4 nSample = texelFetch(uPrepassNormal, q, 0);
    bool sky = u.uSky.x > 0.5;
    if (raw >= 1.0 - 1e-6 || dot(nSample.xyz, nSample.xyz) < 1e-6) {
        if (perPixel) origins[index] = vec4(0.0);
        baked[index] = 3u;
        if (packing) maskWords[index] = 0u;
        if (sky) skyRays[index * 2u] = vec4(0.0);
        return;
    }
    vec2 ndc = (vec2(q) + 0.5) / vec2(fullSize) * 2.0 - 1.0;
    vec4 world = u.uInvViewProj * vec4(ndc, raw, 1.0);
    vec3 position = world.xyz / world.w;
    // The pre-pass normal faces the camera (lit.frag's back-face convention).
    vec3 n = normalize(nSample.xyz);
    // The lift grows with distance, as depth precision shrinks: 1 cm plus 0.1% of the distance.
    float lift = 0.01 + 0.001 * length(position - u.uCamera.xyz);
    vec3 origin = position + n * (dot(n, u.uSun.xyz) > 0.0 ? lift : -lift);
    uint answer = bakedSun(q, n);
    baked[index] = answer;
    // Answered: no ray, and the answer rides the reach (blix_shadow: 0 answered lit, < 0 answered shadowed), so the mask
    // every reader takes -- lit.frag at full res, lighting_upsample at half -- holds it with the traced pixels'.
    if (perPixel) origins[index] = vec4(origin, answer >= 2u ? u.uSun.w : answer == 1u ? -1.0 : 0.0);
    vec3 rayDir = u.uSun.xyz;
    if (u.uDisc.x > 0.0) {
        // The frame's point of a low-discrepancy sequence over the disc (R2), shifted per pixel by a hash (Cranley-
        // Patterson): neighbours sample different parts of the disc, and a pixel covers all of it over frames.
        uint h = hash32(index * 0x9E3779B9u + 0x85EBCA6Bu);
        vec2 shift = vec2(float(h & 0xFFFFu), float(h >> 16)) / 65536.0;
        float frame = u.uDisc.y;
        vec2 xi = fract(vec2(0.5) + frame * vec2(0.7548776662, 0.5698402910) + shift);
        vec3 s = u.uSun.xyz;
        vec3 t = normalize(abs(s.y) < 0.999 ? cross(s, vec3(0.0, 1.0, 0.0)) : cross(s, vec3(1.0, 0.0, 0.0)));
        vec3 b = cross(s, t);
        float r = u.uDisc.x * sqrt(xi.x);
        float phi = 6.28318530718 * xi.y;
        rayDir = normalize(s + (t * cos(phi) + b * sin(phi)) * r);
        if (perPixel) directions[index] = vec4(rayDir, 0.0);
    }
    if (packing) {
        if (answer >= 2u) {
            uint slot = atomicAdd(counters[uint(u.uCompact.y)], 1u);
            packedRays[slot * 2u] = vec4(origin, u.uSun.w);
            packedRays[slot * 2u + 1u] = vec4(rayDir, 0.0);
            pixelOf[slot] = index;
        } else maskWords[index] = answer == 1u ? 1u : 0u;
    }
    if (sky) {
        uint h = hash32(index * 0x9E3779B9u ^ hash32(uint(u.uSky.y)));
        float r1 = float(h >> 8) * (1.0 / 16777216.0);
        float r2 = float(hash32(h) >> 8) * (1.0 / 16777216.0);
        float phi = 6.28318530718 * r1;
        vec3 t = normalize(abs(n.y) < 0.999 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
        vec3 b = cross(n, t);
        vec3 d = (t * cos(phi) + b * sin(phi)) * sqrt(r2) + n * sqrt(1.0 - r2);
        skyRays[index * 2u] = vec4(position + n * lift, u.uSun.w);
        skyRays[index * 2u + 1u] = vec4(normalize(d), 0.0);
    }
}
