#version 450

// The traced sun shadows: one sun shadow ray per pixel, from the pre-pass's depth and normal, for the Metal shadow pass that
// follows (SponzaLoop.RtShadows). Each origin is a vec4: the surface point at the pixel's centre, lifted off the
// surface, and how far its ray goes toward the sun; 0 where the pixel has no surface (lit).
//
// Lifted to the side the sun is on. Facing the sun, that is along the shading normal (the camera's side), and the ray
// answers whether the surface is lit. Facing away, lit.frag uses the answer only for diffuse transmission, the sun
// arriving on the sheet's far side: so the ray starts there (lifted against the normal) and answers that. Lifted
// along the normal instead, it would always leave through the sheet it starts on and find it in shadow, which
// darkened every fold of a curtain turned from the sun. An opaque surface's far-side answer is computed and unused.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform RtShadowRays {
    mat4 uInvViewProj;   // inverse of the jittered view-projection the pre-pass drew with
    vec4 uSize;          // xy: pixels
    vec4 uCamera;        // xyz: position
    vec4 uSun;           // xyz: toward the sun, unit; w: how far a ray goes
    vec4 uHalf;          // x 1: one ray per half-res pixel (uSize the half grid), from the full-res pixel 2p + yz of its
                         // 2x2 (RenderSettings.HalfResShadows: the readout's pixel, lighting_upsample.frag)
    vec4 uDisc;          // the sun's disc (ShadowsSettings.SunDiscDegrees): x the tangent of its angular radius (0: a point,
                         // no directions written), y the frame's number
    vec4 uCompact;       // x 1: the traced rays packed (below); y which of the two counters is this frame's; z 1: the
                         // per-pixel origins and directions written too (unpacked, or a census reads them); w > 0:
                         // interleaved (ShadowsSettings.Interleave), only the pixels of each 2x2 at w - 1 (x + 2y)
                         // trace, the rest left to rt_shadow_fill.comp
    vec4 uTerminator;    // x the shadow terminator's skip (metres; 0 off), y the facet's n.l at most (main); z BLIX_RAYS_STOP
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) writeonly buffer RtShadowOrigins { vec4 origins[]; };
// Each ray's own direction (with uDisc.x): toward a point of the sun's disc, uniform over its area, a different one per
// pixel and per frame -- the Metal pass traces each its own way (hwx_encode_shadow's directions), so a penumbra is a
// mix of rays that reached and rays that did not, which lighting_upsample.frag and TAA average.
layout(std430, set = 0, binding = 5) writeonly buffer RtShadowDirections { vec4 directions[]; };
// uCompact.x: the rays that trace, packed -- origin, direction, and the pixel each answers -- counted into
// counters[uCompact.y] (the other zeroed for the slot's next frame). The Metal pass traces only the packed ones, each
// SIMD group full (one thread a pixel spread the traced over every group: 27.5% traced cost what 100% did), and
// writes their words; this pass writes every other pixel's word itself (no ray: lit).
layout(std430, set = 0, binding = 12) writeonly buffer RtShadowPacked { vec4 packedRays[]; };
layout(std430, set = 0, binding = 13) writeonly buffer RtShadowPixelOf { uint pixelOf[]; };
layout(std430, set = 0, binding = 14) buffer RtShadowCounters { uint counters[]; };
layout(std430, set = 0, binding = 15) writeonly buffer RtShadowMaskWords { uvec4 maskHeader; uint maskWords[]; };

uint hash32(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    bool first = p.x == 0u && p.y == 0u;
    // Interleaved (uCompact.w): dispatched over this frame's pixel of each 2x2 alone -- a thread a traced pixel, where a
    // thread a pixel read every pixel's depth and normal to send three in four home (SponzaLoop.RtShadows.cs).
    if (u.uCompact.w > 0.5) {
        uint ph = uint(u.uCompact.w) - 1u;
        p = p * 2u + uvec2(ph & 1u, ph >> 1);
    }
    if (p.x >= uint(u.uSize.x) || p.y >= uint(u.uSize.y)) return;
    uint index = p.y * uint(u.uSize.x) + p.x;
    bool packing = u.uCompact.x > 0.5;
    bool perPixel = u.uCompact.z > 0.5;
    // The header's z back to 1 (traced; rt_shadow_filter.comp sets 2 when it filters this frame's mask).
    if (first) maskHeader.z = 1u;
    if (packing && first) { counters[1u - uint(u.uCompact.y)] = 0u; counters[3] = 0u; }
    // The full-res pixel this ray starts from.
    ivec2 fullSize = textureSize(uSceneDepth, 0);
    ivec2 q = u.uHalf.x > 0.5 ? min(ivec2(p) * 2 + ivec2(u.uHalf.yz), fullSize - 1) : ivec2(p);
    float raw = texelFetch(uSceneDepth, q, 0).r;
    vec4 nSample = texelFetch(uPrepassNormal, q, 0);
    if (raw >= 1.0 - 1e-6 || dot(nSample.xyz, nSample.xyz) < 1e-6) {
        if (perPixel) origins[index] = vec4(0.0);
        if (packing) maskWords[index] = 0u;
        return;
    }
    // Interleaved: not this frame's pixel of its 2x2 -- no ray, no word (the fill writes it). Packed only, never per pixel.
    if (u.uCompact.w > 0.5 && (p.x & 1u) + 2u * (p.y & 1u) != uint(u.uCompact.w) - 1u) return;
    // BLIX_RAYS_STOP (uTerminator.z, a probe of this pass's cost): out after the depth and normal.
    if (u.uTerminator.z > 0.5) { maskWords[index] = floatBitsToUint(raw + nSample.x); return; }
    vec2 ndc = (vec2(q) + 0.5) / vec2(fullSize) * 2.0 - 1.0;
    vec4 world = u.uInvViewProj * vec4(ndc, raw, 1.0);
    vec3 position = world.xyz / world.w;
    // The pre-pass normal faces the camera (lit.frag's back-face convention).
    vec3 n = normalize(nSample.xyz);
    // The lift grows with distance, as depth precision shrinks: 1 cm plus 0.1% of the distance.
    float lift = 0.01 + 0.001 * length(position - u.uCamera.xyz);
    bool away = dot(n, u.uSun.xyz) <= 0.0;
    vec3 origin = position + n * (away ? -lift : lift);
    // The shadow terminator (uTerminator.x: the skip, 0 off; y: the facet's n.l at most): a coarse mesh shaded by smooth
    // normals -- a curtain -- has facets turned from the sun whose smooth normal still faces it. Their ray, however far it
    // is lifted along the normal, heads below the facet's own plane and meets the neighbouring facets: whole triangles
    // dark across sunlit cloth, a staircase along every fold (Crytek Sponza's curtains, 2026-10-27). There the ray starts
    // uTerminator.x further toward the sun, past its own facets. The facet's normal is the depth's: this pixel's point against
    // its nearer neighbour each way.
    if (u.uTerminator.x > 0.0 && !away) {
        vec3 side[2];
        bool okFacet = true;
        for (int axis = 0; axis < 2; axis++) {
            ivec2 step = axis == 0 ? ivec2(1, 0) : ivec2(0, 1);
            ivec2 qa = clamp(q + step, ivec2(0), fullSize - 1), qb = clamp(q - step, ivec2(0), fullSize - 1);
            float ra = texelFetch(uSceneDepth, qa, 0).r, rb = texelFetch(uSceneDepth, qb, 0).r;
            bool useA = abs(ra - raw) <= abs(rb - raw);
            ivec2 qn = useA ? qa : qb;
            float rn = useA ? ra : rb;
            if (rn >= 1.0 - 1e-6) { okFacet = false; break; }
            vec4 wn = u.uInvViewProj * vec4((vec2(qn) + 0.5) / vec2(fullSize) * 2.0 - 1.0, rn, 1.0);
            side[axis] = (wn.xyz / wn.w - position) * (useA ? 1.0 : -1.0);
        }
        if (okFacet) {
            vec3 ng = cross(side[0], side[1]);
            if (dot(ng, ng) > 1e-20) {
                ng = normalize(ng);
                if (dot(ng, n) < 0.0) ng = -ng;
                if (dot(ng, u.uSun.xyz) <= u.uTerminator.y) origin += u.uSun.xyz * u.uTerminator.x;
            }
        }
    }
    if (perPixel) origins[index] = vec4(origin, u.uSun.w);
    vec3 rayDir = u.uSun.xyz;
    if (u.uDisc.x > 0.0) {
        // The frame's point of a low-discrepancy sequence over the disc (R2), shifted per pixel by a hash (Cranley-
        // Patterson): neighbours sample different parts of the disc, and a pixel covers all of it over frames.
        uint h = hash32(index * 0x9E3779B9u + 0x85EBCA6Bu);
        vec2 shift = vec2(float(h & 0xFFFFu), float(h >> 16)) / 65536.0;
        float frame = u.uDisc.y;
        vec2 xi = fract(vec2(0.5) + frame * vec2(0.7548776662, 0.5698402910) + shift);
        vec3 s = u.uSun.xyz;
        vec3 t = normalize(abs(s.y) < 0.999 ? cross(s, vec3(0.0, 1.0, 0.0)) : cross(s, vec3(1.0, 0.0, 0.0)));
        vec3 b = cross(s, t);
        float r = u.uDisc.x * sqrt(xi.x);
        float phi = 6.28318530718 * xi.y;
        rayDir = normalize(s + (t * cos(phi) + b * sin(phi)) * r);
        if (perPixel) directions[index] = vec4(rayDir, 0.0);
    }
    if (packing) {
        // The census (SponzaLoop.RtShadows.cs, the shot's stats): word 3 the rays from pixels facing away.
        if (away) atomicAdd(counters[3], 1u);
        uint slot = atomicAdd(counters[uint(u.uCompact.y)], 1u);
        packedRays[slot * 2u] = vec4(origin, u.uSun.w);
        packedRays[slot * 2u + 1u] = vec4(rayDir, 0.0);
        pixelOf[slot] = index;
    }
}
