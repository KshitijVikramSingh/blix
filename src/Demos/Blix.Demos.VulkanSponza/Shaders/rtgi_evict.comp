#version 450

// --rtgi (SponzaLoop.Rtgi.cs): a slice of the slots a frame (uEvict.z onward, uEvict.w of them), each emptied when no
// training reached it for uEvict.y frames (its stamp, rtgi_train.comp) -- the resolve visits only the cells trained.
// Only under pressure: while the last sweep of all the slices found more than uPressure.y slots held. Emptied with room to
// spare, cells the screen still read went untrained-and-old together and came back unsure -- placed on, retrained from
// nothing, a wave of young cells through the resolve and the blend (a still Crytek Sponza view at 63% held: frames
// 16.7 -> 25 ms for ~10 s every 1800 frames, 2026-10-27). Held is counted here, slice by slice, into one of three counters
// in turn (uPressure.x the sweep's, mod 3): the one before complete, the one after cleared for the next sweep.

#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiEvict {
    vec4 uEvict;      // x the frame's number; y frames a slot lives untrained; z the slice's first slot; w its slots
    vec4 uPressure;   // x this sweep (0-2); y the slots held past which the old are emptied (0: always); z 1 on a
                      // sweep's first slice (the next counter cleared)
} u;

layout(std430, set = 0, binding = 10) buffer RtgiOccupancy { uint rtgiHeld[4]; };

layout(std430, set = 0, binding = 1) buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 2) buffer RtgiResolved { vec4 rtgiResolved[]; };
layout(std430, set = 0, binding = 3) buffer RtgiMoments { vec4 rtgiMoments[]; };
layout(std430, set = 0, binding = 4) buffer RtgiStamps { uvec2 rtgiStamps[]; };
layout(std430, set = 0, binding = 5) buffer RtgiDirection { vec4 rtgiDirection[]; };
layout(std430, set = 0, binding = 6) buffer RtgiConfidence { vec4 rtgiConfidence[]; };
layout(std430, set = 0, binding = 7) buffer RtgiRecord { uvec4 rtgiRecord[]; };
layout(std430, set = 0, binding = 8) readonly buffer RtgiCells { ivec4 rtgiCells[]; };
// The cache's work counters (rtgi_train.comp): 21-26 the cells emptied by level (0-5, past 5 the last), 27 contact cells
// (level 16 up), 28 those emptied holding 8 samples or more.
layout(std430, set = 0, binding = 9) buffer RtgiStats { uint rtgiStats[32]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint s = uint(u.uEvict.z) + i;
    bool held = i < uint(u.uEvict.w) && rtgiKeys[s] != 0u;
    uint sweep = uint(u.uPressure.x);
    uint n = subgroupBallotBitCount(subgroupBallot(held));
    if (subgroupElect() && n > 0u) atomicAdd(rtgiHeld[sweep], n);
    if (i == 0u && u.uPressure.z > 0.5) rtgiHeld[(sweep + 1u) % 3u] = 0u;
    if (!held) return;
    if (u.uPressure.y > 0.0 && float(rtgiHeld[(sweep + 2u) % 3u]) <= u.uPressure.y) return;
    uint frame = uint(u.uEvict.x);
    if (frame - rtgiStamps[s].x <= uint(u.uEvict.y)) return;
    uint level = uint(rtgiCells[s].w) / 6u;
    atomicAdd(rtgiStats[level >= 16u ? 27u : 21u + min(level, 5u)], 1u);
    if (rtgiResolved[2u * s + 1u].y >= 8.0) atomicAdd(rtgiStats[28], 1u);
    rtgiKeys[s] = 0u;
    rtgiResolved[2u * s] = vec4(0.0);
    rtgiResolved[2u * s + 1u] = vec4(0.0);
    for (uint k = 0u; k < 3u; k++) rtgiMoments[3u * s + k] = vec4(0.0);
    rtgiStamps[s] = uvec2(0u);
    rtgiDirection[s] = vec4(0.0);
    rtgiConfidence[s] = vec4(0.0);
    rtgiRecord[2u * s] = uvec4(0u);
    rtgiRecord[2u * s + 1u] = uvec4(0u);
}
