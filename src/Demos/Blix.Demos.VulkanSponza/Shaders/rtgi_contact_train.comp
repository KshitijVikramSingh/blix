#version 450

// --rtgi (S4 contact detail, SponzaLoop.Rtgi.cs): last frame's contact rays (rtgi_contact_rays.comp), answered, into the
// contact cells -- a quarter of their point's cell's size, at a level of their own (16 up: never a light cell), each
// holding the share of its rays that left past the contact radius (its near visibility, the resolve's w; its light is
// none). Listed for the resolve as training lists its cells. Zeroes the count of the list this frame's rays fill.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiContactTrain {
    vec4 uParams;        // rtgiParams (rtgi_cache.glsl)
    vec4 uCamera;        // xyz position
    vec4 uNearField;     // x the near field's radius (RTGI_NEAR)
    vec4 uList;          // x the frame's number; y the dirty list's room; z the contact list's room
} u;

layout(std430, set = 0, binding = 1) buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 2) buffer RtgiAccum { uint rtgiAccum[]; };
layout(std430, set = 0, binding = 3) buffer RtgiStamps { uvec2 rtgiStamps[]; };
layout(std430, set = 0, binding = 4) buffer RtgiDirty { uint dirtyCount; uint dirtyPad[3]; uint dirty[]; };
layout(std430, set = 0, binding = 5) buffer RtgiCells { ivec4 rtgiCells[]; };
layout(std430, set = 0, binding = 6) readonly buffer RtgiContactCount { uint contactCount; uint contactPad[3]; };
layout(std430, set = 0, binding = 7) readonly buffer RtgiContactPoints { vec4 contactPoints[]; };
layout(std430, set = 0, binding = 8) readonly buffer RtgiContactOccluded { uint contactOccluded[]; };
layout(std430, set = 0, binding = 9) buffer RtgiNextContactCount { uint nextContactCount; uint nextContactPad[3]; };

#define RTGI_KEYS(i) rtgiKeys[i]
#define RTGI_NEAR u.uNearField.x
#include "rtgi_cache.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i == 0u) nextContactCount = 0u;
    if (i >= min(contactCount, uint(u.uList.z))) return;
    vec3 p = contactPoints[2u * i].xyz, n = contactPoints[2u * i + 1u].xyz;
    uint level = rtgiLevel(p, u.uCamera.xyz, u.uParams);
    ivec3 c = ivec3(floor(p / (0.25 * rtgiSize(level, u.uParams))));
    uint side = rtgiSide(n);
    uvec2 h = rtgiCellHash(c, level + 16u, side, u.uParams);
    uint s = 0xFFFFFFFFu;
    for (uint k = 0u; k < RTGI_PROBES; k++) {
        uint t = (h.x + k) & uint(u.uParams.z);
        uint prev = atomicCompSwap(rtgiKeys[t], 0u, h.y);
        if (prev == 0u) rtgiCells[t] = ivec4(c, int((level + 16u) * 6u + side));
        if (prev == 0u || prev == h.y) { s = t; break; }
    }
    if (s == 0xFFFFFFFFu) return;
    uint frame = uint(u.uList.x);
    if (atomicExchange(rtgiStamps[s].x, frame) != frame) {
        uint k = atomicAdd(dirtyCount, 1u);
        if (k < uint(u.uList.y)) dirty[k] = s;
    }
    atomicAdd(rtgiAccum[RTGI_ACC * s + 3u], 1u);
    if ((contactOccluded[i] & 1u) == 0u) atomicAdd(rtgiAccum[RTGI_ACC * s + 11u], 256u);
}
