#version 450
// The far field's pooling (plan.md, R2; SponzaLoop.FarField.cs), a slice's last step: each texel's estimate made from
// its neighbours' evidence as well as its own, where they are compatible three ways, and its error split in two.
//   THE EVIDENCE   per slice texel (texel_far_finish.comp, FarEvidence): its near light per column (its own rays, the
//                  mean of its passes) and that mean's variance; its far light per column and its variance; the harmonic
//                  mean of its rays' hit distances; its reach. Independent estimates -- other rays -- each with its
//                  error: pooling them with their variances is sharing the evidence, not smoothing finished light.
//   THE FOOTPRINT  Ward's: the light changes over about the harmonic mean distance H of the geometry around, so a texel
//                  looks POOL_ACCURACY x H around it in its own plane (capped at POOL_CELLS cells) -- mid-wall in a
//                  corridor tens of centimetres, at a contact next to nothing. A prediction, not a guarantee. Ward's own
//                  0.1-0.2 is an interpolation's error bar; here the light test and the reuse error guard the reuse, and
//                  at 0.15 most texels' footprint was under a cell (the crevices: 71% pooled none, 2026-10-14) -- 0.5.
//                  POOL_SAMPLES points of a Vogel spiral over the footprint, not every cell: the cost bounded.
//   COMPATIBLE     geometry: normals within ~25 degrees, on the plane (within half a cell); radiometric: within 3 sigma
//                  of the first look's plane (not its mean: a corridor dimming away from its doorway is a gradient, and
//                  the mean called it disagreement -- 34% of the crevices' neighbours, 2026-10-14) -- a doorway's light
//                  changing fast on a wall whose geometry is far is what the harmonic mean cannot see. No test of the
//                  reach: each texel's near + far is an estimate of the same light whatever its reach; pooling the
//                  totals is unbiased (pooling the open SHARES across reaches would not be: those it does not pool).
//                  The test's sigma includes the records' own error (two texels reading different patches differ by it --
//                  the blotch pooling should average) and a 2% tolerance; the settling's does not (rays cannot move it).
//   TWO BUDGETS    the pooled light is a weighted plane fit's value at the texel (a gradient across the footprint is not
//                  error); its error is the sampling error (the pooled evidence's, falling as it grows) plus the reuse
//                  error (the neighbours' disagreement with the plane beyond their own noise, which more rays never
//                  fix). Both go to the settling (column 0's w), which refines what either leaves too uncertain.
// Shared evidence makes neighbours' estimates correlated: blotches at the footprint's scale, not grain -- the reuse
// error bounds them. A thread a slice texel.

#define PI 3.14159265359
#define POOL_ACCURACY 0.5
#define POOL_CELLS 16
#define POOL_SAMPLES 32
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform FarPool {
    vec4 uPool;       // x the slice's first entry in NodeIds, y its texels, z the passes, w the columns
    vec4 uTexelGrid;  // xyz origin, w the finest cell
    vec4 uSerial;     // x this slice's serial (FarSliceMap), y the cook hash's slots, z the debug mode (3: pool sizes), w the
                      // sun's column + 1 when the sky's part is kept: the light judged and the moment the sun's alone
} u;

layout(std430, set = 0, binding = 1) readonly buffer Texels { vec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 2) readonly buffer NodeIds { uint nodeIds[]; };
layout(std430, set = 0, binding = 3) readonly buffer SunNodeHash { uint cookHash[]; };
layout(std430, set = 0, binding = 4) readonly buffer FarSliceMap { uint sliceMap[]; };   // [texel id]: serial << 16 | t
layout(std430, set = 0, binding = 5) readonly buffer FarEvidence { vec4 evidence[]; };   // [slice texel][7]
layout(std430, set = 0, binding = 6) buffer NodeAccum { vec4 nodeAccum[]; };
// [0..64] texels by neighbours pooled; [65..70] candidates: found, in another slice, off the surface, turned, another
// reach, another light.
layout(std430, set = 0, binding = 7) buffer FarPoolStats { uint poolStats[]; };

#include "texel_nodes.glsl"

// The evidence's words: [0..2] near rgb per column, [3..5] far rgb per column, [6] (near variance, far variance, H, reach)
// -- the variances of the composed luminance's mean; reach 0: no evidence (no patch).
#define EVIDENCE 7

int poolFind(ivec3 cell, uint bin) {
    if (any(lessThan(cell, ivec3(0))) || any(greaterThan(cell, ivec3(65535)))) return -1;
    uvec2 key = texelKey(cell, bin, 0u);
    uint slots = uint(u.uSerial.y);
    uint slot = texelMix(key) & (slots - 1u);
    uint fingerprint = nodeFingerprint(key);
    // The key's smallest id (a key holds one texel a plane: texel_nodes_prep.comp), the one it held before.
    int best = -1;
    for (int probe = 0; probe < NODE_HASH_PROBES; ++probe) {
        uint e = cookHash[2u * slot];
        if (e == NODE_EMPTY) break;
        uvec2 k;
        if (cookHash[2u * slot + 1u] == fingerprint && nodeTexelKey(e, u.uTexelGrid, k) && k == key && (best < 0 || int(e) < best)) best = int(e);
        slot = (slot + 1u) & (slots - 1u);
    }
    return best;
}

const vec3 lumW = vec3(0.2126, 0.7152, 0.0722);

float composed(uint s, int columns) {
    float l = 0.0;
    for (int k = 0; k < columns; ++k)
        if (u.uSerial.w < 0.5 || k == int(u.uSerial.w) - 1)
            l += dot(evidence[s * uint(EVIDENCE) + uint(k)].rgb + evidence[s * uint(EVIDENCE) + 3u + uint(k)].rgb, lumW);
    return l;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uPool.y)) return;
    uint me = t * uint(EVIDENCE);
    vec4 info = evidence[me + 6u];
    if (info.w <= 0.0) return;   // no patch: its sums stand as they are
    int columns = int(u.uPool.w + 0.5);
    float passes = u.uPool.z;
    uint id = nodeIds[uint(u.uPool.x) + t];
    vec3 x = TEXEL_POSITION(id).xyz;
    vec3 n = normalize(TEXEL_NORMAL(id).xyz);
    vec3 t1 = normalize(abs(n.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), n) : cross(vec3(1.0, 0.0, 0.0), n));
    vec3 t2 = cross(n, t1);
    float cellSize = u.uTexelGrid.w;
    float radius = min(POOL_ACCURACY * info.z, float(POOL_CELLS) * cellSize);
    uint bin = texelBin(n);
    uint serial = uint(u.uSerial.x);
    float mine = composed(t, columns);
    float mineVar = info.x + info.y;
    float mineRecord = evidence[me].w;

    // Twice over the footprint, each fitting the plane L = a + b u + c v (weighted least squares): first over every
    // geometrically compatible neighbour, then over those within 3 sigma of that first plane, pooling each column.
    float m0 = mine, v0 = mineVar;
    vec3 ownNear[3] = vec3[3](evidence[me].rgb, evidence[me + 1u].rgb, evidence[me + 2u].rgb);
    vec3 ownFar[3] = vec3[3](evidence[me + 3u].rgb, evidence[me + 4u].rgb, evidence[me + 5u].rgb);
    vec3 near[3] = ownNear, far[3] = ownFar;   // the texel's own until the second look pools
    int pooled = 0;
    float sw = 1.0, sw2v = mineVar;
    float slopeU = 0.0, slopeV = 0.0;   // the fitted plane's gradient along t1, t2
    for (int round = 0; round < 2 && radius >= cellSize; ++round) {
        float W = 1.0, Wm = mine, Wv2 = mineVar;
        // The plane's normal equations over (1, u, v), and the per-column sums.
        float s00 = 1.0, s01 = 0.0, s02 = 0.0, s11 = 0.0, s12 = 0.0, s22 = 0.0, b0 = mine, b1 = 0.0, b2 = 0.0;
        vec3 sumNear[3] = ownNear, sumFar[3] = ownFar;
        int count = 0;
        int seen[POOL_SAMPLES];
        int seenCount = 0;
        for (int si = 0; si < POOL_SAMPLES; ++si) {
            float rr = radius * sqrt((float(si) + 0.5) / float(POOL_SAMPLES)), phi = float(si) * 2.39996323;
            vec3 q = x + (cos(phi) * t1 + sin(phi) * t2) * rr;
            int other = poolFind(ivec3(floor((q - u.uTexelGrid.xyz) / cellSize)), bin);
            if (other < 0 || uint(other) == id) continue;
            // Two spiral points in one cell find one neighbour: its evidence counts once.
            bool again = false;
            for (int k = 0; k < seenCount; ++k) again = again || seen[k] == other;
            if (again) continue;
            seen[seenCount++] = other;
            bool counting = round == 0;
            if (counting) atomicAdd(poolStats[65], 1u);
            uint tag = sliceMap[uint(other)];
            if ((tag >> 16) != (serial & 0xFFFFu)) { if (counting) atomicAdd(poolStats[66], 1u); continue; }   // not in this slice
            uint s = tag & 0xFFFFu;
            uint at = s * uint(EVIDENCE);
            vec4 oi = evidence[at + 6u];
            if (oi.w <= 0.0) continue;
            // Geometry and estimator.
            vec3 xo = TEXEL_POSITION(uint(other)).xyz;
            vec3 d = xo - x;
            float dist = length(d);
            if (dist > radius || abs(dot(d, n)) > 0.5 * cellSize) { if (counting) atomicAdd(poolStats[67], 1u); continue; }
            if (dot(normalize(TEXEL_NORMAL(uint(other)).xyz), n) < 0.9) { if (counting) atomicAdd(poolStats[68], 1u); continue; }
            float lo = composed(s, columns);
            float vo = oi.x + oi.y;
            float pu = dot(d, t1), pv = dot(d, t2);
            // Radiometric (the second round): within 3 sigma of the first look's plane.
            float plane = m0 + slopeU * pu + slopeV * pv;
            float tolerance = 3.0 * sqrt(vo + v0 + evidence[at].w + mineRecord) + 0.02 * abs(plane);
            if (round == 1 && abs(lo - plane) > tolerance) { atomicAdd(poolStats[70], 1u); continue; }
            float k = 1.0 - (dist / radius) * (dist / radius);
            float w = k * k;
            W += w; Wm += w * lo; Wv2 += w * w * vo;
            s00 += w; s01 += w * pu; s02 += w * pv; s11 += w * pu * pu; s12 += w * pu * pv; s22 += w * pv * pv;
            b0 += w * lo; b1 += w * pu * lo; b2 += w * pv * lo;
            for (int c = 0; c < columns; ++c) { sumNear[c] += w * evidence[at + uint(c)].rgb; sumFar[c] += w * evidence[at + 3u + uint(c)].rgb; }
            count++;
        }
        if (count == 0) break;
        // The plane's value at the texel (its intercept), when the fit is well posed; else the weighted mean.
        float mean = Wm / W;
        float a = mean;
        float det = s00 * (s11 * s22 - s12 * s12) - s01 * (s01 * s22 - s12 * s02) + s02 * (s01 * s12 - s11 * s02);
        if (abs(det) > 1e-12 * s00 * s00 * s00 && count >= 4)
            a = (b0 * (s11 * s22 - s12 * s12) - s01 * (b1 * s22 - s12 * b2) + s02 * (b1 * s12 - s11 * b2)) / det;
        slopeU = 0.0; slopeV = 0.0;
        if (abs(det) > 1e-12 * s00 * s00 * s00 && count >= 4) {
            slopeU = (s00 * (b1 * s22 - s12 * b2) - b0 * (s01 * s22 - s12 * s02) + s02 * (s01 * b2 - b1 * s02)) / det;
            slopeV = (s00 * (s11 * b2 - b1 * s12) - s01 * (s01 * b2 - b1 * s02) + b0 * (s01 * s12 - s11 * s02)) / det;
        }
        m0 = a;
        v0 = Wv2 / (W * W);
        if (round == 0) continue;   // the first look: the plane the second judges its neighbours by
        float scale = mean > 1e-12 ? clamp(a / mean, 0.5, 2.0) : 1.0;
        for (int c = 0; c < columns; ++c) { near[c] = sumNear[c] / W * scale; far[c] = sumFar[c] / W * scale; }
        pooled = count;
        sw = W;
        sw2v = Wv2;
    }
    // The reuse error, from a third pass: the neighbours kept, their spread about the fitted plane beyond their noise.
    float reuse2 = 0.0;
    if (pooled > 0) {
        float W = 1.0, excess = (mine - m0) * (mine - m0) - mineVar - mineRecord;
        int seen[POOL_SAMPLES];
        int seenCount = 0;
        for (int si = 0; si < POOL_SAMPLES; ++si) {
            float rr = radius * sqrt((float(si) + 0.5) / float(POOL_SAMPLES)), phi = float(si) * 2.39996323;
            vec3 q = x + (cos(phi) * t1 + sin(phi) * t2) * rr;
            int other = poolFind(ivec3(floor((q - u.uTexelGrid.xyz) / cellSize)), bin);
            if (other < 0 || uint(other) == id) continue;
            // Two spiral points in one cell find one neighbour: its evidence counts once.
            bool again = false;
            for (int k = 0; k < seenCount; ++k) again = again || seen[k] == other;
            if (again) continue;
            seen[seenCount++] = other;
            uint tag = sliceMap[uint(other)];
            if ((tag >> 16) != (serial & 0xFFFFu)) continue;
            uint s = tag & 0xFFFFu;
            vec4 oi = evidence[s * uint(EVIDENCE) + 6u];
            if (oi.w <= 0.0) continue;
            vec3 d = TEXEL_POSITION(uint(other)).xyz - x;
            float dist = length(d);
            if (dist > radius || abs(dot(d, n)) > 0.5 * cellSize) continue;
            if (dot(normalize(TEXEL_NORMAL(uint(other)).xyz), n) < 0.9) continue;
            float lo = composed(s, columns);
            float vo = oi.x + oi.y;
            float plane = m0 + slopeU * dot(d, t1) + slopeV * dot(d, t2);
            if (abs(lo - plane) > 3.0 * sqrt(vo + v0 + evidence[s * uint(EVIDENCE)].w + mineRecord) + 0.02 * abs(plane)) continue;
            float k = 1.0 - (dist / radius) * (dist / radius);
            float w = k * k;
            excess += w * ((lo - plane) * (lo - plane) - vo - evidence[s * uint(EVIDENCE)].w);
            W += w;
        }
        // Half the unexplained spread's deviation: what the pooled value at the texel may be off by.
        reuse2 = 0.25 * max(excess / W, 0.0);
    }
    float poolSampling = sw2v / (sw * sw);
    int bucket = min(pooled, 64);
    atomicAdd(poolStats[bucket], 1u);
    if (u.uSerial.z > 2.5) {
        // The diagnostic: how many neighbours pooled (blue none, red many), landed in place of the light.
        float f = clamp(float(pooled) / 40.0, 0.0, 1.0);
        vec3 hue = mix(vec3(0.05, 0.1, 0.6), vec3(0.9, 0.2, 0.05), f) * 0.3;
        for (int c = 0; c < columns; ++c) nodeAccum[t * uint(columns) + uint(c)] = vec4((c == 0 ? hue : vec3(0.0)) * passes, 0.0);
        float l = dot(hue, lumW);
        nodeAccum[t * uint(columns)].w = passes * l * l;
        return;
    }
    float total = 0.0;
    for (int c = 0; c < columns; ++c) {
        vec3 v = near[c] + far[c];
        if (u.uSerial.w < 0.5 || c == int(u.uSerial.w) - 1) total += dot(v, lumW);
        nodeAccum[t * uint(columns) + uint(c)] = vec4(v * passes, nodeAccum[t * uint(columns) + uint(c)].w);
    }
    // The settling reads the mean's variance as (w / passes - mean^2) / passes: the two budgets enter as passes^2 x them.
    nodeAccum[t * uint(columns)].w = passes * total * total + passes * passes * (poolSampling + reuse2);
}
