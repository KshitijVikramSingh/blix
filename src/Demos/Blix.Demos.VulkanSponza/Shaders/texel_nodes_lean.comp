#version 450
// --lean-shade (a prototype, SponzaLoop.SunNodes.cs; the runtime gather's model): the gather's shade with nothing but a
// lookup at each hit -- what a runtime gather of short rays, scheduled and budgeted, would pay a ray. A workgroup a
// texel, a thread a ray (RAYS: texel_nodes_shade.glsl's):
//   a miss    the sky along it (x its weight), as the shade
//   a hit     its albedo x weight / pi x its cell side's light (hit_cells.comp's CellLight in the lists' form: albedo-free,
//             the patch blend averaged over the cell's area, and the side's sun -- its bits' blend x n.l x the sun)
//   a near    nearer than the cells' near distance, without a cell, in a contact's cell or on a sheet that lets light
//   hit       through: the shade's search (texel_nodes.glsl, nodeSetAt) -- the likeliest texel's gathered parts, the sun by
//             the candidates' bits, a sheet's far side through it (the shade's nearTexelLight); its cell when none is
//             gathered yet. Lean on the near rounds without it, a crease read across itself: the corridor's seams 0.064
//             against 0.051 (2026-10-23).
//   no cell   the texel's other hits' light, albedo-weighted (the shade's unknown hits: borrowed; one nearer than the
//             cells' near distance from the near hits alone, uNear.z)
// The fine round's near rounds as the shade has them (uNear.x: 1 the first, its far part recorded per fine place; 2 a
// later one, its rays cut at uNear.y: the cut rays out, the recorded far part in).
// --cone-lookups (uCone.x the texel's rays: voxel cone tracing's pre-filtering, in our surface cache): a ray stands for
// a cone of its share of the hemisphere (its solid angle weight / (rays x its cosine)), and a hit reads the light over
// the cone's footprint there (its distance x the cone's radius, over the hit's facing) -- the cell's below the cell size,
// else the patches blended with that reach (their incident light per column + their own direct sun: the cells' form).
// The pass's sums into NodeAccum and NodeDetail as the shade writes them (texel_nodes_shade.glsl), so the resolve, the
// refine, the settling and the landing read it unchanged. Not: sheets that let light through, the far field, the census,
// the ray capture.

#define RAYS 32
layout(local_size_x = RAYS) in;
#define NODE_LOOKUP

layout(set = 0, binding = 0) uniform Lean {
    vec4 uShade;    // x the slice's texels, y the columns (suns), w the pass (> 0: add to the last)
    vec4 uSky;      // x the sky's strength, y its lod, z the kept sky's column + 1 (0: none)
    vec4 uDetail;   // x the slice's first id in NodeIds, y 1: the detail
    vec4 uNear;     // x the near round's mode (0, 1, 2), y the near distance, z 1: an unknown near hit borrows from near hits
    vec4 uLookup;   // x, y the search's plane and spread (cells), z the cells' near distance, w the hash's slots (0: no search)
    vec4 uTexelGrid;
    vec4 uIrr;      // rgb the sun's irradiance; w the sun bits' words a texel
    vec4 uSheets;   // x 1: sheets that let light through in the GI (SheetRows)
    vec4 uCapture;  // --ray-capture (SponzaLoop.RayCapture.cs): x 1 on, y the texels sampled (1 in 2^y), z the tag, w the room
    vec4 uCone;     // --cone-lookups: x the texel's rays (0 off), y the cells' size, z the patch spacing, w the patch light's columns
    vec4 uLevels;   // the coarser patch levels (SponzaLoop.PatchLevels.cs): x how many (0: none)
} u;

layout(set = 0, binding = 1) uniform samplerCube uSkyRadiance;
layout(std430, set = 0, binding = 2) readonly buffer Texels { vec4 texels[]; };
layout(std430, set = 0, binding = 3) readonly buffer NodeRays { vec4 nodeRays[]; };
layout(std430, set = 0, binding = 4) readonly buffer NodeHits { uvec4 nodeHits[]; };
layout(std430, set = 0, binding = 5) readonly buffer SunNodes { vec4 sunNodes[]; };          // per column: toward, kind
layout(std430, set = 0, binding = 6) readonly buffer NodeRayWeights { float nodeRayWeight[]; };
layout(std430, set = 0, binding = 7) readonly buffer NodeIds { uint nodeIds[]; };
layout(std430, set = 0, binding = 8) readonly buffer HitCells { uint hitCells[]; };
layout(std430, set = 0, binding = 9) readonly buffer CellLight { uint cellLight[]; };
layout(std430, set = 0, binding = 10) buffer NodeAccum { vec4 nodeAccum[]; };              // [slice texel][column]
layout(std430, set = 0, binding = 11) buffer NodeDetail { vec4 nodeDetail[]; };
layout(std430, set = 0, binding = 12) readonly buffer FinePlace { uint finePlace[]; };   // a fine texel's place + 1 (0: none)
layout(std430, set = 0, binding = 13) buffer FarPart { vec4 farPart[]; };              // [place][column]: far light, passes
layout(std430, set = 0, binding = 14) readonly buffer SunNodeHash { uint cookHash[]; };
layout(std430, set = 0, binding = 15) readonly buffer FoliagePoints { vec4 foliagePoints[]; };   // the search's set 1: unread
layout(std430, set = 0, binding = 16) readonly buffer FoliageHash { uint foliageHash[]; };
layout(std430, set = 0, binding = 17) readonly buffer SunNodeBits { uint sunBits[]; };
layout(std430, set = 0, binding = 18) readonly buffer SplitSky { uvec2 skyPart[]; };
layout(std430, set = 0, binding = 19) readonly buffer SplitSun { uvec2 sunPart[]; };
layout(std430, set = 0, binding = 20) readonly buffer TexelProvenance { uint provenance[]; };
layout(std430, set = 0, binding = 21) readonly buffer SheetRows { uint sheetRows[]; };
// --ray-capture under --lean-shade (the directional bases' model, tools/gi-model): a sampled texel's every ray -- its id,
// its direction (octahedral, 2 x 16 bits), its light per unit density (the ray's light over the cosine about the texel's
// normal: L / pdf, both columns, the sun's absolute) and that cosine, the pass.
layout(std430, set = 0, binding = 23) readonly buffer SunNodePatchLight { uvec2 patchLight[]; };   // [patch][column]: half rgb
layout(std430, set = 0, binding = 24) readonly buffer PatchNeighbours { int farNeighbours[]; };     // 8 a patch
layout(std430, set = 0, binding = 25) readonly buffer CookedPatches { vec4 cookedPatch[]; };       // 3 a patch: pos, normal, ...
layout(std430, set = 0, binding = 26) readonly buffer PatchDirect { uint patchDirect[]; };         // 2 a patch: n.l x 4096, texels
layout(std430, set = 0, binding = 27) readonly buffer LevelNodes { vec4 levelNodes[]; };          // 2 a node: pos (w level), normal
layout(std430, set = 0, binding = 28) readonly buffer LevelParents { int levelParents[]; };       // [patch][level - 1]
layout(std430, set = 0, binding = 29) readonly buffer LevelNeighbours { int levelNeighbours[]; }; // 8 a node
layout(std430, set = 0, binding = 30) readonly buffer LevelLight { vec4 levelLight[]; };          // 2 a node: sky, sun rgb
layout(std430, set = 0, binding = 22) buffer RayCapture { uint captureCount; uint capturePad[3]; uvec4 captured[]; };
#include "texel_nodes.glsl"

vec3 unpackRgb9e5(uint p) {
    float scale = exp2(float(int(p >> 27) - 15 - 9));
    return vec3(p & 511u, (p >> 9) & 511u, (p >> 18) & 511u) * scale;
}

vec3 patchColumn(int p, uint column) {
    uvec2 w = patchLight[uint(p) * uint(u.uCone.w) + column];
    return vec3(unpackHalf2x16(w.x), unpackHalf2x16(w.y).x);
}

// The patches' light over a footprint of radius reach about x (normal nx), its own patch first: the kernel the far set
// and the cells use (zero at the reach, by the normals' agreement) over the patch and its 8 neighbours, the heaviest 4.
void footprintLight(int p, vec3 x, vec3 nx, float reach, uint skyColumn, uint sunColumn, out vec3 sky, out vec3 sun) {
    // Past a patch and its neighbours: the level whose spacing is the reach -- its node of this patch and its neighbours.
    int levels = int(u.uLevels.x + 0.5);
    // A node no wider than the footprint (rounded down): rounded to nearest, a node twice the footprint read a doorway's
    // sunlit floor into the corridor's dark seams (+43% at points, 2026-10-23).
    if (levels > 0 && reach >= 2.0 * u.uCone.z) {
        int k = clamp(int(floor(log2(reach / u.uCone.z))), 1, levels);
        int node = levelParents[p * levels + k - 1];
        int ids[4] = int[4](-1, -1, -1, -1);
        float ws[4] = float[4](0.0, 0.0, 0.0, 0.0);
        for (int i = -1; i < 8; ++i) {
            int c = i < 0 ? node : levelNeighbours[node * 8 + i];
            if (c < 0) continue;
            float d = length(x - levelNodes[2 * c].xyz) / reach;
            float kk = max(1.0 - d * d, 0.0);
            float w = kk * kk * smoothstep(0.5, 0.9, dot(nx, levelNodes[2 * c + 1].xyz));
            if (w <= ws[3]) continue;
            int at = 3;
            while (at > 0 && ws[at - 1] < w) { ws[at] = ws[at - 1]; ids[at] = ids[at - 1]; --at; }
            ws[at] = w; ids[at] = c;
        }
        float total = ws[0] + ws[1] + ws[2] + ws[3];
        if (total <= 0.0) { ids[0] = node; ws[0] = 1.0; total = 1.0; }
        sky = vec3(0.0); sun = vec3(0.0);
        for (int i = 0; i < 4; ++i) {
            if (ids[i] < 0 || ws[i] <= 0.0) continue;
            sky += ws[i] * levelLight[2 * ids[i]].rgb;
            sun += ws[i] * levelLight[2 * ids[i] + 1].rgb;
        }
        sky /= total; sun /= total;
        return;
    }
    int ids[4] = int[4](-1, -1, -1, -1);
    float ws[4] = float[4](0.0, 0.0, 0.0, 0.0);
    for (int i = -1; i < 8; ++i) {
        int c = i < 0 ? p : farNeighbours[p * 8 + i];
        if (c < 0) continue;
        float d = length(x - cookedPatch[3 * c].xyz) / reach;
        float k = max(1.0 - d * d, 0.0);
        float w = k * k * smoothstep(0.5, 0.9, dot(nx, normalize(cookedPatch[3 * c + 1].xyz)));
        if (w <= ws[3]) continue;
        int at = 3;
        while (at > 0 && ws[at - 1] < w) { ws[at] = ws[at - 1]; ids[at] = ids[at - 1]; --at; }
        ws[at] = w; ids[at] = c;
    }
    float total = ws[0] + ws[1] + ws[2] + ws[3];
    if (total <= 0.0) { ids[0] = p; ws[0] = 1.0; total = 1.0; }
    sky = vec3(0.0); sun = vec3(0.0);
    for (int i = 0; i < 4; ++i) {
        if (ids[i] < 0 || ws[i] <= 0.0) continue;
        uint q = uint(ids[i]);
        float direct = patchDirect[2u * q + 1u] > 0u ? float(patchDirect[2u * q]) / 4096.0 / float(patchDirect[2u * q + 1u]) : 0.0;
        sky += ws[i] * patchColumn(ids[i], skyColumn);
        sun += ws[i] * (patchColumn(ids[i], sunColumn) + u.uIrr.rgb * direct);
    }
    sky /= total; sun /= total;
}

// A texel's gathered light for a column (texel_nodes_shade.glsl's texelPartLight), or false before its gather.
bool partLight(uint t, bool sunColumn, out vec3 l) {
    uvec2 w = sunColumn ? sunPart[t] : skyPart[t];
    l = vec3(0.0);
    if ((w.y & 0x10000u) == 0u) return false;
    uint code = (provenance[t / 4u] >> (8u * (t % 4u) + (sunColumn ? 0u : 4u))) & 0xFu;
    if ((code < 1u || code > 4u) && code != 10u) return false;
    l = unpackRgb9e5(w.x) * (sunColumn ? u.uIrr.rgb : vec3(1.0));
    return true;
}


const vec3 lumW = vec3(0.2126, 0.7152, 0.0722);
const float PI = 3.14159265359;

shared vec3 sLight[RAYS * 2];   // per ray per column (two at most)
shared vec3 sAlbedoW[RAYS];     // a hit's albedo x weight / pi (an unknown one's, for its borrow)
shared float sKnown[RAYS];      // 1 a hit with a cell, 2 a hit without, 0 a miss
shared vec2 sTilt[RAYS * 2];
shared float sMiss[RAYS];
shared float sFar[RAYS];        // past the near distance or a miss (not on a sheet's own texel): the near rounds' far part
shared float sNear[RAYS];       // a hit nearer than the near distance
shared vec3 sMean[2];

void main() {
    uint group = gl_WorkGroupID.x;
    if (group >= uint(u.uShade.x)) return;
    uint lid = gl_LocalInvocationID.x;
    int suns = min(int(u.uShade.y), 2);
    uint slot = group * uint(RAYS) + lid;
    uint id = nodeIds[uint(u.uDetail.x) + group];
    uvec4 h0 = nodeHits[slot * 3u];
    uvec4 h1 = nodeHits[slot * 3u + 1u];
    uvec4 h2 = nodeHits[slot * 3u + 2u];
    vec3 dir = nodeRays[slot * 2u + 1u].xyz;
    float weight = nodeRayWeight[slot];
    bool hit = (h0.w & 1u) != 0u;
    vec3 l0 = vec3(0.0), l1 = vec3(0.0);
    float known = 0.0;
    sMiss[lid] = hit ? 0.0 : weight / PI;
    sAlbedoW[lid] = vec3(0.0);
    if (!hit) {
        vec3 sky = weight * textureLod(uSkyRadiance, dir, u.uSky.y).rgb * u.uSky.x;
        for (int k = 0; k < suns; ++k) {
            bool hasSky = (uint(sunNodes[k].w + 0.5) & 2u) != 0u;
            if (k == 0) l0 = hasSky ? sky : vec3(0.0); else l1 = hasSky ? sky : vec3(0.0);
        }
    } else {
        vec3 albedoW = unpackUnorm4x8(h2.w).rgb * weight / PI;
        sAlbedoW[lid] = albedoW;
        known = 2.0;
        // The hit's cell (texel_nodes_shade.glsl's byCell): its row's r x r square of the barycentrics, lower triangle
        // row by row; the side it was met from.
        float dist = uintBitsToFloat(h0.x);
        vec3 normal = uintBitsToFloat(h2.xyz);
        vec3 hn = dot(normal, dir) > 0.0 ? -normal : normal;
        bool hasCell = h1.z != 0xFFFFFFFFu && (h1.z & 0x80000000u) == 0u;
        uint cellIndex = 0u;
        if (hasCell) {
            uint r = hitCells[2u + 2u * h1.z];
            vec2 bary = vec2(float(h1.w & 0xFFFFu), float(h1.w >> 16)) / 65535.0;
            uint ci = min(uint(bary.x * float(r)), r - 1u);
            uint cj = min(uint(bary.y * float(r)), r - 1u - ci);
            cellIndex = hitCells[1u + 2u * h1.z] + ci * r - (ci * (ci - 1u)) / 2u + cj;
        }
        bool contact = hasCell && (hitCells[1u + 2u * hitCells[0] + 2u * cellIndex + 1u] & 0x80000000u) != 0u;
        vec4 sheet = vec4(0.0);
        if (u.uSheets.x > 0.5 && h1.z != 0xFFFFFFFFu) {
            uint sw = sheetRows[h1.z & 0x7FFFFFFFu];
            if (sw != 0u) sheet = vec4(unpackUnorm4x8(sw).rgb, float(sw >> 24) / 255.0);
        }
        if (u.uLookup.w > 0.5 && (dist < u.uLookup.z || !hasCell || contact || sheet.a > 0.0)) {
            vec3 hitPos = nodeRays[slot * 2u].xyz + dir * dist;
            int ids[NODE_CANDIDATES];
            float ws[NODE_CANDIDATES];
            float total = nodeSetAt(0, hitPos, hn, u.uTexelGrid, uint(u.uLookup.w), u.uLookup.xy, ids, ws);
            int likeliest = -1;
            float most = 0.0;
            for (int c = 0; c < NODE_CANDIDATES; ++c) if (ids[c] >= 0 && ws[c] > most) { most = ws[c]; likeliest = ids[c]; }
            if (total > 0.0 && likeliest >= 0) {
                uint t = uint(likeliest);
                // A sheet's far side: the pair's other record (same position; SponzaLoop.Lightmap.cs).
                uint twin = t;
                if (sheet.a > 0.0 && texels[2u * t].w < 0.0) {
                    vec3 p = texels[2u * t].xyz;
                    twin = texels[2u * (t + 1u)].w < 0.0 && distance(texels[2u * (t + 1u)].xyz, p) < 1e-4 ? t + 1u
                         : t > 0u && texels[2u * (t - 1u)].w < 0.0 && distance(texels[2u * (t - 1u)].xyz, p) < 1e-4 ? t - 1u : t;
                }
                vec3 albedo = max(unpackUnorm4x8(h2.w).rgb, vec3(1e-3));
                bool all = true;
                vec3 cl[2];
                for (int k = 0; k < suns; ++k) {
                    uint kind = uint(sunNodes[k].w + 0.5);
                    bool sunColumn = (kind & 1u) != 0u;
                    vec3 l;
                    all = all && partLight(t, sunColumn, l);
                    if (twin != t) { vec3 far; if (partLight(twin, sunColumn, far)) l = l * (1.0 - sheet.a) + far * sheet.rgb / albedo; }
                    if (sunColumn) {
                        // The hit's sun: the candidates' bits blended, its n.l (the shade's, without the exact ray).
                        float ndotl = max(dot(hn, sunNodes[k].xyz), 0.0);
                        float visible = 0.0;
                        uint words = uint(u.uIrr.w), bit = uint(k);
                        for (int c = 0; c < NODE_CANDIDATES; ++c)
                            if (ids[c] >= 0 && ((sunBits[uint(ids[c]) * words + bit / 32u] >> (bit % 32u)) & 1u) != 0u) visible += ws[c] / total;
                        l += u.uIrr.rgb * ndotl * visible;
                    }
                    cl[k] = albedoW * l;
                }
                if (all) {
                    l0 = cl[0];
                    if (suns > 1) l1 = cl[1];
                    known = 1.0;
                    hasCell = false;   // answered: not the cell's
                }
            }
        }
        if (hasCell) {
            uint side = dot(normal, dir) < 0.0 ? 0u : 1u;   // met from its front (the ray against the normal)
            vec3 sky = unpackRgb9e5(cellLight[4u * cellIndex + 2u * side]);
            vec3 sun = unpackRgb9e5(cellLight[4u * cellIndex + 2u * side + 1u]);
            if (u.uCone.x > 0.5) {
                vec3 n0 = normalize(texels[2u * id + 1u].xyz);
                float c0 = max(dot(n0, dir), 1e-3);
                float omega = weight / (u.uCone.x * c0);                       // the ray's share of the hemisphere (sr)
                // The cone's radius at the hit (not stretched by the hit's obliquity: a grazing footprint is a thin ellipse along
                // the ray, and a disk that wide read the sunlit floor beside it).
                float radius = dist * sqrt(omega / PI);
                if (radius > u.uCone.y) {
                    uint cellAt = 1u + 2u * hitCells[0] + 2u * cellIndex;
                    int p = int(hitCells[cellAt + side] & 0xFFFFFFu) - 1;
                    if (p >= 0) {
                        vec3 hitPos = nodeRays[slot * 2u].xyz + dir * dist;
                        uint skyColumn = 0u, sunColumn = 0u;
                        for (int k = 0; k < suns; ++k) {
                            uint kind = uint(sunNodes[k].w + 0.5);
                            if ((kind & 2u) != 0u) skyColumn = uint(k);
                            if ((kind & 1u) != 0u) sunColumn = uint(k);
                        }
                        footprintLight(p, hitPos, hn, max(radius, u.uCone.z), skyColumn, sunColumn, sky, sun);
                    }
                }
            }
            // CellLight's two words: the sky column's light, the sun column's (texel_lists.comp reads them alike).
            for (int k = 0; k < suns; ++k) {
                uint kind = uint(sunNodes[k].w + 0.5);
                vec3 c = ((kind & 1u) != 0u ? sun : vec3(0.0)) + ((kind & 2u) != 0u ? sky : vec3(0.0));
                if (k == 0) l0 = albedoW * c; else l1 = albedoW * c;
            }
            known = 1.0;
        }
    }
    sLight[lid * 2u] = l0;
    sLight[lid * 2u + 1u] = l1;
    sKnown[lid] = known;
    float dist = hit ? uintBitsToFloat(h0.x) : 1e30;
    bool sheetTexel = abs(texels[2u * id].w) > 4.5;   // a surface that lets light through keeps no far part
    sFar[lid] = (dist >= u.uNear.y || !hit) && !sheetTexel ? 1.0 : 0.0;
    sNear[lid] = hit && dist < u.uNear.y ? 1.0 : 0.0;
    barrier();
    // A hit without a cell: the known hits' light per albedo, by its own albedo (the shade's sUnknownBounce).
    if (known > 1.5) {
        bool nearOnly = u.uNear.z > 0.5 && sNear[lid] > 0.5;
        float nearKnown = 0.0;
        if (nearOnly) for (int r = 0; r < RAYS; ++r) if (sKnown[r] > 0.5 && sKnown[r] < 1.5 && sNear[r] > 0.5) nearKnown += 1.0;
        nearOnly = nearOnly && nearKnown > 0.0;
        for (int k = 0; k < suns; ++k) {
            vec3 num = vec3(0.0), den = vec3(0.0);
            for (int r = 0; r < RAYS; ++r)
                if (sKnown[r] > 0.5 && sKnown[r] < 1.5 && (!nearOnly || sNear[r] > 0.5)) { num += sLight[r * 2 + k]; den += sAlbedoW[r]; }
            vec3 l = sAlbedoW[lid] * num / max(den, vec3(1e-9));
            if (k == 0) l0 = l; else l1 = l;
        }
    }
    barrier();
    sLight[lid * 2u] = l0;
    sLight[lid * 2u + 1u] = l1;
    if (u.uCapture.x > 0.5 && u.uCapture.x < 1.5) {
        uint bits = uint(max(u.uCapture.y, 0.0));
        if (bits == 0u || ((id * 2654435761u) >> (32u - bits)) == 0u) {
            uint at = atomicAdd(captureCount, 1u);
            if (at < uint(u.uCapture.w)) {
                vec3 n0 = normalize(texels[2u * id + 1u].xyz);
                float c0 = dot(n0, dir);
                vec3 l = (l0 + l1) / max(c0, 1e-4);   // the ray's contribution over its cosine: radiance / pdf
                vec3 d = dir / (abs(dir.x) + abs(dir.y) + abs(dir.z));
                vec2 o = d.z >= 0.0 ? d.xy : (1.0 - abs(d.yx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.y >= 0.0 ? 1.0 : -1.0);
                uint od = packSnorm2x16(o);
                captured[2u * at] = uvec4(id, od, floatBitsToUint(l.r), floatBitsToUint(l.g));
                captured[2u * at + 1u] = uvec4(floatBitsToUint(l.b), floatBitsToUint(c0), uint(u.uShade.w), uint(u.uCapture.z));
            }
        }
    }
    if (u.uDetail.y > 0.5) {
        vec3 n = normalize(texels[2u * id + 1u].xyz);
        vec3 t1 = normalize(cross(abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n));
        vec3 t2 = cross(n, t1);
        vec2 g = vec2(dot(t1, dir), dot(t2, dir)) / max(dot(n, dir), 0.1);
        sTilt[lid * 2u] = dot(l0, lumW) * g;
        sTilt[lid * 2u + 1u] = dot(l1, lumW) * g;
    }
    barrier();
    if (lid < uint(suns)) {
        int k = int(lid);
        vec3 sum = vec3(0.0);
        vec2 tilt = vec2(0.0);
        float escaped = 0.0;
        for (int r = 0; r < RAYS; ++r) { sum += sLight[r * 2 + k]; tilt += sTilt[r * 2 + k]; escaped += sMiss[r]; }
        if (u.uNear.x > 0.5) {
            uint place = finePlace[id];
            vec3 farSum = vec3(0.0);
            for (int r = 0; r < RAYS; ++r) farSum += sFar[r] * sLight[r * 2 + k];
            if (place > 0u) {
                uint fp = (place - 1u) * 2u + uint(k);
                if (u.uNear.x < 1.5) farPart[fp] += vec4(farSum / float(RAYS), 1.0);
                else {
                    vec4 f = farPart[fp];
                    sum += (f.w > 0.0 ? f.rgb / f.w : vec3(0.0)) * float(RAYS) - farSum;
                }
            }
        }
        uint at = group * uint(suns) + uint(k);
        if (u.uDetail.y > 0.5) {
            vec4 d = vec4(tilt / float(RAYS), k == 0 ? escaped / float(RAYS) : 0.0, 0.0);
            nodeDetail[at] = u.uShade.w > 0.5 ? nodeDetail[at] + d : d;
        }
        vec3 mean = sum / float(RAYS);
        vec4 before = u.uShade.w > 0.5 ? nodeAccum[at] : vec4(0.0);
        nodeAccum[at] = vec4(before.rgb + mean, before.w);
        sMean[k] = mean;
    }
    barrier();
    if (lid == 0u) {
        float composed = 0.0;
        for (int k = 0; k < suns; ++k) composed += dot(sMean[k], lumW);
        if (u.uSky.z > 0.5) composed = dot(sMean[int(u.uSky.z) - 1], lumW);
        nodeAccum[group * uint(suns)].w += composed * composed;
    }
}
