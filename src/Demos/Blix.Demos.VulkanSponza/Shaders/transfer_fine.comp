#version 450
// The fine levels (SponzaLoop.Transfer.cs, A'): a fine texel -- the atlas's, the 5 cm cells -- has no transfer of its
// own (16 M texels' lists would not fit); its light is its coarse texels' (the transfer's, at the level above: the
// lookup the incident pass makes, texel.glsl's texelsAround), times its contact visibility over theirs (texel_ao.comp):
// what it sees within two coarse spacings that they, larger, do not. Its detail the coarse texels' blend. Written into
// the parts at each light change, after the transfer. A thread a fine texel.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform TransferFine {
    vec4 uFine;        // x the fine texels, y the dispatch's first, z the coarse level, w the coarsest
    vec4 uTexelGrid;   // the finest level's grid: xyz the origin, w the spacing
    vec4 uTexelParams; // x the hash's capacity
    vec4 uKeep;        // x 1: the sky's part kept (a sun change: the copy writes the sun's alone); y 1 the cloth's flag; z 1 (--texel-h4)
                       // the copy's shape (into TexelOwnShape)
    vec4 uFlag;        // x the dark bar (the coarse sweep's: a tenth of its median light); y 1: flag every texel (--fine-all); z the contact ratio under which a texel is flagged
                       // (--fine-contact), w 1: those first (--fine-contact-first)
} u;

layout(std430, set = 0, binding = 1) readonly buffer TexelHash { uint texelHash[]; };
layout(std430, set = 0, binding = 2) readonly buffer Texels { uvec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 3) readonly buffer FineIds { uint fineIds[]; };
layout(std430, set = 0, binding = 4) buffer SplitSky { uvec2 skyPart[]; };
layout(std430, set = 0, binding = 5) buffer SplitSun { uvec2 sunPart[]; };
layout(std430, set = 0, binding = 11) buffer TexelProvenance { uint provenance[]; };
// --texel-h4 (uKeep.z): the light-agnostic record's shape for the copy -- its coarse texels' own (their gathers' shapes,
// texel_shape.glsl), blended with the light's weights; world space, so no frame to turn. Into the same buffer, the fine
// texel's own: its provenance (5, the copy's) tells texel_compose.comp whose it is.
layout(std430, set = 0, binding = 13) buffer TexelOwnShape { uint ownShape[]; };
#include "provenance.glsl"
layout(std430, set = 0, binding = 6) buffer SkyDetail { uint skyDetail[]; };
layout(std430, set = 0, binding = 7) buffer SunDetail { uint sunDetail[]; };
layout(std430, set = 0, binding = 8) readonly buffer AoBytes { uint aoBytes[]; };
// BLIX_SPOT_WHY (uTexelParams.z): a pass over a few texels writing, per texel, 32 words -- each candidate's id and its
// weight as used (after the normal cut), the level read, the total.
layout(std430, set = 0, binding = 9) buffer FineDebug { uint fineDebug[]; };
// The fine texels the copy cannot answer, for their own gather (SponzaLoop.Transfer.cs, the fine refine): word 0 how
// many, 1-3 by why (none turned its way; the ones turned its way disagree; the ones the normal cut disagree with them),
// 4-15 the spread's histogram, then from 16 each its id and its spread.
layout(std430, set = 0, binding = 10) buffer FineFlags { uint fineFlags[]; };


#define TEXEL_HASH(i) uvec3(texelHash[3u * uint(i)], texelHash[3u * uint(i) + 1u], texelHash[3u * uint(i) + 2u])
#include "texel.glsl"
#define TEXEL_SHAPE_NO_STORE
#include "texel_shape.glsl"

uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

vec3 unpackRgb9e5(uint w) {
    float scale = exp2(float(int(w >> 27) - 15 - 9));
    return vec3(float(w & 511u), float((w >> 9) & 511u), float((w >> 18) & 511u)) * scale;
}

float lightOf(uint cid) {
    return dot(unpackRgb9e5(skyPart[cid].x) + unpackRgb9e5(sunPart[cid].x) * u.uTexelParams.w, vec3(0.2126, 0.7152, 0.0722));
}

// A flagged texel: its id and score after the counts (why: 1 none turned its way, 2 the cells turned its way disagree,
// 10 those and the cut ones, 3 the copy and the instant layer).
void flag(uint why, float score) {
    uint slot = atomicAdd(fineFlags[0], 1u);
    atomicAdd(fineFlags[why], 1u);
    fineFlags[16u + 2u * slot] = gl_GlobalInvocationID.x + uint(u.uFine.y) < uint(u.uFine.x) ? fineIds[gl_GlobalInvocationID.x + uint(u.uFine.y)] : 0u;
    fineFlags[17u + 2u * slot] = floatBitsToUint(score);
}

float ao(uint id) { uint v = (aoBytes[id / 4u] >> (8u * (id % 4u))) & 255u; return v == 0u ? -1.0 : float(v - 1u) / 254.0; }

void main() {
    uint t = gl_GlobalInvocationID.x + uint(u.uFine.y);
    if (t >= uint(u.uFine.x)) return;
    uint id = fineIds[t];
    vec3 p = TEXEL_POSITION(id).xyz;
    vec3 n = TEXEL_NORMAL(id).xyz;
    if (dot(n, n) < 1e-12) return;
    n = normalize(n);
    TexelGrid g;
    g.minCorner = u.uTexelGrid.xyz;
    g.spacing = u.uTexelGrid.w;
    g.capacity = uint(u.uTexelParams.x);
    g.level = 0u;
    int ids[TEXEL_CANDIDATES];
    float weights[TEXEL_CANDIDATES];
    vec3 sky = vec3(0.0), sun = vec3(0.0);
    vec3 skyD = vec3(0.0), sunD = vec3(0.0);
    float total = 0.0, coarseAo = 0.0, aoWeight = 0.0;
    vec3 shapeSum0 = vec3(0.0), shapeSum1 = vec3(0.0), shapeSum2 = vec3(0.0);
    float shapeW = 0.0;
    float keptMin = 1e30, keptMax = 0.0, cutMin = 1e30, cutMax = 0.0;
    vec3 f1 = normalize(cross(abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n));
    vec3 f2 = cross(n, f1);
    bool debug = u.uTexelParams.z > 0.5;
    if (debug) for (uint k = 0u; k < 32u; ++k) fineDebug[t * 32u + k] = 0xFFFFFFFFu;
    // The coarse level, else the next coarser where it has none here.
    for (uint level = uint(u.uFine.z); level <= uint(u.uFine.w) && total <= 0.0; ++level) {
        texelsAround(texelLevelGrid(g, level), p, n, 0.0, ids, weights);
        keptMin = 1e30; keptMax = 0.0; cutMin = 1e30; cutMax = 0.0;
        if (debug) {
            fineDebug[t * 32u + 30u] = level;
            uint k = 0u;
            for (int c = 0; c < TEXEL_CANDIDATES && k < 15u; ++c) {
                if (ids[c] < 0 || weights[c] <= 0.0) continue;
                vec3 dn = TEXEL_NORMAL(uint(ids[c])).xyz;
                fineDebug[t * 32u + 2u * k] = uint(ids[c]);
                // Negative: cut by the normal.
                fineDebug[t * 32u + 2u * k + 1u] = floatBitsToUint(dot(dn, dn) > 1e-12 && dot(n, normalize(dn)) > 0.95 ? weights[c] : -weights[c]);
                ++k;
            }
        }
        for (int c = 0; c < TEXEL_CANDIDATES; ++c) {
            if (ids[c] < 0 || weights[c] <= 0.0) continue;
            uint cid = uint(ids[c]);
            // Turned its way only: a coarse cell can average a wall with the ledge under it (its normal 45 degrees down,
            // and its gather the sunlit floor's bounce -- right for it, cell-sized bright blocks copied onto the wall,
            // 2026-10-19). None turned its way: its instant light stands.
            vec3 cn = TEXEL_NORMAL(cid).xyz;
            // The lookup also reads the bins a tilt away (texel.glsl): a wall's texel with no wall cell near took the ledge
            // cell's whole light once the weights were normalised -- a soft weight did not keep it out.
            float w = dot(n, cn) * inversesqrt(max(dot(cn, cn), 1e-12)) > 0.95 ? weights[c] : 0.0;
            float l = lightOf(cid);
            if (w > 0.0) { keptMin = min(keptMin, l); keptMax = max(keptMax, l); } else { cutMin = min(cutMin, l); cutMax = max(cutMax, l); }
            sky += w * unpackRgb9e5(skyPart[cid].x);
            sun += w * unpackRgb9e5(sunPart[cid].x);
            // Its tilt from its own frame (off its own normal, texel_patch_light.comp's rule) into this texel's.
            vec3 cnn = normalize(cn);
            vec3 c1 = normalize(cross(abs(cnn.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), cnn));
            vec3 c2 = cross(cnn, c1);
            vec3 cSky = texelDetailUnpack(skyDetail[cid]);
            vec3 cSun = texelDetailUnpack(sunDetail[cid]);
            vec3 gSky = c1 * cSky.x + c2 * cSky.y;
            vec3 gSun = c1 * cSun.x + c2 * cSun.y;
            skyD += w * vec3(dot(gSky, f1), dot(gSky, f2), cSky.z);
            sunD += w * vec3(dot(gSun, f1), dot(gSun, f2), cSun.z);
            float a = ao(cid);
            if (a >= 0.0) { coarseAo += w * a; aoWeight += w; }
            vec4 q0 = u.uKeep.z > 0.5 && w > 0.0 ? texelShapeUnpack(ownShape[cid * 3u]) : vec4(0.0);
            if (q0.w > 0.5) {
                shapeSum0 += w * q0.xyz; shapeSum1 += w * texelShapeUnpack(ownShape[cid * 3u + 1u]).xyz;
                shapeSum2 += w * texelShapeUnpack(ownShape[cid * 3u + 2u]).xyz; shapeW += w;
            }
            total += w;
        }
    }
    if (debug) fineDebug[t * 32u + 31u] = floatBitsToUint(total);
    const float floorLight = 0.002;
    float keptRatio = (keptMax + floorLight) / (keptMin + floorLight);
    float cutRatio = cutMax > 0.0 ? max((cutMax + floorLight) / (keptMax + floorLight), (keptMin + floorLight) / (cutMin + floorLight)) : 1.0;
    // Its light before the copy: the instant layer's (texel_patch_light.comp), for the flags below.
    float instantLight = lightOf(id);
    if (total <= 0.0) { if (!debug) flag(1u, 1e6); return; }   // none around: its provisional light stands, flagged first
    sky /= total; sun /= total; skyD /= total; sunD /= total;
    // Contact darkens only: a coarse texel's centroid sunk in its surface (a cell holding a face and a recess) measures
    // itself closed, and up to 2x over it lit its fine texels in cell-sized bright blocks (2026-10-19).
    float fineAo = ao(id);
    float ratio = fineAo >= 0.0 && aoWeight > 0.0 && coarseAo > 1e-3 ? clamp(fineAo / (coarseAo / aoWeight), 0.0, 1.0) : 1.0;
    // Flagged for its own gather (SponzaLoop.Transfer.cs, the fine refine): the light around it changes too fast for a
    // copy -- over 2x among the cells turned its way, or between those and the ones the normal cut -- or the copy and the
    // instant layer disagree over 2x (past the dark bar): each catches what the other misses (the hidden faces: a lit
    // cell's copy 40x over, the instant layer right; BLIX_RECALL, 2026-10-19). Ranked by the larger.
    if (!debug) {
        float copyLight = dot(sky * ratio + sun * ratio * u.uTexelParams.w, vec3(0.2126, 0.7152, 0.0722));
        float bar = max(u.uFlag.x, 1e-6);
        float disagree = max(copyLight, bar) / max(instantLight, bar);
        disagree = max(disagree, 1.0 / disagree);
        float score = max(max(keptRatio, cutRatio), disagree);
        if (u.uFlag.y > 0.5) score = max(score, 2.5);   // --fine-all (a measurement): every fine texel gathered
        // A crease or a contact: the texel far more closed than its coarse cells within 20 cm -- the copy leans on the
        // contact ratio alone there, and its seams came out 0.83 of the reference where gathered they are 0.97
        // (crevices, 2026-10-19). --fine-contact R (z): flagged under R.
        // Ranked first (w on): the budget's cut fell at 3.1x on Sponza, under every contact's score, and none was gathered.
        if (u.uFlag.z > 0.0 && ratio < u.uFlag.z) score = u.uFlag.w > 0.5 ? 1000.0 + (1.0 - ratio) : max(score, 2.0 + (1.0 - ratio));
        // A two-sided sheet's texel (uKeep.y: --no-fine-cloth off): every one gathered. A coarse cell spans a cloth's folds and
        // both its sides, so the copy is wrong there in a way no flag above sees, and the ones the flags did pick sat
        // among copied ones a step apart -- the folded curtains stair-stepped along the atlas's texels, the steps exactly
        // the flags' patchwork (Sponza, 2026-10-21). Ranked after the contacts (1000 and over), before the rest.
        bool pairFront = TEXEL_POSITION(id).w < 0.0;
        bool pairBack = id > 0u && TEXEL_POSITION(id - 1u).w < 0.0 && TEXEL_NORMAL(id).w == TEXEL_NORMAL(id - 1u).w;
        bool cloth = u.uKeep.y > 0.5 && (pairFront || pairBack);
        if (cloth && score < 500.0) flag(11u, 500.0 + score / 1000.0);   // its copy below still written: what a cut leaves it
        else if (score > 2.0) flag(disagree >= max(keptRatio, cutRatio) ? 3u : keptRatio >= cutRatio ? 2u : 10u, score);
        const float edges[6] = float[6](1.5, 2.0, 3.0, 4.0, 8.0, 16.0);
        for (int e = 0; e < 6; ++e) if (score > edges[e]) atomicAdd(fineFlags[4 + e], 1u);
    }
    if (u.uKeep.x < 0.5) skyPart[id] = uvec2(packRgb9e5(sky * ratio), 0xFFFFu | 0x10000u);
    provenanceMark(id, 5u, true, u.uKeep.x < 0.5);   // the fine copy
    sunPart[id] = uvec2(packRgb9e5(sun * ratio), 0xFFFFu | 0x10000u);
    // The coarse tilts turned into this texel's frame: in their own (a cell averaging a wall and the ledge under it,
    // turned 45 degrees down, its tilt toward the sunlit floor) they lit the wall's normal-mapped stones in blocks
    // (2026-10-19).
    // Its sky visibility the coarse cells', no more than its own openness within a metre (the instant layer's): what it
    // sees of the sky it sees past that. The cells' alone put bright cell outlines on the wall and the lamps where a
    // cell's centroid sank and its rays left through the wall (2026-10-19); its own alone, the gallery's openness, is far
    // above its sky and lit everything too bright.
    if (u.uKeep.z > 0.5) {
        bool has = shapeW > 0.0;
        ownShape[id * 3u] = has ? texelShapePack(shapeSum0 / shapeW) : 0u;
        ownShape[id * 3u + 1u] = has ? texelShapePack(shapeSum1 / shapeW) : 0u;
        ownShape[id * 3u + 2u] = has ? texelShapePack(shapeSum2 / shapeW) : 0u;
    }
    if (u.uKeep.x < 0.5) skyDetail[id] = texelDetailPack(skyD.xy, min(skyD.z, texelDetailUnpack(skyDetail[id]).z));
    sunDetail[id] = texelDetailPack(sunD.xy, min(sunD.z, texelDetailUnpack(sunDetail[id]).z));
}
