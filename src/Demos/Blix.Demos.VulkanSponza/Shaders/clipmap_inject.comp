#version 450

// The camera-relative probe clipmap's injection: every probe's light, traced through the ray scene, with nothing
// baked (no occupancy, no sky-visibility volume, no albedo grid). Blix.Geometry's ProbeClipmap places the probes and
// Blix.Shaders' probe_clipmap.glsl addresses them; this keeps them solved. Three dispatches a frame, uParams.z says
// which:
//
//   0  reset   the per-level queue counters
//   1  scan    one thread per slot: the cell it should hold now; a slot holding another (the block scrolled) is
//              re-pointed and marked unsolved; every unsolved slot joins its level's queue
//   2  update  one workgroup per probe, a fixed budget a frame: queued probes first, finest level first, the rest
//              round-robin. 64 rays along a Fibonacci spiral, rotated afresh each update:
//                hit     sun (a shadow ray) and the clipmap's own irradiance there (which already holds the sky
//                        that reaches that surface, directly and bounced), re-radiated in the baked albedo
//                escape  the sky's radiance in that direction (the disc-free prefiltered sky, blurred to a ray's
//                        share of the sphere), and it counts toward sky visibility
//              So a probe's irradiance is ALL the indirect light arriving there, direct sky included: the sky a
//              surface actually sees, not the sky's average times the share it sees. That product was measured
//              against a path-traced reference at Sponza's and Bistro's surfaces (SponzaLoop.ProbeReference): 35%
//              high in Sponza's courtyard, which sees the dim zenith, and off by half either way in Bistro's
//              street, even with the true visibility.
//              then each tile texel reconstructs irradiance, depth moments and sky visibility, blended in place with
//              what the probe held; a probe whose rays mostly meet back faces is buried and shades nothing.
//
// The atlases are updated in place and read back by the next update (and by feedback within this one: a neighbour
// read mid-write is either its old or its new answer, both valid), which is why storage images keep their contents
// between dispatches (VulkanGraphicsDevice's storage barrier).

layout(local_size_x = 64) in;

#define RAYS 64
#define PI 3.14159265359

layout(set = 0, binding = 0) uniform ClipmapInject {
    vec4 uDims;            // xyz probes per level, w base spacing (m)
    vec4 uParams;          // x blend band (probes), y the static light's blend floor (0: 1/n throughout), z mode,
                           // w update budget (probes a frame)
    vec4 uOrigin0;         // each level's lowest cell (xyz), levels 0-3
    vec4 uOrigin1;
    vec4 uOrigin2;
    vec4 uOrigin3;
    vec4 uSunDirection;    // xyz the direction the sun travels
    vec4 uSunIrradiance;   // rgb measured irradiance, w 1 when the sky irradiance cube is valid
    vec4 uFrame;           // x frame counter, y bounce strength, z sky strength, w depth lobe exponent
    // Stage 4g-ix, the world-anchored surface probes (probe_surface.glsl): x y z the index's lowest cell, w spacing;
    // the index's dims and the first surface slot; x the atlas row where surface tiles start, y tiles across,
    // z how many surface slots, w 1 when they are on.
    vec4 uSurfaceGrid;
    vec4 uSurfaceDims;
    vec4 uSurfaceAtlas;
    vec4 uGuide;           // x 1: half of each solve's rays guided by the probe's radiance bins (--clipmap-guide), y the
                           // bins' floor, as a share of their mean luminance
    vec4 uFallback;        // x the sky visibility taken at a hit no probe answers for, y the sky's mip for a ray
                           // z young probes: fewer solves than this are queued before the round-robin (0: none)
                           // w visible probes: at most this many a frame (0: none queued as visible)
    // Stage 4f: the reach of what can move, w of the min 1 when there is one (paths are classified against it whether
    // or not it moved this frame); w of the max the blend of a probe's dynamic part (paths through the reach) per update.
    vec4 uDynamicMin;
    vec4 uDynamicMax;
    vec4 uDynamicQueue;    // x how many of a probe's rays must cross the reach for it to be re-solved first
                           // (--clipmap-dependent-rays): fewer, and it keeps its split but waits for the round-robin;
                           // y at most how many dependent probes a frame (--clipmap-dependent-share of the budget), so
                           // the round-robin always keeps the rest: given all of it, 600-1,200 dependent probes stopped
                           // the round-robin and the scene stayed at its first solves (rest median 32% against 10%);
                           // z 1: every hit's sun by a shadow ray, the cascades not consulted (--clipmap-shadow-rays)
                           // w 1: the mover moved this frame, so dependent probes are queued first
    // The sun's cascades, as the lit pass rendered them this frame: a hit they cover is answered there, a shadow
    // ray only beyond them (frame audit F4; screen probes measured their shadow rays at 30% of their pass).
    mat4 uCascadeVP[3];
} u;

layout(set = 0, binding = 1, rgba16f) uniform image2D uClipmapIrradiance;
layout(set = 0, binding = 2, rgba16f) uniform image2D uClipmapDepth;
// Stage 4f: each probe's irradiance in two parts, private to this pass -- static (paths that cross no moving reach,
// on the steady blend) and dynamic (paths that do, on a short blend of their own). Both are normalised over all of a
// texel's rays, so they add up to the whole; uClipmapIrradiance, what every reader samples, is their sum.
layout(set = 0, binding = 7, rgba16f) uniform image2D uClipmapStatic;
layout(set = 0, binding = 8, rgba16f) uniform image2D uClipmapDynamic;
layout(set = 0, binding = 9) uniform sampler2D uCascadeShadowMaps[3];
// Stage 4g-iv: what each probe's rays have seen, by direction -- 6x6 octahedral bins of mean radiance (rgb; a 1 once
// written) at the first 6x6 texels of its tile, private to this pass. It guides where the next solve sends rays.
layout(set = 0, binding = 11, rgba16f) uniform image2D uClipmapRadiance;
// Beside the engine's flags (SOLVED 1, BURIED 2, solves in bits 8-15): bits 16-23, how many of the probe's rays crossed
// a moving reach at its last solve while something moved. Dependence is a fraction, not a flag: the coarse levels'
// probes nearly all see some of the curtain's box (6,506 probes against a budget of 512 a frame, when any ray
// counted), so only those that depend enough are re-solved first.
#define CLIPMAP_DEPENDENT_SHIFT 16
shared uint sDependentRays;
layout(set = 0, binding = 3) uniform samplerCube uIrradiance;   // unused here since radiance replaced it; kept bound by the host
layout(set = 0, binding = 6) uniform samplerCube uSkyRadiance;
layout(std430, set = 0, binding = 4) buffer ClipmapState { uvec4 states[]; };
// counts[0..3] per level, [4] hits this frame, [5] of them no probe answered for, [6] probes solved this frame with
// a path through a moving reach, [7] dependent probes queued this frame; then each level's queue of global slots
// (level * probes-per-level slots each); then the dependent queue (every slot's worth). The order a frame's budget
// takes them in: unsolved first (a probe that answers nothing is worse than a stale one), then dependent, then the
// round-robin. Dependent probes once shared the unsolved queues and, outnumbering the budget, starved them: after 300
// frames level 0 was half solved and levels 1-3 not at all. The round-robin walks from a cursor kept after both
// queues (never reset), advanced each frame by what it was given: it used to start at frame x budget, so the slots
// the queues displaced from each frame's window were skipped.
// After the cursor (stage 4g-ii): four counts and four queues of YOUNG probes, by how many solves they have had
// (1, 2-3, 4-7, 8-15; below uFallback.z, 0 = none queued). A probe re-pointed by the scroll is solved at once as
// unsolved, then waited a whole round-robin sweep (65,536 probes at 512 a frame: ~6 s at 20 fps) for each further
// solve, showing one 64-ray answer -- a few rays on a sunlit curtain colour it -- for seconds at a time. What a solve
// is worth is about 1/(n+1) of the probe's answer, so the fewest solves go first; the round-robin keeps what is left,
// and under 1/n an old probe barely moves when it is re-solved.
#define CLIPMAP_YOUNG_BUCKETS 4
// Before them (stage 4g-iii): the probes this frame's image reads (clipmap_mark.comp stamps them), by solves in
// powers of two (1, 2-3, ... 128-254), fewest first, up to uFallback.w of the budget. Their answers are what is on
// screen, so their noise is what is seen: concentrating the budget there is what takes it down.
#define CLIPMAP_VISIBLE_BUCKETS 8
#define CLIPMAP_BUCKETS (CLIPMAP_VISIBLE_BUCKETS + CLIPMAP_YOUNG_BUCKETS)
layout(std430, set = 0, binding = 5) buffer ClipmapQueue { uint queue[]; };
// The frame each slot was last read by the image (clipmap_mark.comp); seen within the last two counts as visible.
layout(std430, set = 0, binding = 10) readonly buffer ClipmapSeen { uint seen[]; };

#define BLIX_RAY_SET 0
#define BLIX_RAY_BINDING 13
#include "ray_query.glsl"
#include "shadow.glsl"

#define BLIX_CLIPMAP_IRRADIANCE(t) imageLoad(uClipmapIrradiance, t)
#define BLIX_CLIPMAP_DEPTH(t) imageLoad(uClipmapDepth, t)
#define BLIX_CLIPMAP_STATE(s) states[s]
#include "probe_clipmap.glsl"
layout(std430, set = 0, binding = 12) readonly buffer SurfaceIndex { uint surfaceIndex[]; };
#define BLIX_SURFACE_INDEX(i) surfaceIndex[i]
#include "probe_surface.glsl"

BlixSurfaceGrid surfaceGrid() {
    BlixSurfaceGrid s;
    s.minCell = ivec3(u.uSurfaceGrid.xyz);
    s.spacing = u.uSurfaceGrid.w;
    s.dims = ivec3(u.uSurfaceDims.xyz);
    s.firstSlot = int(u.uSurfaceDims.w);
    s.tileRow0 = int(u.uSurfaceAtlas.x);
    s.columns = int(u.uSurfaceAtlas.y);
    s.enabled = u.uSurfaceAtlas.w > 0.5;
    return s;
}

// Guided sampling (stage 4g-iv). In bounce-lit enclosures a probe's light arrives through a few sunlit patches and
// saturated curtains that only a handful of 64 uniform rays hit, so neighbouring probes catch different numbers of
// them and hold different wrong answers (two identical runs 12% apart in Sponza's arcade, as probe-sized blocks).
// Half the rays keep the uniform spiral; the other half go where the probe's own past solves saw radiance (the bins
// above, in proportion to their luminance plus a floor). Every ray is weighted by 1/p of the MIXTURE density, in
// every sum below, so the estimate is the same quantity with less noise: p >= 0.5/(4 pi) everywhere, so no weight
// exceeds 2 and a wrong guide costs efficiency, never correctness. uGuide.x turns it on.
shared float sBinQ[36];      // the guide's probability per bin
shared float sBinCdf[36];
shared float sWeight[RAYS];  // 1 / (4 pi p(dir)) for each ray: 1 for uniform sampling alone
shared uint sGuided;
shared int sRayBin[RAYS];    // the radiance bin each ray's direction falls in
shared vec3 sRadiance[RAYS];
shared vec3 sDirection[RAYS];
shared float sDistance[RAYS];
shared float sEscaped[RAYS];
shared uint sDependent[RAYS];
shared uint sAnyDependent;
shared vec3 sTexelDynamic[36];

// Whether the segment origin + dir * [0, tEnd] passes through the reach of what moved this frame (screen_probe.comp
// asks the same).
bool crossesMovingReach(vec3 origin, vec3 dir, float tEnd) {
    if (u.uDynamicMin.w < 0.5) return false;
    vec3 safe = mix(dir, vec3(1e-8), lessThan(abs(dir), vec3(1e-8)));
    vec3 t0 = (u.uDynamicMin.xyz - origin) / safe;
    vec3 t1 = (u.uDynamicMax.xyz - origin) / safe;
    vec3 lo = min(t0, t1);
    vec3 hi = max(t0, t1);
    return max(max(lo.x, lo.y), max(lo.z, 0.0)) <= min(min(hi.x, hi.y), min(hi.z, tEnd));
}
shared uint sBackfaces;
shared vec4 sTexel[36];      // irradiance rgb, sky visibility a
shared vec2 sMoments[36];
shared int sProbe;

BlixClipmap clipmap() {
    BlixClipmap c;
    c.dims = ivec3(u.uDims.xyz);
    c.baseSpacing = u.uDims.w;
    c.blendProbes = u.uParams.x;
    c.origin[0] = ivec3(u.uOrigin0.xyz);
    c.origin[1] = ivec3(u.uOrigin1.xyz);
    c.origin[2] = ivec3(u.uOrigin2.xyz);
    c.origin[3] = ivec3(u.uOrigin3.xyz);
    return c;
}

vec3 fibonacci(int i, int count) {
    float y = 1.0 - 2.0 * (float(i) + 0.5) / float(count);
    float r = sqrt(max(0.0, 1.0 - y * y));
    float theta = 2.39996323 * float(i);
    return vec3(cos(theta) * r, y, sin(theta) * r);
}

// A rotation from a seed: the spiral turned afresh on every update so successive solves see different directions.
mat3 rotation(uint seed) {
    float a = float(blix_pcg(seed) & 0xFFFFu) / 65536.0 * 2.0 * PI;
    float b = float(blix_pcg(seed ^ 0x9E3779B9u) & 0xFFFFu) / 65536.0 * 2.0 - 1.0;
    float c = float(blix_pcg(seed ^ 0x85EBCA6Bu) & 0xFFFFu) / 65536.0 * 2.0 * PI;
    vec3 axis = vec3(sqrt(1.0 - b * b) * cos(c), b, sqrt(1.0 - b * b) * sin(c));
    float s = sin(a), k = cos(a);
    vec3 t = (1.0 - k) * axis;
    return mat3(t.x * axis.x + k,          t.x * axis.y + s * axis.z, t.x * axis.z - s * axis.y,
                t.y * axis.x - s * axis.z, t.y * axis.y + k,          t.y * axis.z + s * axis.x,
                t.z * axis.x + s * axis.y, t.z * axis.y - s * axis.x, t.z * axis.z + k);
}

void main() {
    BlixClipmap c = clipmap();
    int perLevel = c.dims.x * c.dims.y * c.dims.z;
    int mode = int(u.uParams.z + 0.5);

    uint cursorAt = 8u + 2u * uint(perLevel * BLIX_CLIPMAP_LEVELS);
    // Bucket counts after the cursor (visible first, then young), then each bucket's list, every slot's worth.
    uint bucketAt = cursorAt + 1u;
    uint bucketListAt = bucketAt + uint(CLIPMAP_BUCKETS);
    // Every slot: the clipmap's, then the surface probes' (which never scroll, and join the visible buckets).
    uint clipSlots = uint(perLevel * BLIX_CLIPMAP_LEVELS);
    uint total = clipSlots + uint(u.uSurfaceAtlas.z);
    if (mode == 0) {
        if (gl_GlobalInvocationID.x == 0u) {
            // Last frame's round-robin share, from last frame's counts, before they are cleared.
            uint unsolved = queue[0] + queue[1] + queue[2] + queue[3];
            uint visible = 0u, young = 0u;
            for (int b = 0; b < CLIPMAP_VISIBLE_BUCKETS; ++b) visible += queue[bucketAt + uint(b)];
            for (int b = CLIPMAP_VISIBLE_BUCKETS; b < CLIPMAP_BUCKETS; ++b) young += queue[bucketAt + uint(b)];
            uint used = min(uint(u.uParams.w), unsolved + min(queue[7], uint(u.uDynamicQueue.y))
                + min(visible, uint(u.uFallback.w)) + young);
            queue[cursorAt] = (queue[cursorAt] + uint(u.uParams.w) - used) % clipSlots;
            for (int i = 0; i < 8; ++i) queue[i] = 0u;
            for (int b = 0; b < CLIPMAP_BUCKETS; ++b) queue[bucketAt + uint(b)] = 0u;
        }
        return;
    }

    if (mode == 1) {
        int g = int(gl_GlobalInvocationID.x);
        if (uint(g) >= total) return;
        if (uint(g) >= clipSlots) {
            // A surface probe: allocated by clipmap_mark.comp where a surface is seen; its cell is its own for good.
            // Unsolved, it is a visible probe with no solves (it was allocated because it is seen); then as any.
            uvec4 state = states[g];
            if ((state.w & BLIX_SURFACE_ALLOCATED) == 0u) return;
            uint solves = (state.w & BLIX_CLIPMAP_SOLVED) != 0u ? (state.w >> 8) & 0xFFu : 0u;
            bool visible = solves < 255u && seen[g] + 2u > uint(u.uFrame.x);
            int b = -1;
            if (visible) b = min(findMSB(max(solves, 1u)), CLIPMAP_VISIBLE_BUCKETS - 1);
            else if (solves < uint(u.uFallback.z)) b = CLIPMAP_VISIBLE_BUCKETS + min(findMSB(max(solves, 1u)), CLIPMAP_YOUNG_BUCKETS - 1);
            if (b >= 0) {
                uint k = atomicAdd(queue[bucketAt + uint(b)], 1u);
                queue[bucketListAt + uint(b) * total + k] = uint(g);
            }
            return;
        }
        int level = g / perLevel;
        int index = g % perLevel;
        ivec3 slot = ivec3(index % c.dims.x, (index / c.dims.x) % c.dims.y, index / (c.dims.x * c.dims.y));
        ivec3 expected = blix_clipmapCellInSlot(c, level, slot);
        uvec4 state = states[g];
        if (ivec3(state.xyz) != expected) {
            state = uvec4(uvec3(expected), 0u);
            states[g] = state;
        }
        if ((state.w & BLIX_CLIPMAP_SOLVED) == 0u) {
            uint k = atomicAdd(queue[level], 1u);
            queue[8u + uint(level * perLevel) + k] = uint(g);
        } else if (u.uDynamicQueue.w > 0.5 && ((state.w >> CLIPMAP_DEPENDENT_SHIFT) & 0xFFu) >= uint(u.uDynamicQueue.x)) {
            uint k = atomicAdd(queue[7], 1u);
            queue[8u + uint(BLIX_CLIPMAP_LEVELS * perLevel) + k] = uint(g);
        } else {
            uint solves = (state.w >> 8) & 0xFFu;
            bool visible = u.uFallback.w > 0.5 && solves < 255u && seen[g] + 2u > uint(u.uFrame.x);
            int b = -1;
            if (visible) b = min(findMSB(max(solves, 1u)), CLIPMAP_VISIBLE_BUCKETS - 1);
            else if (solves < uint(u.uFallback.z)) b = CLIPMAP_VISIBLE_BUCKETS + min(findMSB(max(solves, 1u)), CLIPMAP_YOUNG_BUCKETS - 1);
            if (b >= 0) {
                uint k = atomicAdd(queue[bucketAt + uint(b)], 1u);
                queue[bucketListAt + uint(b) * total + k] = uint(g);
            }
        }
        return;
    }

    // mode 2: which probe this workgroup solves.
    uint lane = gl_LocalInvocationIndex;
    if (lane == 0u) {
        int k = int(gl_WorkGroupID.x);
        int chosen = -1;
        for (int l = 0; l < BLIX_CLIPMAP_LEVELS && chosen < 0; ++l) {
            int count = int(queue[l]);
            if (k < count) chosen = int(queue[8 + l * perLevel + k]);
            else k -= count;
        }
        if (chosen < 0) {
            int count = min(int(queue[7]), int(u.uDynamicQueue.y));
            if (k < count) chosen = int(queue[8 + BLIX_CLIPMAP_LEVELS * perLevel + k]);
            else k -= count;
        }
        // Visible probes, fewest solves first, up to their share; then young ones off screen.
        int visibleLeft = int(u.uFallback.w);
        for (int b = 0; b < CLIPMAP_BUCKETS && chosen < 0; ++b) {
            int count = int(queue[bucketAt + uint(b)]);
            if (b < CLIPMAP_VISIBLE_BUCKETS) { count = min(count, visibleLeft); visibleLeft -= count; }
            if (k < count) chosen = int(queue[bucketListAt + uint(b) * total + uint(k)]);
            else k -= count;
        }
        if (chosen < 0) {
            // The budget the queues left over sweeps every clipmap probe in turn, from the cursor (surface probes come
            // only through the queues: an unallocated surface slot has no cell to solve).
            chosen = int((queue[cursorAt] + uint(k)) % clipSlots);
        }
        sProbe = chosen;
        sBackfaces = 0u;
        sAnyDependent = 0u;
        sDependentRays = 0u;
    }
    barrier();
    int g = sProbe;
    BlixSurfaceGrid sg = surfaceGrid();
    bool surfaceProbe = uint(g) >= clipSlots;
    // A surface probe is level 0's spacing at its own world cell; a clipmap probe is where its level's block puts it.
    int level = surfaceProbe ? 0 : g / perLevel;
    int index = g % perLevel;
    ivec3 slot = ivec3(index % c.dims.x, (index / c.dims.x) % c.dims.y, index / (c.dims.x * c.dims.y));
    ivec3 cell = surfaceProbe ? ivec3(states[g].xyz) : blix_clipmapCellInSlot(c, level, slot);
    vec3 origin = blix_clipmapProbePosition(c, level, cell);
    float spacing = blix_clipmapSpacing(c, level);
    ivec2 probeTile = surfaceProbe ? blix_surfaceTileOrigin(sg, g - int(clipSlots)) : blix_clipmapTileOrigin(c, level, slot);
    // As far as a ray can usefully report a distance: well past the level's block.
    float farDistance = spacing * float(max(c.dims.x, max(c.dims.y, c.dims.z))) * 2.0;

    uint seed = blix_pcg(uint(u.uFrame.x) * 2654435761u + uint(g));
    uint stateWord = states[g].w;
    // Guide only from this cell's own history (a re-pointed slot's bins belong to another cell).
    bool guide = u.uGuide.x > 0.5 && (stateWord & BLIX_CLIPMAP_SOLVED) != 0u && ((stateWord >> 8) & 0xFFu) > 0u;
    ivec2 radianceTile = probeTile;
    if (lane < 36u) {
        vec4 bin = guide ? imageLoad(uClipmapRadiance, radianceTile + ivec2(int(lane) % 6, int(lane) / 6)) : vec4(1.0);
        sBinQ[lane] = bin.a > 0.5 ? dot(bin.rgb, vec3(0.2126, 0.7152, 0.0722)) : -1.0;
    }
    barrier();
    if (lane == 0u) {
        // A bin no ray has reached yet counts as the mean; every bin keeps a floor of the mean.
        float sum = 0.0, known = 0.0;
        for (int b = 0; b < 36; ++b) if (sBinQ[b] >= 0.0) { sum += sBinQ[b]; known += 1.0; }
        float mean = known > 0.0 ? sum / known : 1.0;
        float total = 0.0;
        for (int b = 0; b < 36; ++b) {
            float q = (sBinQ[b] >= 0.0 ? sBinQ[b] : mean) + u.uGuide.y * mean + 1e-6;
            sBinQ[b] = q;
            total += q;
        }
        float running = 0.0;
        for (int b = 0; b < 36; ++b) { sBinQ[b] /= total; running += sBinQ[b]; sBinCdf[b] = running; }
        sGuided = guide ? 1u : 0u;
    }
    barrier();
    vec3 dir;
    const int halfRays = RAYS / 2;
    if (sGuided != 0u && int(lane) >= halfRays) {
        // A bin by the guide (stratified over the guided lanes), then a uniform point inside it.
        int j = int(lane) - halfRays;
        uint r = blix_pcg(seed ^ (lane * 0x9E3779B9u));
        float pick = (float(j) + float(r & 0xFFFFu) / 65536.0) / float(halfRays);
        int b = 0;
        while (b < 35 && sBinCdf[b] < pick) ++b;
        uint r2 = blix_pcg(r);
        vec2 inBin = vec2(float(r2 & 0xFFFFu), float(r2 >> 16)) / 65536.0;
        dir = blix_octDecode(((vec2(b % 6, b / 6) + inBin) / 6.0) * 2.0 - 1.0);
    } else {
        dir = rotation(seed) * (sGuided != 0u ? fibonacci(int(lane), halfRays) : fibonacci(int(lane), RAYS));
    }
    {
        vec2 uvBin = blix_octEncode(dir);
        ivec2 b2 = clamp(ivec2(floor((uvBin * 0.5 + 0.5) * 6.0)), ivec2(0), ivec2(5));
        sRayBin[lane] = b2.y * 6 + b2.x;
    }
    if (sGuided != 0u) {
        // The mixture's density at dir, in solid angle: half uniform, half the guide's bin probability spread evenly
        // over the bin's square (4/36 of [-1,1]^2's area 4, so density 9 q per unit), where a unit of square is 1/|p|^3 steradians
        // (p the octahedron point, |p|_1 = 1).
        vec2 uv = blix_octEncode(dir);
        ivec2 bxy = clamp(ivec2(floor((uv * 0.5 + 0.5) * 6.0)), ivec2(0), ivec2(5));
        vec3 pOct = vec3(uv, 1.0 - abs(uv.x) - abs(uv.y));
        if (pOct.z < 0.0) pOct.xy = (1.0 - abs(pOct.yx)) * vec2(pOct.x >= 0.0 ? 1.0 : -1.0, pOct.y >= 0.0 ? 1.0 : -1.0);
        float len = length(pOct);
        float pGuide = sBinQ[bxy.y * 6 + bxy.x] * 9.0 * len * len * len;
        float pMix = 0.5 / (4.0 * PI) + 0.5 * pGuide;
        sWeight[lane] = 1.0 / (4.0 * PI * pMix);
    } else {
        sWeight[lane] = 1.0;
    }
    vec3 toSun = -normalize(u.uSunDirection.xyz);
    BlixRayHit hit;
    vec3 radiance = vec3(0.0);
    float distance = farDistance;
    float escaped = 1.0;
    bool dependent = false;
    if (blix_traceClosest(origin, dir, 0.0, uintBitsToFloat(0x7F800000u), seed ^ lane, hit)) {
        escaped = 0.0;
        distance = min(hit.t, farDistance);
        if (!hit.frontFace) atomicAdd(sBackfaces, 1u);
        vec3 n = dot(hit.normal, dir) > 0.0 ? -hit.normal : hit.normal;
        vec3 hitPos = origin + dir * hit.t;
        float ndotl = max(dot(n, toSun), 0.0);
        // The gather segment, and the hit's way to the sun (stage 4f).
        dependent = crossesMovingReach(origin, dir, hit.t) || (ndotl > 0.0 && crossesMovingReach(hitPos + n * 0.01, toSun, 1e30));
        float sun = 0.0;
        if (ndotl > 0.0) {
            int cascade = -1;
            float lit = 1.0;
            if (u.uDynamicQueue.z < 0.5) {
                lit = blix_sun_shadow_cascaded_hard(
                    uCascadeShadowMaps[0], uCascadeShadowMaps[1], uCascadeShadowMaps[2],
                    u.uCascadeVP[0], u.uCascadeVP[1], u.uCascadeVP[2], hitPos + n * 0.01, ndotl, cascade);
            }
            if (cascade < 0)
                lit = blix_traceAny(hitPos + n * 0.01, toSun, 0.0, uintBitsToFloat(0x7F800000u), blix_pcg(seed ^ lane ^ 0x5bd1e995u)) ? 0.0 : 1.0;
            sun = ndotl * lit;
        }
        // What the clipmap knows at the hit, from earlier solves: bounce in rgb, sky visibility in a. Beyond its
        // coarsest level it knows nothing, and the sky is taken as open there.
        // What the clipmap knows arrives at the hit, from earlier solves: all the indirect light, sky included. Where
        // no probe answers (start-up, or past the coarsest level) it adds nothing, so a wrong start is dark.
        bool known;
        vec4 field = blix_worldSample(sg, c, hitPos, n, known);
        atomicAdd(queue[4], 1u);
        if (!known) atomicAdd(queue[5], 1u);
        vec3 indirect = known ? field.rgb * u.uFrame.y : vec3(0.0);
        radiance = hit.albedo * (u.uSunIrradiance.rgb * sun + indirect) / PI;
    } else {
        // The sky this direction sees, as the lighting integrals see it (no disc: the sun is the shadow rays' job).
        radiance = textureLod(uSkyRadiance, dir, u.uFallback.y).rgb * u.uFrame.z;
        dependent = crossesMovingReach(origin, dir, 1e30);
    }
    if (dependent) { atomicOr(sAnyDependent, 1u); atomicAdd(sDependentRays, 1u); }
    sDependent[lane] = dependent ? 1u : 0u;
    sRadiance[lane] = radiance;
    sDirection[lane] = dir;
    sDistance[lane] = distance;
    sEscaped[lane] = escaped;
    barrier();

    if (lane < 36u) {
        ivec2 t = ivec2(int(lane) % 6, int(lane) / 6);
        vec3 texelDir = blix_octDecode(((vec2(t) + 0.5) / 6.0) * 2.0 - 1.0);
        vec3 irr = vec3(0.0);
        vec3 irrDynamic = vec3(0.0);
        float cosSum = 0.0, skySum = 0.0;
        float dSum = 0.0, d2Sum = 0.0, dWeight = 0.0;
        for (int i = 0; i < RAYS; ++i) {
            float cosine = max(dot(texelDir, sDirection[i]), 0.0);
            if (cosine <= 0.0) continue;
            float k = cosine * sWeight[i];
            if (sDependent[i] != 0u) irrDynamic += sRadiance[i] * k;
            else irr += sRadiance[i] * k;
            skySum += sEscaped[i] * k;
            cosSum += k;
            float w = pow(cosine, u.uFrame.w) * sWeight[i];
            dSum += sDistance[i] * w;
            d2Sum += sDistance[i] * sDistance[i] * w;
            dWeight += w;
        }
        sTexel[lane] = cosSum > 0.0 ? vec4(irr * (PI / cosSum), skySum / cosSum) : vec4(0.0, 0.0, 0.0, 1.0);
        sTexelDynamic[lane] = cosSum > 0.0 ? irrDynamic * (PI / cosSum) : vec3(0.0);
        float mean = dWeight > 0.0 ? dSum / dWeight : farDistance;
        sMoments[lane] = vec2(mean, dWeight > 0.0 ? max(d2Sum / dWeight - mean * mean, 0.0) : 0.0);
    }
    barrier();

    // The radiance bins: the mean radiance this solve's rays saw in each, blended in (1/n, never under 0.1: a guide
    // follows what the light is now). A slot's first solve for its cell writes every bin (one no ray reached takes the
    // solve's mean), so no bin keeps another cell's past.
    if (u.uGuide.x > 0.5 && lane < 36u) {
        vec3 sum = vec3(0.0), all = vec3(0.0);
        float count = 0.0;
        for (int i = 0; i < RAYS; ++i) {
            all += sRadiance[i];
            if (sRayBin[i] == int(lane)) { sum += sRadiance[i]; count += 1.0; }
        }
        uint solvesBefore = (stateWord & BLIX_CLIPMAP_SOLVED) != 0u ? (stateWord >> 8) & 0xFFu : 0u;
        ivec2 at = radianceTile + ivec2(int(lane) % 6, int(lane) / 6);
        if (solvesBefore == 0u) {
            imageStore(uClipmapRadiance, at, vec4(count > 0.0 ? sum / count : all / float(RAYS), 1.0));
        } else if (count > 0.0) {
            vec4 old = imageLoad(uClipmapRadiance, at);
            float rate = max(1.0 / float(solvesBefore + 1u), 0.1);
            imageStore(uClipmapRadiance, at, vec4(mix(old.rgb, sum / count, rate), 1.0));
        }
    }

    uint previousFlags = states[g].w;
    bool solvedBefore = (previousFlags & BLIX_CLIPMAP_SOLVED) != 0u;
    // How many times this slot has been solved for its cell (bits 8-15). The static light averages every solve evenly
    // (1/n): nothing it depends on moves, and re-pointing the slot restarts the count. A fixed blend never settled --
    // each re-solve moved the probe by a quarter of one solve's noise, which in dark, bounce-lit areas is most of it.
    // uParams.y is a floor for the A/B (0.25 was the old steady rate).
    uint solves = solvedBefore ? (previousFlags >> 8) & 0xFFu : 0u;
    // A quarter of the rays meeting back faces: the probe sits inside something.
    bool buried = float(sBackfaces) > 0.25 * float(RAYS);
    float converge = max(u.uParams.y, 1.0 / float(solves + 1u));
    // Depth moments and sky visibility move with the geometry: a probe whose rays cross a moving reach keeps the short
    // blend for them.
    uint dependentNow = u.uDynamicMin.w > 0.5 ? sDependentRays : 0u;
    float geometryConverge = dependentNow > 0u ? max(converge, 0.25) : converge;
    ivec2 tile = probeTile;
    ivec2 texel = ivec2(int(lane) % 8, int(lane) / 8);
    ivec2 src = blix_octBorderSource(texel, 8);
    int interior = (src.y - 1) * 6 + (src.x - 1);
    vec4 value = sTexel[interior];
    vec3 oldStatic = imageLoad(uClipmapStatic, tile + texel).rgb;
    vec3 oldDynamic = imageLoad(uClipmapDynamic, tile + texel).rgb;
    vec4 oldDepth = imageLoad(uClipmapDepth, tile + texel);
    vec3 newStatic = mix(oldStatic, value.rgb, converge);
    vec3 newDynamic = mix(oldDynamic, sTexelDynamic[interior], max(u.uDynamicMax.w, 1.0 / float(solves + 1u)));
    imageStore(uClipmapStatic, tile + texel, vec4(newStatic, 1.0));
    imageStore(uClipmapDynamic, tile + texel, vec4(newDynamic, 1.0));
    imageStore(uClipmapIrradiance, tile + texel, vec4(newStatic + newDynamic, 1.0));
    imageStore(uClipmapDepth, tile + texel, vec4(mix(oldDepth.rg, sMoments[interior], geometryConverge), 0.0, mix(oldDepth.a, value.a, geometryConverge)));
    barrier();
    if (lane == 0u) {
        // How many rays crossed the reach at this solve: a probe that depends on the mover is queued first the moment
        // it moves (uDynamicQueue.w).
        uint dependentRays = dependentNow;
        if (sAnyDependent != 0u) atomicAdd(queue[6], 1u);
        states[g] = uvec4(uvec3(cell), BLIX_CLIPMAP_SOLVED | (buried ? BLIX_CLIPMAP_BURIED : 0u) | (surfaceProbe ? BLIX_SURFACE_ALLOCATED : 0u)
            | (min(solves + 1u, 255u) << 8) | (dependentRays << CLIPMAP_DEPENDENT_SHIFT));
    }
}
