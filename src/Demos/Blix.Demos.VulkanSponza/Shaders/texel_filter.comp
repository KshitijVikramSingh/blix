#version 450
// The texels' spatial filter (--texel-filter): for each texel the image read this frame (texel_mark.comp lists them
// as it stamps them), the 27 texels around its cell on its own surface (its bin, its plane), weighted by distance
// (sigma one cell), by rays, and by how near each one's light is to its own -- one more than ~half again brighter or
// darker is an edge (a shadow's, a corner's), not noise, and drops out -- into TexelFiltered, which the incident pass
// reads. Every frame a texel is seen, not when it is gathered: filtered once at its last gather, a texel that settled
// early froze its noisy young neighbours' average, and the Cornell boxes' faces showed it as stripes a texel wide.
// (Per pixel each frame the same filter cost ~18 ms on Sponza's hall.)

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform TexelFilter {
    vec4 uTexelGrid;      // xyz the cells' origin, w the spacing
    vec4 uTexelParams;    // x hash capacity, y the list's capacity, z the trust rays, w the frame
    vec4 uLightmap;       // --lightmap: x 1 when the atlas's texels are on, yz the atlas size, w its first record
    vec4 uEdge;           // x 1: the edge measured against the brighter of the two (--texel-filter-symmetric);
                          // y 1: each neighbour weighed by the surface it holds (--texel-filter-area)
} u;

layout(std430, set = 0, binding = 1) readonly buffer TexelHash { uint texelHash[]; };
layout(std430, set = 0, binding = 2) readonly buffer Texels { uvec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 3) readonly buffer TexelBlend { vec4 texelBlend[]; };
layout(std430, set = 0, binding = 4) buffer TexelFiltered { vec4 texelFiltered[]; };
// [parity] the counts (this frame's mark adds to set frame & 1; this pass zeroes the other), the list after them.
layout(std430, set = 0, binding = 5) buffer TexelFilterList { uint texelFilterList[]; };

// The atlas's map from texel to record, as an R32UI texture (SponzaLoop.LightmapGather.cs).
layout(std430, set = 0, binding = 6) readonly buffer LightmapIndex { uint lightmapIndex[]; };
#include "lightmap_index.glsl"
#define TEXEL_INDEX_MAP(i) lightmapIndexAt(ivec2(int(i) % int(lightmapIndex[0]), int(i) / int(lightmapIndex[0])))
#define TEXEL_HASH(i) uvec3(texelHash[3u * uint(i)], texelHash[3u * uint(i) + 1u], texelHash[3u * uint(i) + 2u])
#include "texel.glsl"
#include "texel_filter_neighbour.glsl"

shared vec4 sNeighbour[32];

void main() {
    uint group = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    uint parity = uint(u.uTexelParams.w) & 1u;
    uint capacity = uint(u.uTexelParams.y);
    if (group == 0u && lane == 0u) texelFilterList[parity ^ 1u] = 0u;
    if (group >= min(texelFilterList[parity], capacity)) return;
    int id = int(texelFilterList[2u + group]);
    vec4 own = texelBlend[id];
    if (own.w <= 0.0) return;
    vec3 position = TEXEL_POSITION(id).xyz;
    vec3 n = TEXEL_NORMAL(id).xyz;
    const vec3 luma = vec3(0.2126, 0.7152, 0.0722);
    float centre = dot(own.rgb, luma);
    sNeighbour[lane] = vec4(0.0);
    if (lane < 27u) {
        TexelGrid finestGrid;
        finestGrid.minCorner = u.uTexelGrid.xyz;
        finestGrid.spacing = u.uTexelGrid.w;
        finestGrid.capacity = uint(u.uTexelParams.x);
        finestGrid.level = 0u;
        TexelGrid tg;
        int other = texelFilterNeighbour(id, lane, position, n, finestGrid, u.uLightmap, tg);
        if (other >= 0) {
            vec4 light = texelBlend[other];
            if (light.w > 0.0) {
                float w = texelFilterWeight(other, position, n, tg, centre, dot(light.rgb, luma), u.uEdge) * min(light.w / u.uTexelParams.z, 1.0);
                sNeighbour[lane] = vec4(w * light.rgb, w);
            }
        }
    }
    barrier();
    if (lane != 0u) return;
    vec4 acc = vec4(0.0);
    for (int k = 0; k < 27; ++k) acc += sNeighbour[k];
    texelFiltered[id] = acc.w > 1e-6 ? vec4(acc.rgb / acc.w, 1.0) : own;
}
