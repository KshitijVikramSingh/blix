#version 450
// The transport census (plan.md N2; SponzaLoop.TransportCensus.cs), a slice's last step: each texel's 256 light-free
// relationships (texel_nodes_shade.glsl, NodeTransport) sorted, and what storing them would take counted -- the
// distinct entries of each kind (the sky's bins, near texels on its own object, near texels on another object, far
// patches), the distinct patches its near hits lie on, and the near entries left when only the K heaviest near texels
// are kept and the rest merge into their patches (K = 8, 16, 32). A workgroup a texel, a thread a record.

#define RECORDS 256
layout(local_size_x = RECORDS) in;

layout(set = 0, binding = 0) uniform TransportCensus {
    vec4 uCensus;   // x the slice's texels, y the records a texel (passes x 32)
} u;

layout(std430, set = 0, binding = 1) readonly buffer NodeTransport { uvec2 nodeTransport[]; };
// [0..4 x 257]: texels by distinct count (kinds 0-3, then near patches), capped at 256; [1285..1287] the near entries
// summed at K = 8 / 16 / 32; [1288] texels counted.
layout(std430, set = 0, binding = 2) buffer TransportStats { uint stats[]; };

shared uint sKey[RECORDS];
shared uint sCount[5];

void sortShared(uint lid) {
    for (uint k = 2u; k <= uint(RECORDS); k <<= 1u)
        for (uint j = k >> 1u; j > 0u; j >>= 1u) {
            uint other = lid ^ j;
            if (other > lid) {
                bool up = (lid & k) == 0u;
                uint a = sKey[lid], b = sKey[other];
                if ((a > b) == up) { sKey[lid] = b; sKey[other] = a; }
            }
            barrier();
        }
}

void main() {
    uint t = gl_WorkGroupID.x;
    if (t >= uint(u.uCensus.x)) return;
    uint lid = gl_LocalInvocationID.x;
    uint records = uint(u.uCensus.y);
    if (lid < 5u) sCount[lid] = 0u;
    uvec2 r = lid < records ? nodeTransport[t * uint(RECORDS) + lid] : uvec2(0xFFFFFFFFu);
    sKey[lid] = r.x;
    barrier();
    sortShared(lid);
    // Distinct relationships of each kind: the first of each run.
    uint key = sKey[lid];
    bool first = key != 0xFFFFFFFFu && (lid == 0u || sKey[lid - 1u] != key);
    if (first) atomicAdd(sCount[key >> 30], 1u);
    barrier();
    // Distinct near patches: the near records' patches sorted.
    uint nearKind = r.x >> 30;
    sKey[lid] = lid < records && (nearKind == 1u || nearKind == 2u) ? r.y : 0xFFFFFFFFu;
    barrier();
    sortShared(lid);
    uint np = sKey[lid];
    if (np != 0xFFFFFFFFu && (lid == 0u || sKey[lid - 1u] != np)) atomicAdd(sCount[4], 1u);
    barrier();
    if (lid == 0u) {
        for (uint k = 0u; k < 5u; ++k) atomicAdd(stats[k * 257u + min(sCount[k], 256u)], 1u);
        uint nearTexels = sCount[1] + sCount[2], nearPatches = sCount[4];
        // Capped at K: the K heaviest near texels kept, the rest merged into their patches (at most the distinct near
        // patches, at most what is left).
        uint ks[3] = uint[3](8u, 16u, 32u);
        for (int c = 0; c < 3; ++c) {
            uint kept = min(nearTexels, ks[c]);
            uint merged = nearTexels > ks[c] ? min(nearPatches, nearTexels - ks[c]) : 0u;
            atomicAdd(stats[1285u + uint(c)], kept + merged);
        }
        atomicAdd(stats[1288], 1u);
    }
}
