#version 450
// --live-texels (SponzaLoop.LivePatchLight.cs): the texels' sun bits for the sun as it is, on the GPU in the frame --
// what SunNodeBitsFor shot through the host (16 M texels read back, packed on the CPU: 17 s for two suns, 1.5 s of it
// the GPU's). The rule is blix_lightlet_visible's: lit when the texel faces the sun and nothing is in the way of a ray
// from it, lifted along its normal, out to the scene's reach. A thread a live texel of the chunk --
// or, uRay.z 1, a sun point (the foliage's and discovery's, laid out as the texels are: position, normal), its index
// the chunk's first plus the thread: their bits went through the host too, ~1.9 M points in ~13 s of round trips
// behind the frames after each sun turn (2026-10-16).
//   mode 0  each texel's ray, for the frame's shadow batch: (point + n lift, reach); facing away, answered occluded (-1)
//   mode 1  the batch's answers into the bits: the sun's column's bit set where nothing met the ray, the rest cleared

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform LiveSun {
    vec4 uChunk;   // x the chunk's texels, y its first among the live, z the mode, w the bit words a texel
    vec4 uToSun;   // xyz toward the sun; w the sun's column (its bit)
    vec4 uRay;     // x the lift, y the reach, z 1: points (no ids); w the first lightmap record when a record's lift is
                   // half its room at most (TexelClear: texel_clear.comp), 0 none
} u;

layout(std430, set = 0, binding = 1) readonly buffer Texels { vec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 2) readonly buffer LiveIds { uint liveIds[]; };
layout(std430, set = 0, binding = 3) buffer LiveSunOrigins { vec4 origins[]; };
layout(std430, set = 0, binding = 4) readonly buffer LiveSunOccluded { uint occluded[]; };
layout(std430, set = 0, binding = 5) buffer SunNodeBits { uint sunBits[]; };
layout(std430, set = 0, binding = 6) readonly buffer TexelClear { float texelClear[]; };

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uChunk.x)) return;
    uint id = u.uRay.z > 0.5 ? uint(u.uChunk.y) + t : liveIds[uint(u.uChunk.y) + t];
    if (int(u.uChunk.z) == 0) {
        vec4 p = TEXEL_POSITION(id);
        vec3 n = TEXEL_NORMAL(id).xyz;
        bool facing = dot(n, n) > 1e-12 && dot(normalize(n), u.uToSun.xyz) > 0.0;
        // A record's lift half its room along its normal at most: lifted 1 cm, one inside a wall thinner than that shot its
        // sun from outside it -- the sheet shell at 4 mm lit inside (2026-10-24).
        float lift = u.uRay.w > 0.5 && u.uRay.z < 0.5 && float(id) >= u.uRay.w ? min(u.uRay.x, max(0.5 * texelClear[id], 2.5e-4)) : u.uRay.x;
        origins[t] = facing ? vec4(p.xyz + normalize(n) * lift, u.uRay.y) : vec4(p.xyz, -1.0);
        return;
    }
    uint words = uint(u.uChunk.w);
    uint bit = uint(u.uToSun.w);
    for (uint w = 0u; w < words; ++w) sunBits[id * words + w] = 0u;
    if ((occluded[t] & 1u) == 0u) sunBits[id * words + bit / 32u] = 1u << (bit % 32u);
}
