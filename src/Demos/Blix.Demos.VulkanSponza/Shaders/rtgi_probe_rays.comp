#version 450

// --rtgi-probe (S0 of the GI redesign, SponzaLoop.RtgiProbe): the screen gather's rays, to price them in the frame.
// One ray per tile of a grid sized so uProbe.x tiles cover the screen, from a pixel of its tile (a new one each
// frame), cosine-weighted over the pre-pass normal: two vec4s (origin and tMin, direction and tMax; tMax 0 where the
// pixel has no surface: no ray). The first uProbe.y of them also write a sun shadow origin (vec4: position, reach),
// standing in for the cache-update rays' direct sun.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiProbeRays {
    mat4 uInvViewProj;   // inverse of the view-projection the pre-pass drew with
    vec4 uSize;          // xy: full-res pixels; zw: tiles across and down
    vec4 uCamera;        // xyz: position
    vec4 uProbe;         // x: rays; y: shadow origins; z: the frame's number; w: how far a ray goes
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) writeonly buffer RtgiProbeRayBuffer { vec4 rays[]; };
layout(std430, set = 0, binding = 4) writeonly buffer RtgiProbeOrigins { vec4 origins[]; };

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u.uProbe.x)) return;
    bool shadow = i < uint(u.uProbe.y);
    uint tilesX = uint(u.uSize.z);
    ivec2 tile = ivec2(i % tilesX, i / tilesX);
    vec2 tileSize = u.uSize.xy / u.uSize.zw;
    uint h = hash(i * 0x9E3779B9u ^ hash(uint(u.uProbe.z)));
    vec2 jitter = vec2(h & 0xFFFFu, h >> 16) / 65536.0;
    ivec2 q = min(ivec2((vec2(tile) + jitter) * tileSize), ivec2(u.uSize.xy) - 1);
    float raw = texelFetch(uSceneDepth, q, 0).r;
    vec4 nSample = texelFetch(uPrepassNormal, q, 0);
    if (raw >= 1.0 - 1e-6 || dot(nSample.xyz, nSample.xyz) < 1e-6) {
        rays[2u * i] = vec4(0.0);
        rays[2u * i + 1u] = vec4(0.0, 1.0, 0.0, 0.0);
        if (shadow) origins[i] = vec4(0.0);
        return;
    }
    vec2 ndc = (vec2(q) + 0.5) / u.uSize.xy * 2.0 - 1.0;
    vec4 world = u.uInvViewProj * vec4(ndc, raw, 1.0);
    vec3 position = world.xyz / world.w;
    vec3 n = normalize(nSample.xyz);
    float lift = 0.01 + 0.001 * length(position - u.uCamera.xyz);
    vec3 o = position + n * lift;
    // Cosine-weighted about n.
    uint h2 = hash(h);
    float r1 = float(h2 & 0xFFFFu) / 65536.0, r2 = float(h2 >> 16) / 65536.0;
    float phi = 6.28318530718 * r1, s = sqrt(r2);
    vec3 t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
    vec3 b = cross(n, t);
    vec3 d = normalize(t * (cos(phi) * s) + b * (sin(phi) * s) + n * sqrt(max(0.0, 1.0 - r2)));
    rays[2u * i] = vec4(o, 0.0);
    rays[2u * i + 1u] = vec4(d, u.uProbe.w);
    if (shadow) origins[i] = vec4(o, u.uProbe.w);
}
