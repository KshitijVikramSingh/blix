#version 450

// What a ray meets at a triangle, baked once per material from its texture: the triangle's mean albedo and how much
// of it the material's alpha keeps. One dispatch per material, one thread per triangle row of it (BakeRows names
// them), writing that row's word in BlixRaySurfaces (ray_query.glsl): albedo sRGB-encoded in the low three bytes,
// coverage in the top one.
//
// Sixteen points spread evenly over the triangle by area (a 4x4 stratified grid through the square-root warp),
// each sampled at the mip whose texels are its share of the triangle's texture footprint, so the mean is the
// triangle's and not one texel's. Coverage is the share of those points whose alpha (times the factor's) passes the
// material's cutoff; a material without a cutoff is solid.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform Bake {
    vec4 uBaseColor;   // the material's base colour factor, linear rgb and alpha
    vec4 uParams;      // x first entry in BakeRows, y how many, z alpha cutoff (0: opaque)
} u;

layout(set = 0, binding = 1) uniform sampler2D uAlbedo;
layout(std430, set = 0, binding = 2) readonly buffer BlixRayTriangles { uvec4 triangles[]; };
layout(std430, set = 0, binding = 3) readonly buffer BlixRayUvs { vec2 uvs[]; };
layout(std430, set = 0, binding = 4) readonly buffer BakeRows { uint rows[]; };
layout(std430, set = 0, binding = 5) buffer BlixRaySurfaces { uint surfaces[]; };

vec3 encodeSrgb(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= uint(u.uParams.y)) return;
    uint row = rows[uint(u.uParams.x) + k];
    uvec4 tri = triangles[row];
    vec2 a = uvs[tri.x], b = uvs[tri.y], c = uvs[tri.z];

    vec2 size = vec2(textureSize(uAlbedo, 0));
    float texels = abs((b.x - a.x) * (c.y - a.y) - (c.x - a.x) * (b.y - a.y)) * 0.5 * size.x * size.y;
    float lod = 0.5 * log2(max(texels / 16.0, 1.0));

    vec3 sum = vec3(0.0);
    float kept = 0.0;
    for (int i = 0; i < 4; ++i)
    for (int j = 0; j < 4; ++j) {
        float r1 = (float(i) + 0.5) / 4.0;
        float r2 = (float(j) + 0.5) / 4.0;
        float s = sqrt(r1);
        vec2 uv = a * (1.0 - s) + b * (s * (1.0 - r2)) + c * (s * r2);
        vec4 texel = textureLod(uAlbedo, uv, lod);
        sum += texel.rgb;
        kept += (u.uParams.z <= 0.0 || texel.a * u.uBaseColor.a >= u.uParams.z) ? 1.0 : 0.0;
    }
    vec3 albedo = sum / 16.0 * u.uBaseColor.rgb;
    float coverage = u.uParams.z <= 0.0 ? 1.0 : kept / 16.0;
    surfaces[row] = packUnorm4x8(vec4(encodeSrgb(albedo), coverage));
}
