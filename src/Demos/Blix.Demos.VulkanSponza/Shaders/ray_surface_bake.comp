#version 450

// What a ray meets at a triangle, baked once per material from its texture: the triangle's mean albedo and how much
// of it the material's alpha keeps. One dispatch per material, one thread per triangle row of it (BakeRows names
// them), writing that row's word in BlixRaySurfaces (ray_query.glsl): albedo sRGB-encoded in the low three bytes,
// coverage (in sixteenths, bits 4..0) and the diffuse roughness level it was baked at (bits 7..5) in the top one.
//
// Sixteen points spread evenly over the triangle by area (a 4x4 stratified grid through the square-root warp),
// each sampled at the mip whose texels are its share of the triangle's texture footprint, so the mean is the
// triangle's and not one texel's. Coverage is the share of those points whose alpha (times the factor's) passes the
// material's cutoff; a material without a cutoff is solid. A clear one (KHR_materials_transmission: the glass panes)
// is not there at all: nothing models a ray refracting through it, and met as solid it sealed every glazed window, its
// inside lit as a dark box (the GI rendered it black) and nothing behind a pane lit through it.
//
// <b>The albedo stored is what a bounce keeps, not the base colour.</b> The diffuse lobe is EON (Blix.Shaders/diffuse_eon.glsl), whose albedo
// is below its base colour for a rough grey, and the transport (the patch solve, the gather's hits, the probes, the references) bounces light
// with whatever this word says. So with uDiffuse.x set the word holds EON's hemispherical albedo at the material's diffuse roughness (its
// roughness factor times the metallic-roughness texture's mean green over the same sixteen points, times uDiffuse.y), and every consumer
// conserves the energy the roughness loses. The surface the camera sees is shaded from the textures, never from this word.

#include "diffuse_eon.glsl"

// The eight diffuse roughness levels (ray_query.glsl's BLIX_SURFACE_ROUGHNESS; this shader does not include ray_query.glsl).
const float BLIX_SURFACE_ROUGHNESS[8] = float[8](0.0, 0.2, 0.4, 0.55, 0.7, 0.8, 0.9, 1.0);

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform Bake {
    vec4 uBaseColor;   // the material's base colour factor, linear rgb and alpha
    vec4 uParams;      // x first entry in BakeRows, y how many, z alpha cutoff (0: opaque), w 1: clear (coverage 0)
    vec4 uParams2;     // x 1: uTransmission is the material's factor texture; y 1: uTransmissionColor its colour texture; z the alpha atlas's mip of uAlbedo, w 1: authored BLEND (rays stop with the probability of the alpha: always asked at the hit)
    vec4 uDiffuse;     // x 1: store EON's hemispherical albedo (0: the base colour, Lambert); y the diffuse-roughness scale; z the material's roughness factor; w 1: uMetallicRoughness is its texture
} u;

layout(set = 0, binding = 1) uniform sampler2D uAlbedo;
layout(std430, set = 0, binding = 2) readonly buffer BlixRayTriangles { uvec4 triangles[]; };
layout(std430, set = 0, binding = 3) readonly buffer BlixRayUvs { vec2 uvs[]; };
layout(std430, set = 0, binding = 4) readonly buffer BakeRows { uint rows[]; };
layout(std430, set = 0, binding = 5) buffer BlixRaySurfaces { uint surfaces[]; };
// KHR_materials_diffuse_transmission's factor texture (uParams2.x 1: the material has one): the row's mean alpha over the
// same sixteen points, unorm8 (255: the factor whole; no texture writes 255). Scales the rows' T for the GI's sheets, the
// reference's and the shadows' (SponzaLoop.RayScene.cs, RowTransmissionShare).
layout(set = 0, binding = 6) uniform sampler2D uTransmission;
layout(std430, set = 0, binding = 7) buffer BlixRayTransmission { uint transmission[]; };
// And its colour texture (uParams2.y 1): the row's mean colour over the same points, sRGB-encoded in the word's upper
// three bytes (white: none) -- the light through is that colour, not the base colour (lit.frag, dtColor). Without it the
// ColorTexture panels of Khronos' DiffuseTransmissionTest passed white to the reference and the GI's sheets (2026-10-22).
layout(set = 0, binding = 8) uniform sampler2D uTransmissionColor;
// The material's metallic-roughness texture (uDiffuse.w 1: it has one; green is roughness, times the factor): the diffuse roughness the albedo is baked at.
layout(set = 0, binding = 9) uniform sampler2D uMetallicRoughness;

vec3 encodeSrgb(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= uint(u.uParams.y)) return;
    uint row = rows[uint(u.uParams.x) + k];
    uvec4 tri = triangles[row];
    vec2 a = uvs[tri.x], b = uvs[tri.y], c = uvs[tri.z];

    vec2 size = vec2(textureSize(uAlbedo, 0));
    float texels = abs((b.x - a.x) * (c.y - a.y) - (c.x - a.x) * (b.y - a.y)) * 0.5 * size.x * size.y;
    float lod = 0.5 * log2(max(texels / 16.0, 1.0));

    vec3 sum = vec3(0.0);
    float kept = 0.0, through = 0.0;
    vec3 colour = vec3(0.0);
    float rough = 0.0;
    for (int i = 0; i < 4; ++i)
    for (int j = 0; j < 4; ++j) {
        float r1 = (float(i) + 0.5) / 4.0;
        float r2 = (float(j) + 0.5) / 4.0;
        float s = sqrt(r1);
        vec2 uv = a * (1.0 - s) + b * (s * (1.0 - r2)) + c * (s * r2);
        vec4 texel = textureLod(uAlbedo, uv, lod);
        sum += texel.rgb;
        if (u.uParams2.x > 0.5) through += textureLod(uTransmission, uv, lod).a;
        if (u.uParams2.y > 0.5) colour += textureLod(uTransmissionColor, uv, lod).rgb;
        rough += u.uDiffuse.w > 0.5 ? textureLod(uMetallicRoughness, uv, lod).g : 1.0;
        kept += (u.uParams.z <= 0.0 || texel.a * u.uBaseColor.a >= u.uParams.z) ? 1.0 : 0.0;
    }
    vec3 albedo = sum / 16.0 * u.uBaseColor.rgb;
    // The roughness is quantised to the nearest of the eight levels (ray_query.glsl) and the albedo baked at THAT level, so the word's inverse
    // (diffuse_eon.glsl, blix_eonBaseFromHemispherical at the level the word names) recovers the material's albedo exactly. A Lambert bake is level 0.
    uint level = 0u;
    if (u.uDiffuse.x > 0.5) {
        float r = clamp(u.uDiffuse.z * rough / 16.0 * u.uDiffuse.y, 0.0, 1.0);
        for (uint i = 1u; i < 8u; ++i)
            if (abs(BLIX_SURFACE_ROUGHNESS[i] - r) < abs(BLIX_SURFACE_ROUGHNESS[level] - r)) level = i;
        albedo = blix_eonHemisphericalAlbedo(albedo, BLIX_SURFACE_ROUGHNESS[level]);
    }
    uint sixteenths = u.uParams.w > 0.5 ? 0u : u.uParams.z <= 0.0 ? 16u : uint(kept + 0.5);
    // A cut-out material's row is asked at the point hit (RayAlphaAtlas) wherever any sample is in doubt, so 0 and 16 mean none and all of 256
    // samples, read at the atlas's own resolution (uParams2.z, its mip): a big quad of a leaf card at the triangle's mip would read as one
    // blurred texel and be called cut out whole. A row with one texel's hole is partly covered (1..15), not solid.
    if (u.uParams.w < 0.5 && u.uParams.z > 0.0) {
        float fine = 0.0;
        for (int i = 0; i < 16; ++i)
        for (int j = 0; j < 16; ++j) {
            float s1 = sqrt((float(i) + 0.5) / 16.0);
            float r2 = (float(j) + 0.5) / 16.0;
            vec2 uv = a * (1.0 - s1) + b * (s1 * (1.0 - r2)) + c * (s1 * r2);
            fine += (textureLod(uAlbedo, uv, u.uParams2.z).a * u.uBaseColor.a >= u.uParams.z) ? 1.0 : 0.0;
        }
        sixteenths = fine < 0.5 ? 0u : fine > 255.5 ? 16u : uint(clamp(floor(fine / 16.0 + 0.5), 1.0, 15.0));
    }
    // Authored BLEND is never none or all: even a texel of alpha 0.9 stops one ray in ten, so the row is always asked at the hit (RayAlphaAtlas.FlagStochastic).
    if (u.uParams.w < 0.5 && u.uParams.z > 0.0 && u.uParams2.w > 0.5) sixteenths = 8u;
    surfaces[row] = (packUnorm4x8(vec4(encodeSrgb(albedo), 0.0)) & 0xFFFFFFu) | (((level << 5u) | sixteenths) << 24u);
    uint share = u.uParams2.x > 0.5 ? uint(round(clamp(through / 16.0, 0.0, 1.0) * 255.0)) : 255u;
    uint tint = u.uParams2.y > 0.5 ? packUnorm4x8(vec4(encodeSrgb(colour / 16.0), 0.0)) : 0xFFFFFFu;
    transmission[row] = share | (tint << 8);
}
