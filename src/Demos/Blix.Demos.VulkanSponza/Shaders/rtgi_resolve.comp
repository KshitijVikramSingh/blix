#version 450

// --rtgi (SponzaLoop.Rtgi.cs): each slot's frame of samples into what it holds -- a running mean whose history follows
// the light (S2). Two means per cell: the slow one shown, up to uResolve.x samples, so a still light settles (a fixed 64
// left it shimmering, 2026-10-26); and a fast one over uChange.y. When the fast mean strays from the slow by more than
// uResolve.w of the fast's standard errors (the variance from the cell's luminance moments) plus uChange.z of the light, the slow takes the
// fast's value and history -- a sun moved, a light switched, a bounce changed upstream. Judged frame by frame instead,
// a bright frame (a rare sunlit hit) cut the history and a dark one never could: the cache read 30% bright (2026-10-26).
// The disagreement must also last uChange.x frames running: at 3 standard errors and one frame, heavy-tailed light cut
// cells now and then, each snapping to a noisy 64-sample mean -- spots that bounced everywhere (the user, San Miguel);
// Crytek Sponza's flicker 4.5% (3, one frame), 3.1% (5), 1.7% (no cuts), 2026-10-26. A known change (the sun turned,
// uChange.w) cuts at once regardless; this is the net for the rest.
// Its history is also held to uAge.x of its age (the samples since it began, or was last cut; at least uAge.y): the first
// samples were taken while the cells their rays read were still wrong -- dark before the bounce built, bright from coarse
// fallbacks -- and kept in a mean of up to 16,384 they faded only as fast as new ones diluted them, thousands of frames
// (the thin wall's open room 4.5% dark at the gate's shot, 3.4% at 6,000 frames; Crytek Sponza 17% bright at 60).
// Held to half its age, a stale start fades as the square of its share instead; a settled cell still grows without end.
// Sun visibility likewise, its variance binomial. It visits the cells training listed this frame (rtgi_train.comp) -- not
// every slot (5.5 ms a frame at San Miguel's 8 M slots); emptying the ones no training reached is rtgi_evict.comp's.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiResolve {
    vec4 uResolve;   // x samples held at most, y frames a slot lives untrained, z slots, w standard errors that cut history
    vec4 uChange;    // x frames running a disagreement must last; y the fast mean's samples, z the share of the light a disagreement must pass besides the standard errors,
                     // w the samples a sun turn leaves a cell's light history (its sun visibility's: 4)
    vec4 uAge;       // x the share of its age a cell's light history holds at most (0: no limit); y that limit at least
    vec4 uList;      // x the sun's epoch (counts its turns); y the dirty list's room
} u;

layout(std430, set = 0, binding = 1) buffer RtgiKeys { uint rtgiKeys[]; };
// A slot's frame of samples: 16 words, four uvec4s (rtgi_cache.glsl's RTGI_ACC; the words as there).
layout(std430, set = 0, binding = 2) buffer RtgiAccum { uvec4 rtgiAccum4[]; };
layout(std430, set = 0, binding = 3) buffer RtgiResolved { vec4 rtgiResolved[]; };
// Three per slot: (the samples' luminance mean and mean square over the fast window, frames running the fast mean has
// disagreed, history cuts);
// (the fast mean: indirect rgb, sky visibility); (the fast sun visibility, its samples, the fast light's samples, -).
layout(std430, set = 0, binding = 4) buffer RtgiMoments { vec4 rtgiMoments[]; };
// Per slot: the irradiance vector's running mean (xyz; luminance along where the light comes from) and its near visibility
// (w), by the light's weights.
layout(std430, set = 0, binding = 8) buffer RtgiDirection { vec4 rtgiDirection[]; };
// Per slot: the running mean of its rays' inverse hit distances (rtgi_filter.comp's geometric prior).
layout(std430, set = 0, binding = 9) buffer RtgiHitInv { float rtgiHitInv[]; };
layout(std430, set = 0, binding = 5) buffer RtgiStamps { uvec2 rtgiStamps[]; };
layout(std430, set = 0, binding = 6) readonly buffer RtgiDirty { uint dirtyCount; uint dirtyPad[3]; uint dirty[]; };
// The other parity's list: its count zeroed here for the next frame's training.
layout(std430, set = 0, binding = 7) buffer RtgiNextDirty { uint nextDirtyCount; uint nextDirtyPad[3]; uint nextDirty[]; };

#define RTGI_SCALE 4096.0
#define RTGI_LUM2_SCALE 4096.0

float lum(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i == 0u) nextDirtyCount = 0u;
    if (i >= min(dirtyCount, uint(u.uList.y))) return;
    uint s = dirty[i];
    if (rtgiKeys[s] == 0u) return;
    uvec4 a0 = rtgiAccum4[4u * s], a1 = rtgiAccum4[4u * s + 1u], a2 = rtgiAccum4[4u * s + 2u], a3 = rtgiAccum4[4u * s + 3u];
    uint count = a0.w, sunTraced = a1.z;
    vec4 r0 = rtgiResolved[2u * s], r1 = rtgiResolved[2u * s + 1u];
    // The sun turned since this cell last saw it: what it holds of it is stale, whether or not its samples have shown it
    // yet -- a known change, not one to wait for the fast mean to find (at 64 samples, ~10 s to settle a 20 degree change,
    // 2026-10-26). Taken when it is next trained (its epoch behind the sun's), not swept over every slot.
    if (rtgiStamps[s].y != uint(u.uList.x)) {
        r1.y = min(r1.y, u.uChange.w);
        r1.z = min(r1.z, r1.y);
        r1.w = min(r1.w, 4.0);
        rtgiStamps[s].y = uint(u.uList.x);
    }
    vec4 m = rtgiMoments[3u * s], fast = rtgiMoments[3u * s + 1u], fs = rtgiMoments[3u * s + 2u];
    if (count > 0u) {
        float n = float(count);
        vec3 mean = vec3(a0.xyz) / (RTGI_SCALE * n);
        float meanSq = float(a1.w) / (RTGI_LUM2_SCALE * n);
        float sky = float(a1.x) / n;
        vec3 frameB = vec3(ivec3(a2.xyz)) / (RTGI_SCALE * n);
        vec4 dir = rtgiDirection[s];
        // Its near visibility (w): the share of its rays past the contact radius, weighted (rtgi_train.comp).
        float frameNear = float(a2.w) / (256.0 * n);
        // The far light's share of the frame's light (luminance), into the fast state's w.
        float frameFar = lum(mean) > 1e-7 ? clamp(float(a3.x) / (RTGI_SCALE * n) / lum(mean), 0.0, 1.0) : 1.0;
        // The fast mean and the moments over its window.
        fs.z = min(fs.z + n, u.uChange.y);
        float wf = min(1.0, n / max(fs.z, 1.0));
        fast = vec4(mix(fast.rgb, mean, wf), mix(fast.a, sky, wf));
        m.x = mix(m.x, lum(mean), wf);
        m.y = mix(m.y, meanSq, wf);
        // The slow mean, or the fast one when they disagree; its history at most uAge.x of its age (r1.z, in samples).
        float age = r1.z + n;
        float held = min(r1.y + n, u.uResolve.x);
        if (u.uAge.x > 0.0) held = min(held, max(u.uAge.x * age, u.uAge.y));
        float variance = max(m.y - m.x * m.x, 0.0);
        float bound = u.uResolve.w * sqrt(variance / max(fs.z, 1.0)) + u.uChange.z * max(lum(r0.rgb), lum(fast.rgb));
        bool disagree = r1.y > 0.5 && fs.z >= u.uChange.y && abs(lum(fast.rgb) - lum(r0.rgb)) > bound;
        m.z = disagree ? m.z + 1.0 : 0.0;
        if (m.z >= u.uChange.x) {
            r0 = fast;
            held = fs.z;
            age = fs.z;
            m.w += 1.0;
            m.z = 0.0;
            dir = vec4(frameB, frameNear);
            rtgiHitInv[s] = float(a3.y) / (256.0 * n);
            fs.w = frameFar;
        } else {
            // At most 1: a cell given more samples in a frame than it holds (the coarse fallback's, hundreds) took a weight
            // past 1 and the mean extrapolated, grew each frame and overflowed to NaN (2026-10-25).
            float w = min(1.0, n / max(held, 1.0));
            r0 = vec4(mix(r0.rgb, mean, w), mix(r0.a, sky, w));
            dir = vec4(mix(dir.xyz, frameB, w), mix(dir.w, frameNear, w));
            fs.w = mix(fs.w, frameFar, w);
            rtgiHitInv[s] = mix(rtgiHitInv[s], float(a3.y) / (256.0 * n), w);
        }
        rtgiDirection[s] = dir;
        r1.y = held;
        r1.z = age;
    }
    if (sunTraced > 0u) {
        float n = float(sunTraced);
        float lit = float(a1.y) / n;
        fs.y = min(fs.y + n, u.uChange.y);
        fs.x = mix(fs.x, lit, min(1.0, n / max(fs.y, 1.0)));
        float held = min(r1.w + n, u.uResolve.x);
        float p = clamp(fs.x, 0.0, 1.0);
        float bound = u.uResolve.w * sqrt(max(p * (1.0 - p), 0.02) / max(fs.y, 1.0)) + 0.05;
        if (r1.w > 0.5 && fs.y >= u.uChange.y && abs(fs.x - r1.x) > bound) {
            r1.x = fs.x;
            held = fs.y;
        } else r1.x = mix(r1.x, lit, min(1.0, n / max(held, 1.0)));
        r1.w = held;
    }
    rtgiResolved[2u * s] = r0;
    rtgiResolved[2u * s + 1u] = r1;
    rtgiMoments[3u * s] = m;
    rtgiMoments[3u * s + 1u] = fast;
    rtgiMoments[3u * s + 2u] = fs;
    for (uint k = 0u; k < 4u; k++) rtgiAccum4[4u * s + k] = uvec4(0u);
}
