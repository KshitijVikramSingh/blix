#version 450

// --rtgi-screen (S3, visibility-tested reuse, SponzaLoop.Rtgi.cs): each tile's reservoir (rtgi_reservoir.comp, this
// frame's) takes one neighbouring tile's sample as a proposal -- a tile within uSpatial.x, its origin on this tile's
// surface -- and casts a shadow ray from its own origin to the proposal's sample point (or along it, a sky sample's). The
// next frame's reservoir pass merges the proposal only where the ray arrived. Reuse unseen was S3's bias: a pixel took a
// neighbour's sample it could not see, leaking at creases (the gate's seams 0.191, leak 0.030, 2026-10-26).
//
// A proposal, three vec4s: (sample point, its normal packed), (light rgb, albedo packed), (W, count, 1 when valid, -).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiSpatial {
    vec4 uGrid;      // xy tiles across and down; z tiles; w the frame
    vec4 uSpatial;   // x the radius in tiles; y how far a sky sample's ray goes; z the count a proposal brings at most
    vec4 uCamera;    // xyz position
} u;

layout(std430, set = 0, binding = 1) readonly buffer RtgiReservoirs { vec4 res[]; };
layout(std430, set = 0, binding = 2) writeonly buffer RtgiProposals { vec4 proposals[]; };
layout(std430, set = 0, binding = 3) writeonly buffer RtgiSpatialOrigins { vec4 origins[]; };
layout(std430, set = 0, binding = 4) writeonly buffer RtgiSpatialDirs { vec4 dirs[]; };

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

vec2 octWrap(vec2 v) { return (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0); }
vec3 unpackNormal(float f) {
    vec2 e = unpackSnorm2x16(floatBitsToUint(f));
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) n.xy = octWrap(n.xy);
    return normalize(n);
}

void none(uint t) {
    proposals[3u * t + 2u] = vec4(0.0);
    origins[t] = vec4(0.0);
    dirs[t] = vec4(0.0, 1.0, 0.0, 0.0);
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uGrid.z)) return;
    vec4 r0 = res[4u * t], r3 = res[4u * t + 3u];
    if (r3.w < 0.5) { none(t); return; }
    vec3 x = r0.xyz, n = unpackNormal(r0.w);
    int radius = int(u.uSpatial.x);
    uint h = hash(t * 0x9E3779B9u ^ hash(uint(u.uGrid.w)));
    ivec2 tile = ivec2(t % uint(u.uGrid.x), t / uint(u.uGrid.x));
    ivec2 o = ivec2(int(h % uint(2 * radius + 1)) - radius, int((h >> 16) % uint(2 * radius + 1)) - radius);
    if (o == ivec2(0)) o = ivec2(1, 0);
    ivec2 nt = tile + o;
    if (any(lessThan(nt, ivec2(0))) || any(greaterThanEqual(nt, ivec2(u.uGrid.xy)))) { none(t); return; }
    uint ut = uint(nt.y) * uint(u.uGrid.x) + uint(nt.x);
    vec4 q0 = res[4u * ut], q1 = res[4u * ut + 1u], q2 = res[4u * ut + 2u], q3 = res[4u * ut + 3u];
    float tol = 0.05 + 0.01 * length(x - u.uCamera.xyz);
    if (q3.w < 0.5 || q3.z <= 0.0 || abs(dot(q0.xyz - x, n)) > tol || dot(unpackNormal(q0.w), n) < 0.9) { none(t); return; }
    bool sky = unpackUnorm4x8(floatBitsToUint(q2.w)).a > 0.5;
    vec3 toSample = sky ? normalize(q1.xyz - q0.xyz) : q1.xyz - x;
    float dist = sky ? u.uSpatial.y : length(toSample);
    vec3 d = sky ? toSample : toSample / max(dist, 1e-6);
    if (dot(d, n) <= 0.0) { none(t); return; }
    proposals[3u * t] = q1;
    proposals[3u * t + 1u] = q2;
    proposals[3u * t + 2u] = vec4(q3.z, min(q3.y, u.uSpatial.z), 1.0, 0.0);
    float lift = 0.01 + 0.001 * length(x - u.uCamera.xyz);
    origins[t] = vec4(x + n * lift, sky ? dist : max(dist * 0.98 - lift, 0.0));
    dirs[t] = vec4(d, 0.0);
}
