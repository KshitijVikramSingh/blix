#version 450
#extension GL_KHR_shader_subgroup_ballot : require

// --rtgi (SponzaLoop.Rtgi.cs): each cell trained this frame (the dirty list) blended with its neighbours in its plane --
// the same level and side, offset along the surface only (never along its normal: a parallel surface a cell away is
// another surface) -- into what the readout and the lookups read. A cell's light is a mean of few samples where little
// training reaches (the shadowed, the bounce-lit): neighbours that hold more lend it theirs, mud that settled nowhere
// (the user, San Miguel, 2026-10-26). NRD's rules for the weights:
//   - by what each holds (its samples, to 64);
//   - the blend narrowing as the cell itself gathers: its neighbours' share falls from 1 at uFilter.x samples to 0 at
//     uFilter.y;
//   - stopped by luminance: a neighbour further from the cell than the two's spreads allow (uFilter.z standard deviations
//     of their means' difference, plus 10% of the brighter) weighs little -- a shadow's edge between cells stays. Judged
//     by the pair, both ways alike: judged by the cell's own spread, a bright cell (wide) took its dark neighbours and a
//     dark one (narrow) refused its bright ones, light only ever flowing down, compounding along the bounce -- the gate's
//     dead end 0.89 against 1.00 without the blend (2026-10-26).
// Then leaned on its parent (the cell a level up holding it: twice its size, several times its samples, smoother): the
// blend weighted by the samples it stands for, the parent by uParent.x -- a cell of few samples shows mostly its parent,
// one of thousands its own. Cascaded (uFilter2.x): the parent's own blend, as last frame left it -- itself leaned on its
// parent's, and so up every level trained (the user, 2026-10-26); raw, one round. The 3 x 3 blend alone left blotches the size of a patch of cells all short of samples
// together (San Miguel, 2026-10-26).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiFilter {
    vec4 uParams;   // rtgiParams (rtgi_cache.glsl)
    vec4 uFilter;   // x samples at which the neighbours' share starts to fall; y at which it is gone; z luminance sigmas;
                    // w the dirty list's room
    vec4 uParent;   // x the samples the parent stands for (0: no parent); y the top level; z the neighbours' share at least;
                    // w 1: the blend is what is shown (--rtgi-denoise), else the cell's own light (the blend only judging)
    vec4 uFilter2;  // x 1: the parent's blend (the cascade), else its raw light; y the standard errors within which the
                    // cell agrees with its parent (0: the parent weighs uParent.x alone); z the share of the light they may
                    // differ by besides; w the samples the parent may weigh at most
    vec4 uParent2;  // x 1: the parent's light read interpolated at the cell's centre (bilinear over the parent level's cells
                    // in the side's plane), else the cell holding it; y 1: the parent weighed by what its blend stands for
                    // (its own and what it leaned on, the chain), else by its own samples; z 1: weighed as the better of two
                    // estimates (shrinkage), else by the agreement test (uFilter2.y, z); w 1: the shrinkage's cell error
                    // from the spread pooled over its neighbours, else its own
    vec4 uHit;      // x the share of the light its parent may differ from the cell by, per parent size over the mean hit
                    // distance (the geometric prior on the shrinkage's bias; 0: none)
    vec4 uInterp;   // x the samples from which the parent is read interpolated (uParent2.x), below it the one holding it
    vec4 uRota;     // x the samples from which a cell is settled; y a settled cell blended one frame in this many (its turn by
                    // its slot), 1: every frame; z a young cell's (1: every frame)
    vec4 uDone;     // x the frame's number; y frames between drift checks; z the relative error under which a cell is
                    // done; w the dark floor (absolute luminance the error is measured against at least)
    vec4 uReach;    // --rtgi-volume's traced reach (cellReach): x 1 on; y the samples under which the blend widens to 5 x 5;
                    // z the outer ring's weight
} u;

layout(std430, set = 0, binding = 1) readonly buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 2) readonly buffer RtgiResolved { vec4 rtgiResolved[]; };
layout(std430, set = 0, binding = 3) readonly buffer RtgiMoments { vec4 rtgiMoments[]; };
layout(std430, set = 0, binding = 4) readonly buffer RtgiCells { ivec4 rtgiCells[]; };
layout(std430, set = 0, binding = 5) readonly buffer RtgiDirty { uint dirtyCount; uint dirtyPad[3]; uint dirty[]; };
layout(std430, set = 0, binding = 6) buffer RtgiFiltered { vec4 rtgiFiltered[]; };
// Per slot, whether it is done (SponzaLoop.Rtgi.cs): x the shown light's relative standard error, y its luminance at the
// last drift check, z that check's frame, w 1 when done.
layout(std430, set = 0, binding = 7) buffer RtgiConfidence { vec4 rtgiConfidence[]; };
// Per slot: the samples its shown light stands for -- its own, its neighbours' share and its parent's (written here, read
// as a parent's by the cells below).
layout(std430, set = 0, binding = 8) buffer RtgiStands { float rtgiStands[]; };
layout(std430, set = 0, binding = 9) readonly buffer RtgiHitInv { float rtgiHitInv[]; };
// The readout's record (rtgi_cache.glsl): this pass's words, the light shown and how sure it is.
layout(std430, set = 0, binding = 10) buffer RtgiRecord { uvec4 rtgiRecord[]; };

// The cache's work, counted for the profile (SponzaLoop.Rtgi.cs's RtgiWork): one atomic a subgroup, never a lane.
layout(std430, set = 0, binding = 11) buffer RtgiStats { uint rtgiStats[64]; };
// Per slot, its point's traced reach along its surface (rtgi_volume_vis.comp: the key it was traced for, bits 16-27 the
// neighbours a ray reached at one, two and four cells' length).
layout(std430, set = 0, binding = 12) readonly buffer RtgiVolumeCellVis { uvec2 cellVis[]; };

// Whether the cell may take the neighbour (a, b) cells away along its plane's two axes (the filter's ua, va): a ray from
// its point reached that way, that far (rtgi_volume_vis.comp; a diagonal both ways) -- so the blend stops at a corner, a
// junction, the ceiling a wall meets (the leaks the readout's neighbour test stopped, 2026-10-29). Not traced yet, or the
// reach off: as before, every neighbour.
uint reachWord = 0u;
bool reachKnown = false;
bool reachable(uint axis, int a, int b) {
    if (!reachKnown) return true;
    // The vis rays' axes: a0 = axis + 1, a1 = axis + 2 (mod 3); the filter's ua is y for the x side, else x; va z, but y
    // for the z side.
    uint uaAxis = axis == 0u ? 1u : 0u, vaAxis = axis == 2u ? 1u : 2u;
    uint a0 = (axis + 1u) % 3u;
    int steps[2] = int[2](a, b);
    uint axes[2] = uint[2](uaAxis, vaAxis);
    for (int k = 0; k < 2; k++) {
        int st = steps[k];
        if (st == 0) continue;
        uint base = 16u + (abs(st) >= 2 ? 4u : 0u) + (axes[k] == a0 ? 0u : 2u) + (st > 0 ? 0u : 1u);
        if ((reachWord & (1u << base)) == 0u) return false;
    }
    return true;
}
void tally(uint slot, bool v) {
    uint n = subgroupBallotBitCount(subgroupBallot(v));
    if (subgroupElect() && n > 0u) atomicAdd(rtgiStats[slot], n);
}


#define RTGI_KEYS(i) rtgiKeys[i]
#include "rtgi_cache.glsl"

float lum(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= min(dirtyCount, uint(u.uFilter.w))) return;
    uint s = dirty[i];
    if (rtgiKeys[s] == 0u) return;
    vec4 r0 = rtgiResolved[2u * s];
    float held = rtgiResolved[2u * s + 1u].y;
    tally(18u, true);
    bool skip = (u.uRota.y > 1.5 && held >= u.uRota.x && (s + uint(u.uDone.x)) % uint(u.uRota.y) != 0u)
             || (u.uRota.z > 1.5 && held >= 8.0 && held < u.uRota.x && (s + uint(u.uDone.x)) % uint(u.uRota.z) != 0u);
    tally(19u, skip);
    tally(20u, !skip);
    // A settled cell moves by a few hundredths of its noise a frame: blended on its turn (uRota), its light shown a few
    // frames behind -- the blend 8.5 ms a frame at 4x the rays, every cell trained blended every frame (Crytek Sponza,
    // 2026-10-26; 2.9 ms one frame in 4, Cornell's noise left and Crytek's error alike). A cell cut (its history reset to the fast window's samples) is young again, blended every frame.
    // A young cell blended one frame in uRota.z (its turn by its slot): the young are most of the cells trained while the
    // cache fills, each blend ~13 hash lookups -- the blend 11-15 ms a frame through Crytek Sponza's first 15 s at 4x the
    // rays (2026-10-26).
    if (u.uRota.y > 1.5 && held >= u.uRota.x && (s + uint(u.uDone.x)) % uint(u.uRota.y) != 0u) return;
    // Under 8 samples every frame: a slot's blend is what its last occupant left until it is blended (eviction clears it not).
    if (u.uRota.z > 1.5 && held >= 8.0 && held < u.uRota.x && (s + uint(u.uDone.x)) % uint(u.uRota.z) != 0u) return;
    ivec4 cell = rtgiCells[s];
    uint level = (uint(cell.w) & 0xFFu) / 6u, side = (uint(cell.w) & 0xFFu) % 6u;
    // Its neighbours and parents found in its own region (rtgi_cache.glsl's rtgiRegion): never across a thin wall.
    rtgiRegion = uint(cell.w) >> 8;
    // The cell's own spread: its samples' variance (the moments, over the fast window) over what it holds.
    vec4 m = rtgiMoments[3u * s];
    float sigma = sqrt(max(m.y - m.x * m.x, 0.0) / max(held, 1.0));
    float l0 = lum(r0.rgb);
    // At least uParent.z however many it holds: cells each converged on their own read a few percent apart, cloudy
    // blotches on a smooth wall (Cornell, the user, 2026-10-26); the luminance stop keeps real edges.
    float share = max(1.0 - clamp((held - u.uFilter.x) / max(u.uFilter.y - u.uFilter.x, 1.0), 0.0, 1.0), u.uParent.z);
    // The cell itself weighs as its samples up to 64, its neighbours likewise (a cell of thousands no longer drowns them).
    float wSelf = min(held, 64.0);
    vec4 sum = r0 * wSelf;
    float wSum = wSelf;
    // The pooled spread (when is it done): the samples' variance over the cell and its neighbours alike in light, by the
    // same stop, each by its samples to 64 -- nine cells' samples, so a rare bright one is seldom missing from them all.
    float varSelf = max(m.y - m.x * m.x, 0.0);
    float poolVar = varSelf * wSelf, poolW = wSelf;
    {
        if (u.uReach.x > 0.5) {
            uvec2 v = cellVis[s];
            reachKnown = v.x == rtgiKeys[s] && (v.y & 0x1000u) != 0u;
            reachWord = v.y;
        }
        // Few samples (uReach.y): the next ring too, 5 x 5 -- the far ends of a crevice, a patch of cells all short of
        // samples together, blotched where a 3 x 3 drew only on each other (the user, 2026-10-29). Only where traced.
        int r = reachKnown && held < u.uReach.y ? 2 : 1;
        // The two axes in the side's plane.
        uint axis = side / 2u;
        ivec3 ua = axis == 0u ? ivec3(0, 1, 0) : ivec3(1, 0, 0);
        ivec3 va = axis == 2u ? ivec3(0, 1, 0) : ivec3(0, 0, 1);
        for (int a = -r; a <= r; a++) {
            for (int b = -r; b <= r; b++) {
                if (a == 0 && b == 0) continue;
                if (!reachable(axis, a, b)) continue;
                uint t = rtgiFind(rtgiCellHash(cell.xyz + ua * a + va * b, level, side, u.uParams), u.uParams);
                if (t == 0xFFFFFFFFu) continue;
                vec4 r1 = rtgiResolved[2u * t + 1u];
                if (r1.y < 0.5) continue;
                vec4 rn = rtgiResolved[2u * t];
                vec4 mn = rtgiMoments[3u * t];
                float ln = lum(rn.rgb);
                float sigmaN2 = max(mn.y - mn.x * mn.x, 0.0) / max(r1.y, 1.0);
                float d = (ln - l0) / (u.uFilter.z * sqrt(sigma * sigma + sigmaN2) + 0.1 * max(l0, ln) + 1e-5);
                float pw = min(r1.y, 64.0) * ((a == 0 || b == 0) ? 1.0 : 0.7) * (max(abs(a), abs(b)) == 2 ? u.uReach.z : 1.0) * exp(-0.5 * d * d);
                poolVar += max(mn.y - mn.x * mn.x, 0.0) * pw;
                poolW += pw;
                float w = share * pw;
                sum += rn * w;
                wSum += w;
            }
        }
    }
    vec4 blended = wSum > 0.0 ? sum / wSum : r0;
    // The samples the blend stands for: the cell's own, all of them, and its neighbours' share.
    float stands = held + (wSum - wSelf);
    float standsAll = stands;
    if (u.uParent.x > 0.0 && level < uint(u.uParent.y)) {
        uint t = rtgiFind(rtgiCellHash(cell.xyz >> 1, level + 1u, side, u.uParams), u.uParams);
        if (t != 0xFFFFFFFFu && rtgiResolved[2u * t + 1u].y >= 0.5) {
            vec4 parent = u.uFilter2.x > 0.5 ? rtgiFiltered[t] : rtgiResolved[2u * t];
            float heldP = rtgiResolved[2u * t + 1u].y;
            float standsP = u.uParent2.y > 0.5 ? max(rtgiStands[t], heldP) : heldP;
            // The parent level's light at the cell's centre: bilinear over its cells in the side's plane (the cell's
            // centre sits a quarter or three quarters across its parent), each by what it holds. The containing parent's
            // flat mean differs from a fine cell's by the light's gradient across it -- a gently lit wall disagreed, and
            // fell back on the cell's own noise, once the cell held enough to tell (the user: the noise is on the flat).
            // From uInterp.x samples: a cell younger leans on its parent almost wholly, the containing one will do --
            // four lookups less, for most of the cells trained while the cache fills.
            if (u.uParent2.x > 0.5 && held >= u.uInterp.x) {
                uint axis = side / 2u;
                ivec3 ua = axis == 0u ? ivec3(0, 1, 0) : ivec3(1, 0, 0);
                ivec3 va = axis == 2u ? ivec3(0, 1, 0) : ivec3(0, 0, 1);
                int cu = axis == 0u ? cell.y : cell.x, cv = axis == 2u ? cell.y : cell.z;
                // In the parent's cells: the centre (c + 0.5) / 2 - 0.5 = c / 2 - 0.25.
                float fu = float(cu) * 0.5 - 0.25, fv = float(cv) * 0.5 - 0.25;
                int pu = int(floor(fu)), pv = int(floor(fv));
                float tu = fu - float(pu), tv = fv - float(pv);
                ivec3 base = (cell.xyz >> 1) - ua * (cu >> 1) - va * (cv >> 1);
                vec4 sum4 = vec4(0.0);
                float wSum4 = 0.0, standsSum4 = 0.0;
                for (int k = 0; k < 4; k++) {
                    int du = k & 1, dv = k >> 1;
                    uint q = rtgiFind(rtgiCellHash(base + ua * (pu + du) + va * (pv + dv), level + 1u, side, u.uParams), u.uParams);
                    if (q == 0xFFFFFFFFu) continue;
                    float hq = rtgiResolved[2u * q + 1u].y;
                    if (hq < 0.5) continue;
                    float wq = (du == 1 ? tu : 1.0 - tu) * (dv == 1 ? tv : 1.0 - tv) * clamp(hq / 32.0, 1.0 / 32.0, 1.0);
                    sum4 += (u.uFilter2.x > 0.5 ? rtgiFiltered[q] : rtgiResolved[2u * q]) * wq;
                    standsSum4 += (u.uParent2.y > 0.5 ? max(rtgiStands[q], hq) : hq) * wq;
                    wSum4 += wq;
                }
                if (wSum4 > 0.0) { parent = sum4 / wSum4; standsP = standsSum4 / wSum4; }
            }
            // Cell size by how smooth the light is: where the cell agrees with its parent within their standard errors
            // (and uFilter2.z of the light), the parent weighs all it stands for (to uFilter2.w) -- the coarse cells'
            // convergence wherever the light is smooth, the fine cell's where it differs (a crease, a shadow's edge). Few
            // samples, wide errors: the parent; detail shows as the cell gathers enough to tell. 10 cm cells everywhere
            // converged as 4x the rays but read creases 3% bright and Crytek Sponza's settled error 0.111 for 0.090.
            // Weighed by what the parent's blend stands for (uParent2.y), the lean compounds up the levels: on a flat
            // wall each level up holds ~4x the samples.
            float wp = u.uParent.x;
            if (u.uFilter2.y > 0.0) {
                vec4 mp = rtgiMoments[3u * t];
                float seP2 = max(mp.y - mp.x * mp.x, 0.0) / max(standsP, 1.0);
                float seB2 = sigma * sigma * held / max(stands, 1.0);
                float lb = lum(blended.rgb), lp = lum(parent.rgb);
                if (u.uParent2.z > 0.5) {
                    // Shrinkage: the cell (unbiased, its error seB2) and the parent (smooth, its error seP2, biased by
                    // how the light differs across it) weighed for the least squared error -- the parent against the
                    // cell as seB2 over (its bias squared + seP2), its bias squared the difference squared less both
                    // errors. A difference all noise: the parent weighs all it stands for. Where the light really
                    // differs, it fades as the cell converges. The agreement test passed anything within 2% of the
                    // light; with the chain's thousands of samples behind it the creases read 4% bright and Cornell's
                    // error stalled at 0.018 (noise left 0.14%) by 6,000 frames (2026-10-26).
                    // The cell's error from the spread pooled over it and its neighbours alike in light (the done test's):
                    // a bounce-lit cell's light is a few bright paths, its own spread as noisy as its mean -- neighbours
                    // guessed their borrowing far apart, blotches under Cornell's roof (the user, 2026-10-26).
                    float seB2p = (u.uParent2.w > 0.5 ? poolVar / max(poolW, 1e-6) : sigma * sigma * held) / max(stands, 1.0);
                    float bias2 = max((lb - lp) * (lb - lp) - seB2p - seP2, 0.0);
                    // The geometric prior (uHit.x): light changes over the distance to what is around it -- across a
                    // parent cell of size S, by ~S / d of itself, d the rays' harmonic mean hit distance. Open flat
                    // light (long hits) borrows freely; a nook or a crease (short hits) keeps its own, even while its
                    // samples are too few to show the difference (ReBLUR sizes its blur by hit distance).
                    if (u.uHit.x > 0.0) {
                        float prior = u.uHit.x * rtgiSize(level + 1u, u.uParams) * rtgiHitInv[s] * max(lb, lp);
                        bias2 = max(bias2, prior * prior);
                    }
                    wp += min(stands * seB2p / max(bias2 + seP2, 1e-12), u.uFilter2.w);
                } else {
                    float dp = (lb - lp) / (u.uFilter2.y * sqrt(seB2 + seP2) + u.uFilter2.z * max(lb, lp) + 1e-5);
                    wp += min(standsP, u.uFilter2.w) * exp(-0.5 * dp * dp);
                }
            }
            blended = (blended * stands + parent * wp) / (stands + wp);
            standsAll = stands + wp;
        }
    }
    bool showBlend = u.uParent.w > 0.5;
    vec4 shown = showBlend ? blended : r0;
    rtgiFiltered[s] = shown;
    rtgiStands[s] = showBlend ? standsAll : held;
    // Done: the shown light's standard error (the pooled spread over the samples it stands for) under uDone.z of it, and
    // no drift at the last check -- a neighbourhood agreeing on a value still waiting for its bounce keeps creeping, and
    // stays open. Checked every uDone.y frames this cell is trained.
    float pooled = poolVar / max(poolW, 1e-6);
    float se = sqrt(pooled / max(showBlend ? stands : held, 1.0));
    float ls = lum(shown.rgb);
    float rel = se / max(ls, u.uDone.w);
    vec4 c = rtgiConfidence[s];
    float frame = u.uDone.x;
    if (c.z <= 0.0 || frame - c.z >= u.uDone.y) {
        bool drifted = c.z > 0.0 && abs(ls - c.y) > max(2.0 * se, u.uDone.z * max(ls, u.uDone.w));
        c.w = (!drifted && c.z > 0.0 && rel < u.uDone.z) ? 1.0 : 0.0;
        c.y = ls;
        c.z = frame;
    } else if (rel >= u.uDone.z) c.w = 0.0;
    c.x = rel;
    rtgiConfidence[s] = c;
    rtgiRecord[2u * s].x = packHalf2x16(shown.rg);
    rtgiRecord[2u * s].y = packHalf2x16(shown.ba);
    rtgiRecord[2u * s].z = packHalf2x16(vec2(min(rel, 60000.0), c.w));
}
