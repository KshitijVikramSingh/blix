#version 450
// Which texels (texel.glsl) this frame's image reads and still need rays: one pixel in each uTarget.z block each way
// (uOffset picks which, rotating over frames), the eight
// texels the incident pass weighs there. Each is stamped with the frame (first stamp this frame wins), and if it has
// fewer rays than the target it is queued for the gather, in one of three lists by how many it has: none, under an
// eighth of the minimum, under the minimum, settling (texelSettled) -- the gather takes them in that order, so what a
// new view shows first converges first, and a texel refining toward many rays never starves one that has few. Lists hold uParams.y entries each; the counts keep counting past that (the census reads them).
//
// Counts are double-buffered by frame parity: this frame's mark adds to set (frame & 1), the gather reads it and zeroes
// the other set for the next frame's mark.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform TexelMark {
    mat4 uInvProjection;
    mat4 uInvView;
    vec4 uTarget;       // xy the depth target's pixels, z the pixel stride, w 1: probe mode (below)
    vec4 uTexelGrid;    // xyz the cells' origin, w the spacing
    vec4 uTexelParams;  // x hash capacity, y list capacity (the gather's budget), z target rays, w the frame
    vec4 uOffset;       // xy this frame's pixel within each stride block, z the texels' epoch (the patch light's)
    vec4 uNoise;        // texelSettled: x the most rays, y the standard error tolerated (relative), z its floor; w the
                        // filter list's capacity
    vec4 uTexelLevels;  // x levels, y a pixel's width at unit depth, z / w the pixels a texel should span in sun / in shade
    vec4 uTexelSun;     // xyz the direction the sun travels (texelLevelFor's sunlit)
    vec4 uLightmap;     // --lightmap: x 1 when the atlas's texels are on (texel.glsl), yz the atlas size, w its first record
    mat4 uTexelCascadeVP[3];
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(set = 0, binding = 12) uniform sampler2D uTexelCascadeMaps[3];
#include "shadow.glsl"
layout(std430, set = 0, binding = 3) readonly buffer TexelHash { uvec4 texelHash[]; };
layout(std430, set = 0, binding = 4) readonly buffer Texels { vec4 texels[]; };
layout(std430, set = 0, binding = 5) readonly buffer TexelLight { vec4 texelLight[]; };
layout(std430, set = 0, binding = 6) buffer TexelStamp { uint texelStamp[]; };
// [parity * 4 + list] the counts; the four lists after them at 8 + list * capacity.
layout(std430, set = 0, binding = 7) buffer TexelQueue { uint texelQueue[]; };
// Probe mode (uTarget.w 1, a 24 x 24 dispatch of one thread a point): the lookup at the reference's pixels, as the
// incident pass makes it -- world position and the pre-pass's w; texels found, their weight, the shading bin; the
// irradiance they give and the weight that has rays.
layout(std430, set = 0, binding = 8) buffer TexelProbe { vec4 texelProbe[]; };
// The patch light each texel's rays were read from (SponzaLoop.Texels.cs, FollowSun): an older one queues it again.
layout(std430, set = 0, binding = 9) readonly buffer TexelEpoch { uint texelEpoch[]; };
layout(std430, set = 0, binding = 10) readonly buffer TexelMoment { float texelMoment[]; };
// The texels the image reads this frame, for texel_filter.comp: [parity] counts, then the list (uNoise.w long).
layout(std430, set = 0, binding = 11) buffer TexelFilterList { uint texelFilterList[]; };

// --lightmap: the pre-pass's packed atlas texel, and the atlas's map from texel to record (texel.glsl).
layout(set = 0, binding = 13) uniform usampler2D uLightmapTexel;
layout(std430, set = 0, binding = 14) readonly buffer LightmapIndexMap { uint lightmapIndexMap[]; };
#define TEXEL_INDEX_MAP(i) lightmapIndexMap[i]
#define TEXEL_HASH(i) texelHash[i]
#define TEXEL_POSITION(i) texels[2 * (i)]
#define TEXEL_NORMAL(i) texels[2 * (i) + 1]
#include "texel.glsl"

// The pixel's own direct sun, 0-1, for its texel level (texelLevelFor): facing away, or shadowed in the cascades, is
// shade; past the cascades, sun (far, where coarse texels are all a pixel can hold anyway).
float texelSunlit(vec3 world, vec3 n) {
    vec3 toSun = -normalize(u.uTexelSun.xyz);
    float ndotl = dot(n, toSun);
    if (ndotl <= 0.0) return 0.0;
    int cascade = -1;
    float lit = blix_sun_shadow_cascaded_hard(uTexelCascadeMaps[0], uTexelCascadeMaps[1], uTexelCascadeMaps[2],
        u.uTexelCascadeVP[0], u.uTexelCascadeVP[1], u.uTexelCascadeVP[2], world + n * 0.01, ndotl, cascade);
    return cascade < 0 ? 1.0 : lit;
}

void main() {
    bool probe = u.uTarget.w > 0.5;
    ivec2 at = ivec2(gl_GlobalInvocationID.xy) * int(u.uTarget.z) + ivec2(u.uOffset.xy);
    int probeIndex = int(gl_GlobalInvocationID.y) * 24 + int(gl_GlobalInvocationID.x);
    if (probe) {
        if (any(greaterThanEqual(gl_GlobalInvocationID.xy, uvec2(24)))) return;
        at = ivec2((vec2(gl_GlobalInvocationID.xy) + 0.5) / 24.0 * u.uTarget.xy);
        texelProbe[probeIndex * 3] = vec4(0.0);
        texelProbe[probeIndex * 3 + 1] = vec4(0.0);
        texelProbe[probeIndex * 3 + 2] = vec4(0.0);
    }
    if (any(greaterThanEqual(at, ivec2(u.uTarget.xy)))) return;
    vec2 uv = (vec2(at) + 0.5) / u.uTarget.xy;
    float raw = texelFetch(uSceneDepth, at, 0).r;
    if (raw >= 1.0 - 1e-6) return;
    vec4 view = u.uInvProjection * vec4(uv * 2.0 - 1.0, raw, 1.0);
    vec3 world = (u.uInvView * vec4(view.xyz / view.w, 1.0)).xyz;
    vec4 nSample = texelFetch(uPrepassNormal, at, 0);
    if (dot(nSample.xyz, nSample.xyz) < 1e-6) return;
    vec3 n = normalize(nSample.xyz);

    TexelGrid g;
    g.minCorner = u.uTexelGrid.xyz;
    g.spacing = u.uTexelGrid.w;
    g.capacity = uint(u.uTexelParams.x);
    g.level = 0u;
    int ids[TEXEL_CANDIDATES];
    float weights[TEXEL_CANDIDATES];
    if (probe) {
        texelsAround(g, world, n, nSample.w, ids, weights);
        float found = 0.0, weight = 0.0, lit = 0.0;
        vec3 sum = vec3(0.0);
        for (int i = 0; i < TEXEL_CANDIDATES; ++i) {
            if (ids[i] < 0) continue;
            found += 1.0;
            weight += weights[i];
            vec4 light = texelLight[ids[i]];
            if (light.w > 0.0) { sum += weights[i] * light.rgb; lit += weights[i]; }
        }
        texelProbe[probeIndex * 3] = vec4(world, nSample.w);
        texelProbe[probeIndex * 3 + 1] = vec4(found, weight, float(texelBin(n)), 1.0);
        texelProbe[probeIndex * 3 + 2] = vec4(lit > 0.0 ? sum / lit : vec3(0.0), lit);
        return;
    }
    uint frame = uint(u.uTexelParams.w);
    uint parity = frame & 1u;
    uint capacity = uint(u.uTexelParams.y);
    float target = u.uTexelParams.z;
    // The pixel's level and the next coarser (which fills in while it has few rays, and which it blends into across
    // depth: incident_clipmap.frag). Three levels tripled the lookups (+33 ms on Sponza) for no faster settling.
    float viewDepth = abs(view.z / view.w);
    int finest = int(floor(texelLevelFor(viewDepth, u.uTexelLevels, g.spacing, texelSunlit(world, n))));
    int coarsest = min(finest + 1, int(u.uTexelLevels.x) - 1);
    // Lightmap texels: the four the pixel's atlas texel reads, once (the atlas has no levels; its mips are a later
    // question). A pixel without one (a surface the atlas leaves out) marks the hashed texels as without a lightmap.
    vec2 atlasTexel = vec2(0.0);
    bool lightmap = u.uLightmap.x > 0.5 && texelLightmapUnpack(texelFetch(uLightmapTexel, at, 0).r, atlasTexel);
    if (lightmap) coarsest = finest;
    for (int level = finest; level <= coarsest; ++level) {
    if (lightmap) {
        int lm[4];
        float lw[4];
        texelsAroundLightmap(atlasTexel, n, ivec2(u.uLightmap.yz), lm, lw);
        for (int i = 0; i < TEXEL_CANDIDATES; ++i) { ids[i] = i < 4 ? lm[i] : -1; weights[i] = i < 4 ? lw[i] : 0.0; }
    } else
    texelsAround(texelLevelGrid(g, uint(level)), world, n, nSample.w, ids, weights);
    for (int i = 0; i < TEXEL_CANDIDATES; ++i) {
        if (ids[i] < 0) continue;
        uint id = uint(ids[i]);
        if (atomicExchange(texelStamp[id], frame) == frame) continue;
        uint filterSlot = atomicAdd(texelFilterList[parity], 1u);
        if (filterSlot < uint(u.uNoise.w)) texelFilterList[2u + filterSlot] = id;
        vec4 light = texelLight[id];
        float rays = light.w;
        bool stale = texelEpoch[id] != uint(u.uOffset.z);
        if (!stale && texelSettled(light, texelMoment[id], u.uNoise, target)) continue;
        // Need first: none yet, few, under the minimum, then settling toward the noise target. A coarse texel short
        // of the minimum goes first whatever it holds: there are few of them, and they are what a new view shows.
        uint list = rays <= 0.0 || (level > finest && rays < target) ? 0u : (stale || rays < target / 8.0) ? 1u : rays < target ? 2u : 3u;
        uint slot = atomicAdd(texelQueue[parity * 4u + list], 1u);
        if (slot < capacity) texelQueue[8u + list * capacity + slot] = id;
    }
    }
}
