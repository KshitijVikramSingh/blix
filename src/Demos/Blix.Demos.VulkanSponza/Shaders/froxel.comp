#version 450

// Froxel volumetric fog — single fused scatter+integrate pass.
//
// The grid is a view-aligned 3D texture: (x,y) = screen tiles, z = distance
// slices from the camera out to uCamPos.w (fog far). One thread owns a screen
// column (x,y) and marches z front-to-back, accumulating in-scattering
// (shadow-aware sun, plus the scene's own indirect light) and Beer-Lambert
// transmittance. Each slice stores the *integrated* result up to that distance,
// so the lit pass samples one trilinear texel per fragment:
//     litColor = litColor * fog.a + fog.rgb
//
// Reconstruction uses the camera's inverse view-projection (same matrix the
// scene renders with), so the Vulkan clip-space Y flip is handled for free and
// the grid aligns with gl_FragCoord in the lit shader.
//
// Ambient in-scatter comes from the same scene fields as surfaces: environment irradiance weighted
// by baked sky visibility plus dynamic probe bounce. The fallback constant applies only when those
// fields are unavailable. Medium density falls from the volume floor and varies over a slowly
// drifting noise field so both extinction and scattering have spatial structure.
//
// Deliberate simplification: shadow lookup is one cascade texel per froxel rather than filtered
// PCF. Cascade selection still uses the shared fitted-volume lookup.

#include "shadow.glsl"
#include "sky_visibility.glsl"
#include "probe_volume.glsl"
#include "froxel.glsl"
#include "noise.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform Froxel {
    mat4 uInvViewProj;
    vec4 uCamPos;        // xyz camera world pos, w = fog far distance
    vec4 uPrevCamPos;    // xyz last frame's camera world pos
    vec4 uCamForward;    // xyz camera forward, w = extinction coefficient (density)
    vec4 uSunDir;        // xyz direction into scene, w = sun intensity
    vec4 uSunColor;      // rgb sun colour, w = scattering albedo
    vec4 uFogParams;     // x = phase g, y = ambient fallback, z = indirect available (0/1), w = time
    vec4 uBoundsMin;     // xyz sky/probe volume min
    vec4 uBoundsSpan;    // xyz sky/probe volume span
    vec4 uProbeDims;     // xyz bounce grid dimensions
    // xyz occupancy grid dims, w = line-of-sight occupancy weight. Held at zero here so the surface
    // pass remains the sole owner of that measurement axis.
    vec4 uOccupancyDims;
    vec4 uMedium;        // x = height scale (m), y = noise amount 0..1
    vec4 uTemporal;      // x = history weight, y = slice jitter, z = visualize rejection
    mat4 uPrevViewProj;  // last frame's camera, for reprojecting the medium
    mat4 uCascadeVP[3];
} f;

layout(set = 0, binding = 1, rgba16f) uniform writeonly image3D uGrid;
layout(set = 0, binding = 2) uniform sampler2D uCascadeShadowMaps[3];
// Only the L0 band, because a volume point wants the spherical mean (see blix_skyVisibilityMean).
layout(set = 0, binding = 3) uniform sampler3D  uSkyVisibility;
layout(set = 0, binding = 4) uniform samplerCube uIrradiance;
layout(set = 0, binding = 5) uniform sampler2D  uAtlas;
layout(set = 0, binding = 6) uniform sampler2D  uDepthAtlas;
// Reproject local medium state, not the camera-relative integral. RGB stores in-scattered radiance
// and alpha stores extinction before front-to-back integration; after blending, uGrid receives the
// newly integrated result for the current camera.
layout(set = 0, binding = 7) uniform sampler3D uScatterPrev;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image3D uScatter;
// The density grid, for the probe blend's line-of-sight test. Bound rather than passed a stand-in
// texture so the argument means what it says even while uOccupancyDims.w holds it at zero.
layout(set = 0, binding = 9) uniform sampler3D uOccupancy;

const float PI = 3.14159265359;

// Noise feature size as a fraction of fog far, and how fast the field drifts. Both are derived
// rather than dialled: the features scale with the fog's reach so the look does not change when
// the range does, and the drift is slow enough to read as air rather than as an animation.
const float NOISE_FEATURES = 8.0;      // features across the fog's range
const vec3  NOISE_DRIFT = vec3(0.4, 0.05, 0.25);   // metres/second

// How many slices share one probe-volume lookup. The probe field is low-frequency by
// construction — that premise is what a probe volume IS — so resampling it every slice pays for
// resolution the data does not have. Eight probes and their visibility test per froxel is the
// single most expensive thing in this loop.
const int PROBE_STRIDE = 4;

// Henyey-Greenstein phase function (g>0 forward-scatters toward the sun).
float phaseHG(float cosT, float g)
{
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosT;
    return (1.0 - g2) / (4.0 * PI * max(pow(denom, 1.5), 1e-4));
}

// Extinction at a point, relative to the uniform coefficient: air thins with height, and what is
// left of it is not evenly mixed.
float mediumDensity(vec3 p, float groundY, float heightScale, float noiseAmount, float noiseScale, float t)
{
    float h = exp(-max(p.y - groundY, 0.0) / max(heightScale, 0.1));
    if (noiseAmount <= 0.0) return h;
    vec3 q = (p + NOISE_DRIFT * t) / noiseScale;
    // Two octaves, not four: the field is being integrated along a ray through dozens of slices,
    // which is itself a low-pass — detail finer than a slice is paid for and then averaged away.
    float n = blix_vnoise3(q) * 0.65 + blix_vnoise3(q * 2.7) * 0.35;
    return h * mix(1.0, n * 1.6, clamp(noiseAmount, 0.0, 1.0));
}

void main()
{
    ivec3 gsize = imageSize(uGrid);
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= gsize.x || xy.y >= gsize.y) return;

    int   numSlices = gsize.z;
    float fogFar    = f.uCamPos.w;
    vec3  camPos    = f.uCamPos.xyz;
    float g         = f.uFogParams.x;
    bool  giOn      = f.uFogParams.z > 0.5;
    vec3  sunInto   = normalize(f.uSunDir.xyz);

    // Extinction controls energy removed from the ray; scattering albedo selects the share returned
    // as in-scatter rather than absorbed.
    float sigmaT = max(f.uCamForward.w, 1e-5);
    float sigmaS = sigmaT * clamp(f.uSunColor.w, 0.0, 1.0);

    // Pixel-ray direction via inverse view-projection (handles the clip Y flip).
    vec2 uv  = (vec2(xy) + 0.5) / vec2(gsize.xy);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 farH = f.uInvViewProj * vec4(ndc, 1.0, 1.0);
    vec3 farW = farH.xyz / farH.w;
    vec3 rayDir = normalize(farW - camPos);

    // HG angle is between the light's travel direction and the scattered ray
    // travelling toward the camera (-rayDir). Forward scatter (g>0) then peaks
    // when looking toward the sun, giving crepuscular shafts on the right side.
    float phase = phaseHG(-dot(rayDir, sunInto), g);

    // The sky's mean radiance, hoisted: it is the same for every froxel in the grid, because the
    // environment does not vary along a ray — only the fraction of it a point can SEE does. The
    // irradiance cube is a cosine convolution of the sky, so E(n)/pi is the mean radiance over the
    // hemisphere about n, and the six axes average to the sphere.
    vec3 skyRadiance = vec3(0.0);
    vec3 invSpan = vec3(1.0) / max(f.uBoundsSpan.xyz, vec3(1e-4));
    if (giOn) {
        skyRadiance = (texture(uIrradiance, vec3( 1.0, 0.0, 0.0)).rgb
                     + texture(uIrradiance, vec3(-1.0, 0.0, 0.0)).rgb
                     + texture(uIrradiance, vec3( 0.0, 1.0, 0.0)).rgb
                     + texture(uIrradiance, vec3( 0.0,-1.0, 0.0)).rgb
                     + texture(uIrradiance, vec3( 0.0, 0.0, 1.0)).rgb
                     + texture(uIrradiance, vec3( 0.0, 0.0,-1.0)).rgb) / (6.0 * PI);
    }

    vec3  accum = vec3(0.0);
    float transmittance = 1.0;
    vec3  bounce = vec3(0.0);       // held between PROBE_STRIDE slices
    float noiseScale = fogFar / NOISE_FEATURES;
    float groundY = f.uBoundsMin.y;

    // Integrate between slice centres because trilinear coordinate t addresses texel centres. Each
    // stored slice therefore represents the integral from the camera to that centre, including for
    // the non-uniform near/far slice distribution.
    float prevD = 0.0;

    for (int z = 0; z < numSlices; z++)
    {
        float d  = blix_froxelSliceDistance((float(z) + 0.5) / float(numSlices), fogFar);
        float dt = max(d - prevD, 1e-6);               // this segment's world length
        // Jitter within the segment so reprojected history integrates different shadow/density
        // samples over time instead of repeatedly averaging the same midpoint.
        float dist = mix(prevD, d, clamp(f.uTemporal.y, 0.0, 1.0));
        prevD = d;
        vec3 worldPos = camPos + rayDir * dist;

        // ndotl = 1.0: the bias it scales guards a surface against shadowing itself, and a point
        // in a volume has no surface. The cascade it lands in is the one the lit pass would pick
        // for the same point, which is the whole reason this call is not local code.
        int fogCascade;
        float vis = blix_sun_shadow_cascaded_hard(
            uCascadeShadowMaps[0], uCascadeShadowMaps[1], uCascadeShadowMaps[2],
            f.uCascadeVP[0], f.uCascadeVP[1], f.uCascadeVP[2],
            worldPos, 1.0, fogCascade);

        // In-scattered radiance: the phase function against the sun, plus an isotropic ambient
        // term. Both are radiances, so both are simply multiplied by sigmaS — for an isotropic
        // source the phase integrates to one over the sphere and drops out.
        vec3 ambientRadiance = vec3(f.uFogParams.y);
        if (giOn) {
            if ((z % PROBE_STRIDE) == 0) {
                // Bounced light arriving along the view ray. The probe blend is directional, and
                // the direction that matters for in-scatter toward the eye is the one the light
                // travels to get here.
                bounce = blix_probeIrradiance(
                    uAtlas, uDepthAtlas, uOccupancy, ivec3(f.uProbeDims.xyz),
                    ivec3(f.uOccupancyDims.xyz), f.uBoundsMin.xyz, f.uBoundsSpan.xyz,
                    worldPos, -rayDir, f.uOccupancyDims.w) / PI;
            }
            float skyVis = blix_skyVisibilityMean(uSkyVisibility, f.uBoundsMin.xyz, invSpan, worldPos);
            ambientRadiance = skyRadiance * skyVis + bounce;
        }

        vec3 sunLit = f.uSunColor.rgb * f.uSunDir.w * phase * vis;

        // Both coefficients scale with the local density, so the medium's shape shows up in what
        // it scatters AND in what it blocks — a thick patch is bright and also casts its own
        // shadow down the ray.
        float rho = mediumDensity(worldPos, groundY, f.uMedium.x, f.uMedium.y, noiseScale, f.uFogParams.w);
        float st = max(sigmaT * rho, 1e-6);
        vec3 stepScatter = (sunLit + ambientRadiance) * (sigmaS * rho);

        // --- temporal blend, on the medium ---------------------------------
        // Where this froxel's world position sat in last frame's grid. Both halves follow the
        // current addressing contract: the screen coordinate through the previous camera,
        // and the slice coordinate through the SAME quadratic curve the lit pass inverts.
        float historyWeight = 0.0;
        vec4 history = vec4(0.0);
        if (f.uTemporal.x > 0.0) {
            vec4 clipPrev = f.uPrevViewProj * vec4(worldPos, 1.0);
            if (clipPrev.w > 1e-4) {
                vec3 ndcPrev = clipPrev.xyz / clipPrev.w;
                vec2 uvPrev = ndcPrev.xy * 0.5 + 0.5;
                float distPrev = length(worldPos - f.uPrevCamPos.xyz);
                float tPrev = blix_froxelSliceCoord(distPrev, fogFar);
                // Reject out-of-bounds reprojection rather than clamping to unrelated edge medium.
                bool inside = all(greaterThanEqual(uvPrev, vec2(0.0)))
                           && all(lessThanEqual(uvPrev, vec2(1.0)))
                           && tPrev > 0.0 && tPrev < 1.0;
                if (inside) {
                    history = texture(uScatterPrev, vec3(uvPrev, tPrev));
                    historyWeight = clamp(f.uTemporal.x, 0.0, 1.0);
                    // A froxel that has never been written carries zero extinction; blending toward
                    // it would fade the medium out where the camera has just turned.
                    if (history.a <= 0.0) historyWeight = 0.0;
                }
            }
        }
        vec4 current = vec4(stepScatter, st);
        vec4 medium = mix(current, history, historyWeight);
        imageStore(uScatter, ivec3(xy, z), medium);

        stepScatter = medium.rgb;
        st = max(medium.a, 1e-6);

        // Energy-conserving segment integral of in-scattering under extinction.
        float sliceT = exp(-st * dt);
        vec3 sliceIntegral = stepScatter * (1.0 - sliceT) / st;
        accum += transmittance * sliceIntegral;
        transmittance *= sliceT;

        // Visualize normalized rejection: full trust is black at any configured weight, while
        // invalid or unwritten history is bright.
        if (f.uTemporal.z > 0.5) {
            float refused = 1.0 - historyWeight / max(f.uTemporal.x, 1e-3);
            imageStore(uGrid, ivec3(xy, z), vec4(vec3(refused), 0.0));
        } else {
            imageStore(uGrid, ivec3(xy, z), vec4(accum, transmittance));
        }
    }
}
