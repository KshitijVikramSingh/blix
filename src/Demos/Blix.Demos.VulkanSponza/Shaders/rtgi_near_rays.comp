#version 450

// --rtgi-hybrid (SponzaLoop.Rtgi.cs): each pixel's own near field, its rays. One half-res pixel of each 4 x 4 block a frame
// (in turn, all sixteen over sixteen frames) casts a cosine ray of the contact radius's length -- what it meets that near
// is its near field (a crease's other face, a contact, an overhang), what it does not meet is its share of the far light
// the cache holds. A block one slot (no list, no count): the Metal batch traces them closest-hit with each hit's sun
// (SponzaLoop.Rtgi.cs), rtgi_near_shade.comp lights the hits from the cache and writes the samples the readout gathers
// (rtgi_readout.frag hybridNear). tools/gi-model/near_far_hybrid.py modelled it: Crytek 0.148 against the cache's 0.158.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform RtgiNearRays {
    mat4 uInvViewProj;   // inverse of the view-projection the pre-pass drew with
    vec4 uSize;          // xy full-res pixels; zw half-res pixels
    vec4 uCamera;        // xyz position; w the frame
    vec4 uNear;          // x the contact radius (the ray's length); y the blocks across; z the uncertainty map's row; w the block's
                         // side (4: one pixel in sixteen a frame; 2: one in four)
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
// Per slot (block): the ray (origin; direction, its length), as the training rays' (rtgi_rays.comp) for the same trace.
layout(std430, set = 0, binding = 3) writeonly buffer RtgiNearRayBuffer { vec4 nearRays[]; };
// Per slot: the point (xyz; w its half-res pixel's index as bits, 0xFFFFFFFF none), its normal.
layout(std430, set = 0, binding = 4) writeonly buffer RtgiNearInfo { vec4 nearInfo[]; };

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// The sixteen of a block in an order that spreads each frame's pixel from the last's (a 4 x 4 Bayer matrix).
const uint ORDER[16] = uint[16](0u, 10u, 2u, 8u, 5u, 15u, 7u, 13u, 1u, 11u, 3u, 9u, 4u, 14u, 6u, 12u);
const uint ORDER2[4] = uint[4](0u, 3u, 1u, 2u);

void main() {
    uvec2 b = gl_GlobalInvocationID.xy;
    uint side = uint(u.uNear.w);
    uint blocksX = uint(u.uNear.y), blocksY = (uint(u.uSize.w) + side - 1u) / side;
    if (b.x >= blocksX || b.y >= blocksY) return;
    uint slot = b.y * blocksX + b.x;
    uint frame = uint(u.uCamera.w);
    uvec2 h;
    if (side == 2u) { uint k = ORDER2[(frame + hash(slot) % 4u) % 4u]; h = b * 2u + uvec2(k & 1u, k >> 1); }
    else { uint k = ORDER[(frame + hash(slot) % 16u) % 16u]; h = b * 4u + uvec2(k & 3u, k >> 2); }
    nearInfo[2u * slot] = vec4(0.0, 0.0, 0.0, uintBitsToFloat(0xFFFFFFFFu));
    nearRays[2u * slot] = vec4(0.0);
    nearRays[2u * slot + 1u] = vec4(0.0, 1.0, 0.0, 1e-6);
    if (any(greaterThanEqual(h, uvec2(u.uSize.zw)))) return;
    ivec2 q = min(ivec2(h) * 2, ivec2(u.uSize.xy) - 1);
    float raw = texelFetch(uSceneDepth, q, 0).r;
    vec4 ns = texelFetch(uPrepassNormal, q, 0);
    if (raw >= 1.0 - 1e-6 || dot(ns.xyz, ns.xyz) < 1e-6) return;
    vec4 w = u.uInvViewProj * vec4((vec2(q) + 0.5) / u.uSize.xy * 2.0 - 1.0, raw, 1.0);
    vec3 p = w.xyz / w.w;
    vec3 n = normalize(ns.xyz);
    // Lifted as the training rays are (rtgi_rays.comp), so the near light and the cells' far share agree on what is near.
    float lift = 0.01 + 0.001 * length(p - u.uCamera.xyz);
    uint hr = hash(slot * 0x9E3779B9u ^ hash(frame * 0x85EBCA77u + 0x2545F491u));
    float r1 = float(hr & 0xFFFFu) / 65536.0, r2 = float(hr >> 16) / 65536.0;
    float phi = 6.28318530718 * r1, sr = sqrt(r2);
    vec3 t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
    vec3 bt = cross(n, t);
    vec3 d = normalize(t * (cos(phi) * sr) + bt * (sin(phi) * sr) + n * sqrt(max(0.0, 1.0 - r2)));
    nearRays[2u * slot] = vec4(p + n * lift, 0.0);
    nearRays[2u * slot + 1u] = vec4(d, u.uNear.x);
    nearInfo[2u * slot] = vec4(p, uintBitsToFloat(h.y * uint(u.uNear.z) + h.x));
    nearInfo[2u * slot + 1u] = vec4(n, 0.0);
}
