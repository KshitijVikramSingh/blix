#version 450

// --ray-view: the camera's view, traced through ray_query.glsl, beside the raster's depth at the same point.
//
// One ray per pixel of a half-resolution grid, each through its 1x pixel's depth sample: the jittered view-
// projection the depth pre-pass drew with, and the point in the pixel the depth resolve keeps (sample 0 under
// MSAA). The raster's resolved depth there is linearised the way hiz_build.frag does. Per pixel: traced and
// raster view depth (float bits; the traced one infinite on a miss), the placement hit, and its normal packed
// snorm 8:8:8. The host reads it back at the shot, classifies every disagreement, and writes both pictures.

layout(local_size_x = 8, local_size_y = 8) in;

#define BLIX_RAY_SET 0
#define BLIX_RAY_BINDING 2
#include "ray_query.glsl"

layout(set = 0, binding = 0) uniform RayView {
    mat4 uInvViewProj;     // inverse of the jittered view-projection the pre-pass used
    mat4 uInvProjection;   // to linearise raster depth (jitter moves x and y, not z)
    vec4 uCamera;          // xyz position
    vec4 uForward;         // xyz unit view direction
    vec4 uSize;            // xy traced grid, zw the 1x depth's size
    vec4 uSample;          // xy the depth sample's position within its pixel
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(std430, set = 0, binding = 9) buffer RayViewOut { uvec4 pixels[]; };

// Not a const: GLSL will not fold uintBitsToFloat, and 1.0 / 0.0 is undefined.
#define Infinity uintBitsToFloat(0x7F800000u)

void main() {
    uvec2 cell = gl_GlobalInvocationID.xy;
    if (cell.x >= uint(u.uSize.x) || cell.y >= uint(u.uSize.y)) return;
    ivec2 texel = ivec2(cell) * 2;
    vec2 ndc = (vec2(texel) + u.uSample.xy) / u.uSize.zw * 2.0 - 1.0;

    vec4 far = u.uInvViewProj * vec4(ndc, 1.0, 1.0);
    vec3 direction = normalize(far.xyz / far.w - u.uCamera.xyz);
    BlixRayHit hit;
    bool found = blix_traceClosest(u.uCamera.xyz, direction, 0.0, Infinity, cell.y * uint(u.uSize.x) + cell.x, hit);
    float traced = found ? hit.t * dot(direction, u.uForward.xyz) : Infinity;

    float raw = texelFetch(uSceneDepth, texel, 0).r;
    vec4 view = u.uInvProjection * vec4(ndc, raw, 1.0);
    float raster = raw >= 1.0 ? Infinity : -(view.z / view.w);

    uint index = cell.y * uint(u.uSize.x) + cell.x;
    // The normal in the low three bytes, and how bright the albedo is (luminance, 0-255) in the top one.
    float luminance = dot(hit.albedo, vec3(0.2126, 0.7152, 0.0722));
    pixels[index] = uvec4(floatBitsToUint(traced), floatBitsToUint(raster), found ? hit.instance : 0xFFFFFFFFu,
                          found ? (packSnorm4x8(vec4(hit.normal, 0.0)) & 0x00FFFFFFu) | (uint(clamp(luminance, 0.0, 1.0) * 255.0 + 0.5) << 24) : 0u);
}
