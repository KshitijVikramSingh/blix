#version 450

// The traced sun shadows' penumbra, filtered in space (ShadowsSettings.PenumbraFilter): every ray went toward the sun's
// CENTRE (rt_shadow_rays.comp: coherent rays, no direction per pixel), so the mask is the hard shadow, and this widens
// each edge to the penumbra a disc of the sun's angular size casts -- as wide as the blocker's distance times the disc
// (both edges of it; the Metal pass writes how far each blocked ray went, the word's upper half), over a pixel's
// footprint here: hard at contact, soft far from the blocker. Stable frame to frame: no per-ray jitter for TAA to
// average (the old way, per-ray disc directions, stays a toggle).
//
// Writes the visibility (0..255) into bits 8-15 of the pixel's own word and sets the header's z to 2, which lit.frag
// reads as "filtered visibility here". Bit 0 and the distance stay as traced: every other reader (the census, the
// half-res upsample, the audits) sees what it saw. A neighbour's word may be rewritten while read; only its bits 8-15
// change, which this pass does not read.

// Sheets that transmit (a curtain, bit 2: the Metal pass let the ray through it to the sun): the word is blocked, with the
// sheet's distance, so the penumbra above is the curtain's; and the light the sunlit sheet sends the pixel (the mask's
// second plane) is spread over the widest kernel, on the pixel's own surface, into the third plane, with bit 3 saying
// there is some. It is the glow of the sheet over a curtain's width, which no single ray sees: the spread stands in for
// the sum over the sheet, and for the cloth's folds turning to the sun and away.
//
// A 16x16 group reads the mask once into shared memory with the widest radius around it (40x40 words): every tap
// reads the tile, and a group whose tile is all lit or all blocked writes its words and stops (most of a frame). It
// read each tap from the buffer before (2026-10-15: 9.7 ms at 2880x1620).
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform RtShadowFilter {
    mat4 uInvViewProj;
    vec4 uCamera;   // xyz the camera
    vec4 uSize;     // xy the mask's size (full res)
    vec4 uDisc;     // x the tangent of the sun's angular radius; y a full-res pixel's angular size (radians, centre)
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) buffer RtShadowMask { uvec4 rtShadowHeader; uint rtShadowWords[]; };

const int MaxRadius = 12;
const int Group = 16;
const int Tile = Group + 2 * MaxRadius;
shared uint tile[Tile * Tile];
shared uint tileGlow[Tile * Tile];   // the second plane, where the word has bit 2
shared uint tileLit, tileBlocked, tileThrough;
// Where the tile has anything to soften or spread: its depth and normals (packSnorm4x8, 0 for none), read once a group.
// Each tap read both textures before: the sheets' 49-tap spread took the filter from 0.96 to 3.34 ms (2026-10-16).
shared float tileDepth[Tile * Tile];
shared uint tileNormal[Tile * Tile];
ivec2 tileOrigin;

vec3 worldAt(ivec2 pixel, float raw) {
    vec2 ndc = (vec2(pixel) + 0.5) / u.uSize.xy * 2.0 - 1.0;
    vec4 w = u.uInvViewProj * vec4(ndc, raw, 1.0);
    return w.xyz / w.w;
}

// 1 where the sun reached; the blocker's distance where it did not (0 when unknown: a baked answer, no ray).
// p within MaxRadius of the group's pixels (every tap is).
vec2 tapAt(ivec2 p) {
    ivec2 t = p - tileOrigin;
    uint word = tile[t.y * Tile + t.x];
    return (word & 1u) != 0u ? vec2(0.0, unpackHalf2x16(word >> 16).x) : vec2(1.0, 0.0);
}

// The light a sheet sends the pixel, a fraction of the sun's (0 where the ray went through none). As tapAt.
vec3 glowAt(ivec2 p) {
    ivec2 t = p - tileOrigin;
    uint i = uint(t.y * Tile + t.x);
    if ((tile[i] & 5u) != 5u) return vec3(0.0);
    vec3 g = unpackUnorm4x8(tileGlow[i]).rgb;
    return g * g;
}

// p within MaxRadius of the group's pixels, as tapAt.
float surfaceWeight(ivec2 p, vec3 pQ, vec3 nQ, float tolerance) {
    uint i = uint((p.y - tileOrigin.y) * Tile + (p.x - tileOrigin.x));
    float raw = tileDepth[i];
    if (raw >= 1.0 - 1e-6) return 0.0;
    float plane = abs(dot(nQ, worldAt(p, raw) - pQ));
    uint packed = tileNormal[i];
    float facing = packed != 0u ? max(dot(unpackSnorm4x8(packed).xyz, nQ), 0.0) : 0.0;
    return exp(-(plane * plane) / (tolerance * tolerance)) * pow(facing, 8.0);
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(u.uSize.xy);
    if (q.x == 0 && q.y == 0) rtShadowHeader.z = 2u;
    // The tile: the group's pixels and MaxRadius around, clamped to the mask's edge as the taps are.
    tileOrigin = ivec2(gl_WorkGroupID.xy) * Group - MaxRadius;
    if (gl_LocalInvocationIndex == 0u) { tileLit = 0u; tileBlocked = 0u; tileThrough = 0u; }
    barrier();
    uint lit0 = 0u, blocked0 = 0u, through0 = 0u;
    uint planeSize = uint(size.x) * uint(size.y);
    for (uint i = gl_LocalInvocationIndex; i < uint(Tile * Tile); i += uint(Group * Group)) {
        ivec2 at = clamp(tileOrigin + ivec2(int(i) % Tile, int(i) / Tile), ivec2(0), size - 1);
        uint atIndex = uint(at.y) * uint(size.x) + uint(at.x);
        uint w = rtShadowWords[atIndex];
        tile[i] = w;
        bool through = (w & 5u) == 5u;
        tileGlow[i] = through ? rtShadowWords[planeSize + atIndex] : 0u;
        if (through) through0 = 1u;
        if ((w & 1u) != 0u) blocked0 = 1u; else lit0 = 1u;
    }
    if (lit0 != 0u) atomicOr(tileLit, 1u);
    if (blocked0 != 0u) atomicOr(tileBlocked, 1u);
    if (through0 != 0u) atomicOr(tileThrough, 1u);
    barrier();
    // Uniform across the group (shared flags): the depth and normals only where some pixel will weigh its taps.
    if ((tileLit != 0u && tileBlocked != 0u) || tileThrough != 0u) {
        for (uint i = gl_LocalInvocationIndex; i < uint(Tile * Tile); i += uint(Group * Group)) {
            ivec2 at = clamp(tileOrigin + ivec2(int(i) % Tile, int(i) / Tile), ivec2(0), size - 1);
            tileDepth[i] = texelFetch(uSceneDepth, at, 0).r;
            vec4 n = texelFetch(uPrepassNormal, at, 0);
            tileNormal[i] = dot(n.xyz, n.xyz) > 1e-6 ? packSnorm4x8(vec4(normalize(n.xyz), 0.0)) : 0u;
        }
        barrier();
    }
    if (q.x >= size.x || q.y >= size.y) return;
    uint index = uint(q.y) * uint(size.x) + uint(q.x);
    ivec2 own2 = q - tileOrigin;
    uint word = tile[own2.y * Tile + own2.x];
    float own = (word & 1u) != 0u ? 0.0 : 1.0;
    float result = own;
    vec3 glow = vec3(0.0);

    // Every tap would agree (an umbra, or open sun) and no sheet lets light through: nothing to soften or spread.
    bool mixed = tileLit != 0u && tileBlocked != 0u;
    bool sheets = tileThrough != 0u;
    float raw = mixed || sheets ? texelFetch(uSceneDepth, q, 0).r : 1.0;
    // Only where the sun did not reach: a sunlit pixel takes the sun, and at an edge the penumbra blends the two.
    if (raw < 1.0 - 1e-6 && sheets && own < 0.5) {
        // The sheets' light, spread: a 7 x 7 kernel over the widest radius (taps 4 px apart), on the pixel's own surface.
        vec3 pQ = worldAt(q, raw);
        vec4 nSample = texelFetch(uPrepassNormal, q, 0);
        vec3 nQ = dot(nSample.xyz, nSample.xyz) > 1e-6 ? normalize(nSample.xyz) : normalize(u.uCamera.xyz - pQ);
        float tolerance = 0.005 + 0.004 * length(pQ - u.uCamera.xyz);
        const int k = 3;
        const float spacing = float(MaxRadius) / float(k);
        const float sigma = 0.5 * float(MaxRadius);
        vec3 sum = vec3(0.0);
        float weight = 0.0;
        for (int iy = -k; iy <= k; ++iy) {
            for (int ix = -k; ix <= k; ++ix) {
                ivec2 d = ivec2(round(vec2(ix, iy) * spacing));
                ivec2 t = q + d;
                if (any(lessThan(t, ivec2(0))) || any(greaterThanEqual(t, size))) continue;
                float w = exp(-float(dot(d, d)) / (2.0 * sigma * sigma)) * (d == ivec2(0) ? 1.0 : surfaceWeight(t, pQ, nQ, tolerance));
                sum += glowAt(t) * w;
                weight += w;
            }
        }
        if (weight > 1e-4) glow = sum / weight;
    }
    if (!mixed) raw = 1.0;
    if (raw < 1.0 - 1e-6 && u.uDisc.x > 0.0) {
        vec3 pQ = worldAt(q, raw);
        float viewDistance = length(pQ - u.uCamera.xyz);
        float footprint = max(viewDistance * u.uDisc.y, 1e-6);
        // The blocker: from rings of taps out to the widest a penumbra could reach here, the blocked ones' distances.
        float blocker = own < 0.5 ? unpackHalf2x16(word >> 16).x : 0.0;
        float blockers = blocker > 0.0 ? 1.0 : 0.0;
        int lit = int(own), taps = 1;
        // Two rings (4 px and the widest), so a thin shadow next to a lit pixel is still found.
        for (int k = 0; k < 16; ++k) {
            float a = float(k) * 0.785398163 + (k >= 8 ? 0.392699 : 0.0);
            float ring = k < 8 ? 4.0 : float(MaxRadius);
            ivec2 t = clamp(q + ivec2(round(vec2(cos(a), sin(a)) * ring)), ivec2(0), size - 1);
            vec2 s = tapAt(t);
            lit += int(s.x);
            taps++;
            if (s.x < 0.5 && s.y > 0.0) { blocker += s.y; blockers += 1.0; }
        }
        // Everything around agrees (an umbra, or open sun): nothing to soften -- most of a frame stops here.
        if (lit != 0 && lit != taps && blockers > 0.0) {
            float widthPixels = 2.0 * u.uDisc.x * (blocker / blockers) / footprint;
            float radius = min(widthPixels * 0.5, float(MaxRadius));
            if (radius >= 0.75) {
                vec4 nSample = texelFetch(uPrepassNormal, q, 0);
                vec3 nQ = dot(nSample.xyz, nSample.xyz) > 1e-6 ? normalize(nSample.xyz) : normalize(u.uCamera.xyz - pQ);
                float tolerance = 0.005 + 0.004 * viewDistance;
                // A sparse kernel: at most 7 x 7 taps over the radius, k of them a side, spaced r / k (a step of r / 3
                // rounded down had radii 3-5 at every pixel, 121 taps).
                int r = int(ceil(radius));
                int k = min(r, 3);
                float spacing = float(r) / float(k);
                float sigma = 0.5 * radius + 0.5;
                float sum = 0.0, weight = 0.0;
                for (int iy = -k; iy <= k; ++iy) {
                    for (int ix = -k; ix <= k; ++ix) {
                        int dx = int(round(float(ix) * spacing)), dy = int(round(float(iy) * spacing));
                        ivec2 t = q + ivec2(dx, dy);
                        if (any(lessThan(t, ivec2(0))) || any(greaterThanEqual(t, size))) continue;
                        vec2 d = vec2(dx, dy);
                        float w = exp(-dot(d, d) / (2.0 * sigma * sigma)) * (dx == 0 && dy == 0 ? 1.0 : surfaceWeight(t, pQ, nQ, tolerance));
                        sum += tapAt(t).x * w;
                        weight += w;
                    }
                }
                if (weight > 1e-4) result = sum / weight;
            }
        }
    }
    // Bit 3: the third plane holds the sheets' light here (sqrt-encoded, as the second).
    bool glows = max(glow.r, max(glow.g, glow.b)) > 1e-5;
    if (glows) rtShadowWords[2u * planeSize + index] = packUnorm4x8(vec4(sqrt(glow), 0.0));
    rtShadowWords[index] = (word & ~0xFF08u) | (glows ? 8u : 0u) | (uint(round(clamp(result, 0.0, 1.0) * 255.0)) << 8);
}
