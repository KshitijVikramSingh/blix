#version 450
// --live-texels (SponzaLoop.SliceResolve.cs): a traced slice resolved on the GPU -- what SunNodeReadBack did in C# over
// the mapped sums (ProcessSlice: the sums, the refine's judgement, the detail, the landing), which cost 110 ms a slice of
// 32 K texels, 57 s of a 3.6 min light change on Sponza (2026-10-19). A thread a texel of the slice.
//   mode 0  a slice: its sums added to the texel's running state (by its place in the sweep), its light into the parts
//           (the sun's per unit of its irradiance), on the sweep its detail, and if still noisy (SunNodesRefine.cs,
//           CookSettled) its id and place appended for the next round; on the sweep its light into the histogram the
//           dark bar is read from.
//   mode 1  the sweep's unsettled judged again against the dark bar (RejudgeAfterSweep): those still noisy appended.
//           With the pooled stop (uKeep.w), the whole sweep (place = its index), the pool complete by then.
// THE POOLED STOP (default; --no-settle-pool; tools/gi-model/settle_rule.py): a stop that reads its own passes reads its own luck --
// a texel that has not met a rare light (the crevices' corridor, lit through a doorway) reads dark AND steady, and stops
// dark (the model: fine texels -4% to -18%). So the sweep pools its texels' relative noise per patch (Pool: the passes'
// variance over the light^2 summed, the light summed, the texels), and a texel's noise is judged as the larger of its
// own variance and the pool's relative noise times the patch's mean light^2: it settles no sooner than its own would,
// and not on its luck alone (the model: every case within ~1%).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform SliceResolve {
    vec4 uSlice;    // x the slice's first in the round's list, y its texels, z the passes it traced, w 1 refining
    vec4 uSettle;   // x the most rays, y the noise share, z the noise floor, w the dark bar
    vec4 uSun;      // xyz 1 / the sun's irradiance, w the sweep's passes
    vec4 uMode;     // x the mode, y the columns (suns), z which column is the sun's (-1 none), w 1 the detail
    vec4 uKeep;     // x 1: the sky's part kept (a sun change: written and judged the sun's alone); y 1: refine the masked alone;
                    // z the provenance code of what this gather is (SponzaLoop.TexelPicker.cs); w 1: the pooled stop
    vec4 uGlow;     // x 1: the near walls' glow kept apart (--near-glow-split: NodeGlow -> GlowState -> GlowPart)
} u;

layout(std430, set = 0, binding = 1) readonly buffer RoundIds { uint roundIds[]; };   // the round's texel ids
layout(std430, set = 0, binding = 2) readonly buffer RoundPlaces { uint roundPlaces[]; }; // refining: each one's place
layout(std430, set = 0, binding = 3) readonly buffer Accum { vec4 accum[]; };         // [slice texel][column]
layout(std430, set = 0, binding = 4) readonly buffer DetailAccum { vec4 detailAccum[]; };
layout(std430, set = 0, binding = 5) buffer State { vec4 state[]; };                  // [place][column]: the sums; column 0's w the squares
layout(std430, set = 0, binding = 6) buffer StatePasses { uint statePasses[]; };
layout(std430, set = 0, binding = 7) buffer SplitSky { uvec2 skyPart[]; };
layout(std430, set = 0, binding = 8) buffer SplitSun { uvec2 sunPart[]; };
layout(std430, set = 0, binding = 16) buffer TexelProvenance { uint provenance[]; };
// Each texel's passes (32 rays each) at its last gather, 16 bits a texel (SponzaLoop.TexelPicker.cs: the rays view, the
// view dump): where neighbours stopped at different counts.
layout(std430, set = 0, binding = 17) buffer TexelRays { uint texelRays[]; };
#include "provenance.glsl"
layout(std430, set = 0, binding = 9) buffer SkyDetail { uint skyDetail[]; };
layout(std430, set = 0, binding = 10) buffer SunDetail { uint sunDetail[]; };
layout(std430, set = 0, binding = 11) buffer Next { uint nextIds[]; };
layout(std430, set = 0, binding = 12) buffer NextPlaces { uint nextPlaces[]; };
layout(std430, set = 0, binding = 13) buffer Histogram { uint histogram[]; };          // 128 quarter stops from 2^-24
layout(std430, set = 0, binding = 14) buffer NextCount { uint nextCount[]; };
// The texels the round may refine (a bit a texel; uKeep.y on): the fine round's contact-flagged alone.
layout(std430, set = 0, binding = 15) readonly buffer RefineMask { uint refineMask[]; };
// The pooled stop: each texel's patch (the cook's pick; -1 none: its own noise alone), and per patch 4 floats (as bits:
// float atomics by compare-and-swap) -- the relative noise summed, the light summed, the texels.
layout(std430, set = 0, binding = 18) readonly buffer TexelPatch { int texelPatch[]; };
layout(std430, set = 0, binding = 19) buffer Pool { uint pool[]; };
// --near-glow-split (texel_nodes_shade.glsl, NodeGlow): the slice's glow from sheets within the frame's pass-by, by place
// as the sums are, and per texel (rgb9e5 per unit of the sun's irradiance, word 1 bit 16 once written) -- what the lit
// pass leaves out of a sheet pixel's far side, the frame drawing it per pixel (lit.frag, lightmapBackIrradiance).
layout(std430, set = 0, binding = 20) readonly buffer NodeGlow { vec4 nodeGlow[]; };
layout(std430, set = 0, binding = 21) buffer GlowState { vec4 glowState[]; };
layout(std430, set = 0, binding = 22) buffer GlowPart { uvec2 glowPart[]; };
const uint POOL_LEAST = 4u;   // a pool of fewer texels says nothing

void poolAdd(uint at, float v) {
    uint old = pool[at];
    for (int i = 0; i < 64; ++i) {
        uint got = atomicCompSwap(pool[at], old, floatBitsToUint(uintBitsToFloat(old) + v));
        if (got == old) return;
        old = got;
    }
}

uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

// SponzaLoop.SplitDetail.cs's PackDetail.
uint packDetail(vec2 tilt, float sky) {
    vec2 t = clamp(tilt * 0.5, vec2(-1.0), vec2(1.0));
    uvec2 q = uvec2(ivec2(round(t * 127.0)) & 0xFF);
    return q.x | (q.y << 8) | (uint(round(sqrt(clamp(sky, 0.0, 1.0)) * 255.0)) << 16) | (255u << 24);
}

float lum(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 unpackRgb9e5(uint w) {
    float scale = exp2(float(int(w >> 27) - 15 - 9));
    return vec3(float(w & 511u), float((w >> 9) & 511u), float((w >> 18) & 511u)) * scale;
}
vec3 unpackSky(uint id) { return unpackRgb9e5(skyPart[id].x); }

// CookSettled: past the most rays, or the composed light's standard error under the noise share of the larger of its
// light and the bar.
// A texel's judged light (the eye's: with a kept sky, the sun's noise against the whole) and its passes' variance.
void passStats(uint place, uint id, uint suns, uint passes, out float judged, out float own, out float variance) {
    own = 0.0;
    bool kept = u.uKeep.x > 0.5;
    if (kept) own = lum(state[place * suns + uint(u.uMode.z)].rgb);
    else for (uint k = 0u; k < suns; ++k) own += lum(state[place * suns + k].rgb);
    own /= float(passes);
    variance = max(state[place * suns].w / float(passes) - own * own, 0.0);
    judged = kept ? own + lum(unpackSky(id)) : own;
}

// The pooled stop's part: the texel's patch's relative noise into its pool (the sweep).
void poolTexel(uint place, uint id, uint suns, uint passes) {
    int p = texelPatch[id];
    if (p < 0) return;
    float judged, own, variance;
    passStats(place, id, suns, passes, judged, own, variance);
    if (own <= 0.0) return;
    poolAdd(4u * uint(p), min(variance / (own * own), 1e4));
    poolAdd(4u * uint(p) + 1u, own);
    atomicAdd(pool[4u * uint(p) + 2u], 1u);
}

bool settled(uint place, uint id, uint suns, uint passes, float bar, out float mean) {
    float own, variance;
    passStats(place, id, suns, passes, mean, own, variance);
    if (float(passes) * 32.0 >= u.uSettle.x) return true;
    if (u.uKeep.w > 0.5) {
        int p = texelPatch[id];
        uint texels = p >= 0 ? pool[4u * uint(p) + 2u] : 0u;
        if (texels >= POOL_LEAST) {
            float rel = uintBitsToFloat(pool[4u * uint(p)]) / float(texels);
            float light = uintBitsToFloat(pool[4u * uint(p) + 1u]) / float(texels);
            variance = max(variance, rel * light * light);
        }
    }
    float light = mean;
    // The dark bar's histogram reads the texel's whole light too (mean: the judged light): the sun's alone put the median,
    // and the bar, far down and Sponza's sun change refined 4.3 G rays where the boot refined 1.7 (2026-10-19).
    return sqrt(variance / float(passes)) <= u.uSettle.y * max(light, max(u.uSettle.z, bar));
}


void append(uint id, uint place) {
    uint j = atomicAdd(nextCount[0], 1u);
    nextIds[j] = id;
    nextPlaces[j] = place;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uSlice.y)) return;
    uint suns = uint(u.uMode.y);
    float mean;
    if (u.uMode.x > 0.5) {
        // Mode 1: the sweep's unsettled (this list, its places), judged against the bar -- with the pooled stop the whole
        // sweep, its place its index.
        uint place = u.uKeep.w > 0.5 ? t : roundPlaces[t];
        uint id = roundIds[t];
        bool done = settled(place, id, suns, statePasses[place], u.uSettle.w, mean);
        if (u.uKeep.y > 0.5 && (refineMask[id >> 5u] & (1u << (id & 31u))) == 0u) done = true;
        if (!done) append(id, place);
        return;
    }
    bool refining = u.uSlice.w > 0.5;
    uint at = uint(u.uSlice.x) + t;
    uint id = roundIds[at];
    uint place = refining ? roundPlaces[at] : at;
    uint passes = uint(u.uSlice.z) + (refining ? statePasses[place] : 0u);
    for (uint k = 0u; k < suns; ++k) {
        vec4 s = accum[t * suns + k] + (refining ? state[place * suns + k] : vec4(0.0));
        state[place * suns + k] = s;
        vec3 light = s.rgb / float(passes);
        bool sunColumn = int(k) == int(u.uMode.z);
        if (!sunColumn && u.uKeep.x > 0.5) continue;   // the sky's part kept
        uvec2 word = uvec2(packRgb9e5(sunColumn ? light * u.uSun.xyz : light), 0xFFFFu | 0x10000u);
        if (sunColumn) sunPart[id] = word; else skyPart[id] = word;
        provenanceMark(id, uint(u.uKeep.z), sunColumn, !sunColumn);   // uKeep.z: which gather (SponzaLoop.TexelPicker.cs)
        if (k == 0u) {
            uint shift = 16u * (id & 1u);
            atomicAnd(texelRays[id >> 1u], ~(0xFFFFu << shift));
            atomicOr(texelRays[id >> 1u], min(passes, 0xFFFFu) << shift);
        }
        if (!refining && u.uMode.w > 0.5) {
            // The detail, from the sweep alone (SplitDetail.cs, ReadSplitDetail): the tilt over the column's light, the
            // sky visibility from column 0's.
            vec4 d = detailAccum[t * suns + k];
            float l = lum(accum[t * suns + k].rgb);
            vec2 tilt = l > 1e-9 ? d.xy / l : vec2(0.0);
            uint w = packDetail(tilt, detailAccum[t * suns].z / u.uSun.w);
            if (sunColumn) sunDetail[id] = w; else skyDetail[id] = w;
        }
    }
    statePasses[place] = passes;
    if (u.uGlow.x > 0.5) {
        vec4 gs = nodeGlow[t] + (refining ? glowState[place] : vec4(0.0));
        glowState[place] = gs;
        glowPart[id] = uvec2(packRgb9e5(gs.rgb / float(passes) * u.uSun.xyz), 0x10000u);
    }
    if (!refining && u.uKeep.w > 0.5) poolTexel(place, id, suns, passes);
    // Judged without the bar on the sweep (mode 1 judges its unsettled again once the bar is known), with it on a round.
    bool done = settled(place, id, suns, passes, refining ? u.uSettle.w : 0.0, mean);
    // The fine round refines its contact-flagged texels alone (their seams' noise was the excess; the rest settle at the
    // sweep): uKeep.y.
    if (u.uKeep.y > 0.5 && (refineMask[id >> 5u] & (1u << (id & 31u))) == 0u) done = true;
    if (!refining && mean > 0.0) atomicAdd(histogram[uint(clamp((log2(mean) + 24.0) * 4.0, 0.0, 127.0))], 1u);
    if (!done) append(id, place);
}
