#version 450

// The traced sun shadows, interleaved (ShadowsSettings.Interleave): rt_shadow_rays.comp traced one pixel of each 2x2
// this frame (uFill.x), a different one each frame; this writes the other three's words, before the penumbra filter or
// anything else reads the mask.
//
//   last frame's word  where the pixel's surface was there last frame: its point reprojected into last frame's mask,
//                      and the depth last frame saw there (RtShadowDepth, written here for every pixel) within a few
//                      percent of the point's own -- not disoccluded. A pixel is retraced every fourth frame, so a
//                      reused word is at most three frames old.
//   the neighbours     otherwise: the traced pixels around it on its own surface (plane and normal agree), blocked if
//                      most of them are; with none on its surface, the nearest traced pixel's.
//
// Every pixel's depth is written for the next frame's test. A traced pixel's word is left as traced. A word taken from
// another pixel brings that pixel's sheet light with it (the mask's second plane: a ray through a curtain, bit 2).
//
// Half res (uHalf.x, RenderSettings.HalfResShadows): the mask's pixels are half-res, each standing for the full-res pixel
// 2h + uHalf.yz -- its depth and normal read there, last frame's point found on the half-res grid. Interleaved whenever the
// camera moves (the mask not kept, SponzaLoop.RtShadows.cs), at either resolution.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform RtShadowFill {
    mat4 uInvViewProj;   // this frame's (jittered), as the rays pass took
    mat4 uPrevViewProj;  // last frame's (jittered): where last frame's mask was traced
    vec4 uCamera;        // xyz the camera
    vec4 uSize;          // xy the mask's size
    vec4 uFill;          // x this frame's traced pixel of each 2x2 (x + 2y); y 1: last frame's mask and depth are good;
                         // z 1: every pixel was traced (the depth alone written, for the next frame)
    vec4 uHalf;          // x 1: the mask is half-res; yz the full-res pixel of its 2x2 each half-res pixel stands for
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) buffer RtShadowMask { uvec4 maskHeader; uint maskWords[]; };
layout(std430, set = 0, binding = 4) readonly buffer RtShadowPrevMask { uvec4 prevHeader; uint prevWords[]; };
layout(std430, set = 0, binding = 5) writeonly buffer RtShadowDepth { float depths[]; };
layout(std430, set = 0, binding = 6) readonly buffer RtShadowPrevDepth { float prevDepths[]; };

// The full-res pixel a mask pixel stands for.
ivec2 fullOf(ivec2 m) {
    return u.uHalf.x > 0.5 ? min(m * 2 + ivec2(u.uHalf.yz), textureSize(uSceneDepth, 0) - 1) : m;
}

// The surface point at a mask pixel, and its depth (clip w) in this frame's view.
vec4 surfaceAt(ivec2 m, float raw) {
    vec2 ndc = (vec2(fullOf(m)) + 0.5) / vec2(textureSize(uSceneDepth, 0)) * 2.0 - 1.0;
    vec4 w = u.uInvViewProj * vec4(ndc, raw, 1.0);
    return vec4(w.xyz / w.w, 1.0 / w.w);
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(u.uSize.xy);
    if (q.x >= size.x || q.y >= size.y) return;
    uint index = uint(q.y) * uint(size.x) + uint(q.x);
    float raw = texelFetch(uSceneDepth, fullOf(q), 0).r;
    // The normal read only where it decides something (below): every pixel's was most of this pass's traffic.
    bool surface = raw < 1.0 - 1e-6;
    vec4 here = surface ? surfaceAt(q, raw) : vec4(0.0);
    depths[index] = here.w;
    if (u.uFill.z > 0.5) return;
    uint phase = uint(u.uFill.x);
    if (uint(q.x & 1) + 2u * uint(q.y & 1) == phase || !surface) return;   // traced, or no surface (the rays pass wrote 0)

    vec3 pQ = here.xyz;
    vec3 nQ = vec3(0.0);
    bool normalRead = false;
    if (u.uFill.y > 0.5) {
        vec4 clip = u.uPrevViewProj * vec4(pQ, 1.0);
        if (clip.w > 1e-4) {
            vec2 prev = (clip.xy / clip.w * 0.5 + 0.5) * vec2(textureSize(uSceneDepth, 0));
            ivec2 pp = u.uHalf.x > 0.5 ? ivec2(floor((prev - u.uHalf.yz) * 0.5)) : ivec2(floor(prev));
            if (all(greaterThanEqual(pp, ivec2(0))) && all(lessThan(pp, size))) {
                uint pi = uint(pp.y) * uint(size.x) + uint(pp.x);
                float seen = prevDepths[pi];
                // Grazing surfaces change depth fast across a pixel: the tolerance widens as the normal turns from the view,
                // from 2% facing it to 5% edge on. Within 2% the normal cannot matter, and is not read.
                float off = seen > 0.0 ? abs(seen - clip.w) : 1e30;
                bool same = off <= 0.02 * clip.w;
                if (!same && off <= 0.05 * clip.w) {
                    vec4 nSample = texelFetch(uPrepassNormal, fullOf(q), 0);
                    normalRead = true;
                    if (dot(nSample.xyz, nSample.xyz) < 1e-6) return;   // no surface (the rays pass wrote 0)
                    nQ = normalize(nSample.xyz);
                    vec3 view = normalize(u.uCamera.xyz - pQ);
                    same = off <= (0.02 + 0.03 * (1.0 - abs(dot(nQ, view)))) * clip.w;
                }
                if (same) {
                    maskWords[index] = prevWords[pi] & ~0xFF00u;
                    uint n = uint(size.x) * uint(size.y);
                    if ((prevWords[pi] & 4u) != 0u) maskWords[n + index] = prevWords[n + pi];
                    return;
                }
            }
        }
    }

    // Disoccluded, or no history: this frame's traced pixels in the 3x3 around it.
    if (!normalRead) {
        vec4 nSample = texelFetch(uPrepassNormal, fullOf(q), 0);
        if (dot(nSample.xyz, nSample.xyz) < 1e-6) return;   // no surface (the rays pass wrote 0)
        nQ = normalize(nSample.xyz);
    }
    float tolerance = 0.005 + 0.004 * length(pQ - u.uCamera.xyz);
    int onSurface = 0, blocked = 0;
    uint blockedWord = 1u, nearestWord = 0u, blockedAt = 0u, nearestAt = 0u;
    float nearest = 1e9;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 t = q + ivec2(dx, dy);
            if (any(lessThan(t, ivec2(0))) || any(greaterThanEqual(t, size))) continue;
            if (uint(t.x & 1) + 2u * uint(t.y & 1) != phase) continue;
            float tRaw = texelFetch(uSceneDepth, fullOf(t), 0).r;
            if (tRaw >= 1.0 - 1e-6) continue;
            uint at = uint(t.y) * uint(size.x) + uint(t.x);
            uint word = maskWords[at];
            vec3 pT = surfaceAt(t, tRaw).xyz;
            float d = length(pT - pQ);
            if (d < nearest) { nearest = d; nearestWord = word; nearestAt = at; }
            vec4 nT = texelFetch(uPrepassNormal, fullOf(t), 0);
            if (abs(dot(nQ, pT - pQ)) > tolerance || dot(nT.xyz, nT.xyz) < 1e-6 || dot(normalize(nT.xyz), nQ) < 0.8) continue;
            onSurface++;
            if ((word & 1u) != 0u) { blocked++; blockedWord = word; blockedAt = at; }
        }
    }
    bool fromBlocked = onSurface != 0 && 2 * blocked > onSurface;
    uint word = onSurface == 0 ? nearestWord : fromBlocked ? blockedWord : 0u;
    maskWords[index] = word & ~0xFF00u;
    uint n = uint(size.x) * uint(size.y);
    if ((word & 4u) != 0u) maskWords[n + index] = maskWords[n + (fromBlocked ? blockedAt : nearestAt)];
}
