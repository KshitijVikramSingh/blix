#version 450
// --live-texels (SponzaLoop.SplitLanding.cs): a landed slice's texels into a part's buffer on the GPU -- the buffer is
// the part, with no CPU mirror uploaded whole. The mirrors (133 MB a part) went up whole every second of the sweep, and
// paged in from swap: frames of a quarter second and more (2026-10-16). A thread an item: its words (1 or 2) to the
// texel's place.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform SplitScatter {
    vec4 uScatter;   // x the items, y the words an item
} u;

layout(std430, set = 0, binding = 1) readonly buffer ScatterIds { uint ids[]; };
layout(std430, set = 0, binding = 2) readonly buffer ScatterValues { uint values[]; };
layout(std430, set = 0, binding = 3) buffer ScatterTarget { uint target[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u.uScatter.x)) return;
    uint words = uint(u.uScatter.y);
    for (uint w = 0u; w < words; ++w) target[ids[i] * words + w] = values[i * words + w];
}
