#version 450

// --rtgi-probe (S0, SponzaLoop.RtgiProbe): the lean shade and cache update a gather ray's hit would cost, against a
// spatial hash shaped like SHaRC's -- a key per slot (cell coordinates, the level its distance from the camera picks,
// the normal's octant), linear probing over 8 slots, radiance read (the lookup) and added to atomically (the update).
// The light is a stand-in; what is measured is the memory traffic. Reads the last frame's rays and hits (the wavefront's
// answers arrive a frame later).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiProbeShade {
    vec4 uShade;    // x: hits; y: slots - 1 (a power of two); z: the finest cell (m); w: its growth per metre of distance
    vec4 uCamera;   // xyz: position
} u;

layout(std430, set = 0, binding = 1) readonly buffer RtgiProbeRayBuffer { vec4 rays[]; };
layout(std430, set = 0, binding = 2) readonly buffer RtgiProbeHits { uvec4 hits[]; };
layout(std430, set = 0, binding = 3) buffer RtgiCacheKeys { uint keys[]; };
layout(std430, set = 0, binding = 4) buffer RtgiCacheData { uint data[]; };
layout(std430, set = 0, binding = 5) writeonly buffer RtgiProbeLight { vec4 light[]; };

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u.uShade.x)) return;
    uvec4 h0 = hits[3u * i];
    if ((h0.w & 1u) == 0u) { light[i] = vec4(0.0); return; }
    uvec4 h2 = hits[3u * i + 2u];
    vec4 o = rays[2u * i];
    vec4 d = rays[2u * i + 1u];
    vec3 p = o.xyz + d.xyz * uintBitsToFloat(h0.x);
    vec3 n = vec3(uintBitsToFloat(h2.x), uintBitsToFloat(h2.y), uintBitsToFloat(h2.z));
    float cell = u.uShade.z + u.uShade.w * length(p - u.uCamera.xyz);
    uint level = uint(clamp(floor(log2(cell / u.uShade.z)), 0.0, 15.0));
    float size = u.uShade.z * exp2(float(level));
    ivec3 c = ivec3(floor(p / size));
    uint oct = (n.x > 0.0 ? 1u : 0u) | (n.y > 0.0 ? 2u : 0u) | (n.z > 0.0 ? 4u : 0u);
    uint key = hash(uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u ^ (level << 3 | oct) * 2654435761u) | 1u;
    uint mask = uint(u.uShade.y);
    uint slot = key & mask;
    uint found = 0xFFFFFFFFu;
    for (uint k = 0u; k < 8u; k++) {
        uint s = (slot + k) & mask;
        uint prev = atomicCompSwap(keys[s], 0u, key);
        if (prev == 0u || prev == key) { found = s; break; }
    }
    if (found == 0xFFFFFFFFu) { light[i] = vec4(0.0); return; }
    // The lookup: the cell's radiance so far (sum and count); then the update: this hit's stand-in light added.
    uvec4 cached = uvec4(data[4u * found], data[4u * found + 1u], data[4u * found + 2u], data[4u * found + 3u]);
    vec4 albedo = unpackUnorm4x8(h2.w);
    vec3 radiance = cached.w > 0u ? vec3(cached.xyz) / (255.0 * float(cached.w)) : vec3(0.0);
    atomicAdd(data[4u * found], uint(albedo.r * 255.0));
    atomicAdd(data[4u * found + 1u], uint(albedo.g * 255.0));
    atomicAdd(data[4u * found + 2u], uint(albedo.b * 255.0));
    atomicAdd(data[4u * found + 3u], 1u);
    light[i] = vec4(radiance * albedo.rgb, 1.0);
}
