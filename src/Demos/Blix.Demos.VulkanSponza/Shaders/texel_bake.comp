#version 450
// The texels' bake (SponzaLoop.TexelBake.cs): in place of texel_mark.comp, which queues what the image reads, this
// queues the next slice of every live texel (TexelLive: the hashed records and the lightmap's not buried in a solid),
// so texel_gather.comp sweeps them all, one 32-ray pass each a sweep, until every one holds the target. Its result is
// saved, and a later run starts from it settled.
//
// The slice goes in list 0 of the gather's queue (the other three empty), at the bake's own budget.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform TexelBake {
    vec4 uBake;   // x the slice's first entry in TexelLive, y its length (the budget), z the frame's parity, w the live count
} u;

layout(std430, set = 0, binding = 1) readonly buffer TexelLive { uint texelLive[]; };
layout(std430, set = 0, binding = 2) buffer TexelQueue { uint texelQueue[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = uint(u.uBake.y);
    uint parity = uint(u.uBake.z);
    if (i < 4u) texelQueue[parity * 4u + i] = i == 0u ? count : 0u;
    if (i >= count) return;
    texelQueue[8u + i] = texelLive[(uint(u.uBake.x) + i) % uint(u.uBake.w)];
}
