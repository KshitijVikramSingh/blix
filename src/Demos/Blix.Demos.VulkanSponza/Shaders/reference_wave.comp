#version 450
// The gate's surface reference as a WAVEFRONT (SponzaLoop.GpuReference.cs): cosine-sampled paths from each point, every
// ray traced by the frame's batch operations (SponzaLoop.RayBatch.cs) -- Metal's hardware, or the software traversal --
// one bounce a frame:
//
//   step     (uParams.x 0) a lane with no path starts one at its point (or, its quota met, stops); every live lane
//            writes its next cosine ray from where it stands
//   CLOSEST  the batch
//   shade    (uParams.x 1) a miss brings the sky and ends the path; a hit past the last lit one ends it; any other hit
//            writes a ray toward the sun and the sun light it would bring, chooses the path's next direction, and
//            becomes its next start
//   CLOSEST  the sun's batch
//   resolve  (uParams.x 2) the sun light lands where the sun ray met nothing (--ref-bsdf: twice more, past thin panes)
//
// A thin sheet (ReferenceSheets, uCount.w): of the light reaching either side, 1 - T meets the base lobe (albedo) and T
// the transmission lobe (T c, Lambertian about the far side) -- so the sun on the side away from the ray is the sheet's
// glow on this one, and a path goes through with probability T. Shadow rays meet a sheet as any surface: a diffuse sheet
// scatters the beam, it does not pass it (tools/gi-model/thin_sheet.py).
//
// The glTF BSDF (uCount.w bit 2, --ref-bsdf): every hit is shaded with bsdf_gltf.glsl -- GGX metal and dielectric, ior, specular, thin-walled transmission,
// diffuse transmission, and a SOLID (KHR_materials_volume with a thickness: a refracting interface, Beer-Lambert attenuation inside) -- from the row's material
// (ReferenceMaterialRows, ReferenceMaterialTable) and baked means (ReferenceRowMr), both sides of the surface. The reference's own tracer sees the panes the
// frame's rays pass (SponzaLoop.ReferenceMaterials.cs); the sun's ray goes on through a thin pane, by its straight-through transmission, in extra
// rounds (modes 2 and 3). A solid blocks the sun (no caustics): light reaches what is behind glass by the sky and the bounces.
//
// The diffuse lobe is EON (diffuse_eon.glsl) wherever the surface was baked with a diffuse roughness (SponzaLoop.Diffuse.cs): a
// hit's word holds the albedo a bounce keeps (EON's hemispherical albedo) and the roughness level it was baked at, from which the
// base albedo comes back exactly. Each hit is shaded with the BRDF itself: the sun with f_EON(toSun, toPrevious) cos, and the next
// direction, cosine-sampled about the normal AT THE HIT (so the BRDF is weighed against the direction actually taken), carries
// pi f_EON(next, toPrevious). At roughness 0 (a Lambert bake) both are the old albedo / pi and albedo, exactly.
//
// Bounces count as the retired CPU reference counted them, which the GI gate's history was measured with: the sun at hits
// 1..N+1, the sky escaping after up to N+1 hits. A finished path adds pi x its radiance to its lane's sum; the host adds a point's lanes at the
// shot. Lane l serves point l / uParams.w.

#define PI 3.14159265359
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform ReferenceWave {
    vec4 uSunDirection;    // xyz the direction the sun travels
    vec4 uSunIrradiance;   // rgb; w the sky's radiance scale (--ref-sky)
    vec4 uParams;          // x the mode (0 step, 1 shade, 2 resolve), y bounces, z paths a lane in all, w lanes a point
    vec4 uCount;           // x lanes, y the frame (seed), z the tangent of the sun's angular radius (--ref-sun-disc; 0 a point sun),
                           // w bit 0: thin sheets (ReferenceSheets), bit 1: the sun's rays as closest rays (always), bit 2: the glTF BSDF
    vec4 uLift;            // x how far off a hit a path and its sun ray go on (--ref-lift; 1 mm)
} u;

layout(set = 0, binding = 1) uniform samplerCube uSkyRadiance;
// Two vec4s a point: its position, then its normal.
layout(std430, set = 0, binding = 2) readonly buffer ReferencePointList { vec4 points[]; };
// Per lane, its path (the layout beside main); the host starts every lane with no path (hits -1).
layout(std430, set = 0, binding = 3) buffer ReferenceLanes { vec4 lanes[]; };
// Per lane, the pending sun light and the sum of its finished paths.
layout(std430, set = 0, binding = 4) buffer ReferenceLaneSums { vec4 sums[]; };
layout(std430, set = 0, binding = 5) buffer BatchRays { vec4 batchRays[]; };
layout(std430, set = 0, binding = 6) readonly buffer BatchHits { uvec4 batchHits[]; };
// Per triangle row, the sheet it is (KHR_materials_diffuse_transmission; 0: none): rgb8 T c, the light its transmission
// lobe passes to the far side; the top byte T, the share that lobe takes (the base lobe's albedo keeps 1 - T).
layout(std430, set = 0, binding = 10) readonly buffer ReferenceSheets { uint sheets[]; };
// The sun's rays as CLOSEST rays: each lane's, and its answer -- anything met in the way is shade. The same trace the paths
// take, so the reference's sheets stop the beam whatever the frame's shadow kernel makes of sheets that transmit (its
// glow mode lets rays through them). With a disc (uCount.z), each toward its own point of it. Read back by the BSDF's
// later sun rounds (past a pane, the ray goes on from beyond it).
layout(std430, set = 0, binding = 11) buffer BatchSunRays { vec4 batchSunRays[]; };
layout(std430, set = 0, binding = 12) readonly buffer BatchSunHits { uvec4 batchSunHits[]; };

// Nothing here traces (the batches do); ray_query.glsl comes in for blix_pcg and the scene's blocks (the BSDF's tangents).
// The BSDF mode's inputs. Per lane: the medium its path is in (the solid's material index + 1; 0: air). Per triangle row: its material index (0xFFFFFFFF: none, the
// default diffuse) and baked roughness (low byte) and metallic. Per material six vec4s: (base colour factor, metallic), (roughness, ior, specular, transmission),
// (specular colour, diffuse transmission), (diffuse transmission colour, diffuse roughness override), (attenuation coefficient per metre, 0), (flags: x solid,
// y a thin transmitting pane the sun passes through).
layout(std430, set = 0, binding = 21) buffer ReferenceMedium { uint medium[]; };
layout(std430, set = 0, binding = 22) readonly buffer ReferenceMaterialRows { uint materialRows[]; };
layout(std430, set = 0, binding = 23) readonly buffer ReferenceMaterialTable { vec4 materialTable[]; };
layout(std430, set = 0, binding = 24) readonly buffer ReferenceRowMr { uint rowMr[]; };
// The scene's texture coordinates, one per ray position (RayQueryGpuData.Uvs): the tangent of an anisotropic hit comes from the triangle's.
layout(std430, set = 0, binding = 25) readonly buffer ReferenceUvs { vec2 refUvs[]; };
// The table's vec4s a material: 0 (base colour factor, metallic), 1 (roughness, ior, specular, transmission), 2 (specular colour, diffuse transmission), 3 (diffuse
// transmission colour, -), 4 (attenuation coefficient, -), 5 (flags: x solid, y a thin transmitting pane), 6 (sheen colour, sheen roughness), 7 (clearcoat,
// clearcoat roughness, iridescence, iridescence ior), 8 (iridescence thickness, anisotropy, anisotropy rotation, -), 9 (emitted radiance, -).
const uint REF_STRIDE = 10u;

#define BLIX_RAY_SET 0
#define BLIX_RAY_BINDING 13
#include "ray_query.glsl"
#include "bsdf_gltf.glsl"

float referenceRand(inout uint s) { s = blix_pcg(s); return float(s & 0xFFFFFFu) / 16777216.0; }

vec3 referenceCosineAround(vec3 n, float u1, float u2) {
    float r = sqrt(u1);
    float phi = 2.0 * PI * u2;
    vec3 t = normalize(abs(n.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), n) : cross(vec3(1.0, 0.0, 0.0), n));
    vec3 b = cross(n, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

bool referenceSheetsOn() { return (uint(u.uCount.w + 0.5) & 1u) != 0u; }

bool referenceBsdfOn() { return (uint(u.uCount.w + 0.5) & 4u) != 0u; }

// The row's material for the BSDF: the table's factors, the row's baked means, the row's albedo word (base colour at its diffuse roughness level), and its sheet
// (the diffuse transmission, as the old reference reads it).
BlixGltfMaterial referenceMaterial(uint mi, uint rowIdx, vec4 albedoWord) {
    vec4 m1 = materialTable[REF_STRIDE * mi + 1u], m2 = materialTable[REF_STRIDE * mi + 2u];
    BlixGltfMaterial m = blix_gltfDefaultMaterial();
    m.diffuseRoughness = albedoWord.a;
    m.baseColor = blix_eonBaseFromHemispherical(albedoWord.rgb, albedoWord.a);
    uint mr = rowMr[rowIdx];
    m.roughness = float(mr & 255u) / 255.0;
    m.metallic = float((mr >> 8u) & 255u) / 255.0;
    m.ior = m1.y;
    m.specular = m1.z;
    m.transmission = m1.w;
    m.specularColor = m2.rgb;
    m.solid = materialTable[REF_STRIDE * mi + 5u].x > 0.5;
    vec4 m6 = materialTable[REF_STRIDE * mi + 6u], m7 = materialTable[REF_STRIDE * mi + 7u], m8 = materialTable[REF_STRIDE * mi + 8u];
    m.sheenColor = m6.rgb;
    m.sheenRoughness = m6.w;
    m.clearcoat = m7.x;
    m.clearcoatRoughness = m7.y;
    m.iridescence = m7.z;
    m.iridescenceIor = m7.w;
    m.iridescenceThickness = m8.x;
    m.anisotropy = m8.y;
    m.anisotropyRotation = m8.z;
    uint sheet = referenceSheetsOn() ? sheets[rowIdx] : 0u;
    float share = float(sheet >> 24) / 255.0;
    m.diffuseTransmission = share;
    m.dtColor = share > 0.0 ? min(unpackUnorm4x8(sheet).rgb / share, vec3(1.0)) : vec3(1.0);
    return m;
}

// The media a path is in, innermost first: up to three solids' material indices + 1, ten bits each (0: air). The index of the one entered from is what a surface
// bounds against, and the innermost one's attenuation is what the path runs through.
float referenceMediumIor(uint entry) { return entry == 0u ? 1.0 : materialTable[REF_STRIDE * (entry - 1u) + 1u].y; }

// The tangent of the hit triangle in world space (dP/du of its texture coordinates, turned by its entry's transform, made square to the normal): the direction an
// anisotropic lobe's roughness is measured along.
vec3 referenceTangent(uint row, uint entry, vec3 n) {
    uvec4 tri = blix_triangles[row];
    vec3 p0 = blix_positions[tri.x].xyz, p1 = blix_positions[tri.y].xyz, p2 = blix_positions[tri.z].xyz;
    vec2 d1 = refUvs[tri.y] - refUvs[tri.x], d2 = refUvs[tri.z] - refUvs[tri.x];
    float det = d1.x * d2.y - d1.y * d2.x;
    vec3 e1 = p1 - p0, e2 = p2 - p0;
    vec3 local = abs(det) > 1e-12 ? (e1 * d2.y - e2 * d1.y) / det : e1;
    vec3 t = inverse(mat3(blix_instances[entry].worldToLocal)) * local;
    t -= n * dot(n, t);
    return dot(t, t) > 1e-14 ? normalize(t) : normalize(abs(n.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), n) : cross(vec3(1.0, 0.0, 0.0), n));
}

// lanes[4l + 0] origin.xyz, hits so far (-1: no path)
// lanes[4l + 1] normal.xyz, paths finished
// lanes[4l + 2] throughput.rgb, seed bits
// lanes[4l + 3] the path's radiance so far
// sums[2l + 0]  pending sun light (rgb), w unused
// sums[2l + 1]  the lane's finished paths: sum of pi x radiance (rgb), count
void main() {
    uint l = gl_GlobalInvocationID.x;
    if (l >= uint(u.uCount.x)) return;
    int mode = int(u.uParams.x + 0.5);
    int bounces = int(u.uParams.y + 0.5);
    vec4 a = lanes[4u * l], b = lanes[4u * l + 1u], c = lanes[4u * l + 2u], r = lanes[4u * l + 3u];

    if (mode == 0) {
        uint seed = floatBitsToUint(c.w);
        if (a.w < 0.0) {
            if (b.w >= u.uParams.z) {   // the lane's quota is met: no ray
                batchRays[2u * l] = vec4(0.0);
                batchRays[2u * l + 1u] = vec4(0.0, 0.0, 1.0, 0.0);
                return;
            }
            uint point = l / uint(u.uParams.w);
            vec3 n = normalize(points[2u * point + 1u].xyz);
            a = vec4(points[2u * point].xyz, 0.0);
            b = vec4(n, b.w);
            c = vec4(1.0, 1.0, 1.0, c.w);
            r = vec4(0.0);
            if (seed == 0u) seed = blix_pcg(l * 9781u + uint(u.uCount.y) * 2654435761u + 1u);
            if (referenceBsdfOn()) medium[l] = 0u;
        }
        // The first ray of a path: a cosine ray about the point's normal; after a hit, the direction the shade step already chose
        // (b.xyz): it is drawn there, where the BRDF at the hit can be weighed against it.
        vec3 dir = a.w >= 0.5 ? b.xyz : referenceCosineAround(b.xyz, referenceRand(seed), referenceRand(seed));
        batchRays[2u * l] = vec4(a.xyz, 0.0);
        batchRays[2u * l + 1u] = vec4(dir, uintBitsToFloat(0x7F800000u));
        lanes[4u * l] = a;
        lanes[4u * l + 1u] = b;
        lanes[4u * l + 2u] = vec4(c.xyz, uintBitsToFloat(seed));
        lanes[4u * l + 3u] = r;
        return;
    }

    if (a.w < 0.0) return;   // no path (the quota met)
    if (mode == 1) {
        uvec4 h0 = batchHits[3u * l], h2 = batchHits[3u * l + 2u];
        vec3 dir = batchRays[2u * l + 1u].xyz;
        sums[2u * l] = vec4(0.0);
        batchSunRays[2u * l] = vec4(0.0);
        batchSunRays[2u * l + 1u] = vec4(0.0, 1.0, 0.0, 0.0);
        bool ended = false;
        if ((h0.w & 1u) == 0u) {
            r.rgb += c.rgb * textureLod(uSkyRadiance, dir, 1.0).rgb * u.uSunIrradiance.w;
            ended = true;
        } else if (int(a.w + 0.5) == bounces + 1) {
            ended = true;   // a hit past the last one lit: only its escape would have counted
        } else {
            vec3 normal = vec3(uintBitsToFloat(h2.x), uintBitsToFloat(h2.y), uintBitsToFloat(h2.z));
            vec4 albedoWord = unpackUnorm4x8(h2.w);
            float rough = albedoWord.a;                                       // the diffuse roughness the word's albedo was baked at
            vec3 base = blix_eonBaseFromHemispherical(albedoWord.rgb, rough);   // the material's own albedo: the BRDF needs it, a bounce's albedo is the hemispherical one
            vec3 wo = -dir;                                                   // toward where the path came from
            vec3 hn = dot(normal, dir) > 0.0 ? -normal : normal;
            uint matRow = batchHits[3u * l + 1u].z;
            uint matIndex = (referenceBsdfOn() && matRow != 0xFFFFFFFFu) ? materialRows[matRow & 0x7FFFFFFFu] : 0xFFFFFFFFu;
            if (matIndex != 0xFFFFFFFFu) {
                // The glTF BSDF: the path's segment through its medium, the sun's light at the hit, and the next direction -- on whichever side.
                float tSeg = uintBitsToFloat(h0.x);
                uint med = medium[l];
                if ((med & 1023u) != 0u) c.rgb *= exp(-materialTable[REF_STRIDE * ((med & 1023u) - 1u) + 4u].rgb * tSeg);
                vec3 hpB = a.xyz + dir * tSeg;
                bool front = (h0.w & 2u) != 0u;
                BlixGltfMaterial m = referenceMaterial(matIndex, matRow & 0x7FFFFFFFu, albedoWord);
                bool solid = blix_gltfIsSolid(m);
                vec3 nB = solid ? (front ? hn : -hn) : hn;   // a solid's outward side: the ray's side where it hit the front, the far side from inside
                // The medium it is entered from: entering a solid, the innermost one (air without); leaving it, the one outside it (the second).
                m.etaOut = referenceMediumIor(front ? (med & 1023u) : ((med >> 10u) & 1023u));
                // The roughness's directions: the triangle's own tangent where the lobe is anisotropic (the instance's entry rides the hit's flags), any otherwise.
                vec3 tx = (m.anisotropy > 0.0) ? referenceTangent(matRow & 0x7FFFFFFFu, h0.w >> 4u, nB)
                                               : normalize(abs(nB.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), nB) : cross(vec3(1.0, 0.0, 0.0), nB));
                vec3 ty = cross(nB, tx);
                // What the surface gives off along the ray (KHR_materials_emissive_strength folded into the table).
                vec4 emitted = materialTable[REF_STRIDE * matIndex + 9u];
                vec3 emission = emitted.rgb;
                if (emitted.w > 0.5) {   // textured: the row's mean of the texture (RGB565 in the upper half of the row's word)
                    uint e565 = rowMr[matRow & 0x7FFFFFFFu] >> 16u;
                    emission *= vec3(float((e565 >> 11u) & 31u) / 31.0, float((e565 >> 5u) & 63u) / 63.0, float(e565 & 31u) / 31.0);
                }
                r.rgb += c.rgb * emission;
                vec3 woL = vec3(dot(wo, tx), dot(wo, ty), dot(wo, nB));
                bool inside = woL.z < 0.0;
                uint bs = blix_pcg(floatBitsToUint(c.w) ^ 0xB5297A4Du ^ (l * 0x68E31DA4u));
                vec3 toSunB = -normalize(u.uSunDirection.xyz);
                if (u.uCount.z > 0.0) {
                    vec3 ax = abs(toSunB.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
                    vec3 txs = normalize(cross(ax, toSunB));
                    vec3 tys = cross(toSunB, txs);
                    uint hs = blix_pcg(floatBitsToUint(c.w) ^ (l * 0x2545F491u) ^ uint(u.uCount.y) * 0x9E3779B9u);
                    float rr = sqrt(float(hs >> 8) / 16777216.0) * u.uCount.z;
                    float ph = float(blix_pcg(hs) >> 8) / 16777216.0 * 6.28318530718;
                    toSunB = normalize(toSunB + rr * (cos(ph) * txs + sin(ph) * tys));
                }
                if (!inside) {
                    vec3 sunL = vec3(dot(toSunB, tx), dot(toSunB, ty), dot(toSunB, nB));
                    vec3 fS = blix_gltfEval(m, woL, sunL);
                    if ((!solid || sunL.z > 0.0) && dot(fS, vec3(1.0)) > 0.0) {
                        vec3 oS = hpB + nB * (sunL.z > 0.0 ? 1.0 : -1.0) * u.uLift.x;
                        batchSunRays[2u * l] = vec4(oS, 0.0);
                        batchSunRays[2u * l + 1u] = vec4(toSunB, uintBitsToFloat(0x7F800000u));
                        sums[2u * l] = vec4(c.rgb * fS * abs(sunL.z) * u.uSunIrradiance.rgb, 0.0);
                    }
                }
                vec3 wiL = vec3(0.0, 0.0, 1.0), weightB = vec3(0.0);
                bool ok;
                if (inside) {
                    float aI = blix_bsdfAlpha(m.roughness);
                    ok = blix_ifaceSampleDirection(aI, m.etaOut, m.ior, woL, bs, wiL);
                    float pI = blix_ifacePdf(aI, m.etaOut, m.ior, woL, wiL);
                    ok = ok && pI > 0.0;
                    if (ok) weightB = blix_ifaceEval(aI, m.etaOut, m.ior, vec3(1.0), woL, wiL) * abs(wiL.z) / pI;   // the tint was taken on the way in
                } else {
                    ok = blix_gltfSample(m, woL, bs, wiL, weightB);
                }
                if (ok) {
                    c.rgb *= weightB;
                    float sideN = wiL.z > 0.0 ? 1.0 : -1.0;
                    a = vec4(hpB + nB * sideN * u.uLift.x, a.w + 1.0);
                    b.xyz = normalize(wiL.x * tx + wiL.y * ty + wiL.z * nB);
                    if (solid && !inside && wiL.z < 0.0) medium[l] = (med << 10u) | (matIndex + 1u);   // in: this solid becomes the innermost
                    else if (solid && inside && wiL.z > 0.0) medium[l] = med >> 10u;                   // out: the one it was in
                } else {
                    c.rgb = vec3(0.0);   // no sample: the path carries nothing on (it ends at the bounce cap), its sun light already counted
                    a = vec4(hpB + nB * u.uLift.x, a.w + 1.0);
                    b.xyz = nB;
                }
                c.w = uintBitsToFloat(bs);
            } else {
            uint sheet = 0u;
            if (referenceSheetsOn()) {
                uint row = batchHits[3u * l + 1u].z;
                if (row != 0xFFFFFFFFu) sheet = sheets[row & 0x7FFFFFFFu];
            }
            vec3 passed = unpackUnorm4x8(sheet).rgb;            // T c
            float share = float(sheet >> 24) / 255.0;          // T
            vec3 hp = a.xyz + dir * uintBitsToFloat(h0.x);
            vec3 toSun = -normalize(u.uSunDirection.xyz);
            if (u.uCount.z > 0.0) {
                // A uniform point of the disc (radius sqrt(u1), angle 2 pi u2), in a frame about the sun's direction.
                vec3 ax = abs(toSun.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
                vec3 tx = normalize(cross(ax, toSun));
                vec3 ty = cross(toSun, tx);
                uint hs = blix_pcg(floatBitsToUint(c.w) ^ (l * 0x2545F491u) ^ uint(u.uCount.y) * 0x9E3779B9u);
                float rr = sqrt(float(hs >> 8) / 16777216.0) * u.uCount.z;
                float ph = float(blix_pcg(hs) >> 8) / 16777216.0 * 6.28318530718;
                toSun = normalize(toSun + rr * (cos(ph) * tx + sin(ph) * ty));
            }
            float ndl = dot(hn, toSun);
            if (ndl > 0.0) {
                batchSunRays[2u * l] = vec4(hp + hn * u.uLift.x, 0.0);
                batchSunRays[2u * l + 1u] = vec4(toSun, uintBitsToFloat(0x7F800000u));
                sums[2u * l] = vec4(c.rgb * blix_eonBrdf(base, rough, ndl, dot(hn, wo), dot(toSun, wo)) * (1.0 - share) * u.uSunIrradiance.rgb * ndl, 0.0);
            } else if (sheet != 0u && ndl < 0.0) {
                // The sun on the sheet's far side: its glow on this one, the sun ray from there.
                batchSunRays[2u * l] = vec4(hp - hn * u.uLift.x, 0.0);
                batchSunRays[2u * l + 1u] = vec4(toSun, uintBitsToFloat(0x7F800000u));
                sums[2u * l] = vec4(c.rgb * passed * u.uSunIrradiance.rgb * (-ndl) / PI, 0.0);
            }
            // On: reflected (the base lobe, 1 - T of the light, albedo) or through (T, tinted c), chosen by T.
            uint seedNow = floatBitsToUint(c.w) ^ 0xB5297A4Du ^ (l * 0x68E31DA4u);
            bool through = sheet != 0u && referenceRand(seedNow) < share;
            // The next direction is drawn here, about the side the path leaves by: through (Lambertian transmission) or back out (the base lobe, whose
            // weight pi f_EON(next, wo) takes the drawn direction), so the next step only reads it.
            uint nextSeed = blix_pcg(seedNow ^ 0x27D4EB2Fu);
            if (through) {
                c.rgb *= passed / max(share, 1e-4);
                a = vec4(hp - hn * u.uLift.x, a.w + 1.0);
                b.xyz = referenceCosineAround(-hn, referenceRand(nextSeed), referenceRand(nextSeed));
            } else {
                vec3 next = referenceCosineAround(hn, referenceRand(nextSeed), referenceRand(nextSeed));
                c.rgb *= PI * blix_eonBrdf(base, rough, dot(hn, next), dot(hn, wo), dot(next, wo));
                a = vec4(hp + hn * u.uLift.x, a.w + 1.0);
                b.xyz = next;
            }
            c.w = uintBitsToFloat(nextSeed);
            }
        }
        if (ended) {
            vec4 s = sums[2u * l + 1u];
            sums[2u * l + 1u] = vec4(s.rgb + PI * r.rgb, s.w + 1.0);
            a.w = -1.0;
            b.w += 1.0;
        }
        lanes[4u * l] = a;
        lanes[4u * l + 1u] = b;
        lanes[4u * l + 2u] = c;
        lanes[4u * l + 3u] = r;
        return;
    }

    // modes 2 and 3: the sun light lands where nothing was in the way. In the BSDF mode a thin transmitting pane in the way is not: mode 2 takes the light on
    // through it (times its straight-through transmission) from just beyond it, for the next round's sun batch; mode 3, the last, stops at anything.
    vec4 pending = sums[2u * l];
    bool shade = (batchSunHits[3u * l].w & 1u) != 0u;
    if (shade && mode == 2 && referenceBsdfOn() && dot(pending.rgb, vec3(1.0)) > 0.0) {
        uint srow = batchSunHits[3u * l + 1u].z;
        uint smi = srow != 0xFFFFFFFFu ? materialRows[srow & 0x7FFFFFFFu] : 0xFFFFFFFFu;
        if (smi != 0xFFFFFFFFu && materialTable[REF_STRIDE * smi + 5u].y > 0.5) {
            vec3 so = batchSunRays[2u * l].xyz, sd = batchSunRays[2u * l + 1u].xyz;
            float st = uintBitsToFloat(batchSunHits[3u * l].x);
            vec3 sn = normalize(vec3(uintBitsToFloat(batchSunHits[3u * l + 2u].x), uintBitsToFloat(batchSunHits[3u * l + 2u].y), uintBitsToFloat(batchSunHits[3u * l + 2u].z)));
            BlixGltfMaterial pm = referenceMaterial(smi, srow & 0x7FFFFFFFu, unpackUnorm4x8(batchSunHits[3u * l + 2u].w));
            vec3 fr = blix_bsdfFresnelDielectric(pm, abs(dot(sn, sd)));
            vec3 passed = (1.0 - pm.metallic) * (vec3(1.0) - fr) * pm.baseColor * pm.transmission * 1.0;
            sums[2u * l] = vec4(pending.rgb * passed, 0.0);
            batchSunRays[2u * l] = vec4(so + sd * (st + u.uLift.x), 0.0);
            return;
        }
    }
    if (dot(pending.rgb, vec3(1.0)) > 0.0 && !shade) {
        lanes[4u * l + 3u] = vec4(r.rgb + pending.rgb, 0.0);
        sums[2u * l] = vec4(0.0);   // taken: a later round of the sun batch must not add it again
    }
}
