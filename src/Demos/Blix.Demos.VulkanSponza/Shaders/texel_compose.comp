#version 450
// The texels' light, split (SponzaLoop.SplitLight.cs): each live texel's resting answer (TexelResolved, as
// texel_resolve.comp writes it) composed from its two parts -- the sky's, as solved, times the sky's scale; the sun's,
// solved and stored per unit of the sun's irradiance, times the sun's irradiance now. Light is linear: a stronger or
// weaker sun, a brighter or tinted sky, is this pass again, not a new solve.
//   mode 0  the parts composed into TexelComposed
//   mode 1  (--texel-filter) TexelComposed filtered into TexelResolved, as texel_filter.comp filters the gather's light:
//           the weights from the composed light, so each part is filtered with the same weights (light stays linear:
//           a part filtered on its own would find other edges). Unfiltered, the cook's parts left the crevices'
//           corridor at 0.075 |error| against the gather's 0.036 (2026-10-13).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform TexelCompose {
    vec4 uCompose;   // x live texels, y the mode, z 1: the sky visibility cooked (SkyVis), not the parts' detail; w 1 (--texel-h4):
                     // the light-agnostic record's shape (texel_shape.glsl) -- mode 0 each texel's own (TexelOwnShape: its
                     // gather's or its fine copy's, by its provenance; cleared where neither) into TexelShape, mode 1 pooled
                     // over the filter's neighbours into TexelShape
    vec4 uSky;       // rgb the sky's scale (1: as solved)
    vec4 uSun;       // rgb the sun's irradiance (its part is stored per unit of it); w 0: no sun part yet
    vec4 uTexelGrid;  // mode 1: xyz the cells' origin, w the spacing
    vec4 uTexelParams; // mode 1: x hash capacity
    vec4 uLightmap;   // mode 1: as texel_filter.comp's
    vec4 uEdge;       // mode 1: x, y as texel_filter.comp's; z the shapes' pool radius (m) past the filter's neighbours (0 none)
} u;

layout(std430, set = 0, binding = 1) readonly buffer SunNodesLive { uint liveIds[]; };
layout(std430, set = 0, binding = 2) readonly buffer TexelSky { uvec2 texelSky[]; };
layout(std430, set = 0, binding = 3) readonly buffer TexelSun { uvec2 texelSun[]; };
layout(std430, set = 0, binding = 4) writeonly buffer TexelResolved { uvec2 texelResolved[]; };
layout(std430, set = 0, binding = 5) buffer TexelComposed { uvec2 texelComposed[]; };
layout(std430, set = 0, binding = 6) readonly buffer TexelHash { uvec4 texelHash[]; };
layout(std430, set = 0, binding = 7) readonly buffer Texels { vec4 texels[]; };
#include "texel_record.glsl"
// The atlas's map from texel to record, as an R32UI texture (SponzaLoop.LightmapGather.cs).
layout(set = 0, binding = 8) uniform usampler2D uLightmapIndexTex;
// Mode 1: each atlas texel's neighbours across a chart seam (SponzaLoop.Seams.cs) -- start an atlas record (from the first
// one), then the ids -- so a chart's border is filtered with the chart it meets, not on its own.
layout(std430, set = 0, binding = 9) readonly buffer TexelSeamStart { uint seamStart[]; };
layout(std430, set = 0, binding = 10) readonly buffer TexelSeamIds { uint seamIds[]; };
// Mode 0: the cells' detail (SponzaLoop.SplitDetail.cs; texelDetailPack) per part, composed as the light is: the parts'
// directions weighted by their light, the sky visibility the sky part's.
layout(std430, set = 0, binding = 11) readonly buffer TexelSkyDetail { uint texelSkyDetail[]; };
layout(std430, set = 0, binding = 12) readonly buffer TexelSunDetail { uint texelSunDetail[]; };
layout(std430, set = 0, binding = 13) writeonly buffer TexelDetail { uint texelDetail[]; };
// The texels' cooked sky visibility (texel_ao.comp): a byte a texel id, 1..255, 0 none.
layout(std430, set = 0, binding = 14) readonly buffer TexelSkyVis { uint texelSkyVis[]; };
// --texel-h4: a texel's own shape -- its record's where a gather wrote its light last (texel_record_h4.glsl), else the
// fine copy's (transfer_fine.comp) -- and the frame's, pooled over its neighbours: their shapes by the filter's weight
// and their light's likeness, exp(-|ln(L_o / L)| / 0.3) (tools/gi-model/direction_pooling.py: 128-ray directions within
// 20 cm, the error above the truth's floor halved, no smear at creases).
layout(std430, set = 0, binding = 17) buffer TexelOwnShape { uint ownShape[]; };
layout(std430, set = 0, binding = 18) writeonly buffer TexelShape { uint texelShape[]; };
layout(std430, set = 0, binding = 19) readonly buffer TexelProvenance { uint provenance[]; };
#define TEXEL_INDEX_MAP(i) texelFetch(uLightmapIndexTex, ivec2(int(i) % textureSize(uLightmapIndexTex, 0).x, int(i) / textureSize(uLightmapIndexTex, 0).x), 0).r
#define TEXEL_HASH(i) texelHash[i]
#include "texel.glsl"
#include "texel_filter_neighbour.glsl"
#define TEXEL_SHAPE_NO_STORE
#include "texel_shape.glsl"

// The texel's own shape (three channels) or false: what its gather wrote when both its parts were last a gather's
// (provenance 1-4), what its fine copy wrote (5) -- one buffer, the last writer the one its provenance names.
bool ownShapeOf(uint id, out uint w0, out uint w1, out uint w2) {
    w0 = 0u; w1 = 0u; w2 = 0u;
    uint p = (provenance[id / 4u] >> (8u * (id % 4u))) & 255u;
    uint sunCode = p & 15u, skyCode = p >> 4;
    bool gathered = skyCode >= 1u && skyCode <= 4u && sunCode >= 1u && sunCode <= 4u;
    if (!gathered && skyCode != 5u && sunCode != 5u) return false;
    w0 = ownShape[id * 3u]; w1 = ownShape[id * 3u + 1u]; w2 = ownShape[id * 3u + 2u];
    return texelShapeUnpack(w0).w > 0.5;
}

void shapeAdd(uint other, float w, inout vec3 a0, inout vec3 a1, inout vec3 a2, inout float aw) {
    vec4 q0 = texelShapeUnpack(ownShape[other * 3u]);
    if (q0.w < 0.5 || w <= 0.0) return;
    a0 += w * q0.xyz;
    a1 += w * texelShapeUnpack(ownShape[other * 3u + 1u]).xyz;
    a2 += w * texelShapeUnpack(ownShape[other * 3u + 2u]).xyz;
    aw += w;
}

uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

vec3 unpackRgb9e5(uint p) {
    float scale = exp2(float(int(p >> 27) - 15 - 9));
    return vec3(p & 511u, (p >> 9) & 511u, (p >> 18) & 511u) * scale;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u.uCompose.x)) return;
    uint id = liveIds[i];
    if (int(u.uCompose.y) == 0) {
        uvec2 sky = texelSky[id];
        uvec2 sun = texelSun[id];
        vec3 skyLight = unpackRgb9e5(sky.x) * u.uSky.rgb;
        vec3 sunLight = u.uSun.w > 0.5 ? unpackRgb9e5(sun.x) * u.uSun.rgb : vec3(0.0);
        vec3 light = skyLight + sunLight;
        const vec3 luma = vec3(0.2126, 0.7152, 0.0722);
        uint skyDetail = texelSkyDetail[id], sunDetail = texelSunDetail[id];
        bool sunNeeded = u.uSun.w > 0.5 && dot(sunLight, luma) > 0.0;
        if ((skyDetail >> 24) == 0u || (sunNeeded && (sunDetail >> 24) == 0u)) {
            texelDetail[id] = 0u;   // none: the incident pass keeps the clipmap here
        } else {
            float ls = dot(skyLight, luma), lu = sunNeeded ? dot(sunLight, luma) : 0.0;
            vec3 ds = texelDetailUnpack(skyDetail);
            vec2 tilt = ds.xy * ls;
            if (sunNeeded) tilt += texelDetailUnpack(sunDetail).xy * lu;
            float sky = ds.z;
            if (u.uCompose.z > 0.5) {
                uint b = (texelSkyVis[id / 4u] >> (8u * (id % 4u))) & 255u;
                if (b > 0u) { sky = float(b - 1u) / 254.0; sky *= sky; }   // stored by its square root
            }
            texelDetail[id] = texelDetailPack(ls + lu > 0.0 ? tilt / (ls + lu) : vec2(0.0), sky);
        }
        // Valid where the sky's part is (every live texel the cook traced); its confidence the cook's (full).
        texelComposed[id] = uvec2(packRgb9e5(light), sky.y);
        if (u.uCompose.w > 0.5) {
            uint w0, w1, w2;
            if (!ownShapeOf(id, w0, w1, w2)) {
                w0 = w1 = w2 = 0u;
                ownShape[id * 3u] = w0; ownShape[id * 3u + 1u] = w1; ownShape[id * 3u + 2u] = w2;   // the pool reads none
            }
            texelShape[id * 3u] = w0; texelShape[id * 3u + 1u] = w1; texelShape[id * 3u + 2u] = w2;
        }
        return;
    }
    uvec2 own = texelComposed[id];
    if ((own.y & 0x10000u) == 0u) { texelResolved[id] = own; return; }
    const vec3 luma = vec3(0.2126, 0.7152, 0.0722);
    vec3 position = TEXEL_POSITION(id).xyz;
    vec3 n = TEXEL_NORMAL(id).xyz;
    float centre = dot(unpackRgb9e5(own.x), luma);
    TexelGrid finestGrid;
    finestGrid.minCorner = u.uTexelGrid.xyz;
    finestGrid.spacing = u.uTexelGrid.w;
    finestGrid.capacity = uint(u.uTexelParams.x);
    finestGrid.level = 0u;
    vec4 acc = vec4(0.0);
    bool shapes = u.uCompose.w > 0.5;
    vec3 sa0 = vec3(0.0), sa1 = vec3(0.0), sa2 = vec3(0.0);
    float saw = 0.0;
    float lc = max(centre, 1e-12);
    for (uint k = 0u; k < 27u; ++k) {
        TexelGrid tg;
        int other = texelFilterNeighbour(int(id), k, position, n, finestGrid, u.uLightmap, tg);
        if (other < 0) continue;
        uvec2 o = texelComposed[other];
        if ((o.y & 0x10000u) == 0u) continue;
        vec3 light = unpackRgb9e5(o.x);
        float w = texelFilterWeight(other, position, n, tg, centre, dot(light, luma), u.uEdge);
        acc += vec4(w * light, w);
        if (shapes) shapeAdd(uint(other), w * exp(-abs(log(max(dot(light, luma), 1e-12) / lc)) / 0.3), sa0, sa1, sa2, saw);
    }
    if (u.uLightmap.x > 0.5 && float(id) >= u.uLightmap.w - 0.5 && u.uLightmap.w > 0.5) {
        TexelGrid tg = finestGrid;
        tg.spacing = 0.04;   // as texelFilterNeighbour weighs an atlas texel's own neighbours
        uint at = id - uint(u.uLightmap.w + 0.5);
        for (uint e = seamStart[at]; e < seamStart[at + 1u]; ++e) {
            int other = int(seamIds[e]);
            uvec2 o = texelComposed[other];
            if ((o.y & 0x10000u) == 0u) continue;
            vec3 light = unpackRgb9e5(o.x);
            float w = texelFilterWeight(other, position, n, tg, centre, dot(light, luma), u.uEdge);
            acc += vec4(w * light, w);
            if (shapes) shapeAdd(uint(other), w * exp(-abs(log(max(dot(light, luma), 1e-12) / lc)) / 0.3), sa0, sa1, sa2, saw);
        }
    }
    // --texel-shape-pool R (uEdge.z): an atlas record's shape pooled further than the filter's 3 x 3 -- rings of 8 atlas
    // texels 3 and 5 out (12 and 20 cm at 4 cm texels; a Gaussian of R / 2), on its plane, turned its way, by their light's
    // likeness: tools/gi-model/direction_pooling.py, 128-ray shapes 6.5% at 20 deg, pooled 20 cm by likeness 5.1%, the
    // truth's floor 3.7%, no smear at creases.
    if (shapes && u.uEdge.z > 0.0 && u.uLightmap.x > 0.5 && float(id) >= u.uLightmap.w - 0.5) {
        uint packedAt = floatBitsToUint(TEXEL_NORMAL(id).w);
        ivec2 at0 = ivec2(int(packedAt & 0xFFFFu), int(packedAt >> 16));
        float sigma = 0.5 * u.uEdge.z;
        for (int ring = 3; ring <= 5; ring += 2) {
            for (int k = 0; k < 8; ++k) {
                ivec2 d = ivec2(k < 3 ? k - 1 : k == 3 ? -1 : k == 4 ? 1 : k - 6, k < 3 ? -1 : k < 5 ? 0 : 1) * ring;
                ivec2 at = at0 + d;
                if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, ivec2(u.uLightmap.yz)))) continue;
                uint o = TEXEL_INDEX_MAP(at.y * int(u.uLightmap.y) + at.x);
                if (o == 0xFFFFFFFFu) continue;
                if (TEXEL_POSITION(o).w < 0.0 && dot(TEXEL_NORMAL(o).xyz, n) < 0.0) o += 1u;
                if (abs(TEXEL_POSITION(o).w) < 2.0) continue;
                uvec2 c = texelComposed[o];
                if ((c.y & 0x10000u) == 0u) continue;
                vec3 dp = TEXEL_POSITION(o).xyz - position;
                vec3 on = TEXEL_NORMAL(o).xyz;
                float f = dot(normalize(on), normalize(n));
                if (f <= 0.0 || abs(dot(normalize(n), dp)) > 0.04) continue;   // another surface (the atlas runs on past a fold)
                float lo = dot(unpackRgb9e5(c.x), luma);
                float w = exp(-0.5 * dot(dp, dp) / (sigma * sigma)) * f * f * f * f * exp(-abs(log(max(lo, 1e-12) / lc)) / 0.3);
                shapeAdd(o, w, sa0, sa1, sa2, saw);
            }
        }
    }
    if (shapes) {
        // its own in the pool whatever the filter made of it (a texel the filter's weights left alone keeps its own)
        shapeAdd(id, 1.0, sa0, sa1, sa2, saw);
        if (saw > 0.0) {
            texelShape[id * 3u] = texelShapePack(sa0 / saw);
            texelShape[id * 3u + 1u] = texelShapePack(sa1 / saw);
            texelShape[id * 3u + 2u] = texelShapePack(sa2 / saw);
        }
    }
    texelResolved[id] = acc.w > 1e-6 ? uvec2(packRgb9e5(acc.rgb / acc.w), own.y) : own;
}
