#version 450
// Which texels this frame's image reads (SponzaLoop.SplitLight.cs, VisibleFirst): a bit a record, set for every texel
// the incident pass weighs at each pixel -- the four atlas texels a lightmapped pixel reads, and the hashed cells at
// every level where the atlas leaves the surface out (and at the coarser levels a lightmapped pixel blends toward). The
// split light's cook traces these first, so a source change reaches what is on screen before the rest.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform TexelVisible {
    mat4 uInvProjection;
    mat4 uInvView;
    vec4 uTarget;       // xy the depth target's pixels, z the pixel stride
    vec4 uTexelGrid;    // xyz the cells' origin, w the spacing
    vec4 uTexelParams;  // x hash capacity, y levels
    vec4 uLightmap;     // x 1 when the atlas's texels are on, yz the atlas size
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) readonly buffer TexelHash { uvec4 texelHash[]; };
layout(std430, set = 0, binding = 4) readonly buffer Texels { vec4 texels[]; };
layout(std430, set = 0, binding = 5) buffer TexelVisibleBits { uint visibleBits[]; };
layout(set = 0, binding = 6) uniform usampler2D uLightmapTexel;
layout(std430, set = 0, binding = 7) readonly buffer LightmapIndexMap { uint lightmapIndexMap[]; };
#define TEXEL_INDEX_MAP(i) lightmapIndexMap[i]
#define TEXEL_HASH(i) texelHash[i]
#define TEXEL_POSITION(i) texels[2 * (i)]
#define TEXEL_NORMAL(i) texels[2 * (i) + 1]
#include "texel.glsl"

void markTexel(int id) {
    if (id < 0) return;
    atomicOr(visibleBits[uint(id) >> 5], 1u << (uint(id) & 31u));
}

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy) * int(u.uTarget.z);
    if (any(greaterThanEqual(at, ivec2(u.uTarget.xy)))) return;
    vec2 uv = (vec2(at) + 0.5) / u.uTarget.xy;
    float raw = texelFetch(uSceneDepth, at, 0).r;
    if (raw >= 1.0 - 1e-6) return;
    vec4 view = u.uInvProjection * vec4(uv * 2.0 - 1.0, raw, 1.0);
    vec3 world = (u.uInvView * vec4(view.xyz / view.w, 1.0)).xyz;
    vec4 nSample = texelFetch(uPrepassNormal, at, 0);
    if (dot(nSample.xyz, nSample.xyz) < 1e-6) return;
    vec3 n = normalize(nSample.xyz);

    TexelGrid g;
    g.minCorner = u.uTexelGrid.xyz;
    g.spacing = u.uTexelGrid.w;
    g.capacity = uint(u.uTexelParams.x);
    g.level = 0u;
    int levels = int(u.uTexelParams.y);
    vec2 atlasTexel = vec2(0.0);
    bool lightmap = u.uLightmap.x > 0.5 && texelLightmapUnpack(texelFetch(uLightmapTexel, at, 0).r, atlasTexel);
    int ids[TEXEL_CANDIDATES];
    float weights[TEXEL_CANDIDATES];
    for (int level = 0; level < levels; ++level) {
        if (lightmap && level == 0) {
            int lm[4];
            float lw[4];
            texelsAroundLightmap(atlasTexel, n, ivec2(u.uLightmap.yz), lm, lw);
            for (int i = 0; i < 4; ++i) markTexel(lm[i]);
            continue;
        }
        texelsAround(texelLevelGrid(g, uint(level)), world, n, nSample.w, ids, weights);
        for (int i = 0; i < TEXEL_CANDIDATES; ++i) markTexel(ids[i]);
    }
}
