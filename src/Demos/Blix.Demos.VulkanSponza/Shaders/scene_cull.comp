#version 450

// The scene's placements culled and LOD-selected on the GPU: what FillIndirect did on the CPU, one
// pass's list at a time, in three dispatches (uArgs.w says which).
//
//   0  reset     one thread per indirect record of this pass: the record from its drawable's level
//                (indexCount, firstIndex, vertexOffset), instanceCount 0, and its scatter cursor 0.
//   1  classify  one thread per placement: the same visibility and LOD choice as the CPU fill
//                (FillIndirect / Drawable.PickLod / PickLodWorld / SceneExitDistance), the level
//                kept as the placement's LOD state and the visible ones counted into their record.
//   2  scatter   one thread per visible placement: its record's firstInstance is the drawable's
//                region start plus the counts of the levels before it, and its transform row goes
//                into the next free slot of that run.
//
// A drawable's region in the visible list is its placements' run (visibleBase + placementStart, as
// many slots as it has placements), split by level in level order, exactly as the CPU lays it out.
// The order of placements within one level is whatever the atomics give, which no draw depends on.

layout(local_size_x = 64) in;

#include "scene_cull.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint mode = uint(u.uArgs.w);
    if (mode == 0u) {
        if (i < uint(u.uArgs.y)) reset(i);
    } else if (i < uint(u.uRange.y)) {
        if (mode == 1u) classify(i);
        else scatter(i);
    }
}
