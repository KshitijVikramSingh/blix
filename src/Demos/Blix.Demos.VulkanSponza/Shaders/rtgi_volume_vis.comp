#version 450

// RTGI's world volume (SponzaLoop.RtgiVolume.cs): which probes a cache cell's point sees, traced. The readout asks for a cell the
// first time it reads one (rtgi_readout.frag: a point of it, its normal, the level to trace to); here, a frame on, a ray
// from that point to each of the 8 probes around it at that level (the Metal batch traces them), then the mask of those
// it reached, kept with the cell (tagged with its key: a slot emptied and taken by another cell asks again). The readout
// reads the volume only through those probes. The depth maps' statistical test (rtgi_volume.glsl's volSees) let probes
// behind walls thinner than a depth texel's spread of distances light the far side -- Crytek Sponza's arches, its cloth,
// the lavabo (the user, 2026-10-29); a ray is the geometry's own answer, and cells stand still now (sized by the geometry,
// not the camera), so each is traced once.
//
// And its neighbours across the surface: from the same point, a ray each way along the surface's two axes, a cell's size
// long, at its level and the two coarser (12): the readout blends a cell with its neighbours, and at a junction the
// neighbour can be the same wall's continuation past the ceiling it meets, lit, facing the same way -- a bright line along
// every crease of the crevices testbed (the user, 2026-10-29). A neighbour the ray did not reach is left out for good.
//
// uVis.w the kind: 0 the rays (placement time), 1 the masks (with the training), 2 the list emptied (after the masks).
// A request's word (its second vec4's w): bits 0-3 the probes' level (15 none), 8-15 its cache level, 16-18 its side.
// The mask: bits 0-7 the probes reached, 8-11 their level, 12 done, 16-27 the neighbours reached (level offset x 4 +
// +a0, -a0, +a1, -a1; a0, a1 the axes after the side's).
#define VIS_RAYS 20u

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiVolumeVis {
    vec4 uVolume;   // rtgi_volume.glsl's VOL_PARAMS
    vec4 uVis;      // x the requests' room; y the cache's finest cell (m); w the kind
} u;

// The readout's requests: a count, then two vec4s each (the point, the cell's slot as bits; the normal, the level as bits).
layout(std430, set = 0, binding = 1) buffer RtgiVolumeVisRequests { uint visCount; uint visPad[3]; vec4 visRequests[]; };
// Per request, 8 rays (origin, w 0; direction, w its length) and their hits.
layout(std430, set = 0, binding = 2) buffer RtgiVolumeVisRays { vec4 visRays[]; };
layout(std430, set = 0, binding = 3) readonly buffer RtgiVolumeVisHits { uvec4 visHits[]; };
// Per cache slot: the key the mask was traced for, and its word (bits 0-7 the mask, 8-11 the level, bit 16 done).
layout(std430, set = 0, binding = 4) buffer RtgiVolumeCellVis { uvec2 cellVis[]; };
layout(std430, set = 0, binding = 5) readonly buffer RtgiVolumeTable { uvec2 volTable[]; };
layout(std430, set = 0, binding = 6) readonly buffer RtgiVolumeProbes { float volProbes[]; };

#define VOL_PARAMS u.uVolume
#define VOL_GEOM vec4(0.0)
#define VOL_TABLE(i) volTable[i]
#define VOL_PROBES(i) volProbes[i]
#define VOL_DEPTH(i) 0u
#include "rtgi_volume.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint kind = uint(u.uVis.w);
    uint count = min(visCount, uint(u.uVis.x));
    if (kind == 2u) { if (i == 0u) visCount = 0u; return; }
    if (kind == 0u) {
        if (i >= uint(u.uVis.x) * VIS_RAYS) return;
        uint r = i / VIS_RAYS, k = i % VIS_RAYS;
        visRays[2u * i] = vec4(0.0);
        visRays[2u * i + 1u] = vec4(0.0, 1.0, 0.0, 1e-6);
        if (r >= count) return;
        vec4 a = visRequests[2u * r], b = visRequests[2u * r + 1u];
        uint word = floatBitsToUint(b.w);
        vec3 o = a.xyz + b.xyz * 0.02;
        if (k >= 8u) {
            uint j = k - 8u, side = (word >> 16) & 7u, axis = side >> 1u;
            uint ax = j % 4u < 2u ? (axis + 1u) % 3u : (axis + 2u) % 3u;
            vec3 e = vec3(0.0);
            e[ax] = (j % 2u) == 0u ? 1.0 : -1.0;
            float len = u.uVis.y * exp2(float(((word >> 8) & 0xFFu) + j / 4u));
            visRays[2u * i] = vec4(o, 0.0);
            visRays[2u * i + 1u] = vec4(e, len);
            return;
        }
        vec3 q;
        if ((word & 15u) == 15u || volProbeAt(a.xyz, word & 15u, k, q) == 0xFFFFFFFFu) return;
        vec3 d = q - o;
        float len = length(d);
        if (len < 1e-3) return;
        visRays[2u * i] = vec4(o, 0.0);
        visRays[2u * i + 1u] = vec4(d / len, max(len - 0.01, 1e-3));
        return;
    }
    if (i >= count) return;
    vec4 a = visRequests[2u * i], b = visRequests[2u * i + 1u];
    uint slot = floatBitsToUint(a.w), word = floatBitsToUint(b.w);
    uint mask = 0u;
    for (uint k = 0u; k < VIS_RAYS; k++) {
        uint j = VIS_RAYS * i + k;
        bool traced = visRays[2u * j + 1u].w > 1e-5;
        if (traced && (visHits[3u * j].w & 1u) == 0u) mask |= 1u << (k < 8u ? k : k + 8u);
    }
    cellVis[slot].y = mask | ((word & 15u) << 8) | 0x1000u;
}
