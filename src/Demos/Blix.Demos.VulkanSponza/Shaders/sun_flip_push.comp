#version 450
// The moving sun's relight (SponzaLoop.FlipPush.cs): a small sun step's change to the texels' sun part pushed out from
// where it starts -- the texels whose own sun bit flipped, the surfaces a shadow edge crossed -- instead of gathered
// again at every texel (tools/gi-model/sun_flip_push.py: ~80% of the change, from 1-3% of the texels). Each flipped
// texel shoots cosine rays; what they meet takes, by reciprocity, the source's sun term (albedo times its normal,
// in the sun-linear record's units: texel_nodes_shade.glsl uSunW), plus where it came lit, minus where it went dark,
// scaled by the source's area over the receiver's and the rays shot. The hits that stayed lit change with the angle
// alone, which the record gives with no rays.
//   mode 0  the flip list: each live texel whose sun bit (the new bits) differs from the old sun's (OldBits), an entry a
//           block of M rays, its blocks its area over a finest cell's (blocks()): a ray's flux the same from any
//           texel -- M rays a texel whatever its size sent a 64-cell texel's rays with 64x the light, light and dark
//           blotches over the whole screen (2026-10-25)
//   mode 1  a chunk of the list's rays: M cosine rays a flipped texel, about its normal, lifted
//   mode 2  the chunk's hits: the receivers about each (the cook's lookup, nodeSetAt: hashed and atlas texels) take the
//           source's term into Accum (fixed point)
//   mode 3  every live texel: its record moved by what it took, its sun part by the record's change at the new sun
//           against the old (W'.s' - W.s, its colour kept), Accum cleared

layout(local_size_x = 64) in;
#define NODE_LOOKUP

layout(set = 0, binding = 0) uniform FlipPush {
    vec4 uPass;    // x the threads, y the mode, z the rays a flipped texel (M), w the chunk's first ray (mode 1, 2)
    vec4 uNewSun;  // xyz toward the new sun; w the lift
    vec4 uOldSun;  // xyz toward the old sun; w the rays' reach
    vec4 uGrid;    // the finest texel grid (origin, spacing)
    vec4 uLookup;  // x the plane's reach, y the sigma (nodeSetAt), z the cook hash's slots, w the seed
    vec4 uBits;    // x the bit words a texel, y the sun's column, z the list's room (entries), w the coarse levels' first
                   // (transferMinLevel): a hashed texel at or past it is a coarse cell, over the fine texels' surface
} u;

layout(std430, set = 0, binding = 1) readonly buffer Texels { uvec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 2) readonly buffer LiveIds { uint liveIds[]; };
layout(std430, set = 0, binding = 3) readonly buffer OldBits { uint oldBits[]; };     // a bit a texel id: the old sun's
layout(std430, set = 0, binding = 4) readonly buffer SunNodeBits { uint sunBits[]; };  // the live bits: the new sun's
layout(std430, set = 0, binding = 5) buffer FlipList { uint flipCount; uint flipPad[3]; uint flips[]; };   // id | lit << 31
layout(std430, set = 0, binding = 6) buffer FlipRays { vec4 rays[]; };                 // 2 a ray: origin, tMin; dir, tMax
layout(std430, set = 0, binding = 7) readonly buffer FlipHits { uvec4 hits[]; };       // 3 a ray (the closest batch's)
layout(std430, set = 0, binding = 8) readonly buffer SunNodeHash { uint cookHash[]; };
layout(std430, set = 0, binding = 9) readonly buffer FoliagePoints { vec4 foliagePoints[]; };
layout(std430, set = 0, binding = 10) readonly buffer FoliageHash { uint foliageHash[]; };
layout(std430, set = 0, binding = 11) readonly buffer TexelPatch { int texelPatch[]; };
layout(std430, set = 0, binding = 12) readonly buffer PatchTerms { vec4 patchTerms[]; };   // 3 a patch: [0].rgb albedo
layout(std430, set = 0, binding = 13) buffer Accum { int accum[]; };                    // 4 a texel id: W's xyz, fixed point
layout(std430, set = 0, binding = 14) buffer TexelSunW { vec4 texelSunW[]; };
layout(std430, set = 0, binding = 15) buffer SplitSun { uvec2 sunPart[]; };
#include "texel_nodes.glsl"

const float PI = 3.14159265;
const float FIXED = 1048576.0;   // 2^20

uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

vec3 unpackRgb9e5(uint p) {
    float scale = exp2(float(int(p >> 27) - 15 - 9));
    return vec3(p & 511u, (p >> 9) & 511u, (p >> 18) & 511u) * scale;
}

uint hashU(uint x) {
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
    return x;
}

bool newLit(uint id) {
    uint c = uint(u.uBits.y);
    return ((sunBits[id * uint(u.uBits.x) + c / 32u] >> (c % 32u)) & 1u) != 0u;
}

bool oldLit(uint id) { return ((oldBits[id >> 5] >> (id & 31u)) & 1u) != 0u; }

float area(uint id) { return max(abs(TEXEL_POSITION(id).w), 1.0); }

// A flipped texel's blocks of M rays: its area in finest cells (4 a cell), at least one, at most 256.
uint blocks(uint id) { return uint(clamp(round(area(id) / 4.0), 1.0, 256.0)); }

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uPass.x)) return;
    int mode = int(u.uPass.y);
    uint m = uint(u.uPass.z);
    const vec3 lumW = vec3(0.2126, 0.7152, 0.0722);
    if (mode == 0) {
        uint id = liveIds[t];
        if (abs(TEXEL_POSITION(id).w) < 2.0) return;
        // The fine texels alone emit: a coarse cell lies over the same surface as its fine texels, and both flipping, the
        // surface sent its change twice -- the step's net 2.4x the true (2026-10-25). Coarse cells still receive.
        // --flip-sources (uBits.w's sign): + the fine alone (the default), - the coarse alone (-1 - the level), 0 both.
        bool coarseCell = id < texels[1].x && TEXEL_NORMAL(id).w >= abs(u.uBits.w) - (u.uBits.w < 0.0 ? 1.0 : 0.0);
        if (u.uBits.w > 0.0 && coarseCell) return;
        if (u.uBits.w < 0.0 && !coarseCell) return;
        bool lit = newLit(id);
        if (lit == oldLit(id)) return;
        uint k = blocks(id);
        uint at = atomicAdd(flipCount, k);
        for (uint b = 0u; b < k && at + b < uint(u.uBits.z); ++b) flips[at + b] = id | (lit ? 0x80000000u : 0u);
    } else if (mode == 1) {
        uint r = uint(u.uPass.w) + t;
        uint id = flips[r / m] & 0x7FFFFFFFu;
        vec3 n = normalize(TEXEL_NORMAL(id).xyz);
        vec3 p = TEXEL_POSITION(id).xyz;
        uint h = hashU(r * 9781u + uint(u.uLookup.w));
        float u1 = float(h & 0xFFFFu) / 65536.0, u2 = float(h >> 16) / 65536.0;
        vec3 t1 = normalize(cross(abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n));
        vec3 t2 = cross(n, t1);
        float rr = sqrt(u1), phi = 2.0 * PI * u2;
        vec3 dir = normalize(t1 * (rr * cos(phi)) + t2 * (rr * sin(phi)) + n * sqrt(max(1.0 - u1, 0.0)));
        rays[2u * t] = vec4(p + n * u.uNewSun.w, 1e-4);
        rays[2u * t + 1u] = vec4(dir, u.uOldSun.w);
    } else if (mode == 2) {
        uint r = uint(u.uPass.w) + t;
        uvec4 h0 = hits[3u * t];
        // The census (flipPad): [0] rays that met nothing, [1] hits with no receiver about them, [2] hits that took one.
        if ((h0.w & 1u) == 0u) { atomicAdd(flipPad[0], 1u); return; }
        uint entry = flips[r / m];
        uint src = entry & 0x7FFFFFFFu;
        float sign = (entry & 0x80000000u) != 0u ? 1.0 : -1.0;
        vec4 ray0 = rays[2u * t], ray1 = rays[2u * t + 1u];
        vec3 hp = ray0.xyz + ray1.xyz * uintBitsToFloat(h0.x);
        vec3 normal = uintBitsToFloat(hits[3u * t + 2u].xyz);
        vec3 hn = dot(normal, ray1.xyz) > 0.0 ? -normal : normal;
        int ids[NODE_CANDIDATES];
        float weights[NODE_CANDIDATES];
        float total = nodeSetAt(0, hp, hn, u.uGrid, uint(u.uLookup.z), u.uLookup.xy, ids, weights);
        if (total <= 0.0) { atomicAdd(flipPad[1], 1u); return; }
        int srcPatch = texelPatch[src];
        float albedo = srcPatch >= 0 ? dot(patchTerms[3 * srcPatch].rgb, lumW) : 0.5;
        // The albedo alone: the gather's rays weigh cos / pdf (pi for a cosine ray: texel_nodes_rays.comp), so a hit's term
        // in the record and the parts is albedo x the sun's cosine -- with a 1 / pi more the push moved the texels a third of
        // the model's flips (slope 0.33 on Crytek Sponza's 10 deg step, 2026-10-25).
        vec3 term = sign * albedo * normalize(TEXEL_NORMAL(src).xyz) * area(src) / float(m * blocks(src));
        // The one fine texel at the hit (the best weighed of the fine candidates: the fine texels tile the surface once),
        // over its own area: each takes the landings on its own patch. Spread over the lookup's candidates by weight (a cell
        // or two about the hit) the change beside a moving shadow strip was smeared over its neighbourhood -- right in
        // total, and at 75 M rays a 10 deg step no nearer a full gather than the old light (2026-10-25). The coarse cells
        // take the record's angle alone.
        int best = -1;
        float bestW = 0.0;
        for (int c = 0; c < NODE_CANDIDATES; ++c) {
            if (ids[c] < 0 || weights[c] <= bestW) continue;
            uint cid = uint(ids[c]);
            if (cid < texels[1].x && TEXEL_NORMAL(cid).w >= abs(u.uBits.w)) continue;
            best = ids[c];
            bestW = weights[c];
        }
        if (best < 0) { atomicAdd(flipPad[1], 1u); return; }
        uint rid = uint(best);
        vec3 v = term / area(rid);
        atomicAdd(accum[rid * 4u], int(round(v.x * FIXED)));
        atomicAdd(accum[rid * 4u + 1u], int(round(v.y * FIXED)));
        atomicAdd(accum[rid * 4u + 2u], int(round(v.z * FIXED)));
        atomicAdd(flipPad[2], 1u);
    } else {
        uint id = liveIds[t];
        vec3 d = vec3(accum[id * 4u], accum[id * 4u + 1u], accum[id * 4u + 2u]) / FIXED;
        vec4 rec = texelSunW[id];
        if (rec.w <= 0.0 && dot(d, d) == 0.0) return;
        vec3 part = unpackRgb9e5(sunPart[id].x);
        float l = dot(part, lumW);
        // The debt (Accum's w, kept across steps): what the part's floor at zero took off it. A step's noise darkening a
        // texel past nothing was lost while its brightenings stayed: the net change 2x the true (2026-10-25).
        float debt = float(accum[id * 4u + 3u]) / FIXED;
        if (rec.w <= 0.0) {
            // No record (a fine texel copied, not gathered): the push's change alone, signed, and no record made of it --
            // as one (its lit share max(d.s, 0)) the dark flips were clamped away and such texels only brightened: up to
            // 2.2x after 20 steps, the sun part's energy +22% (2026-10-25).
            float want = l + dot(d, u.uNewSun.xyz) + debt;
            float moved = max(want, 0.0);
            sunPart[id].x = packRgb9e5(l > 1e-9 ? part * (moved / l) : vec3(moved));
            accum[id * 4u] = 0; accum[id * 4u + 1u] = 0; accum[id * 4u + 2u] = 0;
            accum[id * 4u + 3u] = int(round(min(want, 0.0) * FIXED));
            return;
        }
        float passes = rec.w;
        vec3 before = rec.xyz / passes, after = before + d;
        // Signed, the part alone clamped: each clamped at zero, a dark flip's deposit on a texel whose lit hits were few took
        // its after below zero and was lost while the lit flips' stayed -- the step's change 2.5x the true net (2026-10-25).
        float litBefore = dot(before, u.uOldSun.xyz), litAfter = dot(after, u.uNewSun.xyz);
        // A record over its own part (6% of the gathered: its last round's rays against every round's) moves it by its share.
        if (litBefore > l && l > 0.0) { float k = l / litBefore; litBefore *= k; litAfter *= k; }
        float want = l + litAfter - litBefore + debt;
        float target = max(want, 0.0);
        vec3 moved = l > 1e-9 ? part * (target / l) : vec3(target);
        sunPart[id].x = packRgb9e5(moved);
        texelSunW[id] = vec4(after * passes, rec.w);
        accum[id * 4u] = 0; accum[id * 4u + 1u] = 0; accum[id * 4u + 2u] = 0;
        accum[id * 4u + 3u] = int(round(min(want, 0.0) * FIXED));
    }
}
