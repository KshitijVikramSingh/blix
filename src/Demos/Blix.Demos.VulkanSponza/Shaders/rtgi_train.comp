#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// RTGI (S1, SponzaLoop.Rtgi.cs): last frame's training points, their rays answered, into the cache. Per point p (normal n):
//   indirect  E = PI * L_in along its cosine ray: the sky's radiance where it missed; where it met a surface's front at q,
//             albedo_q * (E_ind(q) + E_sun * max(0, n_q.s) * sunVis(q)) -- q's outgoing radiance times PI, from q's cell
//             (a coarser level where q's own has nothing yet; no sample at all where neither has, rather than a dark
//             one); a back face's 0 (inside something)
//   sun       whether its shadow ray reached (where it faces the sun)
// added to p's cell and to the cell two levels coarser (the readout's fallback), made where it is not held yet.

// 128 a workgroup was slower (3.36 -> 3.52 ms a dispatch on the bench, SponzaLoop.RtgiBench.cs, 2026-10-27): half the
// workgroups resident.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiTrain {
    vec4 uParams;        // rtgiParams (rtgi_cache.glsl)
    vec4 uCamera;        // xyz position; w points
    vec4 uSun;           // xyz toward the sun; w the sky cube's lod
    vec4 uSunIrradiance; // rgb
    vec4 uNearField;     // x the near field's radius (rtgi_cache.glsl's RTGI_NEAR); y the contact radius (m); z the direct sun at
                         // a ray's hit, scaled (1; 0: none -- a diagnostic of where the samples' variance comes from); w the
                         // levels a sample trains, its own first
    vec4 uList;          // x the frame's number (from 1); y the dirty list's room; z a cell listed once its waiting samples
                         // reach 1 / z of what it holds (listNow)
    vec4 uEpoch;         // x 1: a hit cell still holding an earlier sun's light (its epoch behind y, the sun's) counts as not
                         // ready (irradianceAt); w room for landing requests (0: none)
    vec4 uHitSun;        // x 1: each hit's sun traced (hit flag 8), else read from the hit cell; y 1: the levels three and four
                         // up thinned; z 1: keys and stamps read before their atomics; w a settled cell listed one frame in
                         // this many (listNow; 0 or 1: every frame)
    vec4 uFallback;      // x the levels past two up a landing may look for a cell holding light (0: two up only); y 1: the
                         // cooked near field on (the near and far words written); w 1: a cell's words summed over the subgroup before they are written, 2: over the workgroup, through
                         // its table (tableAdd)
    vec4 uDouble;        // x BLIX_RTGI_TRAIN_DOUBLE, bits, measurement only: a piece run twice, the second changing nothing
                         // (its result into a never-true test; its atomics adding 0), on another cell's memory (the next slot,
                         // the neighbour cell: cold lines, as the first's) -- the time it adds is its cost. 1 the
                         // hit's lookup, 2 the level inserts, 8 the flush's device atomics, 32 the table's shared atomics.
                         // Removals (the bench's frozen cache: no state to drift): 128 no hit lookup, 256 no flush device
                         // atomics, 512 no level finds (a slot from the hash), 2048 no level loop (its finds, table and
                         // flush), 4096 no keep-alive or stale check at a hit. Aggregation (the same light): 8192 the
                         // subgroup's rounds, 16384 each lane's own atomics
    vec4 uCapture;       // --rtgi-capture (SponzaLoop.RtgiCapture.cs): x the pinned points (the first x); y this frame's slot; z the
                         // slots (frames); 0 x: none
    vec4 uCook;          // the cooked cell set: rtgi_cook.glsl's COOK_PARAMS (w 0: not cooked yet)
    vec4 uCookCounts;    // rtgi_cook.glsl's COOK_COUNTS
    vec4 uCookTrain;     // a cooked training point's samples (rtgi_rays.comp's cookedSource): x 1 its back-face samples dropped
                         // and tallied, the point dropped from its cell's turn past z of w (cookTally); y 1 the probe's
                         // lifetime counts (RtgiCookProbe); z the back-face samples a window of w allows; w the window
    vec4 uCookTrain2;    // x the placements (RtgiCookSided's); y 1: the levels above a sample's own assembled, not trained
} u;
bool twice(uint b) { return (uint(u.uDouble.x) & b) != 0u; }
// How a sample's words reach its cell (uFallback.w): 0 each lane's atomics, 1 the subgroup's rounds, 2 the workgroup's table.
float aggregation() { return twice(16384u) ? 0.0 : twice(8192u) ? 1.0 : u.uFallback.w; }

// --rtgi-capture: per slot (frame) and pinned point three words: its sample (rgb: PI x L_in x the weight; w: 4 live + 2 sky
// + 1 counted), its hit (xyz; w the ray's weight), the hit's normal (xyz; w the distance, 1e30 a miss); then per point its
// position and normal (the last frame's).
layout(std430, set = 0, binding = 20) buffer RtgiCaptureOut { vec4 captureOut[]; };
layout(set = 0, binding = 1) uniform samplerCube uSkyRadiance;
layout(std430, set = 0, binding = 2) readonly buffer RtgiPoints { vec4 points[]; };
layout(std430, set = 0, binding = 3) readonly buffer RtgiRayBuffer { vec4 rays[]; };
layout(std430, set = 0, binding = 4) readonly buffer RtgiHits { uvec4 hits[]; };
layout(std430, set = 0, binding = 5) readonly buffer RtgiOccluded { uint occluded[]; };
layout(std430, set = 0, binding = 6) buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 7) buffer RtgiAccum { uint rtgiAccum[]; };
layout(std430, set = 0, binding = 8) readonly buffer RtgiResolved { vec4 rtgiResolved[]; };
// Where rays landed in a cell that holds nothing at its own level: the next frame trains there (rtgi_rays.comp). Read
// through the coarser cell instead, a landing took that cell's average over where training had been -- the walls the
// camera sees -- not over where it landed: the gate's dead end, lit round a corner, read 0.77 (2026-10-26). A count,
// then two vec4s each (point, normal), room for uEpoch.w.
layout(std430, set = 0, binding = 10) readonly buffer RtgiMoments { vec4 rtgiMoments[]; };
// Per slot: the frame it was last trained (x) and the sun it last saw (y, rtgi_resolve.comp). The cells trained this frame,
// listed once each for the resolve (it visits those alone: scanning every slot was 5.5 ms a frame at San Miguel's 8 M).
layout(std430, set = 0, binding = 12) buffer RtgiDirty { uint dirtyCount; uint dirtyPad[3]; uint dirty[]; };
layout(std430, set = 0, binding = 9) buffer RtgiRequests { uint requestCount; uint requestPad[3]; vec4 requests[]; };
// Per slot: its cell (coordinates, level x 6 + side), written when made -- the neighbour blend finds its neighbours by it
// (rtgi_filter.comp); and the blended light the lookups read (indirect rgb, sky visibility).
layout(std430, set = 0, binding = 13) buffer RtgiCells { ivec4 rtgiCells[]; };
layout(std430, set = 0, binding = 14) readonly buffer RtgiFiltered { vec4 rtgiFiltered[]; };


// The cache's work, counted for the profile (SponzaLoop.Rtgi.cs's RtgiWork): one atomic a subgroup, never a lane.
layout(std430, set = 0, binding = 18) buffer RtgiStats { uint rtgiStats[64]; };
// The readout's record (rtgi_cache.glsl; the blend's light, the resolve's samples held and sun epoch): a hit's cell read
// in one 32-byte line (irradianceAt).
layout(std430, set = 0, binding = 19) readonly buffer RtgiRecord { uvec4 rtgiRecord[]; };
void tally(uint slot, bool v) {
    uint n = subgroupBallotBitCount(subgroupBallot(v));
    if (subgroupElect() && n > 0u) atomicAdd(rtgiStats[slot], n);
}

// The level offset the round being added is for (0 the sample's own level): the table's new listings counted by it.
uint statOffset = 0u;
void sink(bool never) { if (never) atomicAdd(rtgiStats[63], 1u); }

#define RTGI_KEYS(i) rtgiKeys[i]
#define RTGI_NEAR u.uNearField.x
// The cooked cell set (rtgi_cook.glsl): its size table sizes the cells (rtgi_cache.glsl's rtgiCellSize), its level-0 cells'
// regions key them (rtgiRegion).
layout(std430, set = 0, binding = 24) readonly buffer RtgiCookTable { uvec2 cookTable[]; };
layout(std430, set = 0, binding = 25) readonly buffer RtgiCookPoints { vec4 cookPoints[]; };
layout(std430, set = 0, binding = 26) readonly buffer RtgiCookPieces { uvec4 cookPieces[]; };
layout(std430, set = 0, binding = 27) readonly buffer RtgiCookScale { uvec2 cookScale[]; };
#define COOK_PARAMS u.uCook
#define COOK_COUNTS u.uCookCounts
#define COOK_TABLE(i) cookTable[i]
#define COOK_POINTS(i) cookPoints[i]
#define COOK_PIECES(i) cookPieces[i]
#define COOK_SCALE(i) cookScale[i]
// The cooked training points' tallies (rtgi_cook.glsl's COOK_CELL_POINTS), the triangles' alpha-tested bits (rtgi_cook.comp's
// RtgiCookSided: a leaf's back face is a front), and the probe's lifetime counts per point (BLIX_RTGI_NEAR_PROBE: samples,
// back-face samples, the samples' luminance in 1024ths).
layout(std430, set = 0, binding = 28) buffer RtgiCookCellPoints { uvec2 cookCellPoints[]; };
layout(std430, set = 0, binding = 29) readonly buffer RtgiCookSided { uint cookSided[]; };
layout(std430, set = 0, binding = 30) buffer RtgiCookProbe { uvec4 cookProbe[]; };
#define RTGI_REGION_OF 1
#include "rtgi_cache.glsl"
#include "rtgi_cook.glsl"

// The slot for the cell at p (its level, the side n faces), made if it is not held -- its cell written then; 0xFFFFFFFF
// when its probes are all taken.
uint rtgiInsertHashed(uvec2 h, ivec4 cell);

uint rtgiInsertAt(vec3 p, vec3 n, uint level) {
    ivec3 c = ivec3(floor((p - rtgiOrigin(rtgiSide(n))) / rtgiSize(level, u.uParams)));
    uint side = rtgiSide(n);
    rtgiKeyAt(p, side);
    uint region = rtgiRegionFor(c, level, side);
    uvec2 h = rtgiCellHashR(c, level, side, region, u.uParams);
    if (twice(512u)) return h.x & uint(u.uParams.z);
    // Its region (its cube's surface piece, rtgi_cook.glsl's cookPieceAt) in bits 8 up: the filter keys its neighbours,
    // parent and children from the piece's centroid (rtgi_filter.comp).
    return rtgiInsertHashed(h, ivec4(c, int((level * 6u + side) | (region << 8))));
}

// Cell (its coordinates, level * 6 + side) of hash h found or made.
uint rtgiInsertHashed(uvec2 h, ivec4 cell) {
    // Held anywhere along its probes first: the eviction empties slots inside other cells' chains, and a swap into the
    // first empty one made a second copy of a cell held past it -- young, its history restarted, the old one left
    // untrained to be evicted in turn 1800 frames on: a wave of young cells through the resolve and the blend every ~30 s
    // on a still Crytek Sponza view (frames 16.7 -> 25 ms for ~10 s, 2026-10-27). Keys only go from 0 to a key within a
    // frame (emptied by the eviction pass alone), so a read key is current or 0, and the swap settles a 0. (Read first
    // was uHitSun.z: a held cell answering without an atomic -- most of a frame's inserts, five a sample.)
    uint held = rtgiFind(h, u.uParams);
    if (held != 0xFFFFFFFFu) return held;
    for (uint k = 0u; k < RTGI_PROBES; k++) {
        uint s = (h.x + k) & uint(u.uParams.z);
        uint prev = atomicCompSwap(rtgiKeys[s], 0u, h.y);
        if (prev == 0u) { rtgiCells[s] = cell; rtgiAccum[RTGI_ACC * s + 14u] = 0u; rtgiAccum[RTGI_ACC * s + 15u] = 0u; atomicAdd(rtgiStats[statOffset >= 8u ? 31u : statOffset == 0u ? 29u : 30u], 1u); }
        if (prev == 0u || prev == h.y) return s;
    }
    return 0xFFFFFFFFu;
}

uvec2 cellAt(vec3 p, vec3 n, uint level) {
    rtgiKeyAt(p, rtgiSide(n));
    return rtgiCellHash(ivec3(floor((p - rtgiOrigin(rtgiSide(n))) / rtgiSize(level, u.uParams))), level, rtgiSide(n), u.uParams);
}

// q's outgoing radiance times PI over its albedo: E_ind + direct sun, from its cell once it holds 8 samples, else the cell
// two levels up, else its own however few it holds; w 0 when none holds any. A cell of a sample or two passed its one
// draw on down the bounce -- odd lights that came and went (the user, Crytek Sponza, 2026-10-26). fine: its own cell
// held enough (else the landing is requested, rtgi_rays.comp).
// sunAt: the hit's own sun (its traced ray: 0 or 1), or below 0 the cell's sun visibility in its place.
// A cell a ray landed in kept from eviction (rtgi_evict.comp): a bounce source off screen is read every frame and, once
// it holds 8 samples, never trained, so at --rtgi-max-age it was emptied, its landings requested again and retrained from
// nothing -- a wave of young cells through the resolve and the blend every 1800 frames, frames 16.7 -> 25 ms for ~10 s
// on a still Crytek Sponza view, and its light restarting (2026-10-27). Stamped a frame back, so a training this frame
// still finds it unlisted; only once in 64 frames, and only where no training stamped it since.
void keepAlive(uint s) {
    uint frame = uint(u.uList.x), w = rtgiAccum[RTGI_ACC * s + 14u];
    if (((frame - w) & 0xFFFFFFu) > 64u) atomicCompSwap(rtgiAccum[RTGI_ACC * s + 14u], w, (w & 0xFF000000u) | ((frame - 1u) & 0xFFFFFFu));
}

vec4 irradianceAt(vec3 q, vec3 nq, out bool fine, float sunAt) {
    uint level = rtgiLevel(q, rtgiSide(nq), u.uCamera.xyz, u.uParams);
    fine = false;
    if (twice(128u)) { fine = true; return vec4(0.1, 0.1, 0.1, 1.0); }
    uint own = rtgiFind(cellAt(q, nq, level), u.uParams);
    vec4 o0 = vec4(0.0), o1 = vec4(0.0);
    uint epochHere = 0u;
    if (own != 0xFFFFFFFFu) {
        // From the readout's record, one 32-byte line: the light (half floats), and the samples held and the sun's epoch
        // (the resolve's, mod 2048). Its sun visibility (o1.x) only where the hit's own was not traced. The blend's light,
        // the resolve's record and the stamp were three lines: the training 3.36 -> 2.71 ms a dispatch (the bench,
        // SponzaLoop.RtgiBench.cs, 2026-10-27). Kept alive one hit in 16, a frame in turn: well within --rtgi-max-age.
        uvec4 a = rtgiRecord[2u * own], c = rtgiRecord[2u * own + 1u];
        o0 = vec4(unpackHalf2x16(a.x), unpackHalf2x16(a.y));
        o1 = vec4(sunAt >= 0.0 ? 0.0 : rtgiResolved[2u * own + 1u].x, uintBitsToFloat(c.w), 0.0, 0.0);
        epochHere = uint(unpackHalf2x16(c.z).y);
        if (!twice(4096u) && (rtgiHash(own ^ uint(u.uList.x) * 0x9E3779B9u) & 15u) == 0u) keepAlive(own);
    }
    vec4 r0 = o0, r1 = o1;
    // Stale (uEpoch.x): the hit cell has not been trained since the sun turned (rtgi_resolve.comp cuts a cell's
    // history only when it is next trained), so its light is the old sun's -- off screen, a bounce source, it may not be
    // trained for a long while, and every ray landing in it brought the old light on. Not ready: the landing is requested,
    // and its cell trained (and cut) next frame.
    bool stale = !twice(4096u) && u.uEpoch.x > 0.5 && own != 0xFFFFFFFFu
        && epochHere != (uint(u.uEpoch.y) & 2047u);
    if (o1.y >= 8.0 && !stale) fine = true;
    else {
        // Two levels up, then (uFallback.x) further: the first holding any light.
        for (uint k = 2u; k <= 2u + uint(u.uFallback.x); k++) {
            uint s = rtgiFind(cellAt(q, nq, min(level + k, uint(u.uParams.w))), u.uParams);
            // Held by the record (an assembled cell's own samples may be none; rtgi_filter.comp).
            float hk = s != 0xFFFFFFFFu ? uintBitsToFloat(rtgiRecord[2u * s + 1u].w) : 0.0;
            if (hk >= 0.5) { r0 = rtgiFiltered[s]; r1 = vec4(rtgiResolved[2u * s + 1u].x, hk, 0.0, 0.0); keepAlive(s); break; }
        }
    }
    // No probes here: a landing given the (since removed) world volume's light trained it into the cell for good -- the
    // volume's noise and its leaks with it, the darkest of Crytek Sponza 2x bright and shimmering 9% (2026-10-29). The
    // cache learns from what its rays reach.
    if (r1.y < 0.5) return vec4(0.0);
    return vec4(r0.rgb + u.uNearField.z * u.uSunIrradiance.rgb * max(0.0, dot(nq, u.uSun.xyz)) * (sunAt >= 0.0 ? sunAt : r1.x), 1.0);
}

vec4 dither;
// The level a cooked point trains + 1 (rtgi_rays.comp: bits 26-29 of its normal's w), 0 the size table's at the point.
uint cookedLevel = 0u;
vec3 sampleDir;
float captureFlags; // --rtgi-capture: 8 its hit a back face (read dark), 16 its hit's cell held no light
float nearWord;   // this sample's near visibility, weighted (256ths): it left past the contact radius
float sampleInvD; // 1 / how far its ray went (a miss: its reach)

// The cell's frame words written: listed for this frame's resolve the first time it is trained, then each non-zero word
// added. Aggregated over the subgroup first (uFallback.w): the lanes training the same cell sum their words and one of
// them writes -- ray placement concentrates the points on the cells least sure, and their atomics queued on the same
// words (Crytek Sponza at 4x the rays: training 9.7 ms, 6.9 with placement off, 2026-10-26). Up to four rounds, each
// the cell of the first lane still writing; the rest write their own.
// A slot in a list for each active lane that needs one, at one atomic per subgroup (uFallback.w): the ballot counts
// them, one lane takes them all from the counter, each lane's its offset among them. Else a lane's own atomic.
uint appendDirty(bool need) {
    if (aggregation() < 0.5) return need ? atomicAdd(dirtyCount, 1u) : 0xFFFFFFFFu;
    uvec4 b = subgroupBallot(need);
    uint count = subgroupBallotBitCount(b), base = 0u;
    if (subgroupElect() && count > 0u) base = atomicAdd(dirtyCount, count);
    base = subgroupBroadcastFirst(base);
    return need ? base + subgroupBallotExclusiveBitCount(b) : 0xFFFFFFFFu;
}

uint appendRequest(bool need) {
    if (aggregation() < 0.5) return need ? atomicAdd(requestCount, 1u) : 0xFFFFFFFFu;
    uvec4 b = subgroupBallot(need);
    uint count = subgroupBallotBitCount(b), base = 0u;
    if (subgroupElect() && count > 0u) base = atomicAdd(requestCount, count);
    base = subgroupBroadcastFirst(base);
    return need ? base + subgroupBallotExclusiveBitCount(b) : 0xFFFFFFFFu;
}

// Listed for this frame's resolve and blend when the update is worth one: its samples waiting in the accumulator
// (pending, with this frame's so far) at least 1 / uList.z of what it holds -- a resolve moves a cell's light by about
// that share -- else on its turn, one frame in uHitSun.w by its slot; its samples left in the accumulator until then,
// nothing lost. A cell behind the sun's epoch (its history cut when next resolved, rtgi_resolve.comp) at once. Listed
// every frame they were trained, the young (under 256 held, which their age cap keeps them until 1024 samples) were
// resolved every frame and blended every other at ~1.6 samples a frame -- each moved ~1%: 200-300k cells listed a frame,
// 25-33 ms frames for 15-60 s after a load or a sun turn on Crytek Sponza (2026-10-27). Still stamped either way (the
// eviction's age, rtgi_evict.comp).
// A cell's training state in its accumulator's spare words, the line its samples are added to: word 14 the frame it was
// last trained (low 24 bits; the eviction's age, rtgi_evict.comp) and the sun's epoch it was last resolved under (high 8,
// mod 256, rtgi_resolve.comp's); word 15 its samples held (the low half), the
// resolve's. In the stamp, the resolved record and the moments, a cell touched was four lines: the
// training 2.96 -> 2.54 ms a dispatch (the bench, SponzaLoop.RtgiBench.cs, 2026-10-27).
bool listNow(uint s, uint frame, uint pending) {
    if (u.uHitSun.w < 1.5) return true;
    if ((rtgiAccum[RTGI_ACC * s + 14u] >> 24) != (uint(u.uEpoch.y) & 255u)) return true;
    if (float(pending) * u.uList.z >= unpackHalf2x16(rtgiAccum[RTGI_ACC * s + 15u]).x) return true;
    return (s + frame) % uint(u.uHitSun.w) == 0u;
}

// First trained this frame: its frame bits claimed, the epoch bits kept.
bool claimFrame(uint s, uint frame) {
    uint seen = rtgiAccum[RTGI_ACC * s + 14u];
    if ((seen & 0xFFFFFFu) == (frame & 0xFFFFFFu)) return false;
    return atomicCompSwap(rtgiAccum[RTGI_ACC * s + 14u], seen, (seen & 0xFF000000u) | (frame & 0xFFFFFFu)) == seen;
}

void writeCell(uint s, uint w[RTGI_ACC]) {
    uint frame = uint(u.uList.x);
    // Listed the first time this frame; read first (uHitSun.z), the swap only where it is not stamped this frame yet.
    bool first = claimFrame(s, frame);
    // The count (word 3) first: what was waiting, for listNow.
    uint pending = atomicAdd(rtgiAccum[RTGI_ACC * s + 3u], w[3]) + w[3];
    for (uint k = 0u; k < RTGI_ACC; k++)
        if (k != 3u && w[k] != 0u) atomicAdd(rtgiAccum[RTGI_ACC * s + k], w[k]);
    uint k = appendDirty(first && listNow(s, frame, pending));
    if (k < uint(u.uList.y)) dirty[k] = s;
}

void commit(uint s, uint w[RTGI_ACC]) {
    bool writing = s != 0xFFFFFFFFu;
    if (aggregation() > 0.5) {
        for (uint round = 0u; round < 4u; round++) {
            if (!subgroupAny(writing)) return;
            if (writing) {
                uint lead = subgroupBroadcastFirst(s);
                if (s == lead) {
                    uint sum[RTGI_ACC];
                    for (uint k = 0u; k < RTGI_WORDS; k++) sum[k] = subgroupAdd(w[k]);
                    for (uint k = RTGI_WORDS; k < RTGI_ACC; k++) sum[k] = 0u;
                    if (subgroupElect()) writeCell(s, sum);
                    writing = false;
                }
            }
        }
    }
    if (writing) writeCell(s, w);
}

// The workgroup's table (uFallback.w 2): each sample's words added into its cell's row in shared memory, then one
// thread a row adds the row's words to the cell -- one device atomic a word a cell a workgroup, where the subgroup's
// rounds (commit) cost a subgroupAdd a word a round over the whole SIMD group: up to 4 rounds of 14 a level, five levels
// a sample, and Xcode's profile of Crytek Sponza's training had it bound by instruction issue and its atomics' writes
// (2026-10-26). The four 0/1 words (count, sky, sun reached, sun traced) share one table word, a byte each: a
// workgroup's 64 samples at most a byte. Every thread of the workgroup takes part in each round (its barriers), those
// with no sample with no cell.
#define RTGI_TABLE 128u
#define RTGI_TW 11u
#define RTGI_EMPTY 0xFFFFFFFFu
shared uint tKey[RTGI_TABLE];
shared uint tAcc[RTGI_TABLE * RTGI_TW];

void tableClear() {
    for (uint j = gl_LocalInvocationIndex; j < RTGI_TABLE; j += gl_WorkGroupSize.x) {
        tKey[j] = RTGI_EMPTY;
        for (uint k = 0u; k < RTGI_TW; k++) tAcc[j * RTGI_TW + k] = 0u;
    }
    barrier();
}

void tableAdd(uint s, uint w[RTGI_ACC]) {
    if (s != RTGI_EMPTY) {
        // A row for the cell: at most a cell a thread, so never full at 128 rows for 64 threads.
        uint e = rtgiHash(s) & (RTGI_TABLE - 1u);
        for (uint probe = 0u; probe < RTGI_TABLE; probe++) {
            uint prev = atomicCompSwap(tKey[e], RTGI_EMPTY, s);
            if (prev == RTGI_EMPTY || prev == s) break;
            e = (e + 1u) & (RTGI_TABLE - 1u);
        }
        uint row = e * RTGI_TW;
        uint t[RTGI_TW] = uint[RTGI_TW](w[0], w[1], w[2], w[3] | (w[4] << 8) | (w[5] << 16) | (w[6] << 24),
                                         w[7], w[8], w[9], w[10], w[11], w[12], w[13]);
        for (uint k = 0u; k < RTGI_TW; k++)
            if (t[k] != 0u) atomicAdd(tAcc[row + k], t[k]);
        if (twice(32u))
            for (uint k = 0u; k < RTGI_TW; k++)
                if (t[k] != 0u) atomicAdd(tAcc[row + k], 0u);
    }
    barrier();
    uint frame = uint(u.uList.x);
    for (uint j = gl_LocalInvocationIndex; j < RTGI_TABLE; j += gl_WorkGroupSize.x) {
        uint c = tKey[j];
        uint row = j * RTGI_TW;
        // Listed the first time this frame (appendDirty's ballot needs every lane: the loop is uniform).
        bool first = c != RTGI_EMPTY && claimFrame(c, frame);
        // The words added first: the count's (word 3) old value is what was waiting, for listNow.
        uint pending = 0u;
        if (c != RTGI_EMPTY) {
            uint small = tAcc[row + 3u];
            uint words[RTGI_WORDS] = uint[RTGI_WORDS](tAcc[row], tAcc[row + 1u], tAcc[row + 2u],
                small & 0xFFu, (small >> 8) & 0xFFu, (small >> 16) & 0xFFu, small >> 24,
                tAcc[row + 4u], tAcc[row + 5u], tAcc[row + 6u], tAcc[row + 7u], tAcc[row + 8u], tAcc[row + 9u], tAcc[row + 10u]);
            if (!twice(256u)) {
                pending = atomicAdd(rtgiAccum[RTGI_ACC * c + 3u], words[3]) + words[3];
                for (uint q = 0u; q < RTGI_WORDS; q++)
                    if (q != 3u && words[q] != 0u) atomicAdd(rtgiAccum[RTGI_ACC * c + q], words[q]);
            }
            if (twice(8u))
                for (uint q = 0u; q < RTGI_WORDS; q++)
                    if (words[q] != 0u) atomicAdd(rtgiAccum[RTGI_ACC * ((c + 1u) & uint(u.uParams.z)) + q], 0u);
            tKey[j] = RTGI_EMPTY;
            for (uint q = 0u; q < RTGI_TW; q++) tAcc[row + q] = 0u;
        }
        bool listed = first && listNow(c, frame, pending);
        uint k = appendDirty(listed);
        if (k < uint(u.uList.y)) dirty[k] = c;
        tally(7u + min(statOffset, 4u), listed);
    }
    barrier();
}

// rich: the sample's level and the two above, which the readout reads (its two, and two up where they hold nothing) -- the
// irradiance vector, hit distance and near visibility written; the levels above feed the blend's parent alone, which
// reads the light, its spread, sky and sun.
void add(uint s, vec3 e, bool counted, bool sky, bool sunTraced, bool sunLit, bool rich) {
    uint w[RTGI_ACC];
    for (uint k = 0u; k < RTGI_ACC; k++) w[k] = 0u;
    vec3 ec = min(e, vec3(RTGI_MAX_SAMPLE));
    float le = dot(ec, vec3(0.2126, 0.7152, 0.0722));
    if (counted) {
        // Rounded stochastically: unbiased however dim (the fraction kept as a chance of one more unit).
        vec3 f = ec * RTGI_SCALE;
        w[0] = uint(f.r + dither.x);
        w[1] = uint(f.g + dither.y);
        w[2] = uint(f.b + dither.z);
        w[3] = 1u;
        if (sky) w[4] = 1u;
        // The luminance's square: the cell's sample variance (rtgi_resolve.comp).
        float l = min(le, RTGI_LUM2_MAX);
        w[7] = uint(l * l * RTGI_LUM2_SCALE + dither.w);
        if (rich) {
            // The irradiance vector: the sample's luminance along its direction, fixed point, signed (its two's
            // complement added as uints sums as ints) -- where the cell's light comes from (rtgi_resolve.comp).
            vec3 b = le * sampleDir * RTGI_SCALE;
            w[8] = uint(int(floor(b.x + dither.x)));
            w[9] = uint(int(floor(b.y + dither.y)));
            w[10] = uint(int(floor(b.z + dither.z)));
            // How near the geometry is: the inverse hit distance, its mean the harmonic -- the nearest occluders set how
            // fast the light can change across the cell (rtgi_filter.comp's prior on how much its parent differs).
            w[13] = uint(sampleInvD * 256.0 + dither.y);
            if (u.uFallback.y > 0.5) {
                // Near visibility and the far light (the cooked near field, rtgi_readout.frag): its weight, and its
                // luminance, where the ray left past the contact radius.
                w[11] = uint(nearWord + dither.w);
                if (nearWord > 0.0) w[12] = uint(le * RTGI_SCALE + dither.x);
            }
        }
    }
    if (sunTraced) {
        w[6] = 1u;
        if (sunLit) w[5] = 1u;
    }
    if (aggregation() > 1.5) tableAdd(s, w);
    else commit(s, w);
}

// --rtgi-capture: the sample's hit (xyz, w the ray's weight) and the hit's normal (xyz, w the distance; 0 0 0 1e30 a miss).
vec4 captureHit = vec4(0.0), captureHitN = vec4(0.0);

// The point's sample: false where it has none (past the frame's points, a point not live, a degenerate hit).
// Whether hit i met an alpha-tested triangle (its back face a front: rtgi_cook.comp's cookAlphaTested).
bool hitAlphaTested(uint i) {
    uint placements = uint(u.uCookTrain2.x);
    uvec4 h1 = hits[3u * i + 1u];
    if (h1.x >= placements) return false;
    uint first = cookSided[h1.x], count = cookSided[h1.x + 1u] - first;
    if (h1.y >= count) return false;
    uint b = first + h1.y;
    return ((cookSided[placements + 1u + (b >> 5u)] >> (b & 31u)) & 1u) != 0u;
}

// A cooked training point's sample tallied (uCookTrain.x): its samples and those whose ray met a back face (strict: an
// alpha-tested triangle's back face a front) over a window of uCookTrain.w; past uCookTrain.z of them, the point is out of
// its cell's turn for good (COOK_POINT_DEAD) -- a point the inside test passed whose rays still start inside a wall (a
// floor's point at a wall's foot): its back-face samples trained its cell black, creases darkening (the user, crevices,
// 2026-10-31).
void cookTally(uint slot, bool back) {
    uint old = atomicAdd(cookCellPoints[slot].y, (1u << 16) + (back ? (1u << 22) : 0u));
    uint n = ((old >> 16) & 63u) + 1u;
    if (n < uint(u.uCookTrain.w)) return;
    uint b = ((old >> 22) & 63u) + (back ? 1u : 0u);
    atomicAnd(cookCellPoints[slot].y, ~(0xFFFu << 16));
    if (float(b) > u.uCookTrain.z) atomicOr(cookCellPoints[slot].y, 0x80000000u);
}

bool pointSample(uint i, out vec4 p, out vec3 n, out vec3 e, out bool counted, out bool sky, out bool sunTraced, out bool sunLit,
                 out uint hd) {
    p = vec4(0.0); n = vec3(0.0); e = vec3(0.0);
    counted = false; sky = false; sunTraced = false; sunLit = false; hd = 0u;
    if (i >= uint(u.uCamera.w)) return false;
    hd = rtgiHash(i * 0x9E3779B9u ^ floatBitsToUint(points[2u * i].x) ^ floatBitsToUint(rays[2u * i + 1u].y));
    dither = vec4(hd & 0xFFu, (hd >> 8) & 0xFFu, (hd >> 16) & 0xFFu, hd >> 24) / 256.0;
    p = points[2u * i];
    if (p.w < 0.5) return false;
    n = points[2u * i + 1u].xyz;
    vec3 d = rays[2u * i + 1u].xyz;
    sampleDir = d;
    // The ray's weight against cosine sampling (rtgi_rays.comp: 1, its rays cosine). Its sample is PI x L_in x it.
    uint wb = floatBitsToUint(points[2u * i + 1u].w);
    bool cooked = (wb & 0xC0000000u) == 0x80000000u;
    uint cookedSlot = wb & 0x03FFFFFFu;
    cookedLevel = cooked ? (wb >> 26) & 15u : 0u;
    float weight = cooked ? 1.0 : uintBitsToFloat(wb);
    captureHit = vec4(rays[2u * i].xyz + d * 1e4, weight);
    captureHitN = vec4(0.0, 0.0, 0.0, 1e30);
    uvec4 h0 = hits[3u * i];
    nearWord = ((h0.w & 1u) == 0u || uintBitsToFloat(h0.x) > u.uNearField.y) ? weight * 256.0 : 0.0;
    sampleInvD = (h0.w & 1u) == 0u ? 1.0 / max(rays[2u * i + 1u].w, 1.0) : 1.0 / max(uintBitsToFloat(h0.x), 0.05);
    counted = true;
    captureFlags = 0.0;
    if ((h0.w & 1u) != 0u && (h0.w & 2u) == 0u) captureFlags += 8.0;
    if (cooked) {
        bool back = (h0.w & 1u) != 0u && (h0.w & 2u) == 0u && !hitAlphaTested(i);
        if (u.uCookTrain.y > 0.5) { atomicAdd(cookProbe[cookedSlot].x, 1u); if (back) atomicAdd(cookProbe[cookedSlot].y, 1u); }
        // A cooked point's ray met a back face: it started inside something -- no sample (a screen point's stays black: a
        // single-sided wall seen from behind is dark).
        if (u.uCookTrain.x > 0.5) {
            cookTally(cookedSlot, back);
            if (back) return false;
        }
    }
    if ((h0.w & 1u) == 0u) {
        e = 3.14159265359 * textureLod(uSkyRadiance, d, u.uSun.w).rgb;
        sky = true;
    } else if ((h0.w & 2u) != 0u) {
        uvec4 h2 = hits[3u * i + 2u];
        vec3 q = rays[2u * i].xyz + d * uintBitsToFloat(h0.x);
        vec3 nq = vec3(uintBitsToFloat(h2.x), uintBitsToFloat(h2.y), uintBitsToFloat(h2.z));
        if (!(dot(nq, nq) > 1e-12)) return false;   // a degenerate triangle (rtgi_rays.comp): no sample
        nq = normalize(nq);
        if (dot(nq, d) > 0.0) nq = -nq;
        captureHit.xyz = q;
        captureHitN = vec4(nq, uintBitsToFloat(h0.x));
        bool fine;
        // The sun at the hit: its own ray where the trace shot one (uHitSun.x; hit flag 8 where it reached the sun), else
        // the hit cell's sun visibility -- a cell's mean over the floor it spans, sunlit and shadowed alike, where a ray up
        // from under an arch meets the floor the arch itself shades: ceilings and the arches' undersides read 8-9% bright
        // against Crytek Sponza's truth, every other variant alike (2026-10-26).
        vec4 eq = irradianceAt(q, nq, fine, u.uHitSun.x > 0.5 ? ((h0.w & 8u) != 0u ? 1.0 : 0.0) : -1.0);
        if (twice(1u)) {
            bool fine2;
            vec3 tq = normalize(abs(nq.y) < 0.99 ? cross(nq, vec3(0.0, 1.0, 0.0)) : cross(nq, vec3(1.0, 0.0, 0.0)));
            vec4 eq2 = irradianceAt(q + tq * rtgiSize(rtgiLevel(q, rtgiSide(nq), u.uCamera.xyz, u.uParams), u.uParams), nq, fine2, -1.0);
            sink(eq2.x == -1234.5);
        }
        if (!fine && u.uEpoch.w > 0.0) {
            uint r = appendRequest(true);
            if (r < uint(u.uEpoch.w)) {
                requests[2u * r] = vec4(q, 1.0);
                requests[2u * r + 1u] = vec4(nq, 0.0);
            }
        }
        if (eq.w < 0.5) captureFlags += 16.0;
        counted = eq.w > 0.5;
        e = unpackUnorm4x8(h2.w).rgb * eq.rgb;
    }
    e *= weight;
    // Nothing not finite reaches a cell: one NaN there spreads to every cell whose rays land in it.
    if (any(isnan(e)) || any(isinf(e))) counted = false;
    if (cooked && u.uCookTrain.y > 0.5 && counted) atomicAdd(cookProbe[cookedSlot].z, uint(min(dot(e, vec3(0.2126, 0.7152, 0.0722)), 4000.0) * 1024.0));
    // A point whose cell's sun is settled traced none (rtgi_rays.comp: w 2).
    sunTraced = dot(n, u.uSun.xyz) > 0.0 && p.w < 1.5;
    sunLit = sunTraced && (occluded[i] & 1u) == 0u;
    return true;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    // The workgroup's table (uFallback.w 2): every thread through every round below, those with no sample adding nothing.
    bool table = aggregation() > 1.5;
    if (table) tableClear();
    vec4 p;
    vec3 n, e;
    bool counted, sky, sunTraced, sunLit;
    uint hd;
    bool live = pointSample(i, p, n, e, counted, sky, sunTraced, sunLit, hd);
    uint captured = uint(u.uCapture.x);
    if (i < captured) {
        uint slot = 3u * (uint(u.uCapture.y) * captured + i);
        captureOut[slot] = live ? vec4(e, 4.0 + (sky ? 2.0 : 0.0) + (counted ? 1.0 : 0.0) + captureFlags) : vec4(0.0);
        captureOut[slot + 1u] = captureHit;
        captureOut[slot + 2u] = captureHitN;
        if (live) {
            uint at = 3u * uint(u.uCapture.z) * captured + 2u * i;
            captureOut[at] = vec4(p.xyz, 1.0);
            captureOut[at + 1u] = vec4(n, 0.0);
        }
    }
    tally(1u, live);
    if (!table && !live) return;
    // A cooked point trains the level of the cell it was chosen for (rtgi_rays.comp's cookedLevel), not the table's at it.
    uint level = !live ? 0u : cookedLevel > 0u ? cookedLevel - 1u : rtgiLevel(p.xyz, rtgiSide(n), u.uCamera.xyz, u.uParams);
    // Its level and uNearField.w - 1 above (3: the next, which the readout blends in, and two up, the fallback; more feed
    // the blend's cascade further up, rtgi_filter.comp).
    uint top = uint(u.uParams.w);
    // Thinned (uHitSun.y): three levels up a sample is added 1 in 2, four up 1 in 4 -- parents fed by many fine cells,
    // their means no different for fewer samples. Each level was an insert and a dozen atomics a sample: the training
    // ~8 ms a frame through Crytek Sponza's first seconds at 4x the rays (2026-10-26).
    uint thin = rtgiHash(hd ^ 0x9E3779B9u);
    // And the finer level's cell holding it, where one is held (found, never made): a cell across a step of the cells'
    // size (rtgi_cache.glsl's rtgiCellSize, by the geometry) holds points of its own level on one part and of the next
    // level up on the other, and was trained by the first alone -- half the samples of the cells beside it, so leaned on
    // its parent the more (rtgi_filter.comp), the parent's wider, brighter mean along every step: a bright line on each of
    // the size's contours, the cells' own light clean (the user, the crevices testbed, 2026-10-30). Trained over all of
    // itself it holds what its neighbours do. Only cells already held: the finer level is not made where nothing reads it.
    {
        uint fs = RTGI_EMPTY;
        if (live && level > 0u) fs = rtgiFind(cellAt(p.xyz, n, level - 1u), u.uParams);
        statOffset = 0u;
        if (table || fs != RTGI_EMPTY) add(fs, e, counted, sky, sunTraced, sunLit, true);
    }
    for (uint k = 0u; k < uint(u.uNearField.w); k++) {
        bool thinned = u.uHitSun.y > 0.5 && k >= 3u && ((thin >> (4u * k)) & ((1u << (k - 2u)) - 1u)) != 0u;
        bool here = live && level + k <= top && !thinned;
        tally(2u + min(k, 4u), here);
        statOffset = k;
        if (!table && !here) continue;
        if (twice(2048u)) continue;
        if (twice(2u) && here) {
            ivec3 cn = ivec3(floor((p.xyz - rtgiOrigin(rtgiSide(n))) / rtgiSize(level + k, u.uParams))) + ivec3(1, 0, 0);
            sink(rtgiFind(rtgiCellHash(cn, level + k, rtgiSide(n), u.uParams), u.uParams) == 0xFFFFFFFEu);
        }
        // Finding the levels above once a workgroup instead (the table keyed by the cell's hash, the flush's thread
        // finding it) moved each find in front of that cell's atomics: 3.36 -> 3.31 ms, nothing (the bench, 2026-10-27).
        uint slot = here ? rtgiInsertAt(p.xyz, n, level + k) : RTGI_EMPTY;
        // Assembled (uCookTrain2.y): the levels above only touched -- made and listed, no sample -- their light put
        // together from their own surface's and their children's by area (rtgi_filter.comp). Trained by every sample
        // below them, a coarse cell held the mean of whichever of its children trained: the screen's, the unsure
        // ones' -- placement spends on the open cells, the settled stop -- its light sliding toward a crease's and
        // staying (a wall's coarse cell 20% darker with the camera still, the readout's view 33, the user, the
        // crevices testbed, 2026-10-31).
        if (k > 0u && u.uCookTrain2.y > 0.5) add(slot, e, false, false, false, false, false);
        else add(slot, e, counted, sky, sunTraced, sunLit, k < 3u);
    }
}
