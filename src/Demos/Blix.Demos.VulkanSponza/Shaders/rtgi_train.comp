#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// --rtgi (S1, SponzaLoop.Rtgi.cs): last frame's training points, their rays answered, into the cache. Per point p (normal n):
//   indirect  E = PI * L_in along its cosine ray: the sky's radiance where it missed; where it met a surface's front at q,
//             albedo_q * (E_ind(q) + E_sun * max(0, n_q.s) * sunVis(q)) -- q's outgoing radiance times PI, from q's cell
//             (a coarser level where q's own has nothing yet; no sample at all where neither has, rather than a dark
//             one); a back face's 0 (inside something)
//   sun       whether its shadow ray reached (where it faces the sun)
// added to p's cell and to the cell two levels coarser (the readout's fallback), made where it is not held yet.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiTrain {
    vec4 uParams;        // rtgiParams (rtgi_cache.glsl)
    vec4 uCamera;        // xyz position; w points
    vec4 uSun;           // xyz toward the sun; w the sky cube's lod
    vec4 uSunIrradiance; // rgb
    vec4 uNearField;     // x the near field's radius (rtgi_cache.glsl's RTGI_NEAR); y the contact radius (m); z the direct sun at
                         // a ray's hit, scaled (1; 0: none -- a diagnostic of where the samples' variance comes from); w the
                         // levels a sample trains, its own first
    vec4 uGuideTable;    // x the guide table's slots - 1 (0: no guiding learnt); y 1: a hit cell still holding an earlier sun's
                         // light (its epoch behind z, the sun's) counts as not ready (irradianceAt)
    vec4 uClamp;         // x > 0: a sample's luminance capped at its cell's mean + x standard deviations (once it holds 32);
                         // y the frame's number (from 1); z the dirty list's room
    vec4 uTrain;         // x 1: a landing cell holding nothing counts as dark (else no sample); y 1: no coarser cell for it;
                         // z 1: a back face's hit read as a front's (else dark); w room for landing requests (0: none)
    vec4 uHitSun;        // x 1: each hit's sun traced (hit flag 8), else read from the hit cell; y 1: the levels three and four
                         // up thinned; z 1: keys and stamps read before their atomics
    vec4 uFallback;      // x the levels past two up a landing may look for a cell holding light (0: two up only); y 1: contact
                         // detail on (the near and far words written); z 1: landings deferred to their request's sample;
                         // w 1: a cell's words summed over the subgroup before they are written, 2: over the workgroup, through
                         // its table (tableAdd)
} u;

layout(set = 0, binding = 1) uniform samplerCube uSkyRadiance;
layout(std430, set = 0, binding = 2) readonly buffer RtgiPoints { vec4 points[]; };
layout(std430, set = 0, binding = 3) readonly buffer RtgiRayBuffer { vec4 rays[]; };
layout(std430, set = 0, binding = 4) readonly buffer RtgiHits { uvec4 hits[]; };
layout(std430, set = 0, binding = 5) readonly buffer RtgiOccluded { uint occluded[]; };
layout(std430, set = 0, binding = 6) buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 7) buffer RtgiAccum { uint rtgiAccum[]; };
layout(std430, set = 0, binding = 8) readonly buffer RtgiResolved { vec4 rtgiResolved[]; };
// Where rays landed in a cell that holds nothing at its own level: the next frame trains there (rtgi_rays.comp). Read
// through the coarser cell instead, a landing took that cell's average over where training had been -- the walls the
// camera sees -- not over where it landed: the gate's dead end, lit round a corner, read 0.77 (2026-10-26). A count,
// then two vec4s each (point, normal), room for uTrain.w.
layout(std430, set = 0, binding = 10) readonly buffer RtgiMoments { vec4 rtgiMoments[]; };
// Per slot: the frame it was last trained (x) and the sun it last saw (y, rtgi_resolve.comp). The cells trained this frame,
// listed once each for the resolve (it visits those alone: scanning every slot was 5.5 ms a frame at San Miguel's 8 M).
layout(std430, set = 0, binding = 11) buffer RtgiStamps { uvec2 rtgiStamps[]; };
layout(std430, set = 0, binding = 12) buffer RtgiDirty { uint dirtyCount; uint dirtyPad[3]; uint dirty[]; };
layout(std430, set = 0, binding = 9) buffer RtgiRequests { uint requestCount; uint requestPad[3]; vec4 requests[]; };
// Per point: where a deferred landing came from (rtgi_rays.comp copies it from its request) -- its point and ray weight,
// its normal and the landing's albedo (packed), its ray's direction and w 1 (0: no deferred landing).
layout(std430, set = 0, binding = 17) readonly buffer RtgiPointOrigins { vec4 pointOrigins[]; };
// Per slot: its cell (coordinates, level x 6 + side), written when made -- the neighbour blend finds its neighbours by it
// (rtgi_filter.comp); and the blended light the lookups read (indirect rgb, sky visibility).
layout(std430, set = 0, binding = 13) buffer RtgiCells { ivec4 rtgiCells[]; };
layout(std430, set = 0, binding = 14) readonly buffer RtgiFiltered { vec4 rtgiFiltered[]; };
// Path guiding's table (rtgi_guide.glsl): each sample's light added to its guide cell's bin.
layout(std430, set = 0, binding = 15) buffer GuideKeys { uint guideKeys[]; };
layout(std430, set = 0, binding = 16) buffer GuideAccum { uint guideAccum[]; };

#define RTGI_KEYS(i) rtgiKeys[i]
#define RTGI_NEAR u.uNearField.x
#include "rtgi_cache.glsl"
#define GUIDE_KEYS(i) guideKeys[i]
#include "rtgi_guide.glsl"

// The slot for the cell at p (its level, the side n faces), made if it is not held -- its cell written then; 0xFFFFFFFF
// when its probes are all taken.
uint rtgiInsertAt(vec3 p, vec3 n, uint level) {
    ivec3 c = ivec3(floor(p / rtgiSize(level, u.uParams)));
    uint side = rtgiSide(n);
    uvec2 h = rtgiCellHash(c, level, side, u.uParams);
    for (uint k = 0u; k < RTGI_PROBES; k++) {
        uint s = (h.x + k) & uint(u.uParams.z);
        // Read first (uHitSun.z): a cell already held answers without an atomic -- most of a frame's inserts, five a
        // sample. Keys only go from 0 to a key within a frame (emptied by the eviction pass alone), so a read key is current
        // or 0, and the swap settles a 0.
        if (u.uHitSun.z > 0.5) {
            uint seen = rtgiKeys[s];
            if (seen == h.y) return s;
            if (seen != 0u) continue;
        }
        uint prev = atomicCompSwap(rtgiKeys[s], 0u, h.y);
        if (prev == 0u) rtgiCells[s] = ivec4(c, int(level * 6u + side));
        if (prev == 0u || prev == h.y) return s;
    }
    return 0xFFFFFFFFu;
}

uvec2 cellAt(vec3 p, vec3 n, uint level) {
    return rtgiCellHash(ivec3(floor(p / rtgiSize(level, u.uParams))), level, rtgiSide(n), u.uParams);
}

// q's outgoing radiance times PI over its albedo: E_ind + direct sun, from its cell once it holds 8 samples, else the cell
// two levels up, else its own however few it holds; w 0 when none holds any. A cell of a sample or two passed its one
// draw on down the bounce -- odd lights that came and went (the user, Crytek Sponza, 2026-10-26). fine: its own cell
// held enough (else the landing is requested, rtgi_rays.comp).
// sunAt: the hit's own sun (its traced ray: 0 or 1), or below 0 the cell's sun visibility in its place.
vec4 irradianceAt(vec3 q, vec3 nq, out bool fine, float sunAt) {
    uint level = rtgiLevel(q, u.uCamera.xyz, u.uParams);
    fine = false;
    uint own = rtgiFind(cellAt(q, nq, level), u.uParams);
    vec4 o0 = vec4(0.0), o1 = vec4(0.0);
    if (own != 0xFFFFFFFFu) { o0 = rtgiFiltered[own]; o1 = rtgiResolved[2u * own + 1u]; }
    vec4 r0 = o0, r1 = o1;
    // Stale (uGuideTable.y): the hit cell has not been trained since the sun turned (rtgi_resolve.comp cuts a cell's
    // history only when it is next trained), so its light is the old sun's -- off screen, a bounce source, it may not be
    // trained for a long while, and every ray landing in it brought the old light on. Not ready: the landing is requested,
    // and its cell trained (and cut) next frame.
    bool stale = u.uGuideTable.y > 0.5 && own != 0xFFFFFFFFu && rtgiStamps[own].y != uint(u.uGuideTable.z);
    if (o1.y >= 8.0 && !stale) fine = true;
    else if (u.uTrain.y < 0.5) {
        // Two levels up, then (uFallback.x) further: the first holding any light.
        for (uint k = 2u; k <= 2u + uint(u.uFallback.x); k++) {
            uint s = rtgiFind(cellAt(q, nq, min(level + k, uint(u.uParams.w))), u.uParams);
            if (s != 0xFFFFFFFFu && rtgiResolved[2u * s + 1u].y >= 0.5) { r0 = rtgiFiltered[s]; r1 = rtgiResolved[2u * s + 1u]; break; }
        }
    }
    if (r1.y < 0.5) return vec4(0.0);
    return vec4(r0.rgb + u.uNearField.z * u.uSunIrradiance.rgb * max(0.0, dot(nq, u.uSun.xyz)) * (sunAt >= 0.0 ? sunAt : r1.x), 1.0);
}

vec4 dither;
vec3 sampleDir;
float nearWord;   // this sample's near visibility, weighted (256ths): it left past the contact radius
float sampleInvD; // 1 / how far its ray went (a miss: its reach)

// The cell's frame words written: listed for this frame's resolve the first time it is trained, then each non-zero word
// added. Aggregated over the subgroup first (uFallback.w): the lanes training the same cell sum their words and one of
// them writes -- ray placement concentrates the points on the cells least sure, and their atomics queued on the same
// words (Crytek Sponza at 4x the rays: training 9.7 ms, 6.9 with placement off, 2026-10-26). Up to four rounds, each
// the cell of the first lane still writing; the rest write their own.
// A slot in a list for each active lane that needs one, at one atomic per subgroup (uFallback.w): the ballot counts
// them, one lane takes them all from the counter, each lane's its offset among them. Else a lane's own atomic.
uint appendDirty(bool need) {
    if (u.uFallback.w < 0.5) return need ? atomicAdd(dirtyCount, 1u) : 0xFFFFFFFFu;
    uvec4 b = subgroupBallot(need);
    uint count = subgroupBallotBitCount(b), base = 0u;
    if (subgroupElect() && count > 0u) base = atomicAdd(dirtyCount, count);
    base = subgroupBroadcastFirst(base);
    return need ? base + subgroupBallotExclusiveBitCount(b) : 0xFFFFFFFFu;
}

uint appendRequest(bool need) {
    if (u.uFallback.w < 0.5) return need ? atomicAdd(requestCount, 1u) : 0xFFFFFFFFu;
    uvec4 b = subgroupBallot(need);
    uint count = subgroupBallotBitCount(b), base = 0u;
    if (subgroupElect() && count > 0u) base = atomicAdd(requestCount, count);
    base = subgroupBroadcastFirst(base);
    return need ? base + subgroupBallotExclusiveBitCount(b) : 0xFFFFFFFFu;
}

void writeCell(uint s, uint w[RTGI_ACC]) {
    uint frame = uint(u.uClamp.y);
    // Listed the first time this frame; read first (uHitSun.z), the swap only where it is not stamped this frame yet.
    bool first = (u.uHitSun.z < 0.5 || rtgiStamps[s].x != frame) && atomicExchange(rtgiStamps[s].x, frame) != frame;
    uint k = appendDirty(first);
    if (k < uint(u.uClamp.z)) dirty[k] = s;
    for (uint k = 0u; k < RTGI_ACC; k++)
        if (w[k] != 0u) atomicAdd(rtgiAccum[RTGI_ACC * s + k], w[k]);
}

void commit(uint s, uint w[RTGI_ACC]) {
    bool writing = s != 0xFFFFFFFFu;
    if (u.uFallback.w > 0.5) {
        for (uint round = 0u; round < 4u; round++) {
            if (!subgroupAny(writing)) return;
            if (writing) {
                uint lead = subgroupBroadcastFirst(s);
                if (s == lead) {
                    uint sum[RTGI_ACC];
                    for (uint k = 0u; k < RTGI_WORDS; k++) sum[k] = subgroupAdd(w[k]);
                    for (uint k = RTGI_WORDS; k < RTGI_ACC; k++) sum[k] = 0u;
                    if (subgroupElect()) writeCell(s, sum);
                    writing = false;
                }
            }
        }
    }
    if (writing) writeCell(s, w);
}

// The workgroup's table (uFallback.w 2): each sample's words added into its cell's row in shared memory, then one
// thread a row adds the row's words to the cell -- one device atomic a word a cell a workgroup, where the subgroup's
// rounds (commit) cost a subgroupAdd a word a round over the whole SIMD group: up to 4 rounds of 14 a level, five levels
// a sample, and Xcode's profile of Crytek Sponza's training had it bound by instruction issue and its atomics' writes
// (2026-10-26). The four 0/1 words (count, sky, sun reached, sun traced) share one table word, a byte each: a
// workgroup's 64 samples at most a byte. Every thread of the workgroup takes part in each round (its barriers), those
// with no sample with no cell.
#define RTGI_TABLE 128u
#define RTGI_TW 11u
#define RTGI_EMPTY 0xFFFFFFFFu
shared uint tKey[RTGI_TABLE];
shared uint tAcc[RTGI_TABLE * RTGI_TW];

void tableClear() {
    for (uint j = gl_LocalInvocationIndex; j < RTGI_TABLE; j += gl_WorkGroupSize.x) {
        tKey[j] = RTGI_EMPTY;
        for (uint k = 0u; k < RTGI_TW; k++) tAcc[j * RTGI_TW + k] = 0u;
    }
    barrier();
}

void tableAdd(uint s, uint w[RTGI_ACC]) {
    if (s != RTGI_EMPTY) {
        // A row for the cell: at most a cell a thread, so never full at 128 rows for 64 threads.
        uint e = rtgiHash(s) & (RTGI_TABLE - 1u);
        for (uint probe = 0u; probe < RTGI_TABLE; probe++) {
            uint prev = atomicCompSwap(tKey[e], RTGI_EMPTY, s);
            if (prev == RTGI_EMPTY || prev == s) break;
            e = (e + 1u) & (RTGI_TABLE - 1u);
        }
        uint row = e * RTGI_TW;
        uint t[RTGI_TW] = uint[RTGI_TW](w[0], w[1], w[2], w[3] | (w[4] << 8) | (w[5] << 16) | (w[6] << 24),
                                         w[7], w[8], w[9], w[10], w[11], w[12], w[13]);
        for (uint k = 0u; k < RTGI_TW; k++)
            if (t[k] != 0u) atomicAdd(tAcc[row + k], t[k]);
    }
    barrier();
    uint frame = uint(u.uClamp.y);
    for (uint j = gl_LocalInvocationIndex; j < RTGI_TABLE; j += gl_WorkGroupSize.x) {
        uint c = tKey[j];
        uint row = j * RTGI_TW;
        // Listed the first time this frame (appendDirty's ballot needs every lane: the loop is uniform).
        bool first = c != RTGI_EMPTY && (u.uHitSun.z < 0.5 || rtgiStamps[c].x != frame) && atomicExchange(rtgiStamps[c].x, frame) != frame;
        uint k = appendDirty(first);
        if (k < uint(u.uClamp.z)) dirty[k] = c;
        if (c != RTGI_EMPTY) {
            uint small = tAcc[row + 3u];
            uint words[RTGI_WORDS] = uint[RTGI_WORDS](tAcc[row], tAcc[row + 1u], tAcc[row + 2u],
                small & 0xFFu, (small >> 8) & 0xFFu, (small >> 16) & 0xFFu, small >> 24,
                tAcc[row + 4u], tAcc[row + 5u], tAcc[row + 6u], tAcc[row + 7u], tAcc[row + 8u], tAcc[row + 9u], tAcc[row + 10u]);
            for (uint q = 0u; q < RTGI_WORDS; q++)
                if (words[q] != 0u) atomicAdd(rtgiAccum[RTGI_ACC * c + q], words[q]);
            tKey[j] = RTGI_EMPTY;
            for (uint q = 0u; q < RTGI_TW; q++) tAcc[row + q] = 0u;
        }
    }
    barrier();
}

// rich: the sample's level and the two above, which the readout reads (its two, and two up where they hold nothing) -- the
// irradiance vector, hit distance and near visibility written; the levels above feed the blend's parent alone, which
// reads the light, its spread, sky and sun.
void add(uint s, vec3 e, bool counted, bool sky, bool sunTraced, bool sunLit, bool rich) {
    // --rtgi-clamp-sigma: a rare bright sample (a ray out to the sky, onto a sunlit patch through a gap) capped against the
    // cell's own spread once it has some: in a cell with few samples it was a blob that came and went (San Miguel).
    if (s != 0xFFFFFFFFu && counted && u.uClamp.x > 0.0 && rtgiMoments[3u * s + 2u].z >= 32.0) {
        vec4 m = rtgiMoments[3u * s];
        float cap = m.x + u.uClamp.x * sqrt(max(m.y - m.x * m.x, 0.0)) + 1e-4;
        float l = dot(e, vec3(0.2126, 0.7152, 0.0722));
        if (l > cap) e *= cap / l;
    }
    uint w[RTGI_ACC];
    for (uint k = 0u; k < RTGI_ACC; k++) w[k] = 0u;
    vec3 ec = min(e, vec3(RTGI_MAX_SAMPLE));
    float le = dot(ec, vec3(0.2126, 0.7152, 0.0722));
    if (counted) {
        // Rounded stochastically: unbiased however dim (the fraction kept as a chance of one more unit).
        vec3 f = ec * RTGI_SCALE;
        w[0] = uint(f.r + dither.x);
        w[1] = uint(f.g + dither.y);
        w[2] = uint(f.b + dither.z);
        w[3] = 1u;
        if (sky) w[4] = 1u;
        // The luminance's square: the cell's sample variance (rtgi_resolve.comp).
        float l = min(le, RTGI_LUM2_MAX);
        w[7] = uint(l * l * RTGI_LUM2_SCALE + dither.w);
        if (rich) {
            // The irradiance vector: the sample's luminance along its direction, fixed point, signed (its two's
            // complement added as uints sums as ints) -- where the cell's light comes from (rtgi_resolve.comp).
            vec3 b = le * sampleDir * RTGI_SCALE;
            w[8] = uint(int(floor(b.x + dither.x)));
            w[9] = uint(int(floor(b.y + dither.y)));
            w[10] = uint(int(floor(b.z + dither.z)));
            // How near the geometry is: the inverse hit distance, its mean the harmonic -- the nearest occluders set how
            // fast the light can change across the cell (rtgi_filter.comp's prior on how much its parent differs).
            w[13] = uint(sampleInvD * 256.0 + dither.y);
            if (u.uFallback.y > 0.5) {
                // Near visibility and the far light (S4 contact detail, rtgi_readout.frag): its weight, and its
                // luminance, where the ray left past the contact radius.
                w[11] = uint(nearWord + dither.w);
                if (nearWord > 0.0) w[12] = uint(le * RTGI_SCALE + dither.x);
            }
        }
    }
    if (sunTraced) {
        w[6] = 1u;
        if (sunLit) w[5] = 1u;
    }
    if (u.uFallback.w > 1.5) tableAdd(s, w);
    else commit(s, w);
}

// The point's sample: false where it has none (past the frame's points, a point not live, a degenerate hit).
bool pointSample(uint i, out vec4 p, out vec3 n, out vec3 e, out bool counted, out bool sky, out bool sunTraced, out bool sunLit,
                 out uint hd) {
    p = vec4(0.0); n = vec3(0.0); e = vec3(0.0);
    counted = false; sky = false; sunTraced = false; sunLit = false; hd = 0u;
    if (i >= uint(u.uCamera.w)) return false;
    hd = rtgiHash(i * 0x9E3779B9u ^ floatBitsToUint(points[2u * i].x) ^ floatBitsToUint(rays[2u * i + 1u].y));
    dither = vec4(hd & 0xFFu, (hd >> 8) & 0xFFu, (hd >> 16) & 0xFFu, hd >> 24) / 256.0;
    p = points[2u * i];
    if (p.w < 0.5) return false;
    n = points[2u * i + 1u].xyz;
    vec3 d = rays[2u * i + 1u].xyz;
    sampleDir = d;
    // The ray's weight against cosine sampling: cos / (PI x its pdf) -- 1 for a cosine ray, other for a guided one, 0 for
    // one that left below the surface (rtgi_rays.comp). Its sample is PI x L_in x it.
    float weight = points[2u * i + 1u].w;
    uvec4 h0 = hits[3u * i];
    nearWord = ((h0.w & 1u) == 0u || uintBitsToFloat(h0.x) > u.uNearField.y) ? weight * 256.0 : 0.0;
    sampleInvD = (h0.w & 1u) == 0u ? 1.0 / max(rays[2u * i + 1u].w, 1.0) : 1.0 / max(uintBitsToFloat(h0.x), 0.05);
    counted = true;
    if ((h0.w & 1u) == 0u) {
        e = 3.14159265359 * textureLod(uSkyRadiance, d, u.uSun.w).rgb;
        sky = true;
    } else if ((h0.w & 2u) != 0u || u.uTrain.z > 0.5) {
        uvec4 h2 = hits[3u * i + 2u];
        vec3 q = rays[2u * i].xyz + d * uintBitsToFloat(h0.x);
        vec3 nq = vec3(uintBitsToFloat(h2.x), uintBitsToFloat(h2.y), uintBitsToFloat(h2.z));
        if (!(dot(nq, nq) > 1e-12)) return false;   // a degenerate triangle (rtgi_rays.comp): no sample
        nq = normalize(nq);
        if (dot(nq, d) > 0.0) nq = -nq;
        bool fine;
        // The sun at the hit: its own ray where the trace shot one (uHitSun.x; hit flag 8 where it reached the sun), else
        // the hit cell's sun visibility -- a cell's mean over the floor it spans, sunlit and shadowed alike, where a ray up
        // from under an arch meets the floor the arch itself shades: ceilings and the arches' undersides read 8-9% bright
        // against Crytek Sponza's truth, every other variant alike (2026-10-26).
        vec4 eq = irradianceAt(q, nq, fine, u.uHitSun.x > 0.5 ? ((h0.w & 8u) != 0u ? 1.0 : 0.0) : -1.0);
        bool deferred = false;
        if (!fine && u.uTrain.w > 0.0) {
            uint r = appendRequest(true);
            if (r < uint(u.uTrain.w)) {
                requests[5u * r] = vec4(q, 1.0);
                requests[5u * r + 1u] = vec4(nq, 0.0);
                // Deferred (uFallback.z): the light at q is not guessed from cells around it -- the unseen behind an
                // arch, inside a gap, read the open surfaces' light (bright) or none (dark, where it was lit round a
                // corner) -- but taken from q's own sample next frame, its request traced: one more bounce of the path,
                // a frame late. A request's own landings are not deferred again (the walk up the levels instead).
                deferred = u.uFallback.z > 0.5 && pointOrigins[3u * i + 2u].w < 0.5;
                requests[5u * r + 2u] = vec4(p.xyz, deferred ? weight : 0.0);
                requests[5u * r + 3u] = vec4(n, uintBitsToFloat(h2.w));
                requests[5u * r + 4u] = vec4(d, deferred ? 1.0 : 0.0);
            }
        }
        counted = !deferred && (eq.w > 0.5 || u.uTrain.x > 0.5);
        e = unpackUnorm4x8(h2.w).rgb * eq.rgb;
    }
    e *= weight;
    // Nothing not finite reaches a cell: one NaN there spreads to every cell whose rays land in it.
    if (any(isnan(e)) || any(isinf(e))) counted = false;
    // A point whose cell's sun is settled traced none (rtgi_rays.comp: w 2).
    sunTraced = dot(n, u.uSun.xyz) > 0.0 && p.w < 1.5;
    sunLit = sunTraced && (occluded[i] & 1u) == 0u;
    return true;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    // The workgroup's table (uFallback.w 2): every thread through every round below, those with no sample adding nothing.
    bool table = u.uFallback.w > 1.5;
    if (table) tableClear();
    vec4 p;
    vec3 n, e;
    bool counted, sky, sunTraced, sunLit;
    uint hd;
    bool live = pointSample(i, p, n, e, counted, sky, sunTraced, sunLit, hd);
    if (!table && !live) return;
    uint level = live ? rtgiLevel(p.xyz, u.uCamera.xyz, u.uParams) : 0u;
    // Path guiding: the sample's light into its guide cell's bin (two levels up, its side), counted -- the bin's light over
    // the samples counted estimates the light arriving through it (rtgi_guide.glsl).
    if (live && counted && u.uGuideTable.x > 0.0) {
        uint gl = min(level + 2u, uint(u.uParams.w));
        uint gside = rtgiSide(n);
        uvec2 gh = guideHash(ivec3(floor(p.xyz / rtgiSize(gl, u.uParams))), gl, gside, uint(u.uGuideTable.x));
        uint g = 0xFFFFFFFFu;
        for (uint k = 0u; k < GUIDE_PROBES; k++) {
            uint gs = (gh.x + k) & uint(u.uGuideTable.x);
            uint prev = atomicCompSwap(guideKeys[gs], 0u, gh.y);
            if (prev == 0u || prev == gh.y) { g = gs; break; }
        }
        if (g != 0xFFFFFFFFu) {
            int bin = guideBin(sampleDir, gside);
            if (bin >= 0) atomicAdd(guideAccum[33u * g + uint(bin)], uint(dot(min(e, vec3(RTGI_MAX_SAMPLE)), vec3(0.2126, 0.7152, 0.0722)) * RTGI_SCALE + dither.y));
            atomicAdd(guideAccum[33u * g + 32u], 1u);
        }
    }
    // Its level and uNearField.w - 1 above (3: the next, which the readout blends in, and two up, the fallback; more feed
    // the blend's cascade further up, rtgi_filter.comp).
    uint top = uint(u.uParams.w);
    // Thinned (uHitSun.y): three levels up a sample is added 1 in 2, four up 1 in 4 -- parents fed by many fine cells,
    // their means no different for fewer samples. Each level was an insert and a dozen atomics a sample: the training
    // ~8 ms a frame through Crytek Sponza's first seconds at 4x the rays (2026-10-26).
    uint thin = rtgiHash(hd ^ 0x9E3779B9u);
    for (uint k = 0u; k < uint(u.uNearField.w); k++) {
        bool thinned = u.uHitSun.y > 0.5 && k >= 3u && ((thin >> (4u * k)) & ((1u << (k - 2u)) - 1u)) != 0u;
        bool here = live && level + k <= top && !thinned;
        if (!table && !here) continue;
        add(here ? rtgiInsertAt(p.xyz, n, level + k) : RTGI_EMPTY, e, counted, sky, sunTraced, sunLit, k < 3u);
    }
    // A deferred landing's sample, now that this point -- its landing -- has its own: the light leaving here (this sample's
    // indirect irradiance, its own sun ray's direct) times the albedo, along the origin's ray, into the origin's cells.
    // Only with deferred landings on (uFallback.z, the same for the whole dispatch: the table's rounds stay uniform).
    if (u.uFallback.z < 0.5) return;
    vec4 o0 = live ? pointOrigins[3u * i + 2u] : vec4(0.0);
    vec3 eo = vec3(0.0);
    uint lo = 0u;
    vec4 oP = vec4(0.0), oN = vec4(0.0);
    bool landing = live && o0.w > 0.5 && counted;
    if (landing) {
        oP = pointOrigins[3u * i];
        oN = pointOrigins[3u * i + 1u];
        vec3 direct = u.uNearField.z * u.uSunIrradiance.rgb * max(0.0, dot(n, u.uSun.xyz)) * (sunLit ? 1.0 : 0.0);
        eo = unpackUnorm4x8(floatBitsToUint(oN.w)).rgb * (e + direct) * oP.w;
        landing = !any(isnan(eo)) && !any(isinf(eo));
        sampleDir = o0.xyz;
        nearWord = 0.0;
        sampleInvD = 1.0 / max(length(p.xyz - oP.xyz), 0.05);
        lo = rtgiLevel(oP.xyz, u.uCamera.xyz, u.uParams);
    }
    if (!table && !landing) return;
    for (uint k = 0u; k < uint(u.uNearField.w); k++) {
        bool here = landing && lo + k <= top;
        if (!table && !here) continue;
        add(here ? rtgiInsertAt(oP.xyz, oN.xyz, lo + k) : RTGI_EMPTY, eo, true, false, false, false, k < 3u);
    }
}
