#version 450

// The texels at rest (SponzaLoop.Texels.cs, ResolveTexels): each one's answer as incident_clipmap.frag's lookup forms it
// -- the prior blended with its own light (filtered, else the occlusion blend, else as gathered) and its confidence --
// written once into 8 bytes (RGB9E5 + a 16-bit confidence and a valid bit), so the gather's own buffers (light, prior,
// filtered, blend, open, moment, stamp, epoch: ~100 bytes a texel, 1.5 GB on Sponza) can go until the light changes.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform TexelResolve {
    vec4 uResolve;  // x texels, y 1 when the filtered light is read (texelFilter), z the rays a texel is trusted at
} u;

layout(std430, set = 0, binding = 1) readonly buffer TexelLight { vec4 texelLight[]; };
layout(std430, set = 0, binding = 2) readonly buffer TexelPrior { vec4 texelPrior[]; };
layout(std430, set = 0, binding = 3) readonly buffer TexelFiltered { vec4 texelFiltered[]; };
layout(std430, set = 0, binding = 4) readonly buffer TexelBlend { vec4 texelBlend[]; };
layout(std430, set = 0, binding = 5) writeonly buffer TexelResolved { uvec2 texelResolved[]; };

// Shared exponent, 9-bit mantissas (the format's own encoding, as a GPU's RGB9E5 texture holds it).
uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(u.uResolve.x)) return;
    vec4 light = texelLight[id];
    vec4 prior = texelPrior[id];
    if (light.w <= 0.0 && prior.w <= 0.0) { texelResolved[id] = uvec2(0u); return; }
    vec3 own = u.uResolve.y > 0.5 && texelFiltered[id].w > 0.0 ? texelFiltered[id].rgb
        : texelBlend[id].w > 0.0 ? texelBlend[id].rgb : light.rgb;
    vec3 value = prior.w > 0.0 ? mix(prior.rgb, own, min(light.w / 256.0, 1.0)) : own;
    float confidence = prior.w > 0.0 ? 1.0 : min(light.w / u.uResolve.z, 1.0);
    texelResolved[id] = uvec2(packRgb9e5(value), uint(round(confidence * 65535.0)) | 0x10000u);
}
