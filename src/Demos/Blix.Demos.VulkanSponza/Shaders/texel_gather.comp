#version 450
// Texels' gather (texel.glsl): one workgroup a queued texel, one thread a ray. RAYS cosine-weighted directions from the
// texel (stratified, rotated afresh each pass); a hit's light is its albedo times its own direct sun (the shadow
// cascades where they cover it, a shadow ray beyond) and its nearest cooked patch's indirect light, over pi; a miss
// the sky. The pass's irradiance estimate (pi x the mean radiance) is averaged into the texel at 1/n over rays, to the
// target (texel_mark.comp stops queueing it there): a still sun settles once and then nothing is traced. When the
// patch light is re-solved for a new sun the epoch moves on, and a texel from before gathers afresh, its old light
// shown meanwhile as a prior (TexelPrior).
//
// The queue is texel_mark.comp's: four lists (no rays yet, few, under the minimum, settling), in that order up to
// the budget.
// Workgroup 0 also zeroes the other parity's counts for the next frame's mark.

#define RAYS 32
#define PI 3.14159265359
layout(local_size_x = RAYS) in;

layout(set = 0, binding = 0) uniform TexelGather {
    vec4 uTexelGrid;      // xyz the cells' origin, w the spacing
    vec4 uTexelParams;    // x hash capacity, y list capacity (the budget), z target rays, w the frame
    vec4 uSunDirection;   // xyz the direction the sun travels
    vec4 uSunIrradiance;  // rgb
    vec4 uSky;            // x sky strength, y the sky's mip for a ray, z the texels' epoch
    mat4 uCascadeVP[3];
    vec4 uOpen;           // x the occlusion estimate's reach (m), y its relative error (the blend's), z 1: blend at all
    vec4 uCookedGrid;
    vec4 uCookedDims;
} u;

layout(set = 0, binding = 1) uniform samplerCube uSkyRadiance;
layout(set = 0, binding = 2) uniform sampler2D uCascadeShadowMaps[3];
#include "shadow.glsl"
layout(std430, set = 0, binding = 3) readonly buffer Texels { vec4 texels[]; };
layout(std430, set = 0, binding = 4) buffer TexelLight { vec4 texelLight[]; };
layout(std430, set = 0, binding = 5) buffer TexelQueue { uint texelQueue[]; };
// The patch light a texel's rays were read from: a texel from an older epoch keeps its estimate as one pass's worth.
layout(std430, set = 0, binding = 9) buffer TexelEpoch { uint texelEpoch[]; };
// A stale texel's old light (rgb, w 1 while it stands): what the incident pass shows while the new gather is young,
// blended out over its first TEXEL_PRIOR_RAYS rays and then dropped. Keeping it as one pass's worth in the running
// mean instead left 3% of the old sun's light in for good (Cornell, after a turn: +3.1% energy).
layout(std430, set = 0, binding = 10) buffer TexelPrior { vec4 texelPrior[]; };
#define TEXEL_PRIOR_RAYS 256.0
// The running mean of each pass's luminance squared: with the mean, how much passes disagree (texel.glsl,
// texelSettled decides from it how many rays the texel gets).
layout(std430, set = 0, binding = 11) buffer TexelMoment { float texelMoment[]; };
// Guides (SponzaLoop.Transport.cs, BuildGuides): per patch, a CDF over an 8x8 octahedral map of world directions of
// where its light comes from. Half of each pass's rays sample the texel's nearest patch's; the other half are cosine
// as before, and every ray is weighted by the mixture's density (the balance heuristic): unbiased whatever the guide.
layout(std430, set = 0, binding = 12) readonly buffer CookedGuides { float cookedGuide[]; };
#define GUIDE_RES 8
#define GUIDE_BINS 64
// The occlusion estimate: a texel's openness (x the fraction of its cosine rays that met nothing within uOpen.x, y how
// many) -- the cosine half of every pass measures it -- and the estimate it gives: the patches' interpolated light x
// its openness over theirs. Smooth from the first pass (no light is sampled), ~18% off on Sponza's hall; the gathered
// light is unbiased but noisy. TexelBlend is the two by inverse variance: what the filter and the incident pass read.
layout(std430, set = 0, binding = 22) buffer TexelOpen { vec4 texelOpen[]; };
layout(std430, set = 0, binding = 23) buffer TexelBlend { vec4 texelBlend[]; };

#define COOKED_BINDING 6
#define COOKED_GRID u.uCookedGrid
#define COOKED_DIMS u.uCookedDims
#include "cooked_patches.glsl"

#define BLIX_RAY_SET 0
#define BLIX_RAY_BINDING 13
#include "ray_query.glsl"

shared vec3 sRadiance[RAYS];
shared int sGuide;
shared float sOpen[RAYS];

vec2 guideOctEncode(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    if (d.z >= 0.0) return d.xy;
    return vec2((1.0 - abs(d.y)) * (d.x >= 0.0 ? 1.0 : -1.0), (1.0 - abs(d.x)) * (d.y >= 0.0 ? 1.0 : -1.0));
}

vec3 guideOctDecodeRaw(vec2 uv) {   // the octahedron's point (|x|+|y|+|z| = 1), not normalised
    vec3 d = vec3(uv, 1.0 - abs(uv.x) - abs(uv.y));
    if (d.z < 0.0) { float x = d.x; d.x = (1.0 - abs(d.y)) * (x >= 0.0 ? 1.0 : -1.0); d.y = (1.0 - abs(x)) * (d.y >= 0.0 ? 1.0 : -1.0); }
    return d;
}

int guideBin(vec3 d) {
    ivec2 b = clamp(ivec2((guideOctEncode(d) * 0.5 + 0.5) * float(GUIDE_RES)), ivec2(0), ivec2(GUIDE_RES - 1));
    return b.y * GUIDE_RES + b.x;
}

// The guide's density over solid angle at d: its bin's probability, uniform over the bin in the octahedral square
// (area 4 / 64: 16 p over the square), times dA/domega = |p|^3 for the octahedron point p = d / |d|_1, and
// |p| = 1 / |d|_1. (Multiplying by |d|_1^3 instead read Cornell's energy at 0.20.)
float guidePdf(int patchIndex, vec3 d) {
    int b = guideBin(d);
    float p = cookedGuide[patchIndex * GUIDE_BINS + b] - (b > 0 ? cookedGuide[patchIndex * GUIDE_BINS + b - 1] : 0.0);
    float l1 = abs(d.x) + abs(d.y) + abs(d.z);
    return p * 16.0 / (l1 * l1 * l1);
}

vec3 guideSample(int patchIndex, float u0, float u1, float u2) {
    int lo = 0, hi = GUIDE_BINS - 1;
    while (lo < hi) { int mid = (lo + hi) / 2; if (cookedGuide[patchIndex * GUIDE_BINS + mid] < u0) lo = mid + 1; else hi = mid; }
    vec2 uv = (vec2(lo % GUIDE_RES, lo / GUIDE_RES) + vec2(u1, u2)) / float(GUIDE_RES) * 2.0 - 1.0;
    return normalize(guideOctDecodeRaw(uv));
}

void main() {
    uint group = gl_WorkGroupID.x;
    uint frame = uint(u.uTexelParams.w);
    uint parity = frame & 1u;
    uint capacity = uint(u.uTexelParams.y);
    if (group == 0u && gl_LocalInvocationID.x < 4u) texelQueue[(parity ^ 1u) * 4u + gl_LocalInvocationID.x] = 0u;
    // Which texel: the lists in order, each clamped to what it holds.
    int id = -1;
    uint i = group;
    for (uint list = 0u; list < 4u && id < 0; ++list) {
        uint count = min(texelQueue[parity * 4u + list], capacity);
        if (i < count) id = int(texelQueue[8u + list * capacity + i]);
        else i -= count;
    }
    if (id < 0) return;   // the whole workgroup: id is uniform across it

    vec3 position = texels[2 * id].xyz;
    vec3 n = texels[2 * id + 1].xyz;
    uint ray = gl_LocalInvocationID.x;
    if (ray == 0u) sGuide = cookedNearest(position, n);
    barrier();
    int guide = sGuide;
    float rays = texelLight[id].w;
    uint epoch = uint(u.uSky.z);
    bool stale = texelEpoch[id] != epoch;
    if (stale) rays = 0.0;
    uint pass = uint(rays) / uint(RAYS);
    uint seed = blix_pcg(uint(id) * 9781u + pass * 0x632BE5ABu + ray * 2654435761u);
    uint setSeed = blix_pcg(uint(id) * 9781u + pass * 0x632BE5ABu);
    float rotation = float(blix_pcg(setSeed) & 0xFFFFu) / 65536.0;
    float jitter = float(blix_pcg(seed) & 0xFFFFu) / 65536.0;
    // Half the rays cosine-weighted (a stratified disc, radius sqrt of the ray's band, lifted to the hemisphere), half
    // from the guide; without a patch nearby all cosine.
    const uint halfRays = uint(RAYS) / 2u;
    bool guided = guide >= 0 && ray >= halfRays;
    float cosineCount = guide >= 0 ? float(halfRays) : float(RAYS);
    uint stratum = guide >= 0 ? ray % halfRays : ray;
    vec3 dir;
    if (guided) {
        uint s1 = blix_pcg(seed ^ 0x9E3779B9u), s2 = blix_pcg(s1);
        dir = guideSample(guide, (float(stratum) + jitter) / float(halfRays), float(s1 & 0xFFFFu) / 65536.0, float(s2 & 0xFFFFu) / 65536.0);
    } else {
        float r = sqrt((float(stratum) + jitter) / cosineCount);
        float phi = 2.0 * PI * fract(float(stratum) * 0.618034 + rotation);
        vec3 t = normalize(abs(n.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), n) : cross(vec3(1.0, 0.0, 0.0), n));
        vec3 b = cross(n, t);
        dir = normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - r * r)));
    }
    float cosTheta = dot(dir, n);
    // The mixture's density (the counts' shares of each technique's), and this ray's weight on irradiance.
    float mixturePdf = guide >= 0 ? 0.5 * max(cosTheta, 0.0) / PI + 0.5 * guidePdf(guide, dir) : max(cosTheta, 0.0) / PI;
    float rayWeight = cosTheta > 0.0 && mixturePdf > 0.0 ? cosTheta / mixturePdf : 0.0;
    vec3 origin = position + n * 0.01;

    vec3 radiance;
    BlixRayHit hit;
    bool hitSomething = blix_traceClosest(origin, dir, 0.0, uintBitsToFloat(0x7F800000u), seed, hit);
    // Openness, from the cosine-distributed rays only (-1: a guided ray says nothing about it).
    sOpen[ray] = guided ? -1.0 : (hitSomething && hit.t < u.uOpen.x ? 0.0 : 1.0);
    if (hitSomething) {
        vec3 hn = dot(hit.normal, dir) > 0.0 ? -hit.normal : hit.normal;
        vec3 hitPos = origin + dir * hit.t;
        vec3 toSun = -normalize(u.uSunDirection.xyz);
        float ndotl = max(dot(hn, toSun), 0.0);
        float sun = 0.0;
        if (ndotl > 0.0) {
            int cascade = -1;
            float lit = blix_sun_shadow_cascaded_hard(
                uCascadeShadowMaps[0], uCascadeShadowMaps[1], uCascadeShadowMaps[2],
                u.uCascadeVP[0], u.uCascadeVP[1], u.uCascadeVP[2], hitPos + hn * 0.01, ndotl, cascade);
            if (cascade < 0) lit = blix_traceAny(hitPos + hn * 0.01, toSun, 0.0, uintBitsToFloat(0x7F800000u), blix_pcg(seed ^ 0x5bd1e995u)) ? 0.0 : 1.0;
            sun = ndotl * lit;
        }
        bool found;
        vec3 indirect = cookedIndirect(hitPos, hn, found);
        radiance = hit.albedo * (u.uSunIrradiance.rgb * sun + indirect) / PI;
    } else {
        radiance = textureLod(uSkyRadiance, dir, u.uSky.y).rgb * u.uSky.x;
    }
    sRadiance[ray] = radiance * rayWeight;
    barrier();
    if (ray == 0u) {
        vec3 sum = vec3(0.0);
        for (int k = 0; k < RAYS; ++k) sum += sRadiance[k];
        vec3 estimate = sum / float(RAYS);
        float total = rays + float(RAYS);
        vec4 old = texelLight[id];
        if (stale) {
            // Only a texel that had light keeps it as the prior; it starts its own gather from nothing.
            if (old.w > 0.0) texelPrior[id] = vec4(old.rgb, 1.0);
            texelEpoch[id] = epoch;
            old = vec4(0.0);
        }
        vec4 gathered = vec4(mix(old.rgb, estimate, float(RAYS) / total), total);
        texelLight[id] = gathered;
        const vec3 luma = vec3(0.2126, 0.7152, 0.0722);
        float lum = dot(estimate, luma);
        float m2 = mix(stale ? 0.0 : texelMoment[id], lum * lum, float(RAYS) / total);
        texelMoment[id] = m2;
        if (total >= TEXEL_PRIOR_RAYS) texelPrior[id] = vec4(0.0);
        // Openness this pass, into its running mean.
        float freeRays = 0.0, cosineRays = 0.0;
        for (int k = 0; k < RAYS; ++k) if (sOpen[k] >= 0.0) { cosineRays += 1.0; freeRays += sOpen[k]; }
        vec4 open = texelOpen[id];
        float openCount = open.y + cosineRays;
        float openness = openCount > 0.0 ? (open.x * open.y + freeRays) / openCount : 0.0;
        texelOpen[id] = vec4(openness, openCount, 0.0, 0.0);
        vec4 value = gathered;
        if (u.uOpen.z > 0.5) {
            float wsum;
            vec4 interp = cookedInterp(position, n, wsum);
            if (wsum > 1e-6) {
                vec3 occlusion = interp.a > 1e-3 ? interp.rgb * (openness / interp.a) : interp.rgb;
                // The gathered mean's variance: its passes' spread over their count, with one pseudo-pass of 100%
                // spread so a texel of one or two passes does not claim certainty it has not earned.
                float mean = dot(gathered.rgb, luma);
                float passes = total / float(RAYS);
                float variance = (max(m2 - mean * mean, 0.0) * passes + mean * mean) / (passes * (passes + 1.0));
                float occlusionError = u.uOpen.y * dot(occlusion, luma);
                float wGathered = 1.0 / (variance + 1e-12);
                float wOcclusion = 1.0 / (occlusionError * occlusionError + 1e-12);
                value = vec4((wGathered * gathered.rgb + wOcclusion * occlusion) / (wGathered + wOcclusion), total);
            }
        }
        texelBlend[id] = value;
    }
}
