#version 450
// Potential suns (SponzaLoop.PotentialSuns.cs): every live texel's light for the sun as it is now, from the nodes --
// written as the texels at rest hold it (TexelResolved, texel_resolve.comp's format), so the incident pass reads it as
// it reads a bake. A workgroup a block of texels (SunNodeBlocks): the block's basis taken at the sun (Catmull-Rom over
// the 4 x 4 nodes around it: sixteen weights), then each texel's light is its Rank coefficients against that.
//
// uResolve.w picks what is written (RenderSettings.PotentialSunsView; viz channel 10 shows it unexposed):
//   0  the light
//   1  against the bake (TexelBaked, the boot sun's): red brighter, blue darker, full at uView.y relative
//   2  coefficient uView.x, signed (red +, blue -), over the block's largest
//   3  the blocks, a colour each

#define RANK 8
#define BLOCK 4096
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform PotentialResolve {
    vec4 uResolve;     // x blocks, y live texels, z columns (suns x 3), w the view
    vec4 uView;        // x the coefficient, y the heat scale
    mat4 uWeights[2];  // sixteen (node, weight) pairs, two to a column (xy, zw): eight columns in two matrices
} u;

layout(std430, set = 0, binding = 1) readonly buffer SunNodesLive { uint liveIds[]; };
layout(std430, set = 0, binding = 2) readonly buffer PotentialBasis { uint basisWords[]; };   // halves: [block][rank][column]
layout(std430, set = 0, binding = 3) readonly buffer PotentialCoefs { uint coefWords[]; };    // halves: [live][rank]
layout(std430, set = 0, binding = 4) writeonly buffer TexelResolved { uvec2 texelResolved[]; };
layout(std430, set = 0, binding = 5) readonly buffer TexelBaked { uvec2 texelBaked[]; };

shared vec3 sFactor[RANK];
shared float sMax[RANK];

float basisAt(uint index) {
    uint w = basisWords[index >> 1u];
    return (index & 1u) == 0u ? unpackHalf2x16(w).x : unpackHalf2x16(w).y;
}

uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

vec3 unpackRgb9e5(uint p) {
    float scale = exp2(float(int(p >> 27) - 15 - 9));
    return vec3(p & 511u, (p >> 9) & 511u, (p >> 18) & 511u) * scale;
}

// Red for +, blue for -, full at 1, on a dim grey so zero still shows the surface.
vec3 signedColour(float v) {
    return vec3(0.04) + vec3(clamp(v, 0.0, 1.0), 0.0, clamp(-v, 0.0, 1.0));
}

void main() {
    uint block = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;
    uint cols = uint(u.uResolve.z);
    if (lid < uint(RANK * 3)) {
        uint r = lid / 3u, c = lid % 3u;
        float s = 0.0;
        for (int q = 0; q < 16; ++q) {
            vec4 column = u.uWeights[q / 8][(q / 2) % 4];
            vec2 pair = (q & 1) == 0 ? column.xy : column.zw;
            if (pair.y == 0.0) continue;
            s += pair.y * basisAt((block * uint(RANK) + r) * cols + uint(pair.x) * 3u + c);
        }
        sFactor[r][c] = s;
    }
    int view = int(u.uResolve.w + 0.5);
    if (view == 2 && lid == 0u) {
        // The block's largest |coefficient| for the one shown, so each block reads on its own scale.
        uint k = uint(u.uView.x);
        float m = 1e-12;
        for (uint i = 0u; i < uint(BLOCK); ++i) {
            uint idx = block * uint(BLOCK) + i;
            if (idx >= uint(u.uResolve.y)) break;
            uint w = coefWords[(idx * uint(RANK) + k) >> 1u];
            m = max(m, abs((k & 1u) == 0u ? unpackHalf2x16(w).x : unpackHalf2x16(w).y));
        }
        sMax[0] = m;
    }
    barrier();
    for (uint i = lid; i < uint(BLOCK); i += 64u) {
        uint idx = block * uint(BLOCK) + i;
        if (idx >= uint(u.uResolve.y)) break;
        uint id = liveIds[idx];
        float coef[RANK];
        for (uint w = 0u; w < uint(RANK) / 2u; ++w) {
            vec2 h = unpackHalf2x16(coefWords[idx * uint(RANK) / 2u + w]);
            coef[2u * w] = h.x;
            coef[2u * w + 1u] = h.y;
        }
        vec3 light = vec3(0.0);
        for (int r = 0; r < RANK; ++r) light += coef[r] * sFactor[r];
        light = max(light, vec3(0.0));
        vec3 shown = light;
        if (view == 1) {
            vec3 baked = unpackRgb9e5(texelBaked[id].x);
            float l = dot(light, vec3(0.2126, 0.7152, 0.0722));
            float b = dot(baked, vec3(0.2126, 0.7152, 0.0722));
            shown = signedColour((l - b) / max(b, 1e-3) / max(u.uView.y, 1e-4));
        } else if (view == 2) {
            shown = signedColour(coef[int(u.uView.x)] / sMax[0]);
        } else if (view == 3) {
            uint h = block * 2654435761u;
            shown = vec3(float(h & 255u), float((h >> 8) & 255u), float((h >> 16) & 255u)) / 255.0;
        }
        texelResolved[id] = uvec2(packRgb9e5(shown), 0xFFFFu | 0x10000u);
    }
}
