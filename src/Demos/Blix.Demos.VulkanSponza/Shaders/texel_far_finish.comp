#version 450
// The far field (texel_far.glsl), a slice's last step before its sums are read back: each texel's light from beyond its
// reach, added into its sums as if every pass had carried it -- so the refining, the settling and the landing read the
// whole light, and the noise (column 0's w) stays the near rays' alone: the far light is the same every pass.
//   far = sum over the bins the record knows of  L(bin) x C(bin) x V(bin)
//     L  the record's mean radiance in the bin (the patch's texels' far rays, pooled)
//     C  the bin's share of the texel's cosine-weighted hemisphere, in irradiance (integrated over 512 fixed directions:
//        the same for every texel with the same frame, so no noise of its own)
//     V  the share of the texel's own rays in the bin that went past its reach (NodeFarBins: its near geometry, which only
//        it knows); a bin none of its rays fell in takes the texel's share over all known bins
// Blended (texel_far.glsl, farSet): the far light is the weighted sum of each blended patch's own estimate -- its record,
// its bins, the texel's open share in its bins -- over the directions every blended patch knows (the rest were the
// texel's own rays). Its error, the patches' errors summed by their weights (they share the texel's rays: correlated).
// So which bins a texel's rays happen to land in no longer matters -- that was the noise -- only what it sees near.
// V is itself an estimate from the texel's few rays a bin: its error (a weighted binomial's: ((1 - V)^2 far w^2 +
// V^2 near w^2) / (sum w)^2 -- the guided rays weigh less, and counting weight / pi had overstated it 3-10x) goes
// into the noise the settling judges, so a texel whose far light is still uncertain refines -- each round a fresh V.
// A thread a slice texel.

#define PI 3.14159265359
#define FAR_DIRECTIONS 512
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform FarFinish {
    vec4 uFinish;   // x the slice's first entry in NodeIds, y its texels, z the passes, w the columns (suns)
    vec4 uCookedGrid;
    vec4 uCookedDims;
    vec4 uFar;
    vec4 uDebug;    // x 1: land the far light alone; 2: the blended patches as colours (--far-debug); y the slice's serial; z the
                    // sun's column + 1 when the sky's part is kept (the moment the sun's alone: texel_nodes_shade.glsl)
} u;

layout(std430, set = 0, binding = 1) readonly buffer Texels { vec4 texels[]; };
layout(std430, set = 0, binding = 2) readonly buffer NodeIds { uint nodeIds[]; };
layout(std430, set = 0, binding = 3) readonly buffer TexelPatch { int texelPatch[]; };
layout(std430, set = 0, binding = 4) readonly buffer NodeGuidePatch { uint guidePatch[]; };
// [slice texel][blended patch][bin]: x weight, y far, z w^2, w far w^2 (texel_nodes_shade.glsl).
layout(std430, set = 0, binding = 5) readonly buffer NodeFarBins { vec4 farBins[]; };
layout(std430, set = 0, binding = 6) buffer NodeAccum { vec4 nodeAccum[]; };
// The pooling's inputs (texel_far_pool.comp): each slice texel's evidence, where its id's evidence lies this slice, and
// its rays' harmonic sums (texel_nodes_shade.glsl: x sum of 1 / hit distance, y rays).
layout(std430, set = 0, binding = 12) writeonly buffer FarEvidence { vec4 evidence[]; };
layout(std430, set = 0, binding = 13) writeonly buffer FarSliceMap { uint sliceMap[]; };
layout(std430, set = 0, binding = 14) readonly buffer NodeHarmonic { vec2 harmonic[]; };
#define EVIDENCE 7

#define COOKED_BINDING 7
#define COOKED_GRID u.uCookedGrid
#define COOKED_DIMS u.uCookedDims
#include "cooked_patches.glsl"
#define FAR_RECORD_BINDING 10
#define FAR_RECORD_ACCESS readonly
#define FAR_NEIGHBOURS_BINDING 11
#include "texel_far.glsl"

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uFinish.y)) return;
    uint id = nodeIds[uint(u.uFinish.x) + t];
    int p = texelPatch[id];
    if (p < 0) p = int(guidePatch[id]) - 2;
    sliceMap[id] = (uint(u.uDebug.y) & 0xFFFFu) << 16 | t;
    if (p < 0) {
        evidence[t * uint(EVIDENCE) + 6u] = vec4(0.0);   // no patch: no evidence, its sums stand
        return;
    }
    vec3 x = texels[2u * id].xyz;
    vec3 n = normalize(texels[2u * id + 1u].xyz);
    int ids[FAR_SET];
    float ws[FAR_SET];
    farSet(x, n, p, u.uFar, ids, ws);
    vec3 fn[FAR_SET], ft[FAR_SET], fb[FAR_SET];
    for (int i = 0; i < FAR_SET; ++i) if (ids[i] >= 0) farFrame(ids[i], fn[i], ft[i], fb[i]);
    // C: the texel's cosine lobe over each patch's bins, where every blended patch knows the direction.
    float c[FAR_SET * FAR_BINS];
    for (int b = 0; b < FAR_SET * FAR_BINS; ++b) c[b] = 0.0;
    vec3 tt = normalize(abs(n.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), n) : cross(vec3(1.0, 0.0, 0.0), n));
    vec3 tb = cross(n, tt);
    for (int k = 0; k < FAR_DIRECTIONS; ++k) {
        float r2 = (float(k) + 0.5) / float(FAR_DIRECTIONS);
        float r = sqrt(r2), phi = float(k) * 2.39996323;
        vec3 d = tt * (r * cos(phi)) + tb * (r * sin(phi)) + n * sqrt(1.0 - r2);
        int bins[FAR_SET];
        bool joint = true;
        for (int i = 0; i < FAR_SET; ++i) {
            bins[i] = -1;
            if (ids[i] < 0) continue;
            bins[i] = farBin(d, fn[i], ft[i], fb[i]);
            joint = joint && bins[i] >= 0 && farKnown(ids[i], bins[i], u.uFar);
        }
        if (!joint) continue;
        for (int i = 0; i < FAR_SET; ++i) if (ids[i] >= 0) c[i * FAR_BINS + bins[i]] += PI / float(FAR_DIRECTIONS);
    }
    int columns = int(u.uFinish.w + 0.5);
    float passes = u.uFinish.z;
    const vec3 lumW = vec3(0.2126, 0.7152, 0.0722);
    vec3 light[4] = vec3[4](vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0));   // per column (a split cook: up to 3)
    float spread = 0.0, recordSpread = 0.0;
    for (int i = 0; i < FAR_SET; ++i) {
        if (ids[i] < 0) continue;
        uint row = (t * uint(FAR_SET) + uint(i)) * uint(FAR_BINS);
        // V: the texel's own share past its reach in this patch's bins; over all its bins for a bin none of its rays fell in.
        float allW = 0.0, allF = 0.0;
        for (int b = 0; b < FAR_BINS; ++b) { vec4 wf = farBins[row + uint(b)]; allW += wf.x; allF += wf.y; }
        float vAll = allW > 0.0 ? allF / allW : 0.0;
        float variance = 0.0, recordVariance = 0.0;
        for (int b = 0; b < FAR_BINS; ++b) {
            float cb = c[i * FAR_BINS + b];
            if (cb <= 0.0) continue;
            vec4 wf = farBins[row + uint(b)];
            float v = wf.x > 0.0 ? wf.y / wf.x : vAll;
            // V's error, a weighted binomial's: ((1 - V)^2 far w^2 + V^2 near w^2) / (sum w)^2; a bin none of its rays
            // fell in, as uncertain as one ray.
            float vVariance = wf.x > 0.0 ? ((1.0 - v) * (1.0 - v) * wf.w + v * v * (wf.z - wf.w)) / (wf.x * wf.x) : vAll * (1.0 - vAll);
            float l = 0.0;
            for (int k = 0; k < columns; ++k) {
                vec3 L = farLight(ids[i], b, k, u.uFar);
                light[k] += ws[i] * L * cb * v;
                l += dot(L, lumW);
            }
            variance += (cb * l) * (cb * l) * max(vVariance, 0.0);
            float se = farBinError(ids[i], b, u.uFar);
            recordVariance += (cb * v * se) * (cb * v * se);
        }
        spread += ws[i] * sqrt(variance);
        recordSpread += ws[i] * sqrt(recordVariance);
    }
    if (u.uDebug.x > 0.5) {
        // The diagnostic: the far light alone, or each blended patch's colour by its weight -- landed in place of the
        // light, its noise nil (settled at once).
        vec3 hue = vec3(0.0);
        for (int i = 0; i < FAR_SET; ++i) {
            if (ids[i] < 0) continue;
            uint h = uint(ids[i]) * 2654435761u;
            hue += ws[i] * vec3(float(h & 255u), float((h >> 8) & 255u), float((h >> 16) & 255u)) / 255.0;
        }
        float lum = 0.0;
        for (int k = 0; k < columns; ++k) {
            vec3 v = u.uDebug.x < 1.5 ? light[k] : (k == 0 ? 0.3 * hue : vec3(0.0));
            nodeAccum[t * uint(columns) + uint(k)] = vec4(v * passes, 0.0);
            lum += dot(v, lumW);
        }
        nodeAccum[t * uint(columns)].w = passes * lum * lum;
        return;
    }
    // The evidence: near light per column (the mean of its passes) and its mean's variance; the far light and its variance;
    // the harmonic mean hit distance (a ray cut at the reach counted at the reach: errs small); the reach.
    int cols = min(columns, 3);
    float nearMean = 0.0;
    for (int k = 0; k < 3; ++k) {
        vec3 near = k < cols ? nodeAccum[t * uint(columns) + uint(k)].rgb / passes : vec3(0.0);
        if (u.uDebug.z < 0.5 || k == int(u.uDebug.z) - 1) nearMean += dot(near, lumW);
        // Slot 0's w: the far light's error from its patches' records -- not the texel's to refine (more of its rays do
        // not move it), but what makes two texels reading different patches differ: the pooling's light test needs it.
        evidence[t * uint(EVIDENCE) + uint(k)] = vec4(near, k == 0 ? recordSpread * recordSpread : 0.0);
        evidence[t * uint(EVIDENCE) + 3u + uint(k)] = vec4(k < cols ? light[k] : vec3(0.0), 0.0);
    }
    float squares = nodeAccum[t * uint(columns)].w;
    float nearVariance = max(squares / passes - nearMean * nearMean, 0.0) / passes;
    vec2 hs = harmonic[t];
    float h = hs.x > 0.0 ? min(hs.y / hs.x, 8.0) : 8.0;
    evidence[t * uint(EVIDENCE) + 6u] = vec4(nearVariance, spread * spread, h, max(farSetReach(x, ids, u.uFar), 1e-3));
}
