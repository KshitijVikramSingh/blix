#version 450

// The cooked near field (rtgi_cook.glsl: the level-0 junction cells, the first COOK_COUNTS.y): each one's near light this
// frame, over its own NEAR_RAYS fixed cosine rays (PI x L_in each): a ray that met a surface within the contact radius
// brings that surface's light from the cache -- albedo x (its indirect irradiance plus the sun by its cell's sun
// visibility); one that left brings nothing here, the readout putting the cache's far light over it (rtgi_readout.frag).
// No rays: the cook traced them (rtgi_cook.comp kinds 6, 7); only light is read. Blended over a few frames (uUpdate.z), a
// share of the cells a frame (uUpdate.x, .y).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiNearCookUpdate {
    vec4 uParams;        // rtgiParams (rtgi_cache.glsl)
    vec4 uCamera;        // xyz position
    vec4 uSun;           // xyz toward the sun
    vec4 uSunIrradiance; // rgb
    vec4 uCook;          // rtgi_cook.glsl's COOK_PARAMS
    vec4 uCookCounts;    // rtgi_cook.glsl's COOK_COUNTS
    vec4 uUpdate;        // x the first cell this frame; y the cells; z the blend's weight of this frame; w the contact radius
    vec4 uNearField;     // x the near field's radius (rtgi_cache.glsl's RTGI_NEAR)
} u;

layout(std430, set = 0, binding = 1) readonly buffer RtgiCookTable { uvec2 cookTable[]; };
layout(std430, set = 0, binding = 2) readonly buffer RtgiCookPoints { vec4 cookPoints[]; };
layout(std430, set = 0, binding = 3) readonly buffer RtgiCookRegions { uint cookRegions[]; };
layout(std430, set = 0, binding = 4) readonly buffer RtgiCookScale { uvec2 cookScale[]; };
layout(std430, set = 0, binding = 5) readonly buffer RtgiNearLinks { uvec2 nearLinks[]; };
layout(std430, set = 0, binding = 6) buffer RtgiNearLight { vec4 nearLight[]; };
layout(std430, set = 0, binding = 7) readonly buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 8) readonly buffer RtgiRecord { uvec4 rtgiRecord[]; };
layout(std430, set = 0, binding = 9) readonly buffer RtgiResolved { vec4 rtgiResolved[]; };
// Per link, its hit's level-0 cooked cell + 1 and cache level (rtgi_cook.comp kind 7: worked out once at cook).
layout(std430, set = 0, binding = 10) readonly buffer RtgiNearHits { uint nearHits[]; };

#define COOK_PARAMS u.uCook
#define COOK_COUNTS u.uCookCounts
#define COOK_TABLE(i) cookTable[i]
#define COOK_POINTS(i) cookPoints[i]
#define COOK_REGIONS(i) cookRegions[i]
#define COOK_SCALE(i) cookScale[i]
#define RTGI_REGION_OF 1
#include "rtgi_cook.glsl"
#define RTGI_KEYS(i) rtgiKeys[i]
#define RTGI_NEAR u.uNearField.x
#include "rtgi_cache.glsl"

// The cache's indirect light at q facing n: its level's cell holding light, else a coarser one (two up at most); w its sun
// visibility, -1 none found.
vec4 cellLightKeyed(vec3 q, vec3 n, uint level) {
    uint side = rtgiSide(n);
    uint top = uint(u.uParams.w);
    for (uint l = level; l <= min(level + 2u, top); ++l) {
        uint s = rtgiFind(rtgiCellHash(ivec3(floor((q - rtgiOrigin(side)) / rtgiSize(l, u.uParams))), l, side, u.uParams), u.uParams);
        if (s == 0xFFFFFFFFu) continue;
        uvec4 a = rtgiRecord[2u * s], c = rtgiRecord[2u * s + 1u];
        if (uintBitsToFloat(c.w) < 0.5) continue;
        vec2 rg = unpackHalf2x16(a.x), bs = unpackHalf2x16(a.y);
        return vec4(rg, bs.x, rtgiResolved[2u * s + 1u].x);
    }
    return vec4(0.0, 0.0, 0.0, -1.0);
}

// q's cell under its own region, else under the unsplit key (region 0): a hit right at a junction resolves to a region its
// pieces split there that no training point keys alike -- a cell never trained, and a cooked cell all of whose rays met
// it never gathered (the blue dashes along the crevices testbed's edges, 2026-10-30).
// Its region and level the cook's (hit: rtgi_cook.comp kind 7), the level asked here only where the size table had none.
vec4 cellLight(vec3 q, vec3 n, uint hit) {
    rtgiRegion = hit & 0x0FFFFFFFu;
    uint level = hit >> 28;
    if (level > 10u) level = rtgiLevel(q, u.uCamera.xyz, u.uParams);
    vec4 c = cellLightKeyed(q, n, level);
    if (c.w < 0.0 && rtgiRegion != 0u) { rtgiRegion = 0u; c = cellLightKeyed(q, n, level); }
    return c;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uUpdate.y)) return;
    uint i = uint(u.uUpdate.x) + t;
    if (i >= uint(COOK_COUNTS.y)) i -= uint(COOK_COUNTS.y);
    vec4 pw = cookPoints[2u * i], nw = cookPoints[2u * i + 1u];
    if ((floatBitsToUint(pw.w) & NEAR_BURIED) != 0u || nearLight[i].w < -0.5) return;
    vec3 p = pw.xyz, n = nw.xyz;
    // Per ray: a surface met within the contact radius brings its cache light (albedo x (its indirect irradiance plus the
    // sun by its sun visibility)); one that left brings nothing here -- the readout puts the cache's far light over it.
    vec3 sum = vec3(0.0);
    float found = 0.0, left = 0.0, met = 0.0;
    for (uint k = 0u; k < NEAR_RAYS; k++) {
        uvec2 link = nearLinks[i * NEAR_RAYS + k];
        if ((link.x & 0x80000000u) == 0u) { left += 1.0; continue; }
        met += 1.0;
        vec3 d = nearRayDir(i, k, n);
        float dist = float((link.x >> 16) & 0x7FFFu) / 32767.0 * u.uUpdate.w;
        vec3 q = p + n * 0.01 + d * dist;
        vec3 nq = nearOctDecode(vec2(link.x & 0xFFu, (link.x >> 8) & 0xFFu) / 255.0);
        vec4 c = cellLight(q, nq, nearHits[i * NEAR_RAYS + k]);
        if (c.w < 0.0) continue;
        sum += unpackUnorm4x8(link.y).rgb * (c.rgb + u.uSunIrradiance.rgb * max(dot(nq, u.uSun.xyz), 0.0) * c.w);
        found += 1.0;
    }
    float esc = left / float(NEAR_RAYS);
    // The met ones' light (over those the cache had light for), scaled to their share of the rays.
    if (met > 0.5 && found < 0.5) return;
    vec3 now = met > 0.5 ? sum / found * (met / float(NEAR_RAYS)) : vec3(0.0);
    vec4 old = nearLight[i];
    // w: 1 + the escape share once it has light (the readout and the others' hits read it from then).
    nearLight[i] = vec4(old.w > 0.5 ? mix(old.rgb, now, u.uUpdate.z) : now, 1.0 + esc);
}
