#version 450
// The coarse cells' light filtered before the fine copy reads it (SponzaLoop.Transfer.cs, ApplyFineNow): each coarse
// cell's parts over its 27 neighbours at its level, weighed as the compose's filter weighs the composed light
// (texel_filter_neighbour.glsl: distance, normal, and an edge where a neighbour's light is ~half again brighter or
// darker -- a shadow's, a corner's -- not noise). The fine texels take their cells' light as smooth fields; unfiltered,
// each cell's own ray noise (~1.3% of its light at 384 rays) went onto every fine texel it lights, cell-sized blobs the
// eye reads as patches (Cornell, 2026-10-21). The compose filters the composed light at rest too, but the copy reads the
// parts.
// uEdge.z 1 (the default; --coarse-filter-mean 0): a local linear fit in the surface's plane instead of the weighted mean -- the light as
// c + g.(offset), c kept. Where the neighbourhood is one-sided (a cell beside a crease, the surface ending) the mean's
// centre sits ~0.4 of a cell off the cell's, and the light's slope there times that offset came out as a bias; the fit has
// none to first order, and over a full neighbourhood it is the mean exactly (the offsets' moments vanish).
//   mode 0  each coarse cell's filtered parts into FilteredSky / FilteredSun
//   mode 1  those back into the parts (the confidence words kept)

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform CoarseFilter {
    vec4 uFilter;       // x the coarse cells, y the mode, z 1: the sky's part too (0: kept, a sun change), w the sun's luminance
    vec4 uTexelGrid;    // xyz the cells' origin, w the spacing
    vec4 uTexelParams;  // x hash capacity
    vec4 uLightmap;     // as texel_filter.comp's
    vec4 uEdge;         // as texel_filter.comp's
} u;

layout(std430, set = 0, binding = 1) readonly buffer CoarseIds { uint coarseIds[]; };
layout(std430, set = 0, binding = 2) readonly buffer TexelHash { uint texelHash[]; };
layout(std430, set = 0, binding = 3) readonly buffer Texels { uvec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 4) readonly buffer LightmapIndex { uint lightmapIndex[]; };
#include "lightmap_index.glsl"
layout(std430, set = 0, binding = 5) buffer SplitSky { uvec2 skyPart[]; };
layout(std430, set = 0, binding = 6) buffer SplitSun { uvec2 sunPart[]; };
layout(std430, set = 0, binding = 7) buffer FilteredSky { uint filteredSky[]; };   // [coarse cell]
layout(std430, set = 0, binding = 8) buffer FilteredSun { uint filteredSun[]; };
#define TEXEL_INDEX_MAP(i) lightmapIndexAt(ivec2(int(i) % int(lightmapIndex[0]), int(i) / int(lightmapIndex[0])))
#define TEXEL_HASH(i) uvec3(texelHash[3u * uint(i)], texelHash[3u * uint(i) + 1u], texelHash[3u * uint(i) + 2u])
#include "texel.glsl"
#include "texel_filter_neighbour.glsl"

uint packRgb9e5(vec3 c) {
    const float maxValue = 65408.0;
    c = clamp(c, vec3(0.0), vec3(maxValue));
    float maxC = max(c.r, max(c.g, c.b));
    int e = max(-16, int(floor(log2(max(maxC, 1e-30))))) + 1;
    float scale = exp2(float(e - 9));
    if (int(floor(maxC / scale + 0.5)) == 512) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(c / scale + 0.5));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(e + 15) << 27);
}

vec3 unpackRgb9e5(uint p) {
    float scale = exp2(float(int(p >> 27) - 15 - 9));
    return vec3(p & 511u, (p >> 9) & 511u, (p >> 18) & 511u) * scale;
}

const vec3 luma = vec3(0.2126, 0.7152, 0.0722);
float composedLum(uint id) { return dot(unpackRgb9e5(skyPart[id].x), luma) + dot(unpackRgb9e5(sunPart[id].x), luma) * u.uFilter.w; }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u.uFilter.x)) return;
    uint id = coarseIds[i];
    bool sky = u.uFilter.z > 0.5;
    if (int(u.uFilter.y) == 1) {
        if (sky) skyPart[id].x = filteredSky[i];
        sunPart[id].x = filteredSun[i];
        return;
    }
    filteredSky[i] = skyPart[id].x;
    filteredSun[i] = sunPart[id].x;
    if ((skyPart[id].y & 0x10000u) == 0u) return;   // not gathered: as it is
    vec3 position = TEXEL_POSITION(id).xyz;
    vec3 n = TEXEL_NORMAL(id).xyz;
    float centre = composedLum(id);
    TexelGrid finestGrid;
    finestGrid.minCorner = u.uTexelGrid.xyz;
    finestGrid.spacing = u.uTexelGrid.w;
    finestGrid.capacity = uint(u.uTexelParams.x);
    finestGrid.level = 0u;
    vec3 accSky = vec3(0.0), accSun = vec3(0.0);
    float total = 0.0;
    // The linear fit's moments: the offsets (in the cell's tangent plane, in cells) and the light against them.
    vec3 ta = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
    vec3 tb = cross(n, ta);
    float sx = 0.0, sy = 0.0, sxx = 0.0, sxy = 0.0, syy = 0.0;
    vec3 skyX = vec3(0.0), skyY = vec3(0.0), sunX = vec3(0.0), sunY = vec3(0.0);
    vec3 skyLo = vec3(1e30), skyHi = vec3(0.0), sunLo = vec3(1e30), sunHi = vec3(0.0);
    for (uint k = 0u; k < 27u; ++k) {
        TexelGrid tg;
        int other = texelFilterNeighbour(int(id), k, position, n, finestGrid, u.uLightmap, tg);
        if (other < 0 || (skyPart[other].y & 0x10000u) == 0u) continue;
        float w = texelFilterWeight(other, position, n, tg, centre, composedLum(uint(other)), u.uEdge);
        vec3 ks = unpackRgb9e5(skyPart[other].x), kn = unpackRgb9e5(sunPart[other].x);
        accSky += w * ks;
        accSun += w * kn;
        total += w;
        vec3 dp = (TEXEL_POSITION(other).xyz - position) / tg.spacing;
        float x = dot(dp, ta), y = dot(dp, tb);
        sx += w * x; sy += w * y; sxx += w * x * x; sxy += w * x * y; syy += w * y * y;
        skyX += w * x * ks; skyY += w * y * ks; sunX += w * x * kn; sunY += w * y * kn;
        if (w > 1e-4) { skyLo = min(skyLo, ks); skyHi = max(skyHi, ks); sunLo = min(sunLo, kn); sunHi = max(sunHi, kn); }
    }
    if (total <= 1e-6) return;
    vec3 outSky = accSky / total, outSun = accSun / total;
    if (u.uEdge.z > 0.5) {
        // Weighted least squares for (c, gx, gy), the slope's terms damped (a tenth of the weight: a line of neighbours, or
        // two, leaves the slope across it unknown, and the fit then leans to the mean); c is the first row of the inverse.
        float lam = 0.1 * total;
        float a00 = total, a01 = sx, a02 = sy, a11 = sxx + lam, a12 = sxy, a22 = syy + lam;
        float c00 = a11 * a22 - a12 * a12, c01 = a02 * a12 - a01 * a22, c02 = a01 * a12 - a02 * a11;
        float det = a00 * c00 + a01 * c01 + a02 * c02;
        if (abs(det) > 1e-8 * total * total * total) {
            // Never past what the neighbours hold: noise in a one-sided fit would otherwise extrapolate.
            outSky = clamp((c00 * accSky + c01 * skyX + c02 * skyY) / det, skyLo, skyHi);
            outSun = clamp((c00 * accSun + c01 * sunX + c02 * sunY) / det, sunLo, sunHi);
        }
    }
    if (sky) filteredSky[i] = packRgb9e5(outSky);
    filteredSun[i] = packRgb9e5(outSun);
}
