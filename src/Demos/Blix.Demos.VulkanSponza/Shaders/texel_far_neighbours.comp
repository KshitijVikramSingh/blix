#version 450
// The far field's patch neighbours (texel_far.glsl, farSet): a texel blends the far light of its patch and of the
// patches around it, so the far light is continuous across patches instead of stepping where a texel's patch changes.
// The neighbours are not "the nearest patches" (cookedInterp's): those cross thin walls at their feet. They are the
// patches within FAR_NEIGHBOUR_REACH spacings facing within ~45 degrees whose centre the patch can SEE (a ray between
// them, both lifted off their surfaces, meets nothing) -- the same rule as a texel's own patch (texel_nodes_patch.comp).
//   mode 0  a patch's candidates, nearest first, and a ray to each (the CLOSEST batch)
//   mode 1  those whose ray got through, into PatchNeighbours (-1: none)
// A thread a patch of the chunk.

#define FAR_NEIGHBOURS 8
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform FarNeighbours {
    vec4 uNeighbours;   // x the chunk's first patch, y its patches, z the mode, w the spacing
    vec4 uCookedGrid;
    vec4 uCookedDims;
} u;

layout(std430, set = 0, binding = 1) buffer NodeRays { vec4 nodeRays[]; };            // 2 a ray: origin, tMin; dir, tMax
layout(std430, set = 0, binding = 2) readonly buffer NodeHits { uvec4 nodeHits[]; };  // 3 a ray
layout(std430, set = 0, binding = 3) buffer PatchNeighbours { int neighbours[]; };    // [patch][FAR_NEIGHBOURS]

#define COOKED_BINDING 4
#define COOKED_GRID u.uCookedGrid
#define COOKED_DIMS u.uCookedDims
#include "cooked_patches.glsl"

// 1.75 spacings: a texel blends the patches within one spacing of it, and its own patch is within ~0.75 of it, so any
// patch it blends lies within 1.75 of its own (SponzaLoop.FarField.cs).
#define FAR_NEIGHBOUR_REACH 1.75

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(u.uNeighbours.y)) return;
    int p = int(u.uNeighbours.x) + int(t);
    vec3 pos = cookedPatch[3 * p].xyz;
    vec3 n = normalize(cookedPatch[3 * p + 1].xyz);
    if (u.uNeighbours.z < 0.5) {
        int best[FAR_NEIGHBOURS];
        float bestD[FAR_NEIGHBOURS];
        for (int k = 0; k < FAR_NEIGHBOURS; ++k) { best[k] = -1; bestD[k] = 1e30; }
        float reach = FAR_NEIGHBOUR_REACH * u.uNeighbours.w;
        ivec3 dims = ivec3(COOKED_DIMS.xyz);
        ivec3 c = ivec3(floor((pos - COOKED_GRID.xyz) / COOKED_GRID.w));
        int ring = int(ceil(reach / COOKED_GRID.w));
        for (int dz = -ring; dz <= ring; ++dz)
        for (int dy = -ring; dy <= ring; ++dy)
        for (int dx = -ring; dx <= ring; ++dx) {
            ivec3 cc = c + ivec3(dx, dy, dz);
            if (any(lessThan(cc, ivec3(0))) || any(greaterThanEqual(cc, dims))) continue;
            int cell = (cc.z * dims.y + cc.y) * dims.x + cc.x;
            for (uint k = cookedCellStart[cell]; k < cookedCellStart[cell + 1]; ++k) {
                int j = int(cookedId[k]);
                if (j == p || dot(cookedPatch[3 * j + 1].xyz, n) < 0.7) continue;
                vec3 d = cookedPatch[3 * j].xyz - pos;
                float d2 = dot(d, d);
                if (d2 > reach * reach || d2 >= bestD[FAR_NEIGHBOURS - 1]) continue;
                int at = FAR_NEIGHBOURS - 1;
                while (at > 0 && bestD[at - 1] > d2) { bestD[at] = bestD[at - 1]; best[at] = best[at - 1]; --at; }
                bestD[at] = d2;
                best[at] = j;
            }
        }
        vec3 origin = pos + n * 0.01;
        for (int k = 0; k < FAR_NEIGHBOURS; ++k) {
            uint slot = t * uint(FAR_NEIGHBOURS) + uint(k);
            neighbours[uint(p) * uint(FAR_NEIGHBOURS) + uint(k)] = best[k];
            if (best[k] < 0) { nodeRays[slot * 2u] = vec4(0.0); nodeRays[slot * 2u + 1u] = vec4(0.0); continue; }
            vec3 target = cookedPatch[3 * best[k]].xyz + normalize(cookedPatch[3 * best[k] + 1].xyz) * 0.01;
            vec3 d = target - origin;
            float len = length(d);
            nodeRays[slot * 2u] = vec4(origin, 0.0);
            nodeRays[slot * 2u + 1u] = len > 1e-4 ? vec4(d / len, len * 0.999) : vec4(0.0, 1.0, 0.0, 0.0);
        }
        return;
    }
    for (int k = 0; k < FAR_NEIGHBOURS; ++k) {
        uint slot = t * uint(FAR_NEIGHBOURS) + uint(k);
        uint at = uint(p) * uint(FAR_NEIGHBOURS) + uint(k);
        if (neighbours[at] >= 0 && (nodeHits[slot * 3u].w & 1u) != 0u) neighbours[at] = -1;   // met something short of it
    }
}
