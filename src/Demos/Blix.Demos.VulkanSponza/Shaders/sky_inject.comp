#version 450

// Updates the directional incident-light probe atlas from the current sun, distant sky, and the
// previous transport sweep. Geometry is baked as occupancy/visibility; lighting stays dynamic so
// sun direction and environment changes can propagate without rebaking.
//
// Rays use the entered voxel face as a surface normal, trace sun transmittance, and feed the
// previous probe field back through the surface albedo. Stored values are average incident
// radiance; conversion to irradiance happens during directional reconstruction. Keeping feedback
// in radiance makes albedo the per-bounce gain and therefore keeps physical materials convergent.
//
// The atlas is directional because nearby occluders and coloured surfaces cannot be represented by
// one RGB value per probe. Sky visibility remains a separate baked field: it supplies the enclosure
// geometry while this pass supplies changing incident light.

#include "probe_volume.glsl"
#include "sky_visibility.glsl"

#define BLIX_OCT_INTERIOR 6
#define BLIX_OCT_TILE     8
// 256 rays are required by the sharp directional depth reconstruction, not irradiance. With the
// pow(dot, 50) depth lobe, measured effective samples rise from 1.82 at 64 rays to 4.97 at 256.
// Widening the lobe improves the count by blurring the wall boundaries the visibility test needs.
#define BLIX_OCT_RAYS     256

// Fraction of the newly solved value incorporated into an established tile.
#define SOLVE_CONVERGE 0.4


// One workgroup per probe; one thread per ray, then one thread per tile texel. The rays are
// marched once into shared memory and every texel reads all of them, which is what makes a
// 36-texel map cost one set of marches rather than thirty-six.
layout(local_size_x = BLIX_OCT_RAYS) in;

shared vec3 sRadiance[BLIX_OCT_RAYS];
shared vec3 sDirection[BLIX_OCT_RAYS];
shared vec3 sTexel[BLIX_OCT_INTERIOR * BLIX_OCT_INTERIOR];
shared float sClosure[BLIX_OCT_RAYS];
shared float sMeanClosure;
shared float sDistance[BLIX_OCT_RAYS];
// Per-ray reachability, reduced once per probe below.
shared float sReach[BLIX_OCT_RAYS];
shared float sSunlit[BLIX_OCT_RAYS];
shared vec2 sDepthTexel[BLIX_OCT_INTERIOR * BLIX_OCT_INTERIOR];

layout(set = 0, binding = 0) uniform Inject {
    vec4 uBoundsMin;      // xyz world min of the probe/occupancy volume, w unused
    vec4 uBoundsSpan;     // xyz world span, w = bounce albedo
    vec4 uProbeDims;      // xyz probe grid dims, w = rays per probe
    vec4 uOccupancyDims;  // xyz occupancy dims, w unused
    vec4 uSunDirection;   // xyz direction the sun TRAVELS, w unused
    vec4 uSunIrradiance;  // rgb measured irradiance, w = 1 when the sky-visibility volume is loaded
    // x = frame counter, y = how many frames a full sweep takes. Bounce is the low-frequency half
    // of the image and the sun moves slowly, so solving every probe every frame spends 19 ms to
    // re-derive a field that barely changed — measured, it doubled the frame. Each probe is
    // refreshed on its own turn instead.
    // x = frame counter, y = sweep length, z = usage decay per frame (0 disables sleeping).
    vec4 uSchedule;   // w: 1 when the atlases alternate and a skipped probe must carry its tile
    // x = post-load frames during which NOTHING sleeps. See the wake test below.
    vec4 uWarmup;
    // x = multi-bounce feedback strength; 0 isolates direct sun and sky injection.
    // y = occupancy-march strength for transport feedback visibility.
    vec4 uTransport;
    // xyz albedo grid dims (0 = none shipped), w = translucency.
    vec4 uAlbedoDims;
} u;

// One octahedral tile per probe: an 8x8 footprint containing a 6x6 directional interior and a
// one-texel fold-aware border for bilinear sampling. This preserves narrower incident-light
// features than an L1 representation while keeping a fixed-size atlas.
//
// Tiles are laid out x across, (y + z * dimY) down — so a probe's neighbours in x are adjacent in
// memory, which is the axis a trilinear fetch walks first.
layout(set = 0, binding = 1, rgba16f) uniform image2D uAtlas;
layout(set = 0, binding = 4) uniform sampler2D uAtlasPrev;
// Mean hit distance, variance, reachability, and closure per direction/tile. These describe whether
// a probe can see a shading point rather than how bright the probe is.
layout(set = 0, binding = 11, rgba16f) uniform image2D uDepthAtlas;
layout(set = 0, binding = 12) uniform sampler2D uDepthAtlasPrev;
layout(set = 0, binding = 2) uniform sampler3D uOccupancy;
// Baked directional sky visibility and the irradiance cube form the distant-sky source term.
layout(set = 0, binding = 3) uniform sampler3D uSkyVisibility;
layout(set = 0, binding = 6) uniform sampler3D uSkyVisibility1;
layout(set = 0, binding = 8) uniform sampler3D uSkyVisibility2;
// The distant sky's cosine-convolved irradiance, the same cube the lit pass reads.
layout(set = 0, binding = 9) uniform samplerCube uIrradiance;
layout(set = 0, binding = 5) uniform sampler3D uAlbedo;
// Usage marks written by shading let the scheduler age out probes that no visible surface reads.
layout(set = 0, binding = 10, rgba16f) uniform image3D uProbeUsage;

#define PI 3.14159265359
// What the previous sweep left at a point, for a surface facing n. One bilinear fetch inside that
// probe's tile — the border ring is what makes this fetch safe at the octahedron's fold.
vec3 blixSampleAtlas(vec3 worldPos, vec3 n) {
    ivec3 dims = ivec3(u.uProbeDims.xyz);
    vec3 grid = clamp((worldPos - u.uBoundsMin.xyz) / u.uBoundsSpan.xyz, vec3(0.0), vec3(1.0))
              * vec3(dims) - 0.5;
    ivec3 p = clamp(ivec3(floor(grid + 0.5)), ivec3(0), dims - 1);

    vec2 oct = blix_octEncode(normalize(n)) * 0.5 + 0.5;          // [0,1] across the interior
    vec2 tile = vec2(p.x, p.y + p.z * dims.y) * float(BLIX_OCT_TILE);
    vec2 texel = tile + 1.0 + oct * float(BLIX_OCT_INTERIOR);      // +1 skips the border ring
    vec2 atlasSize = vec2(dims.x, dims.y * dims.z) * float(BLIX_OCT_TILE);
    return texture(uAtlasPrev, texel / atlasSize).rgb;
}

// The grid stores density: opaque triangles write 1 while cutout surfaces retain partial opacity.
// Transport must preserve that grade so foliage attenuates rather than becoming either air or wall.
float densityAt(ivec3 c) {
    float d = texelFetch(uOccupancy, clamp(c, ivec3(0), ivec3(u.uOccupancyDims.xyz) - 1), 0).r;
    // uOccupancyDims.w selects density-aware foliage transport; opaque cells read identically.
    return u.uOccupancyDims.w > 0.5 ? d : (d > 0.5 ? 1.0 : 0.0);
}

// Linear surface colour from the albedo cell corresponding to the hit. The host binds nearest
// sampling because this grid is one-to-one with occupancy; the stored byte is sqrt(linear), so
// square it after sampling to retain precision in absorbing channels.
vec3 albedoAt(vec3 worldPos) {
    if (u.uAlbedoDims.x < 1.0) return vec3(1.0);   // compatibility with packs without an albedo grid
    vec3 uvw = (worldPos - u.uBoundsMin.xyz) / u.uBoundsSpan.xyz;
    vec3 c = texture(uAlbedo, clamp(uvw, vec3(0.0), vec3(1.0))).rgb;
    return c * c;
}

// Shared DDA state keeps sun and gather traversal on the same cell-stepping contract.
struct Dda {
    ivec3 c;
    ivec3 step;
    vec3 tMax;
    vec3 inv;
    int axis;
};

Dda ddaInit(vec3 origin, vec3 dir, vec3 dims, vec3 cell) {
    Dda d;
    vec3 p = (origin - u.uBoundsMin.xyz) / cell;
    d.c = clamp(ivec3(floor(p)), ivec3(0), ivec3(dims) - 1);
    d.step = ivec3(sign(dir));
    d.inv = 1.0 / max(abs(dir), vec3(1e-9));
    d.tMax = vec3(
        (d.step.x > 0 ? (float(d.c.x) + 1.0 - p.x) : (p.x - float(d.c.x))) * d.inv.x,
        (d.step.y > 0 ? (float(d.c.y) + 1.0 - p.y) : (p.y - float(d.c.y))) * d.inv.y,
        (d.step.z > 0 ? (float(d.c.z) + 1.0 - p.z) : (p.z - float(d.c.z))) * d.inv.z);
    d.axis = 0;
    return d;
}

// Returns false once the walk has left the grid, which is the one case that means "sky".
bool ddaStep(inout Dda d, vec3 dims) {
    if (d.tMax.x < d.tMax.y && d.tMax.x < d.tMax.z) { d.c.x += d.step.x; d.tMax.x += d.inv.x; d.axis = 0; }
    else if (d.tMax.y < d.tMax.z)                   { d.c.y += d.step.y; d.tMax.y += d.inv.y; d.axis = 1; }
    else                                            { d.c.z += d.step.z; d.tMax.z += d.inv.z; d.axis = 2; }
    return !(any(lessThan(d.c, ivec3(0))) || any(greaterThanEqual(d.c, ivec3(dims))));
}

// How much sunlight survives the walk toward the sun. The boolean version asked "did anything stop
// the ray", which for a leaf card is the wrong question — letting light through is half of what a
// canopy does.
// Spectral, not scalar, and that is the whole point of it. A leaf does not dim sunlight evenly —
// it absorbs red and passes green — so a float here can only ever deliver grey light to the ground
// under a tree. Light reaching the far side of a cell is the part that went through the gaps
// (untinted, 1 - density) plus the part that went through the material itself, wearing its colour.
vec3 transmittance(vec3 origin, vec3 dir, float maxCells) {
    vec3 dims = u.uOccupancyDims.xyz;
    vec3 cell = u.uBoundsSpan.xyz / dims;
    Dda d = ddaInit(origin, dir, dims, cell);
    vec3 t = vec3(1.0);
    for (int i = 0; i < int(maxCells); ++i) {
        if (!ddaStep(d, dims)) break;   // left the grid: the rest of the way is open sky
        float density = densityAt(d.c);
        if (density <= 0.01) continue;
        // An OPAQUE cell transmits nothing, whatever colour it is. Without this gate a wall at
        // density 1 would pass albedo * translucency and the sun would come through stone.
        float trans = density >= 0.99 ? 0.0 : u.uAlbedoDims.w;
        vec3 through = vec3(1.0 - density);
        if (trans > 0.0) {
            vec3 hit = u.uBoundsMin.xyz + (vec3(d.c) + 0.5) * cell;
            through += density * albedoAt(hit) * trans;
        }
        t *= through;
        if (dot(t, vec3(1.0)) < 0.03) return vec3(0.0);
    }
    return t;
}

// Walk one direction and accumulate every encountered surface, weighted by remaining transmittance.
// Opaque geometry still terminates at its first occupied cell. The caller reconstructs directional
// irradiance using the direction from which this radiance arrived.
// reach is 1 when the ray escapes without solid geometry; sunlit is 1 when any encountered surface
// can see the sun. Their reductions distinguish a dark but reachable probe from a sealed one.
vec3 gather(vec3 origin, vec3 dir, float maxCells, vec3 toSun, float cellSize,
            out float hitDistance, out float reach, out float sunlit, out float closure) {
    // Closure is the fraction of this ray's unit transport handed to surfaces. The march starts
    // with a transmittance of one, spends `t * density` at every cell that re-radiates, and this is
    // the total it spent. Mean closure should agree with one minus independently baked sky
    // visibility and is retained as a transport self-check.
    closure = 0.0;
    // Directional hit distance supports visibility rejection. Escaping rays use the far bound;
    // zero would incorrectly describe an immediate blocker.
    hitDistance = maxCells * length(u.uBoundsSpan.xyz / u.uOccupancyDims.xyz);
    vec3 dims = u.uOccupancyDims.xyz;
    vec3 cell = u.uBoundsSpan.xyz / dims;
    Dda d = ddaInit(origin, dir, dims, cell);
    vec3 sum = vec3(0.0);
    vec3 t = vec3(1.0);
    bool recordedHit = false;
    reach = 1.0;    // cleared only by SOLID geometry -- see below
    sunlit = 0.0;

    for (int i = 0; i < int(maxCells); ++i) {
        if (!ddaStep(d, dims)) break;   // escaped: that is sky, already baked into the visibility SH
        float density = densityAt(d.c);
        if (density <= 0.01) continue;

        // The FIRST thing this ray meets is what stands between a probe and anything beyond it, so
        // the distance to it is what the visibility test needs — not the distance to whatever
        // happened to contribute most of the light.
        if (!recordedHit) {
            hitDistance = distance(origin, u.uBoundsMin.xyz + (vec3(d.c) + 0.5) * cell);
            recordedHit = true;
        }
        // Only solid geometry clears reach. Partial-density foliage attenuates transport but does
        // not by itself classify a probe as sealed.
        if (density >= 0.99) reach = 0.0;

        // A cell absorbs this fraction of the light still travelling, and re-radiates it. Spectral
        // for the same reason as the walk toward the sun: what arrives here has already passed
        // through whatever stands between, and that may have been a leaf.
        vec3 weight = t * density;
        // Counted before the 0.06 threshold below, on purpose: a cell skipped for being too faint
        // to matter is still transport that happened, and hiding it here would make the instrument
        // agree with the shortcut instead of measuring it.
        closure += dot(weight, vec3(1.0)) / 3.0;
        float trans = density >= 0.99 ? 0.0 : u.uAlbedoDims.w;

        // Below this a cell moves the answer by less than the 32-frame rotation's own noise, and
        // each one that clears the bar costs a second march. This bound is why foliage stays cheap.
        if (dot(weight, vec3(1.0)) > 0.06) {
            vec3 hitPos = u.uBoundsMin.xyz + (vec3(d.c) + 0.5) * cell;
            // The face we came through: opposite the axis we stepped along.
            vec3 n = vec3(0.0);
            n[d.axis] = float(-d.step[d.axis]);

            // A surface facing away from the sun catches none of it and needs no sun march.
            float ndotl = max(dot(n, toSun), 0.0);
            vec3 sunReach = ndotl > 0.0
                ? transmittance(hitPos + n * cellSize * 1.5, toSun, maxCells) * ndotl
                : vec3(0.0);
            if (dot(sunReach, vec3(1.0)) > 1e-4) sunlit = 1.0;

            // Evaluated along the hit surface's OWN normal: a surface re-radiates what reaches the
            // side it faces, using the atlas at full directional resolution.
            // The source sum is direct sun, visibility-weighted distant sky, and prior-sweep
            // feedback, all evaluated at the hit surface.
            //
            // Queried at the already-offset position with no further push: hitPos is one and a half
            // occupancy cells off the face, which is what the wall bias is for.
            vec3 probePos = hitPos + n * cellSize * 1.5;
            vec3 skyTerm = u.uSunIrradiance.w > 0.5
                ? texture(uIrradiance, n).rgb
                    * blix_skyVisibility(uSkyVisibility, uSkyVisibility1, uSkyVisibility2,
                                         u.uBoundsMin.xyz, 1.0 / u.uBoundsSpan.xyz, 0.0,
                                         probePos, n)
                : vec3(0.0);
            // Feedback uses the full visibility-weighted probe blend. Measured against a nearest
            // probe lookup, this costs about 0.6 ms with sleeping enabled and avoids light crossing
            // walls. Transport has its own occupancy strength because this dependency is evaluated
            // during injection rather than at the final shading point.
            vec3 feedback = u.uTransport.x > 0.0
                ? u.uTransport.x * blix_probeIrradiance(
                      uAtlasPrev, uDepthAtlasPrev, uOccupancy,
                      ivec3(u.uProbeDims.xyz), ivec3(u.uOccupancyDims.xyz),
                      u.uBoundsMin.xyz, u.uBoundsSpan.xyz, probePos, n, u.uTransport.y)
                : vec3(0.0);
            vec3 incident = u.uSunIrradiance.rgb * sunReach + skyTerm + feedback;

            // Lambertian outgoing radiance in the surface's colour; uBoundsSpan.w is a strength.
            sum += weight * u.uBoundsSpan.w * albedoAt(hitPos) * incident / PI;
        }

        // Tinted for the same reason the sun walk is: what continues past a red curtain is red.
        {
            vec3 through = vec3(1.0 - density);
            if (trans > 0.0) {
                vec3 here = u.uBoundsMin.xyz + (vec3(d.c) + 0.5) * cell;
                through += density * albedoAt(here) * trans;
            }
            t *= through;
        }
        if (dot(t, vec3(1.0)) < 0.03) break;
    }
    return sum;
}

vec3 fibonacci(int i, int count) {
    float y = 1.0 - 2.0 * (float(i) + 0.5) / float(count);
    float r = sqrt(max(0.0, 1.0 - y * y));
    float theta = 2.39996323 * float(i);
    return vec3(cos(theta) * r, y, sin(theta) * r);
}

// Where probe (x,y,z)'s tile starts in the atlas.
ivec2 blixTileOrigin(ivec3 probe, ivec3 dims) {
    return ivec2(probe.x, probe.y + probe.z * dims.y) * BLIX_OCT_TILE;
}

void main() {
    ivec3 dims = ivec3(u.uProbeDims.xyz);
    int probeIndex = int(gl_WorkGroupID.x);
    ivec3 probe = ivec3(probeIndex % dims.x,
                        (probeIndex / dims.x) % dims.y,
                        probeIndex / (dims.x * dims.y));
    if (probe.z >= dims.z) return;

    int lane = int(gl_LocalInvocationIndex);
    ivec2 tile = blixTileOrigin(probe, dims);
    // Rays and tile texels are independent: every lane may trace a ray, but only the first 8x8
    // lanes own atlas texels. Gating writes prevents higher ray counts from crossing tile bounds.
    const int tileTexels = BLIX_OCT_TILE * BLIX_OCT_TILE;
    bool ownsTexel = lane < tileTexels;
    ivec2 texel = ivec2(lane % BLIX_OCT_TILE, lane / BLIX_OCT_TILE);

    // Is this probe's turn? A scatter over the three axes rather than whole slices, so the ones
    // refreshed together are spread through the volume and a sun change arrives evenly rather than
    // sweeping across the scene as a visible plane.
    // Shading marks probes it samples. Marks decay into sleeping state, while the stored tile is
    // carried forward so waking resumes from a valid answer.
    float usage = imageLoad(uProbeUsage, probe).r;
    float decay = u.uSchedule.z;

    // Sleeping starts only after a whole-volume warm-up. Multi-bounce paths depend on intermediate
    // probes the current camera may never sample, so usage is a steady-state refresh hint rather
    // than permission to omit initial transport.
    bool warm = u.uSchedule.x >= u.uWarmup.x;
    bool asleep = warm && decay > 0.0 && usage <= 0.02;

    int period = int(u.uSchedule.y);
    int slot = (probe.x * 5 + probe.y * 11 + probe.z * 17) % period;

    if (asleep || slot != int(u.uSchedule.x) % period) {
        // Alternating atlases require skipped tiles to be copied forward. A single-atlas solve can
        // leave the existing tile in place.
        if (u.uSchedule.w > 0.5 && ownsTexel) {
            imageStore(uAtlas, tile + texel, texelFetch(uAtlasPrev, tile + texel, 0));
            imageStore(uDepthAtlas, tile + texel, texelFetch(uDepthAtlasPrev, tile + texel, 0));
        }
        if (lane == 0) imageStore(uProbeUsage, probe, vec4(max(usage - decay, 0.0)));
        return;
    }

    vec3 origin = u.uBoundsMin.xyz + (vec3(probe) + 0.5) * u.uBoundsSpan.xyz / vec3(dims);
    vec3 toSun = -normalize(u.uSunDirection.xyz);
    float maxCells = max(u.uOccupancyDims.x, max(u.uOccupancyDims.y, u.uOccupancyDims.z));
    float cellSize = length(u.uBoundsSpan.xyz / u.uOccupancyDims.xyz);

    // One ray per thread, marched once and shared with every texel that wants it.
    // uProbeDims.w selects active rays up to the 256-lane ceiling. Inactive lanes still participate
    // in barriers and may own tile texels, but contribute zero to reconstruction.
    int rays = clamp(int(u.uProbeDims.w + 0.5), 8, BLIX_OCT_RAYS);
    vec3 d = fibonacci(lane, rays);
    float rayDistance, rayReach, raySunlit, rayClosure;
    sDirection[lane] = d;
    rayDistance = 0.0; rayReach = 0.0; raySunlit = 0.0; rayClosure = 0.0;
    sRadiance[lane] = lane < rays
        ? gather(origin, d, maxCells, toSun, cellSize, rayDistance, rayReach, raySunlit, rayClosure)
        : vec3(0.0);
    sDistance[lane] = rayDistance;
    sReach[lane] = rayReach;
    sSunlit[lane] = raySunlit;
    sClosure[lane] = rayClosure;
    barrier();

    if (lane == 0) {
        float c = 0.0;
        for (int i = 0; i < rays; ++i) c += sClosure[i];
        sMeanClosure = c / float(rays);
    }
    barrier();

    // Reachability is geometric rather than brightness-based: buried probes, or probes with neither
    // meaningful escape nor a sunlit encountered surface, must not become light sources. A dim room
    // reached through a doorway remains valid.
    float escape = 0.0, litRays = 0.0;
    for (int i = 0; i < rays; ++i) { escape += sReach[i]; litRays += sSunlit[i]; }
    escape /= float(rays);
    // Its own cell: a probe inside a wall has no business lighting anything, whatever its rays say.
    vec3 selfUvw = (origin - u.uBoundsMin.xyz) / u.uBoundsSpan.xyz;
    bool buried = texture(uOccupancy, clamp(selfUvw, vec3(0.0), vec3(1.0))).r > 0.5;
    float reachable = (!buried && (escape >= 0.02 || litRays > 0.0)) ? 1.0 : 0.0;
    // The sunlit fraction is retained in the atlas as a transport diagnostic; the gather already
    // computes it for reachability, so the aggregate adds no marches.
    float sunlitFraction = litRays / float(rays);

    // Interior texels store the cosine-weighted irradiance arriving at a surface facing the texel
    // direction, so readers multiply by surface response without another PI conversion.
    const int interiorCount = BLIX_OCT_INTERIOR * BLIX_OCT_INTERIOR;
    if (lane < interiorCount) {
        ivec2 c = ivec2(lane % BLIX_OCT_INTERIOR, lane / BLIX_OCT_INTERIOR);
        vec2 uv = ((vec2(c) + 0.5) / float(BLIX_OCT_INTERIOR)) * 2.0 - 1.0;
        vec3 texelDir = blix_octDecode(uv);

        vec3 sum = vec3(0.0);
        float weight = 0.0;
        for (int i = 0; i < rays; ++i) {
            float w = max(dot(texelDir, sDirection[i]), 0.0);
            if (w <= 0.0) continue;
            sum += sRadiance[i] * w;
            weight += w;
        }
        sTexel[lane] = weight > 0.0 ? sum * (PI / weight) : vec3(0.0);

        // Depth wants a SHARPER lobe than irradiance. Irradiance is a cosine average by definition;
        // a distance field blurred over a hemisphere reports a wall as far away because most of the
        // hemisphere is open, and then fails to reject anything. The exponent is what keeps an edge
        // an edge.
        float dSum = 0.0, d2Sum = 0.0, dWeight = 0.0;
        for (int i = 0; i < rays; ++i) {
            float w = pow(max(dot(texelDir, sDirection[i]), 0.0), 50.0);
            if (w <= 0.0) continue;
            dSum += sDistance[i] * w;
            d2Sum += sDistance[i] * sDistance[i] * w;
            dWeight += w;
        }
        // Store variance rather than a second moment. Forming mean2 - mean^2 after independently
        // filtering both moments causes cancellation and unstable Chebyshev weights. Computing it
        // before filtering keeps the sampled value positive and smooth; the omitted between-texel
        // mixture term makes boundaries slightly stricter, which is the safe direction for leaks.
        float dMean = dWeight > 0.0 ? dSum / dWeight : 0.0;
        float dVar  = dWeight > 0.0 ? max(d2Sum / dWeight - dMean * dMean, 0.0) : 0.0;
        sDepthTexel[lane] = dWeight > 0.0 ? vec2(dMean, dVar) : vec2(0.0);
    }
    barrier();

    // Every texel of the tile, interior and border alike, from shared memory — so the border never
    // reads an image the same dispatch is still writing.
    if (!ownsTexel) return;
    ivec2 src = blix_octBorderSource(texel, BLIX_OCT_TILE);
    vec3 value = sTexel[(src.y - 1) * BLIX_OCT_INTERIOR + (src.x - 1)];
    // Established probes converge toward a new solve to avoid waking or relighting steps. A probe's
    // first solve replaces the cleared tile outright; alpha distinguishes unsolved storage.
    vec4 previous = texelFetch(uAtlasPrev, tile + texel, 0);
    // Alpha encodes sunlit fraction in [0.5, 1], leaving zero as the unambiguous unsolved marker.
    float converge = previous.a > 0.25 ? SOLVE_CONVERGE : 1.0;
    imageStore(uAtlas, tile + texel,
               vec4(mix(previous.rgb, value, converge), 0.5 + 0.5 * sunlitFraction));
    vec2 moments = sDepthTexel[(src.y - 1) * BLIX_OCT_INTERIOR + (src.x - 1)];
    // Depth .b stores tile-constant reachability and .a stores mean closure. Both travel with the
    // already allocated and sampled RG depth moments.
    imageStore(uDepthAtlas, tile + texel, vec4(moments, reachable, sMeanClosure));
    if (lane == 0) imageStore(uProbeUsage, probe, vec4(max(usage - decay, 0.0)));
}
