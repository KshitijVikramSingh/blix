#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// --rtgi-volume (SponzaLoop.RtgiVolume.cs): what each probe sees, cooked once at load from the geometry (rtgi_volume.glsl).
// A workgroup a probe, a subgroup of 32 lanes over its rays (rtgi_volume_rays.comp's kinds 1 and 2):
//   1 moved: where its rays mostly meet back faces it sits inside something -- moved out through the nearest back face, a
//     tenth of a spacing past it; where a front face is nearer than 0.15 spacings, moved away from it. Kept within 0.45
//     spacings of where the grid put it (its cell).
//   2 its depth map: lane l's rays land in texels l and l + 32 alone (texel = ray mod 64), so each lane averages its two;
//     the back faces counted again from where it now stands -- still mostly back faces, it is inside something: dropped.
//     Its harmonic mean distance (what sizes the cache's cells, rtgi_volume.glsl's volCellScale), and whether the geometry
//     around it is tighter than its spacing -- inside something, moved past uVol2.x spacings, or surfaces on opposite sides
//     closer together than uVol2.y spacings (a gap, a thin wall's two faces): the CPU adds the next level's probes there
//     (RtgiVolumeRefine, read back; SponzaLoop.RtgiVolume.cs).

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform RtgiVolumeCook {
    vec4 uVolume;   // rtgi_volume.glsl's VOL_PARAMS
    vec4 uVol;      // x the probes listed; y rays a probe; z the back-face share past which a probe is inside; w the kind
    vec4 uVol2;     // x the move (spacings) past which a probe asks for finer ones; y the gap (spacings) under which it does;
                    // z 1: its level may be refined
} u;

layout(std430, set = 0, binding = 1) readonly buffer RtgiVolumeBatch { uvec4 batch[]; };
layout(std430, set = 0, binding = 2) readonly buffer RtgiVolumeRayBuffer { vec4 volRays[]; };
layout(std430, set = 0, binding = 3) readonly buffer RtgiVolumeHits { uvec4 volHits[]; };
layout(std430, set = 0, binding = 4) buffer RtgiVolumeProbes { float volProbes[]; };
layout(std430, set = 0, binding = 5) buffer RtgiVolumeDepth { uint volDepth[]; };
// Per probe id: 1 where the geometry asks for finer probes around it (the cook's second pass), else 0.
layout(std430, set = 0, binding = 6) buffer RtgiVolumeRefine { uint volRefine[]; };

#define VOL_PARAMS u.uVolume
#define VOL_GEOM vec4(0.0)
#define VOL_TABLE(i) uvec2(0u)
#define VOL_PROBES(i) volProbes[i]
#define VOL_DEPTH(i) volDepth[i]
#include "rtgi_volume.glsl"

shared float sBackT[32], sFrontT[32];
shared vec3 sBackD[32], sFrontD[32];
shared float sMean[64];

void main() {
    uint probe = gl_WorkGroupID.x;
    if (probe >= uint(u.uVol.x)) return;
    uint lane = gl_SubgroupInvocationID;
    uint k = uint(u.uVol.y);
    uvec4 b = batch[probe];
    uint id = b.x, level = b.y;
    float s = volSpacing(level);
    float reach = VOL_REACH * s;
    uint kind = uint(u.uVol.w);
    float back = 0.0;
    float backT = 1e30, frontT = 1e30;
    vec3 backD = vec3(0.0), frontD = vec3(0.0);
    float sum[2] = float[2](0.0, 0.0), sum2[2] = float[2](0.0, 0.0), cnt[2] = float[2](0.0, 0.0);
    float inv = 0.0;
    for (uint j = lane; j < k; j += 32u) {
        uint r = probe * k + j;
        vec3 d = volRays[2u * r + 1u].xyz;
        uvec4 h0 = volHits[3u * r];
        float t = reach;
        if ((h0.w & 1u) != 0u) {
            t = uintBitsToFloat(h0.x);
            if ((h0.w & 2u) == 0u) { back += 1.0; if (t < backT) { backT = t; backD = d; } }
            else if (t < frontT) { frontT = t; frontD = d; }
        }
        inv += 1.0 / max(min(t, reach), 0.02 * s);
        t = min(t, reach) / s;
        uint slot = (j % VOL_TEXELS) < 32u ? 0u : 1u;
        sum[slot] += t; sum2[slot] += t * t; cnt[slot] += 1.0;
    }
    back = subgroupAdd(back) / float(k);
    inv = subgroupAdd(inv);
    uint base = id * VOL_FLOATS;
    if (kind == 1u) {
        sBackT[lane] = backT; sBackD[lane] = backD; sFrontT[lane] = frontT; sFrontD[lane] = frontD;
        barrier();
        if (lane != 0u) return;
        for (uint l = 1u; l < 32u; l++) {
            if (sBackT[l] < backT) { backT = sBackT[l]; backD = sBackD[l]; }
            if (sFrontT[l] < frontT) { frontT = sFrontT[l]; frontD = sFrontD[l]; }
        }
        vec3 off = vec3(0.0);
        if (back > u.uVol.z && backT < 1e29) off = backD * (backT + 0.1 * s);
        else if (frontT < 0.15 * s) off = -frontD * (0.15 * s - frontT);
        off = clamp(off, vec3(-0.45 * s), vec3(0.45 * s));
        volProbes[base + VOL_OFFSET] = off.x;
        volProbes[base + VOL_OFFSET + 1u] = off.y;
        volProbes[base + VOL_OFFSET + 2u] = off.z;
        return;
    }
    for (uint slot = 0u; slot < 2u; slot++) {
        float n = max(cnt[slot], 1.0);
        volDepth[id * VOL_TEXELS + lane + 32u * slot] = packHalf2x16(vec2(sum[slot] / n, sum2[slot] / n));
        sMean[lane + 32u * slot] = sum[slot] / n;
    }
    barrier();
    // The narrowest gap through it: each texel's distance plus the opposite texel's.
    float gap = 1e30;
    for (uint slot = 0u; slot < 2u; slot++) {
        uint texel = lane + 32u * slot;
        vec3 d = volOctDecode((vec2(texel % VOL_SIDE, texel / VOL_SIDE) + 0.5) / float(VOL_SIDE));
        gap = min(gap, sMean[texel] + sMean[volTexel(-d)]);
    }
    gap = subgroupMin(gap);
    if (lane == 0u) {
        float moved = length(volOffset(id)) / s;
        bool dead = back > u.uVol.z;
        volRefine[id] = u.uVol2.z > 0.5 && (dead || moved > u.uVol2.x || gap < u.uVol2.y) ? 1u : 0u;
        volProbes[base + VOL_SCALE] = float(k) / max(inv, 1e-6);
        uint flags = uint(volProbes[base + VOL_FLAGS]) & VOL_TRAINED;
        volProbes[base + VOL_FLAGS] = float(flags | VOL_COOKED | (back > u.uVol.z ? VOL_DEAD : 0u));
        volProbes[base + VOL_BACK] = back;
    }
}
