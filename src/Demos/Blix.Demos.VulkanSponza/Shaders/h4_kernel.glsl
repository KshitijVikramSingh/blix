// The ray w (in the record's frame) times its L / pdf r, into the four coefficients.
vec4 h4Kernel(vec3 w) {
    float th = acos(clamp(w.z, -1.0, 1.0)) * (256.0 / 3.14159265359);
    int i = min(int(th), 255);
    float f = th - float(i);
    float k0 = mix(H4K0[i], H4K0[i + 1], f), k1s = mix(H4K1S[i], H4K1S[i + 1], f), kz = mix(H4KZ[i], H4KZ[i + 1], f);
    return vec4(k0, k1s * w.x, k1s * w.y, kz);
}
