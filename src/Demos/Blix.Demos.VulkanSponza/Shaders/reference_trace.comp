#version 450
// The reference view (--gi-reference, G toggles): each pixel's incoming indirect light path-traced through the ray
// scene and accumulated while the camera and the sun hold still -- what the renderer's indirect light should be, shown
// in the renderer itself. One path a reference pixel a frame; a reference pixel is a 2 x 2 block of the frame, its
// sample point rotating through the block. The path is reference_path.glsl's (reference_points.comp takes the same).

#define PI 3.14159265359
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform ReferenceTrace {
    mat4 uInvProjection;
    mat4 uInvView;
    vec4 uTarget;          // xy the frame's pixels, zw the reference's (half each way)
    vec4 uSunDirection;    // xyz the direction the sun travels
    vec4 uSunIrradiance;   // rgb
    vec4 uParams;          // x the frame (seed), y bounces, z 1: restart the accumulation, w the sample's offset in its block (0-3)
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(set = 0, binding = 3) uniform samplerCube uSkyRadiance;
layout(std430, set = 0, binding = 4) buffer ReferenceAccum { vec4 accum[]; };

#define BLIX_RAY_SET 0
#define BLIX_RAY_BINDING 13
#include "ray_query.glsl"

#include "reference_path.glsl"

void main() {
    ivec2 refPixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 refSize = ivec2(u.uTarget.zw);
    if (any(greaterThanEqual(refPixel, refSize))) return;
    int index = refPixel.y * refSize.x + refPixel.x;
    int o = int(u.uParams.w + 0.5);
    ivec2 at = min(refPixel * 2 + ivec2(o & 1, o >> 1), ivec2(u.uTarget.xy) - 1);
    float raw = texelFetch(uSceneDepth, at, 0).r;
    vec4 ns = texelFetch(uPrepassNormal, at, 0);
    bool restart = u.uParams.z > 0.5;
    if (raw >= 1.0 - 1e-6 || dot(ns.xyz, ns.xyz) < 1e-6) {
        if (restart) accum[index] = vec4(0.0);
        return;
    }
    vec2 uv = (vec2(at) + 0.5) / u.uTarget.xy;
    vec4 view = u.uInvProjection * vec4(uv * 2.0 - 1.0, raw, 1.0);
    vec3 world = (u.uInvView * vec4(view.xyz / view.w, 1.0)).xyz;
    vec3 n = normalize(ns.xyz);
    float viewDepth = abs(view.z / view.w);

    uint seed = blix_pcg(uint(index) * 9781u + uint(u.uParams.x) * 2654435761u);
    vec3 toSun = -normalize(u.uSunDirection.xyz);
    vec3 origin = world + n * (0.01 + 0.001 * viewDepth);
    vec3 radiance = referencePath(origin, n, int(u.uParams.y + 0.5), toSun, u.uSunIrradiance.rgb, seed);
    vec4 sample1 = vec4(PI * radiance, 1.0);
    accum[index] = restart ? sample1 : accum[index] + sample1;
}
