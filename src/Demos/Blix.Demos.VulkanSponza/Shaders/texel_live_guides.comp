#version 450
// --live-texels (SponzaLoop.LivePatchLight.cs): the patches' guides from the live patch light, on the GPU, each time it
// rests -- where a patch's light comes from, the octahedral 8 x 8 bins of the directions to the patches it is coupled
// to, each weighted by the coupling and that patch's outgoing luminance, as a CDF (texel_nodes_rays.comp's guideSample).
// The cook's guides came from the band's averages on the CPU (BuildGuides: ~7 s, and the CPU's couplings, which live
// mode lets go): without them the live gather's rays went by the cosine alone, and a corridor lit through a doorway was
// noisy (2026-10-16). The sky's directions too, as the CPU's had them: each bin's escaped share times the sky's
// luminance there (folded at the cook from its 16 x 16 sky bins, SponzaLoop.Transport.cs).
// A thread a patch.

layout(local_size_x = 64) in;

#define GUIDE_RES 8
#define PI 3.14159265359
#define GUIDE_BINS 64

layout(set = 0, binding = 0) uniform LiveGuides {
    vec4 uGuides;   // x the patches, y the components (G), z 1: a patch's own direct sun counted (--guide-sun); w 1: the
                    // sky's component alone (--guide-sky-only: the same under every sun)
    vec4 uIrr;      // rgb the sun's irradiance
} u;

layout(std430, set = 0, binding = 1) readonly buffer CookedPatches { vec4 cookedPatch[]; };   // 3 a patch: pos, normal, indirect
layout(std430, set = 0, binding = 2) readonly buffer CouplingStart { uint couplingStart[]; };
layout(std430, set = 0, binding = 3) readonly buffer Couplings { uvec2 coupling[]; };
layout(std430, set = 0, binding = 4) readonly buffer NodeOutgoing { vec4 nodeOut[]; };      // [patch][component]
layout(std430, set = 0, binding = 5) writeonly buffer PatchGuides { float guide[]; };       // [patch][bin]: the CDF
// And its light list (texel_nodes_rays.comp's light strategy, BuildLights' layout): the LIGHT_K patches sending it the
// most light -- coupling x outgoing luminance -- as (index bits, cumulative share), index -1 empty. A share of a texel's
// rays aims at their disks: a corridor lit through a doorway finds the doorway's patches.
#define LIGHT_K 16
layout(std430, set = 0, binding = 6) writeonly buffer PatchLights { vec2 lightList[]; };
layout(std430, set = 0, binding = 7) readonly buffer PatchSkyEscape { float skyEscape[]; };   // [patch][bin]
layout(std430, set = 0, binding = 8) readonly buffer SkyGuideLum { float skyLum[]; };          // [bin]
// --guide-sun: a patch's outgoing light is its bounce (nodeOut: albedo / pi x what it receives) AND its own direct sun
// (texel_live_direct.comp's sums: the mean n.l over its texels, their sun bits) -- the sunlet's part, which nodeOut has
// not. Without it the guides and the lists never aimed at the sunlit floor: the ray capture found the fine round's
// contact texels' light-list rays, a quarter of their rays, bringing 0.9% of their light, and the sun at the hits 70%
// of their variance (Cornell, 2026-10-22); tools/gi-model/contact_far.py: lists that count the sun, 384 rays as noisy as
// 640 plain, today's as 300.
layout(std430, set = 0, binding = 9) readonly buffer PatchDirect { uint patchDirect[]; };   // 2 a patch: n.l x 4096, texels
layout(std430, set = 0, binding = 10) readonly buffer PatchTerms { vec4 patchTerms[]; };   // 3 a patch: albedo, sky, boot

vec2 octEncode(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    if (d.z >= 0.0) return d.xy;
    return vec2((1.0 - abs(d.y)) * (d.x >= 0.0 ? 1.0 : -1.0), (1.0 - abs(d.x)) * (d.y >= 0.0 ? 1.0 : -1.0));
}

int octBin(vec3 d) {
    ivec2 b = clamp(ivec2((octEncode(d) * 0.5 + 0.5) * float(GUIDE_RES)), ivec2(0), ivec2(GUIDE_RES - 1));
    return b.y * GUIDE_RES + b.x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u.uGuides.x)) return;
    uint G = uint(u.uGuides.y);
    float h[GUIDE_BINS];
    for (int b = 0; b < GUIDE_BINS; ++b) h[b] = 0.0;
    vec3 p = cookedPatch[3u * i].xyz;
    const vec3 lum = vec3(0.2126, 0.7152, 0.0722);
    int topTo[LIGHT_K];
    float topW[LIGHT_K];
    int n = 0;
    for (uint c = couplingStart[i]; c < couplingStart[i + 1u]; ++c) {
        uint j = coupling[c].x;
        vec3 d = cookedPatch[3u * j].xyz - p;
        if (dot(d, d) < 1e-8) continue;
        vec3 out_ = vec3(0.0);
        for (uint k = 0u; k < (u.uGuides.w > 0.5 ? 1u : G); ++k) out_ += nodeOut[j * G + k].rgb;   // component 0: the sky alone
        if (u.uGuides.z > 0.5 && patchDirect[2u * j + 1u] > 0u)
            out_ += patchTerms[3u * j].rgb * u.uIrr.rgb * (float(patchDirect[2u * j]) / 4096.0 / float(patchDirect[2u * j + 1u])) / PI;
        float s = uintBitsToFloat(coupling[c].y) * dot(out_, lum);
        h[octBin(normalize(d))] += s;
        if (j == i || s <= 0.0) continue;
        if (n < LIGHT_K) { topTo[n] = int(j); topW[n] = s; n++; continue; }
        int least = 0;
        for (int k = 1; k < LIGHT_K; ++k) if (topW[k] < topW[least]) least = k;
        if (s > topW[least]) { topTo[least] = int(j); topW[least] = s; }
    }
    float listTotal = 0.0;
    for (int k = 0; k < n; ++k) listTotal += topW[k];
    float listAcc = 0.0;
    for (int k = 0; k < LIGHT_K; ++k) {
        bool has = k < n && listTotal > 0.0;
        if (has) listAcc += topW[k] / listTotal;
        lightList[i * uint(LIGHT_K) + uint(k)] = vec2(intBitsToFloat(has ? topTo[k] : -1), has ? (k == n - 1 ? 1.0 : listAcc) : (n > 0 ? 1.0 : 0.0));
    }
    for (int b = 0; b < GUIDE_BINS; ++b) h[b] += skyEscape[i * uint(GUIDE_BINS) + uint(b)] * skyLum[b];
    float total = 0.0;
    for (int b = 0; b < GUIDE_BINS; ++b) total += h[b];
    float acc = 0.0;
    for (int b = 0; b < GUIDE_BINS; ++b) {
        acc += total > 0.0 ? h[b] / total : 1.0 / float(GUIDE_BINS);
        guide[i * uint(GUIDE_BINS) + uint(b)] = b == GUIDE_BINS - 1 ? 1.0 : acc;
    }
}
