#version 450
// The atlas resolve (SponzaLoop.LightmapCells.cs): after each compose, per atlas cell, what the incident pass's lightmapped
// pixels read of it -- its record's resolved light and sky visibility, its normal, and why a pixel must look closer --
// so a pixel takes its four cells' answer in a handful of reads where the full lookup made ~35 dependent ones and its
// rare branches (the record walk, the neighbour search, the seams) stalled the pixels beside it: the incident pass was
// 35-42 ms of a moving frame at 2880 x 1620 (2026-10-24). A thread a cell of every 8 x 8 tile; empty tiles out.
//
// A cell, beside its id in LightmapIndex's pool (the same place: the tile's slot x 64 + its cell), two words:
//   x  the record's resolved light (rgb9e5, texelResolved's)
//   y  bits 0-7 the sky visibility's byte (texelDetailPack's: by its square root), 8-15 flags, 16-31 its normal
//      (octahedral, 8 + 8 bits)
// Flags (lightmap_index.glsl, LIGHTMAP_CELL_*): 1 no record here (none, or buried: a pixel weighs it nothing), 2 not to be
// taken as it is (its light not landed or not whole, no detail word, no normal), 4 a double-sided pair (its words the
// front's; a pixel facing away reads the back record, id + 1, itself), 8 seam neighbours (the seam blend is the pixel's),
// 16 a pair whose back is not whole. 2, 8 (and 16 for a pixel facing away) under a pixel: the full lookup.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform LightmapCells {
    vec4 uCells;   // x the tiles, y the first atlas record, z 1: the seam blend on (flag 8), w unused
} u;

layout(std430, set = 0, binding = 1) readonly buffer LightmapIndex { uint lightmapIndex[]; };
layout(std430, set = 0, binding = 2) readonly buffer Texels { uvec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 3) readonly buffer TexelResolved { uvec2 texelResolved[]; };
layout(std430, set = 0, binding = 4) readonly buffer TexelDetail { uint texelDetail[]; };
layout(std430, set = 0, binding = 5) readonly buffer TexelSeamStart { uint seamStart[]; };
layout(std430, set = 0, binding = 6) writeonly buffer LightmapCellLight { uvec2 cellLight[]; };

uint octNormal8(vec3 n) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    uvec2 q = uvec2(round(clamp(e * 0.5 + 0.5, 0.0, 1.0) * 255.0));
    return q.x | (q.y << 8);
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    uint tile = t >> 6u;
    if (tile >= uint(u.uCells.x)) return;
    uint at = lightmapIndex[4u + tile];
    if (at == 0xFFFFFFFFu) return;
    uint head = 4u + lightmapIndex[3];
    uint cell = at - head + (t & 63u);   // the cell's place in the pool, as its id's
    uint id = lightmapIndex[at + (t & 63u)];
    if (id == 0xFFFFFFFFu) { cellLight[cell] = uvec2(0u, 1u << 8); return; }
    vec4 p = TEXEL_POSITION(id);
    if (abs(p.w) < 2.0) { cellLight[cell] = uvec2(0u, 1u << 8); return; }   // buried: weighs nothing, as the lookup's
    vec3 n = TEXEL_NORMAL(id).xyz;
    uint flags = 0u;
    if (p.w < 0.0) {
        flags |= 4u;
        uvec2 rb = texelResolved[id + 1u];
        if (abs(TEXEL_POSITION(id + 1u).w) < 2.0 || (rb.y & 0x10000u) == 0u || (rb.y & 0xFFFFu) != 0xFFFFu || (texelDetail[id + 1u] >> 24) == 0u)
            flags |= 16u;
    }
    uvec2 r = texelResolved[id];
    uint d = texelDetail[id];
    if ((r.y & 0x10000u) == 0u || (r.y & 0xFFFFu) != 0xFFFFu || (d >> 24) == 0u || dot(n, n) < 1e-12) flags |= 2u;
    uint first = uint(u.uCells.y);
    if (u.uCells.z > 0.5 && id >= first && seamStart[id - first + 1u] > seamStart[id - first]) flags |= 8u;
    // A pair's back with seams of its own: the full lookup for a pixel facing it.
    if ((flags & 4u) != 0u && u.uCells.z > 0.5 && id + 1u >= first && seamStart[id + 1u - first + 1u] > seamStart[id + 1u - first]) flags |= 16u;
    uint nrm = dot(n, n) > 1e-12 ? octNormal8(normalize(n)) : 0u;
    cellLight[cell] = uvec2(r.x, ((d >> 16) & 0xFFu) | (flags << 8) | (nrm << 16));
}
