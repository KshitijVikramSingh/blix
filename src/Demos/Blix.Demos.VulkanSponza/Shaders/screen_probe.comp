#version 450

// Screen probes (screen_probe.glsl): place one per tile on the visible surface, trace a few full-length rays from
// it, and fold them into the radiance its past carried.
//
// A workgroup holds 8 probes of 8 rays. Each probe:
//   place    the tile's centre pixel, or the first of four inner points that has a surface; position from the
//            depth, geometric normal and surface identity (its material) from the pre-pass
//   history  a past probe is this one's past only if it is the SAME SURFACE, by everything that can say so:
//              identity   the same material (not the same placement: the cook splits one wall into hundreds,
//                         and placement identity restarted 12% of probes a frame under orbit at the seams)
//              normal     within ~25 degrees
//              plane      off this probe's plane by under 2% of the depth
//              lateral    within one tile's footprint at this depth (not "a similar depth somewhere nearby": a
//                         stale probe from the wall behind a pillar would carry that wall's light across the
//                         pillar's shadow, the clipmap's spatial leak made temporal)
//              visible    the past probe's own position is still the visible surface from this frame's camera
//                         (nothing in front of it by more than 2% of its depth): disocclusion
//            searched over the 3x3 tiles around where this probe falls in the last frame (TAA's jitter moves
//            which surface a tile's centre lands on at edges); the closest candidate passing all of them wins,
//            else the probe starts afresh
//   trace    8 directions uniform over its hemisphere; a hit is lit by the sun (a shadow ray) and by the probe
//            clipmap's irradiance at the hit, re-radiated in its albedo; an escape brings the disc-free sky
//   blend    the frame's estimate (2 pi / rays per sample, the uniform hemisphere's density) averaged in at 1/n,
//            n capped at uFrame.y
//
// Writes the tile's header (first probe, count) as well as the probe: one per tile today, at pool index = tile.

layout(local_size_x = 64) in;

#define RAYS 8
#define PROBES_PER_GROUP 8
#define PI 3.14159265359

layout(set = 0, binding = 0) uniform ScreenProbes {
    mat4 uInvProjection;
    mat4 uInvView;
    mat4 uViewProj;        // this frame's, for the past probe's visibility now
    mat4 uPrevViewProj;    // last frame's, for finding each probe's past
    vec4 uTarget;          // xy frame pixels, zw tiles across and down
    vec4 uDims;            // the clipmap: xyz probes per level, w base spacing
    vec4 uParams;          // x the clipmap's blend band; y 1 when last frame's probes are valid; z one pixel's width
                           // at unit depth (2 tan(fov/2) / height)
    vec4 uOrigin0;
    vec4 uOrigin1;
    vec4 uOrigin2;
    vec4 uOrigin3;
    vec4 uSunDirection;    // xyz the direction the sun travels
    vec4 uSunIrradiance;   // rgb
    vec4 uFrame;           // x frame counter, y history cap (frames), z sky strength, w sky mip for a ray
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(set = 0, binding = 3) uniform sampler2D uClipmapIrradiance;
layout(set = 0, binding = 4) uniform sampler2D uClipmapDepth;
layout(std430, set = 0, binding = 5) readonly buffer ClipmapState { uvec4 states[]; };
layout(set = 0, binding = 6) uniform samplerCube uSkyRadiance;

#include "screen_probe.glsl"
layout(std430, set = 0, binding = 7) readonly buffer ScreenProbeTilesPrevious { ScreenProbeTile previousTiles[]; };
layout(std430, set = 0, binding = 8) readonly buffer ScreenProbesPrevious { ScreenProbe previous[]; };
layout(std430, set = 0, binding = 9) writeonly buffer ScreenProbeTilesCurrent { ScreenProbeTile currentTiles[]; };
layout(std430, set = 0, binding = 10) writeonly buffer ScreenProbesCurrent { ScreenProbe current[]; };
// Why probes start afresh, summed over the run: for each probe that found no past, the first test its nearest
// candidate failed. [0] no candidate tile at all, [1] identity, [2] normal, [3] plane, [4] lateral, [5] no longer
// visible, [6] probes that kept a past.
layout(std430, set = 0, binding = 11) buffer ScreenProbeStats { uint stats[8]; };

#define BLIX_RAY_SET 0
#define BLIX_RAY_BINDING 13
#include "ray_query.glsl"

#define BLIX_CLIPMAP_IRRADIANCE(t) texelFetch(uClipmapIrradiance, t, 0)
#define BLIX_CLIPMAP_DEPTH(t) texelFetch(uClipmapDepth, t, 0)
#define BLIX_CLIPMAP_STATE(s) states[s]
#include "probe_clipmap.glsl"

shared vec3 sRadiance[64];
shared vec3 sDirection[64];

BlixClipmap clipmap() {
    BlixClipmap c;
    c.dims = ivec3(u.uDims.xyz);
    c.baseSpacing = u.uDims.w;
    c.blendProbes = u.uParams.x;
    c.origin[0] = ivec3(u.uOrigin0.xyz);
    c.origin[1] = ivec3(u.uOrigin1.xyz);
    c.origin[2] = ivec3(u.uOrigin2.xyz);
    c.origin[3] = ivec3(u.uOrigin3.xyz);
    return c;
}

// A pixel's surface: world position, view depth, geometric normal and identity. False where nothing was drawn.
bool surfaceAt(ivec2 pixel, out vec3 world, out float viewDepth, out vec3 n, out float identity) {
    ivec2 size = ivec2(u.uTarget.xy);
    pixel = clamp(pixel, ivec2(0), size - 1);
    float raw = texelFetch(uSceneDepth, pixel, 0).r;
    vec4 ns = texelFetch(uPrepassNormal, pixel, 0);
    world = vec3(0.0); viewDepth = 0.0; n = vec3(0.0, 1.0, 0.0); identity = 0.0;
    if (raw >= 1.0 - 1e-6 || dot(ns.xyz, ns.xyz) < 1e-6) return false;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 view = u.uInvProjection * vec4(uv * 2.0 - 1.0, raw, 1.0);
    view.xyz /= view.w;
    world = (u.uInvView * vec4(view.xyz, 1.0)).xyz;
    viewDepth = abs(view.z);
    n = normalize(ns.xyz);
    identity = ns.w;
    return true;
}

// Whether a past probe at `at` is still the surface this frame's camera sees there (disocclusion): nothing in front
// of it by more than 2% of its depth FROM THIS FRAME'S CAMERA (clip w; the depth it was stored with is last frame's,
// and a moving camera changes it).
bool stillVisible(vec3 at) {
    vec4 clip = u.uViewProj * vec4(at, 1.0);
    if (clip.w <= 1e-4) return false;
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return false;
    vec3 w; float d; vec3 n; float id;
    if (!surfaceAt(ivec2(uv * u.uTarget.xy), w, d, n, id)) return false;
    return d > clip.w * 0.98;
}

void main() {
    uint lane = gl_LocalInvocationIndex;
    uint ray = lane % RAYS;
    int probeIndex = int(gl_WorkGroupID.x) * PROBES_PER_GROUP + int(lane / RAYS);
    ivec2 tiles = ivec2(u.uTarget.zw);
    bool inRange = probeIndex < tiles.x * tiles.y;
    ivec2 tile = ivec2(probeIndex % max(tiles.x, 1), probeIndex / max(tiles.x, 1));

    vec3 world = vec3(0.0), n = vec3(0.0, 1.0, 0.0);
    float viewDepth = 0.0, identity = 0.0;
    bool placed = false;
    if (inRange) {
        ivec2 corner = tile * SCREEN_PROBE_TILE;
        placed = surfaceAt(corner + SCREEN_PROBE_TILE / 2, world, viewDepth, n, identity);
        const ivec2 inner[4] = ivec2[4](ivec2(4, 4), ivec2(12, 4), ivec2(4, 12), ivec2(12, 12));
        for (int i = 0; i < 4 && !placed; ++i) placed = surfaceAt(corner + inner[i], world, viewDepth, n, identity);
    }

    // Trace: every lane of a placed probe, one direction uniform over the hemisphere around its normal.
    vec3 radiance = vec3(0.0);
    vec3 dir = n;
    if (placed) {
        uint seed = blix_pcg(uint(u.uFrame.x) * 2654435761u + uint(probeIndex) * 9781u + ray);
        float u1 = (float(ray) + float(blix_pcg(seed) & 0xFFFFu) / 65536.0) / float(RAYS);   // stratified in height
        float u2 = float(blix_pcg(seed ^ 0x68E31DA4u) & 0xFFFFu) / 65536.0;
        float z = u1;
        float r = sqrt(max(0.0, 1.0 - z * z));
        float phi = 2.0 * PI * u2;
        vec3 t = normalize(abs(n.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), n) : cross(vec3(1.0, 0.0, 0.0), n));
        vec3 b = cross(n, t);
        dir = normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * z);
        vec3 origin = world + n * (0.01 + 0.001 * viewDepth);
        BlixRayHit hit;
        if (blix_traceClosest(origin, dir, 0.0, uintBitsToFloat(0x7F800000u), seed, hit)) {
            vec3 hn = dot(hit.normal, dir) > 0.0 ? -hit.normal : hit.normal;
            vec3 hitPos = origin + dir * hit.t;
            vec3 toSun = -normalize(u.uSunDirection.xyz);
            float ndotl = max(dot(hn, toSun), 0.0);
            float sun = ndotl > 0.0 && !blix_traceAny(hitPos + hn * 0.01, toSun, 0.0, uintBitsToFloat(0x7F800000u), blix_pcg(seed ^ 0x5bd1e995u))
                ? ndotl : 0.0;
            bool known;
            vec4 field = blix_clipmapSample(clipmap(), hitPos, hn, known);
            radiance = hit.albedo * (u.uSunIrradiance.rgb * sun + (known ? field.rgb : vec3(0.0))) / PI;
        } else {
            radiance = textureLod(uSkyRadiance, dir, u.uFrame.w).rgb * u.uFrame.z;
        }
    }
    sRadiance[lane] = radiance;
    sDirection[lane] = dir;
    barrier();

    if (ray != 0u || !inRange) return;
    currentTiles[probeIndex] = ScreenProbeTile(uint(probeIndex), placed ? 1u : 0u, 0u, 0u);
    ScreenProbe probe;
    probe.position = vec4(world, viewDepth);
    probe.normal = vec4(n, 0.0);
    probe.identity = vec4(identity, 0.0, 0.0, 0.0);
    for (int i = 0; i < 9; ++i) probe.radiance[i] = vec4(0.0);
    if (!placed) { current[probeIndex] = probe; return; }

    // This frame's estimate: each ray's radiance times the basis, over the uniform hemisphere's density.
    vec3 estimate[9];
    for (int i = 0; i < 9; ++i) estimate[i] = vec3(0.0);
    for (uint k = 0u; k < uint(RAYS); ++k) {
        float y[9];
        screenProbeBasis(sDirection[lane + k], y);
        for (int i = 0; i < 9; ++i) estimate[i] += sRadiance[lane + k] * y[i];
    }
    float scale = 2.0 * PI / float(RAYS);

    // Its past: the same surface, by every test in the header.
    float history = 0.0;
    int best = -1;
    int nearestReasonOut = 0;
    if (u.uParams.y > 0.5) {
        vec4 clip = u.uPrevViewProj * vec4(world, 1.0);
        if (clip.w > 1e-4) {
            vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
            ivec2 pastTile = ivec2(floor(uv * u.uTarget.xy / float(SCREEN_PROBE_TILE)));
            float footprint = float(SCREEN_PROBE_TILE) * u.uParams.z * viewDepth;
            float bestScore = 1e30;
            float nearest = 1e30;
            int nearestReason = 0;
            for (int k = 0; k < 9; ++k) {
                ivec2 t = pastTile + ivec2(k % 3 - 1, k / 3 - 1);
                if (any(lessThan(t, ivec2(0))) || any(greaterThanEqual(t, tiles))) continue;
                ScreenProbeTile header = previousTiles[t.y * tiles.x + t.x];
                for (uint j = 0u; j < min(header.y, uint(SCREEN_PROBE_MAX_PER_TILE)); ++j) {
                    int index = int(header.x + j);
                    vec4 pp = previous[index].position;
                    vec3 offset = world - pp.xyz;
                    float plane = abs(dot(n, offset));
                    float lateral = length(offset - n * dot(n, offset));
                    int reason = previous[index].identity.x != identity ? 1
                        : dot(previous[index].normal.xyz, n) < 0.9 ? 2
                        : plane > 0.02 * viewDepth ? 3
                        : lateral > footprint ? 4
                        : !stillVisible(pp.xyz) ? 5 : 0;
                    if (length(offset) < nearest) { nearest = length(offset); nearestReason = reason; nearestReasonOut = reason; }
                    if (reason != 0) continue;
                    float score = plane * 4.0 + lateral;
                    if (score >= bestScore) continue;
                    bestScore = score;
                    best = index;
                }
            }
        }
    }
    if (best >= 0) history = previous[best].normal.w;
    atomicAdd(stats[best >= 0 ? 6 : nearestReasonOut], 1u);
    float count = min(history + 1.0, u.uFrame.y);
    float alpha = 1.0 / count;
    for (int i = 0; i < 9; ++i) {
        vec3 fresh = estimate[i] * scale;
        probe.radiance[i] = vec4(best >= 0 ? mix(previous[best].radiance[i].rgb, fresh, alpha) : fresh, 0.0);
    }
    probe.normal.w = count;
    current[probeIndex] = probe;
}
