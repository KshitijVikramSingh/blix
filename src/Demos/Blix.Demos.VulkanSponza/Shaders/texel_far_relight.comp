#version 450
// The far field relit (plan.md N3; SponzaLoop.FarTransport.cs): the light-free record (texel_nodes_shade.glsl,
// FarTransport: per patch per bin, the patches its texels' far rays met, the weight that escaped) made into the radiance
// record the sweep reads (texel_far.glsl, FarRecord) for whatever lights there are now -- no ray traced. A bin's light:
//   a hit patch   albedo / pi x (its incident light now -- the patches' solve for these suns, SunNodePatchLight -- plus
//                 its average direct sun now: its texels' n.l x visibility, PatchDirectSums, x the sun's irradiance)
//   no slot held  the slots' mean light (what the record could not name)
//   escaped       the sky's radiance at the bin's direction (columns with the sky)
// over the bin's whole weight. A bin with too little weight is unknown (its weight 0): the texels' own rays answer.
// The record's spread words say nothing (zero variance): what the record knows of this light it knows exactly.
// A thread a patch-bin.

#define PI 3.14159265359
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform FarRelight {
    vec4 uRelight;        // x the patches, y the columns (suns), z the least weight a known bin carries (fixed), w the bins
    vec4 uSunIrradiance;  // rgb
    vec4 uSky;            // x strength, y mip
    vec4 uFar;            // texel_far.glsl's
    vec4 uCookedGrid;
    vec4 uCookedDims;
    vec4 uCompare;        // x 1: the radiance record was traced this cook -- each bin's relit light against it (RelightStats);
                          // y 1: relight from the complete lists (FarList*) rather than the slots; z a list weight (a
                          // fraction of a patch's rays) in the record's fixed-point ray weight
} u;

layout(set = 0, binding = 1) uniform samplerCube uSkyRadiance;
layout(std430, set = 0, binding = 2) readonly buffer FarTransport { uint farTransport[]; };
layout(std430, set = 0, binding = 3) readonly buffer SunNodePatchLight { uvec2 patchLight[]; };   // [patch][column]
layout(std430, set = 0, binding = 4) readonly buffer PatchAlbedo { vec4 patchAlbedo[]; };
layout(std430, set = 0, binding = 5) readonly buffer PatchDirectSums { uint patchDirect[]; };
layout(std430, set = 0, binding = 6) readonly buffer SunNodes { vec4 sunNodes[]; };
// The comparison: by the bin's unnamed share (hits no slot held: < 10%, < 30%, < 60%, more) and escape-only bins (the
// sky at the bin's centre): [bucket x 4] bins, sum |relit - traced| / traced (x 1000), sum (relit - traced) / traced
// (x 1000, offset), sum of the unnamed share (x 1000).
layout(std430, set = 0, binding = 11) buffer RelightStats { uint relightStats[]; };
// The complete light-free lists (SponzaLoop.Transport.cs, BuildFarLists): per patch-bin, CSR over (id, weight) -- an id a
// patch the transport cook's rays met past the reach, or (top bit) a sky direction (TransportSkyRes^2 octahedral bins) its
// rays escaped into; the weight the share of the patch's rays.
layout(std430, set = 0, binding = 12) readonly buffer FarListStart { uint farListStart[]; };
layout(std430, set = 0, binding = 13) readonly buffer FarListIds { uint farListId[]; };
layout(std430, set = 0, binding = 14) readonly buffer FarListWeights { float farListWeight[]; };
#define SKY_RES 16

#define COOKED_BINDING 7
#define COOKED_GRID u.uCookedGrid
#define COOKED_DIMS u.uCookedDims
#include "cooked_patches.glsl"
#define FAR_RECORD_BINDING 10
#define FAR_RECORD_ACCESS
#include "texel_far.glsl"

#define FAR_SLOTS 3
#define FAR_TRANSPORT_STRIDE (2 * FAR_SLOTS + 3)

// A word, held under the top (a bright sky's sums would wrap).
uint fixedWord(float v) { return uint(min(max(v, 0.0) + 0.5, 4.29e9)); }

// A patch's outgoing radiance for a column now.
vec3 patchRadiance(uint q, uint k, uint columns, uint patches) {
    uvec2 p = patchLight[q * columns + k];
    vec3 incident = vec3(unpackHalf2x16(p.x), unpackHalf2x16(p.y).x);
    uint kind = uint(sunNodes[k].w + 0.5);
    float texelsThere = float(patchDirect[patches * columns + q]);
    float direct = (kind & 1u) != 0u && texelsThere > 0.0 ? float(patchDirect[q * columns + k]) / 65536.0 / texelsThere : 0.0;
    return patchAlbedo[q].rgb / PI * (incident + u.uSunIrradiance.rgb * direct);
}

// The direction at a bin's centre, in the world.
vec3 binCentre(int patchIndex, int bin) {
    vec3 n, t, b;
    farFrame(patchIndex, n, t, b);
    vec2 uv = (vec2(bin % FAR_RES, bin / FAR_RES) + 0.5) / float(FAR_RES) * 2.0 - 1.0;   // (p.x + p.y, p.x - p.y)
    vec2 p = vec2(uv.x + uv.y, uv.x - uv.y) * 0.5;
    float z = 1.0 - abs(p.x) - abs(p.y);
    return normalize(t * p.x + b * p.y + n * max(z, 0.0));
}

// A transport sky bin's direction (SponzaLoop.Transport.cs, OctDecode at the bin's centre).
vec3 skyBinDirection(uint s) {
    vec2 uv = (vec2(float(s % uint(SKY_RES)), float(s / uint(SKY_RES))) + 0.5) / float(SKY_RES) * 2.0 - 1.0;
    vec3 d = vec3(uv, 1.0 - abs(uv.x) - abs(uv.y));
    if (d.z < 0.0) { float x = d.x; d.x = (1.0 - abs(d.y)) * (x >= 0.0 ? 1.0 : -1.0); d.y = (1.0 - abs(x)) * (d.y >= 0.0 ? 1.0 : -1.0); }
    return normalize(d);
}

// The lists' relight of one bin: the light per column, composed, and the weights (fixed point) -- written as main's.
void relightFromLists(int p, int bin, uint dst, uint columns, uint patches, float traced) {
    uint i = uint(p) * uint(FAR_BINS) + uint(bin);
    uint first = farListStart[i], last = farListStart[i + 1u];
    float W = 0.0, escaped = 0.0;
    for (uint e = first; e < last; ++e) { W += farListWeight[e]; if ((farListId[e] & 0x80000000u) != 0u) escaped += farListWeight[e]; }
    float Wf = W * u.uCompare.z;
    if (Wf < u.uRelight.z) { farRecord[dst] = 0u; return; }
    const vec3 lumW = vec3(0.2126, 0.7152, 0.0722);
    float relit = 0.0;
    for (uint k = 0u; k < columns; ++k) {
        bool skyOn = (uint(sunNodes[k].w + 0.5) & 2u) != 0u;
        vec3 sum = vec3(0.0);
        float square = 0.0;   // the weight x luminance^2: the bin's spread over its entries (each its rays at one light)
        for (uint e = first; e < last; ++e) {
            uint id = farListId[e];
            float w = farListWeight[e];
            vec3 l = vec3(0.0);
            if ((id & 0x80000000u) != 0u) { if (skyOn) l = textureLod(uSkyRadiance, skyBinDirection(id & 0x7FFFFFFFu), u.uSky.y).rgb * u.uSky.x; }
            else l = patchRadiance(id, k, columns, patches);
            sum += w * l;
            square += w * dot(l, lumW) * dot(l, lumW);
        }
        vec3 radiance = sum / W;
        uint c = farRgbAt(dst, int(k));
        farRecord[c] = fixedWord(radiance.r * Wf);
        farRecord[c + 1u] = fixedWord(radiance.g * Wf);
        farRecord[c + 2u] = fixedWord(radiance.b * Wf);
        float m = dot(radiance, lumW);
        // The spread kept: the judge's last word (texel_far_judge.comp, mode 1) then leaves a bin too uncertain -- a
        // doorway seen by a few of the patch's rays -- to the texels' own rays, and the pooling's light test sees it.
        farRecord[farSquareAt(dst, int(k), u.uFar)] = fixedWord(square / W * Wf);
        relit += m;
    }
    if (traced > 1e-6) {
        float d = (relit - traced) / traced;
        int bucket = escaped >= W * 0.999 ? 4 : 0;
        atomicAdd(relightStats[bucket * 4], 1u);
        atomicAdd(relightStats[bucket * 4 + 1], uint(min(abs(d), 100.0) * 1000.0));
        atomicAdd(relightStats[bucket * 4 + 2], uint(clamp(d, -1.0, 100.0) * 1000.0 + 1000.0));
    }
    farRecord[dst] = fixedWord(Wf);
    farRecord[dst + 1u] = fixedWord(escaped * u.uCompare.z);
    farRecord[dst + 2u] = fixedWord(Wf * PI);
}

void main() {
    uint i = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;   // a 2-D grid
    uint patches = uint(u.uRelight.x), columns = uint(u.uRelight.y);
    if (i >= patches * uint(FAR_BINS)) return;
    int p = int(i / uint(FAR_BINS)), bin = int(i % uint(FAR_BINS));
    uint src = i * uint(FAR_TRANSPORT_STRIDE);
    uint dst = farBase(p, bin, u.uFar);
    if (u.uCompare.y > 0.5) {
        float tracedL = -1.0;
        if (u.uCompare.x > 0.5 && farRecord[dst] > 0u) {
            float tw = float(farRecord[dst]);
            tracedL = 0.0;
            for (uint k = 0u; k < columns; ++k) {
                uint c = farRgbAt(dst, int(k));
                tracedL += dot(vec3(float(farRecord[c]), float(farRecord[c + 1u]), float(farRecord[c + 2u])) / tw, vec3(0.2126, 0.7152, 0.0722));
            }
        }
        relightFromLists(p, bin, dst, columns, patches, tracedL);
        return;
    }
    float W = float(farTransport[src + uint(2 * FAR_SLOTS) + 2u]);
    if (W < u.uRelight.z) {
        farRecord[dst] = 0u;   // unknown: the texels' own rays
        return;
    }
    float escaped = float(farTransport[src + uint(2 * FAR_SLOTS) + 1u]);
    float unnamed = float(farTransport[src + uint(2 * FAR_SLOTS)]);
    vec3 sky = textureLod(uSkyRadiance, binCentre(p, bin), u.uSky.y).rgb * u.uSky.x;
    const vec3 lumW = vec3(0.2126, 0.7152, 0.0722);
    // The traced light of this bin (the record pass's, before it is overwritten), composed over the columns.
    float traced = -1.0;
    if (u.uCompare.x > 0.5 && farRecord[dst] > 0u) {
        float tw = float(farRecord[dst]);
        traced = 0.0;
        for (uint k = 0u; k < columns; ++k) {
            uint c = farRgbAt(dst, int(k));
            traced += dot(vec3(float(farRecord[c]), float(farRecord[c + 1u]), float(farRecord[c + 2u])) / tw, lumW);
        }
    }
    float relit = 0.0;
    for (uint k = 0u; k < columns; ++k) {
        vec3 sum = vec3(0.0);
        float named = 0.0;
        for (int s = 0; s < FAR_SLOTS; ++s) {
            uint id = farTransport[src + uint(2 * s)];
            if (id == 0u) continue;
            float w = float(farTransport[src + uint(2 * s) + 1u]);
            sum += w * patchRadiance(id - 1u, k, columns, patches);
            named += w;
        }
        if (named > 0.0) sum += unnamed * sum / named;   // what no slot held, at the slots' mean
        if ((uint(sunNodes[k].w + 0.5) & 2u) != 0u) sum += escaped * sky;
        vec3 radiance = sum / W;   // W and the sums both fixed point: the mean radiance
        uint c = farRgbAt(dst, int(k));
        farRecord[c] = fixedWord(radiance.r * W);
        farRecord[c + 1u] = fixedWord(radiance.g * W);
        farRecord[c + 2u] = fixedWord(radiance.b * W);
        float m = dot(radiance, lumW);
        farRecord[farSquareAt(dst, int(k), u.uFar)] = fixedWord(m * m * W);   // no spread
        relit += m;
    }
    if (traced > 1e-6) {
        float hits = max(W - escaped, 1.0);
        float share = unnamed / hits;
        int bucket = escaped >= W * 0.999 ? 4 : share < 0.1 ? 0 : share < 0.3 ? 1 : share < 0.6 ? 2 : 3;
        float d = (relit - traced) / traced;
        atomicAdd(relightStats[bucket * 4], 1u);
        atomicAdd(relightStats[bucket * 4 + 1], uint(min(abs(d), 100.0) * 1000.0));
        atomicAdd(relightStats[bucket * 4 + 2], uint(clamp(d, -1.0, 100.0) * 1000.0 + 1000.0));
        atomicAdd(relightStats[bucket * 4 + 3], uint(share * 1000.0));
    }
    farRecord[dst] = uint(W + 0.5);
    farRecord[dst + 1u] = uint(escaped + 0.5);
    farRecord[dst + 2u] = fixedWord(W * PI);   // effective rays: as cosine rays (weight pi each)
}
