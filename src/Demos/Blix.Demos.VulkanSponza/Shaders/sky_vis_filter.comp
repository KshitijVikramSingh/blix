#version 450
// The cooked sky visibility denoised (SponzaLoop.Transfer.cs, CookTexelAo): each texel's share of escaped rays averaged
// with its neighbours on the same surface -- texel_filter_neighbour.glsl's neighbourhood, distance and normal weights --
// where they agree to within the count's own noise: a difference past ~2.5 standard deviations of a binomial share at
// the cook's rays is an edge (a crease, a contact, a wall's end), not noise, and drops out. A light ratio would not do:
// in a dark corner (2% of the sky) the noise is half the value, and every neighbour would read as an edge.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform SkyVisFilter {
    vec4 uFilter;      // x texels, y the rays a texel, z the edge in standard deviations, w 1: the last pass (bytes out)
    vec4 uTexelGrid;   // xyz the cells' origin, w the spacing
    vec4 uTexelParams; // x hash capacity
    vec4 uLightmap;    // as texel_filter.comp's
} u;

layout(std430, set = 0, binding = 1) readonly buffer TexelHash { uvec4 texelHash[]; };
layout(std430, set = 0, binding = 2) readonly buffer Texels { uvec4 texels[]; };
#include "texel_record.glsl"
layout(set = 0, binding = 3) uniform usampler2D uLightmapIndexTex;
layout(std430, set = 0, binding = 4) readonly buffer SkyIn { uint skyIn[]; };    // [texel id / 4]: the cook's, 1..255, 0 none
layout(std430, set = 0, binding = 5) buffer SkyOut { uint skyOut[]; };           // the last pass's, the same, zeroed before
// Between the passes in float (a share, -1 none): a byte each pass put its quantization into every pass after, and the
// dark texels' noise stopped falling at ~2.7% however many passes ran (2026-10-21).
layout(std430, set = 0, binding = 6) readonly buffer SkyFrom { float skyFrom[]; };
layout(std430, set = 0, binding = 7) writeonly buffer SkyInto { float skyInto[]; };
#define TEXEL_INDEX_MAP(i) texelFetch(uLightmapIndexTex, ivec2(int(i) % textureSize(uLightmapIndexTex, 0).x, int(i) / textureSize(uLightmapIndexTex, 0).x), 0).r
#define TEXEL_HASH(i) texelHash[i]
#include "texel.glsl"
#include "texel_filter_neighbour.glsl"

uint skyByte(uint id) { return (skyIn[id / 4u] >> (8u * (id % 4u))) & 255u; }
// The share the pass reads: the cook's byte (stored by its square root, texel_ao.comp) unless it was 0 (none), then the
// last pass's float. -1 none.
float skyAt(uint id) {
    uint b = skyByte(id);
    if (b == 0u) return -1.0;
    float f = skyFrom[id];
    if (f >= 0.0) return f;
    float r = float(b - 1u) / 254.0;
    return r * r;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(u.uFilter.x)) return;
    float centre = skyAt(id);
    if (centre < 0.0) { skyInto[id] = -1.0; return; }
    vec3 position = TEXEL_POSITION(id).xyz;
    vec3 n = TEXEL_NORMAL(id).xyz;
    TexelGrid finestGrid;
    finestGrid.minCorner = u.uTexelGrid.xyz;
    finestGrid.spacing = u.uTexelGrid.w;
    finestGrid.capacity = uint(u.uTexelParams.x);
    finestGrid.level = 0u;
    float rays = max(u.uFilter.y, 1.0);
    float sum = 0.0, weight = 0.0;
    for (uint k = 0u; k < 27u; ++k) {
        TexelGrid tg;
        int other = texelFilterNeighbour(int(id), k, position, n, finestGrid, u.uLightmap, tg);
        if (other < 0) continue;
        float v = skyAt(uint(other));
        if (v < 0.0) continue;
        // Distance and normal as the light's filter weighs them (its own edge test off: the same value twice).
        float w = texelFilterWeight(other, position, n, tg, 0.5, 0.5, vec4(0.0));
        // The two shares' difference over its noise: a binomial share's variance at these rays, the pair's pooled
        // (a floor of one ray's worth, so a share of 0 or 1 still has some).
        float p = 0.5 * (v + centre);
        float sigma = sqrt(2.0 * max(p * (1.0 - p), 1.0 / rays) / rays);
        float e = (v - centre) / (u.uFilter.z * sigma);
        w *= exp(-e * e);
        sum += w * v;
        weight += w;
    }
    float filtered = weight > 0.0 ? sum / weight : centre;
    skyInto[id] = filtered;
    if (u.uFilter.w > 0.5) atomicOr(skyOut[id / 4u], min(uint(sqrt(filtered) * 254.0 + 1.5), 255u) << (8u * (id % 4u)));
}
