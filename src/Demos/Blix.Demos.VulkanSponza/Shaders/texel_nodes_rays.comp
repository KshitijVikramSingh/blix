#version 450
// Sun nodes (SponzaLoop.SunNodes.cs): one pass of a slice's gather rays, out to the CLOSEST batch. A workgroup a
// texel, a thread a ray, drawn as texel_gather.comp draws them: half cosine-weighted (stratified, rotated afresh each
// pass), half from the texel's nearest patch's guide -- the BAND's guide (built from the patches' and sunlets' light
// averaged over every node's sun, SunNodesSolve.cs), so one set of rays serves every sun -- each weighted by the
// mixture's density (NodeRayWeights: the ray's weight on irradiance, pi for a cosine ray without a guide). Without
// guides (uSlice.w 0) all cosine, as before.
// THE LIGHT STRATEGY (uLights.x): with the guide patch's light list (BuildLights: the LIGHT_K patches it sees sending it
// the most light), 16 cosine rays, 8 by the guide, 8 at a point on a listed patch's disk (picked by its share, a uniform
// point on the disk). Every ray is weighted by multiple importance sampling -- the balance heuristic over the three
// strategies' densities at its direction, by their ray counts -- and the light's density is exact for the disks (each
// tested against the ray), so the estimate stays unbiased: only where the rays go changes. A sunlit patch a few cosine
// rays in fifty found now takes a quarter of the rays, each carrying its share.

#define RAYS 32
#define PI 3.14159265359
layout(local_size_x = RAYS) in;

layout(set = 0, binding = 0) uniform SunNodesRays {
    vec4 uSlice;   // x the slice's first live texel, y its texels, z the pass, w 1: guided
    vec4 uCookedGrid;
    vec4 uCookedDims;
    vec4 uLights;  // x 1: the light strategy; y the patches' disk radius; z 1: a lightmap record gathers about its smooth
                   // normal (the smooth gather, LightmapFrames); w 1: a texel's lift bounded by its room (TexelClear)
    vec4 uFar;     // the far field (texel_far.glsl); x 2: a ray in a bin the record knows stops at the texel's reach
    vec4 uTile;    // --interleave: x 1 on, y the finest cells' spacing, z the first lightmap record (its texels by atlas);
                   // w a near round's reach (--near-cut, texel_nodes_shade.glsl FarPart; 0 none)
} u;

layout(std430, set = 0, binding = 1) readonly buffer Texels { vec4 texels[]; };
#include "texel_record.glsl"
layout(std430, set = 0, binding = 2) readonly buffer SunNodesLive { uint liveIds[]; };
layout(std430, set = 0, binding = 3) writeonly buffer NodeRays { vec4 nodeRays[]; };   // 2 a ray: origin, tMin; dir, tMax
layout(std430, set = 0, binding = 4) writeonly buffer NodeRayWeights { float nodeRayWeight[]; };
layout(std430, set = 0, binding = 5) readonly buffer NodeGuides { float cookedGuide[]; };   // per patch, a CDF over 64 bins
// Each texel's guide patch (its cookedNearest), once: 0 not yet, else the patch + 2 (1: none). Worked out again on every
// pass, the search of up to 125 cells a texel made the rays as dear as the trace (11.6 ms a pass of 1 M, 2026-10-14).
layout(std430, set = 0, binding = 9) buffer NodeGuidePatch { uint guidePatch[]; };
// Per patch LIGHT_K (index bits, cumulative share); index -1 empty (BuildLights).
layout(std430, set = 0, binding = 10) readonly buffer NodeLights { vec2 lightList[]; };
#define LIGHT_K 16
// Each live texel's nearest patch it can see (texel_nodes_patch.comp; -1 none): the far field's patch, else the guide's.
layout(std430, set = 0, binding = 11) readonly buffer TexelPatch { int texelPatch[]; };
// The smooth gather (default; --no-gather-smooth-normal): a lightmap record's LOD 0 shading frame (SponzaLoop.Lightmap.cs PackFrame; [0] the atlas size,
// [1 + id] its packed normal and tangent, zero none). A record carries its triangle's face normal; the pixel reads its
// light at the smooth one, and on a faceted fold (drapes' curtain, 2 cm strips) the face's irradiance parts from the
// smooth's by up to half a facet's turn (tools/gi-model/facet_normal.py: 1-2% median, 8-20% at most, with light from
// one side) -- every strip read its own, stepping 3-5% at each strip's edge where the path trace runs smooth (the
// user's vertical stripes, 2026-10-22). The rays (their lift, directions, cosines) about the smooth normal; the patches
// picked by the face's.
layout(std430, set = 0, binding = 14) readonly buffer LightmapFrames { uvec2 lightmapFrames[]; };
// Each texel's room along its normal (texel_clear.comp): the rays' lift half of it at most.
layout(std430, set = 0, binding = 15) readonly buffer TexelClear { float texelClear[]; };
vec3 recordSmoothNormal(uint id, vec3 face) {
    if (u.uLights.z < 0.5 || lightmapFrames[0].x == 0u) return face;
    uint packed = lightmapFrames[1u + id].x;
    if (packed == 0u) return face;
    vec2 o = unpackSnorm2x16(packed);
    vec3 v = vec3(o, 1.0 - abs(o.x) - abs(o.y));
    if (v.z < 0.0) v.xy = (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
    v = normalize(v);
    // A double-sided pair's back shares its front's frame: turned to its own face's side. Past 30 degrees from the
    // face (a frame across a hard edge): the face's.
    if (dot(v, face) < 0.0) v = -v;
    return dot(v, face) > 0.866 ? v : face;
}

#define COOKED_BINDING 6
#define COOKED_GRID u.uCookedGrid
#define COOKED_DIMS u.uCookedDims
#include "cooked_patches.glsl"
#define FAR_RECORD_BINDING 12
#define FAR_RECORD_ACCESS readonly
#define FAR_NEIGHBOURS_BINDING 13
#include "texel_far.glsl"

#define GUIDE_RES 8
#define GUIDE_BINS 64

// ray_query.glsl's (without its ray scene's buffers): the gather's seeds.
uint blix_pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// texel_gather.comp's guide sampling and density, unchanged.
vec2 guideOctEncode(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    if (d.z >= 0.0) return d.xy;
    return vec2((1.0 - abs(d.y)) * (d.x >= 0.0 ? 1.0 : -1.0), (1.0 - abs(d.x)) * (d.y >= 0.0 ? 1.0 : -1.0));
}

vec3 guideOctDecodeRaw(vec2 uv) {
    vec3 d = vec3(uv, 1.0 - abs(uv.x) - abs(uv.y));
    if (d.z < 0.0) { float x = d.x; d.x = (1.0 - abs(d.y)) * (x >= 0.0 ? 1.0 : -1.0); d.y = (1.0 - abs(x)) * (d.y >= 0.0 ? 1.0 : -1.0); }
    return d;
}

int guideBin(vec3 d) {
    ivec2 b = clamp(ivec2((guideOctEncode(d) * 0.5 + 0.5) * float(GUIDE_RES)), ivec2(0), ivec2(GUIDE_RES - 1));
    return b.y * GUIDE_RES + b.x;
}

float guidePdf(int patchIndex, vec3 d) {
    int b = guideBin(d);
    float p = cookedGuide[patchIndex * GUIDE_BINS + b] - (b > 0 ? cookedGuide[patchIndex * GUIDE_BINS + b - 1] : 0.0);
    float l1 = abs(d.x) + abs(d.y) + abs(d.z);
    return p * 16.0 / (l1 * l1 * l1);
}

vec3 guideSample(int patchIndex, float u0, float u1, float u2) {
    int lo = 0, hi = GUIDE_BINS - 1;
    while (lo < hi) { int mid = (lo + hi) / 2; if (cookedGuide[patchIndex * GUIDE_BINS + mid] < u0) lo = mid + 1; else hi = mid; }
    vec2 uv = (vec2(lo % GUIDE_RES, lo / GUIDE_RES) + vec2(u1, u2)) / float(GUIDE_RES) * 2.0 - 1.0;
    return normalize(guideOctDecodeRaw(uv));
}

// The light strategy's density at a direction from origin: over the guide patch's list, each disk the ray crosses, its
// share times its solid-angle density there (t^2 over the disk's area and the cosine at it).
float lightPdf(int listPatch, vec3 origin, vec3 d) {
    float radius = u.uLights.y;
    float area = PI * radius * radius;
    float pdf = 0.0, before = 0.0;
    for (int k = 0; k < LIGHT_K; ++k) {
        vec2 e = lightList[listPatch * LIGHT_K + k];
        int j = floatBitsToInt(e.x);
        float share = e.y - before;
        before = e.y;
        if (j < 0 || share <= 0.0) continue;
        vec3 c = cookedPatch[3 * j].xyz;
        vec3 nj = cookedPatch[3 * j + 1].xyz;
        float denom = dot(d, nj);
        if (abs(denom) < 1e-6) continue;
        float t = dot(c - origin, nj) / denom;
        if (t <= 0.0) continue;
        vec3 q = origin + d * t - c;
        if (dot(q, q) > radius * radius) continue;
        pdf += share * t * t / (abs(denom) * area);
    }
    return pdf;
}

// A point on a listed patch's disk, the patch picked by u0 against the shares.
vec3 lightSample(int listPatch, vec3 origin, float u0, float u1, float u2) {
    int pick = LIGHT_K - 1;
    for (int k = 0; k < LIGHT_K; ++k) if (u0 < lightList[listPatch * LIGHT_K + k].y) { pick = k; break; }
    int j = floatBitsToInt(lightList[listPatch * LIGHT_K + pick].x);
    if (j < 0) return vec3(0.0);
    vec3 c = cookedPatch[3 * j].xyz;
    vec3 nj = normalize(cookedPatch[3 * j + 1].xyz);
    vec3 t = normalize(abs(nj.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), nj) : cross(vec3(1.0, 0.0, 0.0), nj));
    vec3 b = cross(nj, t);
    float r = u.uLights.y * sqrt(u1), phi = 2.0 * PI * u2;
    vec3 to = c + t * (r * cos(phi)) + b * (r * sin(phi)) - origin;
    return dot(to, to) > 1e-10 ? normalize(to) : vec3(0.0);
}

shared int sGuide;
shared int sFarPatch;
shared float sFarReach;
shared int sFarIds[FAR_SET];
shared vec3 sFarN[FAR_SET], sFarT[FAR_SET], sFarB[FAR_SET];

float radicalInverse(uint i, uint base) {
    float f = 1.0, r = 0.0;
    while (i > 0u) { f /= float(base); r += f * float(i % base); i /= base; }
    return r;
}
vec2 interleaveShift = vec2(0.0);   // the guide's and the light strategy's two random numbers shifted by it (--interleave)

// Interleaved sampling (--interleave; tools/gi-model/cell_noise.py --interleave, ray_mix.py): the nine cells of a 3x3 tile
// on their surface share their rays' random numbers, each shifted by its place's radical inverses, so the coarse filter's
// 3x3 average is nine shifted copies of the tile's samples filling in between one another. Returns the tile's id (the
// numbers' seed) and the cell's place in it (0-8): hashed cells by their grid cell at their level (two mod-3 indices that
// tell the nine apart on every axis plane); lightmap records by their atlas texel. An experiment: near-field noise, which
// neighbours do not share, it cannot cancel (ray_mix.py).
uint interleaveTile(uint id, vec3 position, out uint place) {
    if (float(id) >= u.uTile.z) {
        uint packed = floatBitsToUint(TEXEL_NORMAL(id).w);
        uvec2 at = uvec2(packed & 0xFFFFu, packed >> 16);
        place = (at.x % 3u) + 3u * (at.y % 3u);
        return blix_pcg((at.x / 3u) * 73856093u ^ (at.y / 3u) * 19349663u ^ 0x5EED1u);
    }
    float level = TEXEL_NORMAL(id).w;
    float spacing = u.uTile.y * exp2(floor(level + 0.5));
    ivec3 c = ivec3(floor(position / spacing));
    ivec3 m = ((c % 3) + 3) % 3;
    place = uint((m.x + m.y + m.z) % 3) * 3u + uint((m.x + 2 * m.y) % 3);
    ivec3 t = (c - m) / 3;
    return blix_pcg(uint(t.x) * 73856093u ^ uint(t.y) * 19349663u ^ uint(t.z) * 83492791u ^ uint(floor(level + 0.5)) * 2654435761u);
}

void main() {
    uint group = gl_WorkGroupID.x;
    uint ray = gl_LocalInvocationID.x;
    uint slot = group * uint(RAYS) + ray;
    if (group >= uint(u.uSlice.y)) {
        nodeRays[slot * 2u] = vec4(0.0);
        nodeRays[slot * 2u + 1u] = vec4(0.0);
        nodeRayWeight[slot] = 0.0;
        return;
    }
    uint id = liveIds[uint(u.uSlice.x) + group];
    vec3 position = TEXEL_POSITION(id).xyz;
    vec3 n = normalize(TEXEL_NORMAL(id).xyz);
    if (ray == 0u) {
        // The texel's patch (its nearest): the guide's, and the far field's where the cook's pick saw none -- found
        // unguided too (the transfer's cook, SponzaLoop.Transfer.cs, reads the far field with cosine rays).
        uint known = guidePatch[id];
        int g = known != 0u ? int(known) - 2 : cookedNearest(position, n);
        if (known == 0u) guidePatch[id] = uint(g + 2);
        sGuide = u.uSlice.w > 0.5 ? g : -1;
        // The far field: the patch the shade will read (texel_nodes_shade.glsl picks it the same way) and the reach.
        int fp = -1;
        if (u.uFar.x > 1.5) {
            fp = texelPatch[id];
            if (fp < 0) fp = int(guidePatch[id]) - 2;
        }
        sFarPatch = max(fp, -1);
        if (fp >= 0) {
            int ids[FAR_SET];
            float ws[FAR_SET];
            farSet(position, n, fp, u.uFar, ids, ws);
            sFarReach = farSetReach(position, ids, u.uFar);
            for (int i = 0; i < FAR_SET; ++i) {
                sFarIds[i] = ids[i];
                if (ids[i] < 0) continue;
                vec3 fn, ft, fb;
                farFrame(ids[i], fn, ft, fb);
                sFarN[i] = fn; sFarT[i] = ft; sFarB[i] = fb;
            }
        }
    }
    barrier();
    int guide = sGuide;
    uint pass = uint(u.uSlice.z);
    uint seed = blix_pcg(id * 9781u + pass * 0x632BE5ABu + ray * 2654435761u);
    uint setSeed = blix_pcg(id * 9781u + pass * 0x632BE5ABu);
    float rotation = float(blix_pcg(setSeed) & 0xFFFFu) / 65536.0;
    float jitter = float(blix_pcg(seed) & 0xFFFFu) / 65536.0;
    if (u.uTile.x > 0.5) {
        uint place;
        uint tile = interleaveTile(id, position, place);
        uint tileSet = blix_pcg(tile * 9781u + pass * 0x632BE5ABu);
        seed = blix_pcg(tile * 9781u + pass * 0x632BE5ABu + ray * 2654435761u);
        interleaveShift = vec2(radicalInverse(place, 5u), radicalInverse(place, 7u));
        rotation = fract(float(blix_pcg(tileSet) & 0xFFFFu) / 65536.0 + radicalInverse(place, 3u));
        jitter = fract(float(blix_pcg(seed) & 0xFFFFu) / 65536.0 + radicalInverse(place, 2u));
    }
    const uint halfRays = uint(RAYS) / 2u;
    // The rays by strategy: cosine [0, cosineEnd), guide [cosineEnd, guideEnd), light [guideEnd, RAYS).
    bool lit = guide >= 0 && u.uLights.x > 0.5 && lightList[guide * LIGHT_K + LIGHT_K - 1].y > 0.5;
    uint cosineEnd = guide >= 0 ? halfRays : uint(RAYS);
    uint guideEnd = lit ? halfRays + uint(RAYS) / 4u : uint(RAYS);
    float cosineCount = float(cosineEnd);
    float guideCount = float(guideEnd - cosineEnd);
    float lightCount = float(uint(RAYS) - guideEnd);
    bool guided = ray >= cosineEnd && ray < guideEnd;
    bool aimed = ray >= guideEnd;
    uint stratum = aimed ? ray - guideEnd : guided ? ray - cosineEnd : ray;
    // The rays about the record's smooth normal (--gather-smooth-normal); the guide and far patches above by its face's.
    n = recordSmoothNormal(id, n);
    // The lift: 1 cm, and half the texel's room along its normal at most (a quarter of a millimetre at least, off its own
    // surface) -- 1 cm crossed walls thinner than it: the sheet shell at 4 mm read the sky inside itself, the teacup's
    // saucer well its outside (texel_clear.comp, 2026-10-24).
    // A lightmap record's alone (it lies on its triangle): a hashed texel's position is its cell's centroid, between the two
    // faces of a wall thinner than the cell that face the same way, and its room from there is the wall's inside.
    float lift = u.uLights.w > 0.5 && float(id) >= u.uTile.z ? min(0.01, max(0.5 * texelClear[id], 2.5e-4)) : 0.01;
    vec3 origin = position + n * lift;
    vec3 dir;
    if (aimed) {
        uint s1 = blix_pcg(seed ^ 0x85EBCA77u), s2 = blix_pcg(s1);
        dir = lightSample(guide, origin, (float(stratum) + jitter) / lightCount, fract(float(s1 & 0xFFFFu) / 65536.0 + interleaveShift.x), fract(float(s2 & 0xFFFFu) / 65536.0 + interleaveShift.y));
    } else if (guided) {
        uint s1 = blix_pcg(seed ^ 0x9E3779B9u), s2 = blix_pcg(s1);
        dir = guideSample(guide, (float(stratum) + jitter) / guideCount, fract(float(s1 & 0xFFFFu) / 65536.0 + interleaveShift.x), fract(float(s2 & 0xFFFFu) / 65536.0 + interleaveShift.y));
    } else {
        float r = sqrt((float(stratum) + jitter) / cosineCount);
        float phi = 2.0 * PI * fract(float(stratum) * 0.618034 + rotation);
        vec3 t = normalize(abs(n.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), n) : cross(vec3(1.0, 0.0, 0.0), n));
        vec3 b = cross(n, t);
        dir = normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - r * r)));
    }
    if (dot(dir, dir) < 0.5) dir = n * -1.0;   // a degenerate light sample: below the surface, weight 0
    float cosTheta = dot(dir, n);
    // The balance heuristic: the ray's weight over every strategy's density, each by its share of the rays.
    float mixturePdf = cosineCount / float(RAYS) * max(cosTheta, 0.0) / PI;
    if (guideCount > 0.0) mixturePdf += guideCount / float(RAYS) * guidePdf(guide, dir);
    if (lightCount > 0.0 && cosTheta > 0.0) mixturePdf += lightCount / float(RAYS) * lightPdf(guide, origin, dir);
    nodeRayWeight[slot] = cosTheta > 0.0 && mixturePdf > 0.0 ? cosTheta / mixturePdf : 0.0;
    nodeRays[slot * 2u] = vec4(origin, 0.0);
    // Short rays: where every blended patch's record knows the direction, past the reach is the patch's -- the ray need go no further.
    float tMax = uintBitsToFloat(0x7F800000u);
    if (sFarPatch >= 0) {
        bool known = true;
        for (int i = 0; i < FAR_SET && known; ++i) {
            if (sFarIds[i] < 0) continue;
            int bin = farBin(dir, sFarN[i], sFarT[i], sFarB[i]);
            known = bin >= 0 && farKnown(sFarIds[i], bin, u.uFar);
        }
        if (known) tMax = sFarReach;
    }
    // A near round's cut -- not for a sheet's texel (|w| 5: SponzaLoop.Lightmap.cs), whose far light still settles.
    if (u.uTile.w > 0.0 && abs(TEXEL_POSITION(id).w) < 4.5) tMax = min(tMax, u.uTile.w);
    nodeRays[slot * 2u + 1u] = vec4(dir, tMax);
}
