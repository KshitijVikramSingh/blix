#version 450

// --rtgi-near-cook (rtgi_nearcook.glsl): the cook, a chunk of cells a frame. Kinds 4 and 5: each cell's point chosen among
// its candidates. Kind 0 (placement time): each cell's NEAR_RAYS rays, from its point lifted off its surface, into the
// Metal batch (closest hit). Kind 1 (with the training): their hits into the cell's links (within the contact radius), its
// escape share, and whether it is buried. Kinds 6-10: the regions by connectivity. Kinds 11-13: the cells' sizes. Kinds 14,
// 15: the cells near the camera listed (--rtgi-near-train).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiNearCookCook {
    vec4 uNearCook;  // rtgi_nearcook.glsl's NEAR_PARAMS
    vec4 uCook;      // x the chunk's first cell; y its cells; z the contact radius (m); w the kind
    vec4 uVolume;    // rtgi_volume.glsl's VOL_PARAMS (kinds 2 and 3); x the level the regions are probes of
    vec4 uConn;      // x 1: the labels' first pass (each its own index); y the cube hash's slots - 1; z the scale's pass (its parity)
    vec4 uGeom;      // rtgi_volume.glsl's VOL_GEOM (kinds 11-13: x the cells' share of the distance, y their most, w the level)
    vec4 uNear;      // kinds 14 and 15: xyz the camera, w the reach (m)
} u;
// Per cell, its candidate points (one sample per 4 x 4 sub-square of it across its surface, w 1 where it had one): kinds 4
// and 5 test each with 8 rays and keep the one meeting no back face, nearest the cell's middle, as its point -- the
// mean of its samples fell under a wall standing on part of it (SponzaLoop.RtgiNearCook.cs).
#define NEAR_CANDIDATES 16u
// How far the test and cook rays go (m): far enough to meet whatever closes round the point. To the contact radius only, a
// candidate inside a hollow block (the crevices testbed's walls are closed shells standing on the floor, the floor running
// under them) saw nothing in half its directions -- open, as far as the count went: a floor cell's point chosen under the
// wall beside it, never marked buried, its training rays (long) 91% on the wall's inside -- a black strip along every wall's
// foot from the first frame (the user, 2026-10-30). Links still only within the radius.
#define NEAR_TEST_REACH 64.0
#define NEAR_CHOOSE_RAYS 8u
layout(std430, set = 0, binding = 8) readonly buffer RtgiNearCandidates { vec4 nearCandidates[]; };

layout(std430, set = 0, binding = 1) buffer RtgiNearPoints { vec4 nearPoints[]; };
layout(std430, set = 0, binding = 6) readonly buffer RtgiVolumeTable { uvec2 volTable[]; };
layout(std430, set = 0, binding = 7) readonly buffer RtgiVolumeProbes { float volProbes[]; };
layout(std430, set = 0, binding = 2) buffer RtgiNearCookRays { vec4 cookRays[]; };
layout(std430, set = 0, binding = 3) readonly buffer RtgiNearCookHits { uvec4 cookHits[]; };
layout(std430, set = 0, binding = 4) buffer RtgiNearLinks { uvec2 nearLinks[]; };
layout(std430, set = 0, binding = 5) buffer RtgiNearLight { vec4 nearLight[]; };

// The regions (kinds 6-10, after the links): each cell's links to its 8 neighbours across its surface (a clear ray
// between their points), its piece's label at each of NEAR_LEVELS cube sizes (the lowest cell index reached along links
// within the cube, propagated a pass at a time), each cube's lowest label (a hash of cubes), and its regions: 0 for the
// piece holding the cube's lowest, 1 + its label for any other.
layout(std430, set = 0, binding = 9) buffer RtgiNearAdj { uint nearAdj[]; };
layout(std430, set = 0, binding = 10) buffer RtgiNearLabels { uint nearLabels[]; };
layout(std430, set = 0, binding = 11) buffer RtgiNearRegions { uint nearRegions[]; };
layout(std430, set = 0, binding = 12) buffer RtgiNearCubes { uvec2 nearCubes[]; };
layout(std430, set = 0, binding = 13) readonly buffer RtgiNearTable { uvec2 nearTable[]; };
// The cache's cell size the cooked cells ask for (kinds 11-13, after the regions): each live cell's mean inverse distance
// over its NEAR_RAYS rays -- a ray that met a surface its distance, one that left the probes' harmonic distance there (at
// least the contact radius) -- two halves for the passes averaging it over its linked neighbours, then 0.1 / it (VOL_GEOM)
// into a table by 5 cm cube, sides alike (the smallest of a cube's cells): rtgi_nearcook.glsl's nearScaleAt, which
// rtgi_cache.glsl's rtgiCellSize asks before the probes. Sized from the 2 m probes alone, trilinear over 2 m with cooked
// probes missing here and there, a crease's cells stepped size at the probes' cubes -- tears in the cell-size view and
// steps of light along the crevices testbed's floor (the user, 2026-10-30); a cooked cell's own rays are its surface's.
layout(std430, set = 0, binding = 14) buffer RtgiNearScale { float nearScale[]; };
layout(std430, set = 0, binding = 15) buffer RtgiNearScaleTable { uvec2 nearScaleTable[]; };
// The live cells within uNear.w of the camera (kind 14 empties it, 15 lists them): rtgi_rays.comp's --rtgi-near-train points.
layout(std430, set = 0, binding = 16) buffer RtgiNearList { uint nearListCount; uint nearListPad[3]; uint nearList[]; };

#define NEAR_PARAMS u.uNearCook
#define NEAR_TABLE(i) nearTable[i]
#include "rtgi_nearcook.glsl"

// A live (not buried) cell's neighbour k across its surface, or 0xFFFFFFFF.
uint nearNeighbour(uint i, uint k) {
    vec3 p = nearPoints[2u * i].xyz;
    uint side = floatBitsToUint(nearPoints[2u * i].w) & 7u;
    ivec3 c = ivec3(floor((p - rtgiOrigin(side)) / NEAR_PARAMS.x));
    uint axis = side >> 1u, a0 = (axis + 1u) % 3u, a1 = (axis + 2u) % 3u;
    c[a0] += NEAR_RING[k].x;
    c[a1] += NEAR_RING[k].y;
    uint j = nearFind(c, side);
    if (j == 0xFFFFFFFFu || (floatBitsToUint(nearPoints[2u * j].w) & NEAR_BURIED) != 0u) return 0xFFFFFFFFu;
    return j;
}
ivec3 nearCube(uint i, uint level) { return ivec3(floor((nearPoints[2u * i].xyz - rtgiOrigin((floatBitsToUint(nearPoints[2u * i].w) & 7u))) / (NEAR_PARAMS.x * exp2(float(level))))); }
bool nearLive(uint i) { return (floatBitsToUint(nearPoints[2u * i].w) & NEAR_BURIED) == 0u; }
#define VOL_PARAMS vec4(u.uVolume.xyz, 1.0)
// The probes' raw harmonic distance (volCellScale with a share of 1, no most).
#define VOL_GEOM vec4(1.0, 1e6, 0.0, u.uGeom.w)
#define VOL_TABLE(i) volTable[i]
#define VOL_PROBES(i) volProbes[i]
#define VOL_DEPTH(i) 0u
#include "rtgi_volume.glsl"

void main() {
    uint t = gl_GlobalInvocationID.x;
    uint first = uint(u.uCook.x), cells = uint(u.uCook.y);
    float radius = u.uCook.z;
    uint kind = uint(u.uCook.w + 0.5);
    if (kind == 6u) {
        // A ray from the cell's point to each live neighbour's, both lifted off their surface.
        if (t >= cells * 8u) return;
        uint i = first + t / 8u, k = t % 8u;
        cookRays[2u * t] = vec4(0.0);
        cookRays[2u * t + 1u] = vec4(0.0, 1.0, 0.0, 1e-6);
        if (!nearLive(i)) return;
        uint j = nearNeighbour(i, k);
        if (j == 0xFFFFFFFFu) return;
        vec3 o = nearPoints[2u * i].xyz + nearPoints[2u * i + 1u].xyz * 0.01;
        vec3 q = nearPoints[2u * j].xyz + nearPoints[2u * j + 1u].xyz * 0.01;
        float len = length(q - o);
        if (len < 1e-4) return;
        cookRays[2u * t] = vec4(o, 0.0);
        cookRays[2u * t + 1u] = vec4((q - o) / len, max(len - 0.002, 1e-4));
        return;
    }
    if (kind == 7u) {
        if (t >= cells) return;
        uint i = first + t, mask = 0u;
        for (uint k = 0u; k < 8u; k++) {
            uint r = t * 8u + k;
            if (cookRays[2u * r + 1u].w > 1e-5 && (cookHits[3u * r].w & 1u) == 0u) mask |= 1u << k;
        }
        nearAdj[i] = mask;
        return;
    }
    if (kind == 8u) {
        // A pass of the labels: each level's the lowest of its own and its linked neighbours' (both ways) in its cube.
        if (t >= cells) return;
        uint i = first + t;
        for (uint l = 0u; l < NEAR_LEVELS; l++) {
            uint lab = u.uConn.x > 0.5 ? i : nearLabels[i * NEAR_LEVELS + l];
            if (u.uConn.x < 0.5 && nearLive(i)) {
                ivec3 cube = nearCube(i, l);
                for (uint k = 0u; k < 8u; k++) {
                    if ((nearAdj[i] & (1u << k)) == 0u) continue;
                    uint j = nearNeighbour(i, k);
                    if (j == 0xFFFFFFFFu || (nearAdj[j] & (1u << (k ^ 1u))) == 0u || nearCube(j, l) != cube) continue;
                    lab = min(lab, nearLabels[j * NEAR_LEVELS + l]);
                }
            }
            nearLabels[i * NEAR_LEVELS + l] = lab;
        }
        return;
    }
    if (kind == 9u || kind == 10u) {
        // 9: each cube's lowest label (its key claimed, the lowest kept); 10: the regions.
        if (t >= cells) return;
        uint i = first + t;
        uint side = floatBitsToUint(nearPoints[2u * i].w) & 7u;
        for (uint l = 0u; l < NEAR_LEVELS; l++) {
            if (!nearLive(i)) { if (kind == 10u) nearRegions[i * NEAR_LEVELS + l] = 0u; continue; }
            ivec3 cube = nearCube(i, l);
            uint ha = nearHash(uint(cube.x) * 0x9E3779B1u ^ nearHash(uint(cube.y) * 0x85EBCA77u ^ nearHash(uint(cube.z) * 0xC2B2AE3Du ^ (side + 8u * l + 0x51Fu))));
            uvec2 h = uvec2(ha, nearHash(ha ^ 0x2545F491u ^ uint(cube.x) * 0x1B873593u ^ uint(cube.y) * 0xCC9E2D51u) | 1u);
            uint mask = uint(u.uConn.y);
            uint lab = nearLabels[i * NEAR_LEVELS + l];
            uint slot = 0xFFFFFFFFu;
            for (uint k = 0u; k < 32u; k++) {
                uint s = (h.x + k) & mask;
                if (kind == 9u) {
                    uint prev = atomicCompSwap(nearCubes[s].x, 0u, h.y);
                    if (prev == 0u || prev == h.y) { slot = s; break; }
                } else if (nearCubes[s].x == h.y) { slot = s; break; }
                else if (nearCubes[s].x == 0u) break;
            }
            if (slot == 0xFFFFFFFFu) { if (kind == 10u) nearRegions[i * NEAR_LEVELS + l] = 0u; continue; }
            if (kind == 9u) atomicMin(nearCubes[slot].y, lab);
            else nearRegions[i * NEAR_LEVELS + l] = lab == nearCubes[slot].y ? 0u : lab + 1u;
        }
        return;
    }
    if (kind == 14u) { if (t == 0u) nearListCount = 0u; return; }
    if (kind == 15u) {
        if (t >= cells) return;
        uint i = first + t;
        if (!nearLive(i) || distance(nearPoints[2u * i].xyz, u.uNear.xyz) > u.uNear.w) return;
        nearList[atomicAdd(nearListCount, 1u)] = i;
        return;
    }
    if (kind == 11u || kind == 12u || kind == 13u) {
        if (t >= cells) return;
        uint i = first + t, n = uint(NEAR_PARAMS.z);
        uint src = u.uConn.z > 0.5 ? n : 0u, dst = n - src;
        if (kind == 11u) {
            if (!nearLive(i)) { nearScale[i] = 0.0; return; }
            float far = volCellScale(nearPoints[2u * i].xyz);
            float leftInv = far > 0.0 ? 1.0 / max(far, radius) : 0.0, inv = 0.0;
            for (uint k = 0u; k < NEAR_RAYS; k++) {
                uint link = nearLinks[i * NEAR_RAYS + k].x;
                inv += (link & 0x80000000u) != 0u ? 1.0 / max(float((link >> 16) & 0x7FFFu) / 32767.0 * radius, 0.01) : leftInv;
            }
            nearScale[i] = inv / float(NEAR_RAYS);
            return;
        }
        if (!nearLive(i)) return;
        if (kind == 12u) {
            float s = nearScale[src + i], w = 1.0;
            for (uint k = 0u; k < 8u; k++) {
                if ((nearAdj[i] & (1u << k)) == 0u) continue;
                uint j = nearNeighbour(i, k);
                if (j == 0xFFFFFFFFu || (nearAdj[j] & (1u << (k ^ 1u))) == 0u) continue;
                s += nearScale[src + j];
                w += 1.0;
            }
            nearScale[dst + i] = s / w;
            return;
        }
        float inv = nearScale[src + i];
        float size = inv > 0.0 ? min(u.uGeom.x / inv, u.uGeom.y) : u.uGeom.y;
        uvec2 h = nearCellHash(ivec3(floor((nearPoints[2u * i].xyz - NEAR_SCALE_ORIGIN) / NEAR_PARAMS.x)), 7u);
        for (uint k = 0u; k < NEAR_PROBE_STEPS; k++) {
            uint s = (h.x + k) & uint(NEAR_PARAMS.y);
            uint prev = atomicCompSwap(nearScaleTable[s].x, 0u, h.y);
            if (prev == 0u || prev == h.y) { atomicMin(nearScaleTable[s].y, floatBitsToUint(size)); break; }
        }
        return;
    }
    if (kind == 4u) {
        if (t >= cells * NEAR_CANDIDATES * NEAR_CHOOSE_RAYS) return;
        uint i = first + t / (NEAR_CANDIDATES * NEAR_CHOOSE_RAYS);
        uint c = (t / NEAR_CHOOSE_RAYS) % NEAR_CANDIDATES, r = t % NEAR_CHOOSE_RAYS;
        vec4 cand = nearCandidates[NEAR_CANDIDATES * i + c];
        vec3 n = nearPoints[2u * i + 1u].xyz;
        cookRays[2u * t] = vec4(cand.xyz + n * 0.01, 0.0);
        cookRays[2u * t + 1u] = vec4(nearRayDir(i, r * (NEAR_RAYS / NEAR_CHOOSE_RAYS), n), cand.w > 0.5 ? NEAR_TEST_REACH : 1e-6);
        return;
    }
    if (kind == 5u) {
        if (t >= cells) return;
        uint i = first + t;
        vec3 mid = nearPoints[2u * i].xyz;
        uint best = 0xFFFFFFFFu;
        float bestBacks = 1e30, bestD = 1e30;
        for (uint c = 0u; c < NEAR_CANDIDATES; c++) {
            vec4 cand = nearCandidates[NEAR_CANDIDATES * i + c];
            if (cand.w < 0.5) continue;
            float backs = 0.0;
            for (uint r = 0u; r < NEAR_CHOOSE_RAYS; r++) {
                uint ray = (t * NEAR_CANDIDATES + c) * NEAR_CHOOSE_RAYS + r;
                uvec4 h0 = cookHits[3u * ray];
                if ((h0.w & 1u) != 0u && (h0.w & 2u) == 0u) backs += 1.0;
            }
            float dm = length(cand.xyz - mid);
            if (backs < bestBacks || (backs == bestBacks && dm < bestD)) { bestBacks = backs; bestD = dm; best = c; }
        }
        if (best != 0xFFFFFFFFu) nearPoints[2u * i].xyz = nearCandidates[NEAR_CANDIDATES * i + best].xyz;
        return;
    }
    if (u.uCook.w < 0.5) {
        if (t >= cells * NEAR_RAYS) return;
        uint i = first + t / NEAR_RAYS, k = t % NEAR_RAYS;
        vec3 p = nearPoints[2u * i].xyz, n = nearPoints[2u * i + 1u].xyz;
        cookRays[2u * t] = vec4(p + n * 0.01, 0.0);
        cookRays[2u * t + 1u] = vec4(nearRayDir(i, k, n), NEAR_TEST_REACH);
        return;
    }
    if (t >= cells) return;
    uint i = first + t;
    float left = 0.0, backs = 0.0;
    for (uint k = 0u; k < NEAR_RAYS; k++) {
        uint r = t * NEAR_RAYS + k;
        uvec4 h0 = cookHits[3u * r];
        float dist = uintBitsToFloat(h0.x);
        uvec2 link = uvec2(0u);
        // A back face met at any distance: the ray started inside something.
        if ((h0.w & 1u) != 0u && (h0.w & 2u) == 0u) backs += 1.0;
        if ((h0.w & 1u) != 0u && dist <= radius) {
            uvec4 h2 = cookHits[3u * r + 2u];
            vec3 nq = vec3(uintBitsToFloat(h2.x), uintBitsToFloat(h2.y), uintBitsToFloat(h2.z));
            vec3 d = cookRays[2u * r + 1u].xyz;
            nq = dot(nq, nq) > 1e-12 ? normalize(nq) : -d;
            if (dot(nq, d) > 0.0) nq = -nq;
            uvec2 o = uvec2(clamp(nearOctEncode(nq) * 255.0 + 0.5, 0.0, 255.0));
            uint dq = uint(clamp(dist / radius, 0.0, 1.0) * 32767.0);
            // A back face met: the ray started inside something -- dark (albedo 0).
            uint albedo = (h0.w & 2u) != 0u ? h2.w : 0u;
            link = uvec2(0x80000000u | (dq << 16) | (o.y << 8) | o.x, albedo);
        } else left += 1.0;
        nearLinks[i * NEAR_RAYS + k] = link;
    }
    // Its light not gathered yet (w 0: rtgi_nearcook_update.comp sets it 1 with its first). Buried (most rays on back faces:
    // its point inside something): marked, its light -1 for good -- trained from, those points started rays inside the wall
    // a floor ran under, black, and every edge where one thing stood on another darkened as the cells' history filled
    // (the user, the crevices testbed, 2026-10-30).
    bool buried = backs > 0.5 * float(NEAR_RAYS);

    if (buried) nearPoints[2u * i].w = uintBitsToFloat(floatBitsToUint(nearPoints[2u * i].w) | NEAR_BURIED);
    nearLight[i] = buried ? vec4(0.0, 0.0, 0.0, -1.0) : vec4(0.0);
}
