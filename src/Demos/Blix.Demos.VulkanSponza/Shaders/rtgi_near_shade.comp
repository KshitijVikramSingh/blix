#version 450

// --rtgi-hybrid (SponzaLoop.Rtgi.cs): the near rays' hits lit (rtgi_near_rays.comp placed them, the Metal batch traced
// them closest-hit with each hit's sun), into the samples the readout gathers (rtgi_readout.frag hybridNear). A surface's
// front met within the contact radius brings its light as the training's hits do (rtgi_train.comp): its albedo times its
// cell's indirect light (the readout's record, its level or up to two coarser) and the sun where its sun ray reached it --
// PI x L_in for the cosine ray. A back face met: the ray started inside something, dark. Nothing met that near: the ray
// left, the pixel's share of the cache's far light (its weight, 1 for a cosine ray). Written at the pixel's half-res
// index, stamped with the frame, beside the point and its normal.
//
// And (uNear2.y) into the world: the point's near cell -- a quarter of its cache cell's size, at the cell's level + 24 (a
// key range of its own: never a light cell, nor a contact cell) -- adds the sample like a training sample (its light, the
// count, the escape as the near word), listed for this frame's resolve, which keeps them as it keeps any cell's
// (rtgi_resolve.comp: E the near light per ray, the direction's w the escape share). The readout reads these
// (rtgi_readout.frag readNear) in place of a per-pixel history on the screen: that history belonged to the screen's
// pixels, cleared whenever the camera moved and took seconds to come back -- a crevice's edge blurred half light and
// half dark after every move (the user, the crevices testbed, 2026-10-29); the cells stand still with the surface.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiNearShade {
    vec4 uParams;        // rtgiParams (rtgi_cache.glsl)
    vec4 uCamera;        // xyz position
    vec4 uSun;           // xyz toward the sun
    vec4 uSunIrradiance; // rgb
    vec4 uNear;          // x the contact radius; y this frame's stamp; z the slots; w the samples' slots (half-res pixels)
    vec4 uVolume;        // --rtgi-volume: rtgi_volume.glsl's VOL_PARAMS (w 0: off), what sizes the cells
    vec4 uVolumeGeom;    // rtgi_volume.glsl's VOL_GEOM
    vec4 uNearCook;      // rtgi_nearcook.glsl's NEAR_PARAMS (the regions)
    vec4 uNear2;         // x 1: each hit's own sun ray (its flag 8); 0: its cell's sun visibility, the cache's mean; y 1: into
                         // the near cells too; z the frame's number (the resolve's list); w the dirty list's room
} u;

layout(std430, set = 0, binding = 1) buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 10) buffer RtgiAccum { uint rtgiAccum[]; };
layout(std430, set = 0, binding = 11) buffer RtgiCells { ivec4 rtgiCells[]; };
layout(std430, set = 0, binding = 12) buffer RtgiDirty { uint dirtyCount; uint dirtyPad[3]; uint dirty[]; };
layout(std430, set = 0, binding = 2) readonly buffer RtgiRecord { uvec4 rtgiRecord[]; };
layout(std430, set = 0, binding = 3) readonly buffer RtgiNearRayBuffer { vec4 nearRays[]; };
layout(std430, set = 0, binding = 4) readonly buffer RtgiNearHits { uvec4 nearHits[]; };
layout(std430, set = 0, binding = 5) readonly buffer RtgiNearInfo { vec4 nearInfo[]; };
layout(std430, set = 0, binding = 6) writeonly buffer RtgiNearSamples { vec4 nearSamples[]; };
layout(std430, set = 0, binding = 7) readonly buffer RtgiResolved { vec4 rtgiResolved[]; };

layout(std430, set = 0, binding = 8) readonly buffer RtgiVolumeTable { uvec2 volTable[]; };
layout(std430, set = 0, binding = 9) readonly buffer RtgiVolumeProbes { float volProbes[]; };
#define VOL_PARAMS u.uVolume
#define VOL_GEOM u.uVolumeGeom
#define VOL_TABLE(i) volTable[i]
#define VOL_PROBES(i) volProbes[i]
#define VOL_DEPTH(i) 0u
#include "rtgi_volume.glsl"
#define RTGI_GEOM_SCALE(p) volCellScale(p)
#define RTGI_FAR_GROW u.uVolumeGeom.z
layout(std430, set = 0, binding = 13) readonly buffer RtgiNearTable { uvec2 nearTable[]; };
layout(std430, set = 0, binding = 14) readonly buffer RtgiNearPoints { vec4 nearPoints[]; };
#define NEAR_PARAMS u.uNearCook
#define NEAR_TABLE(i) nearTable[i]
#define NEAR_POINTS(i) nearPoints[i]
#define RTGI_KEYS(i) rtgiKeys[i]
// The cooked cells' regions by level and their links (rtgi_nearcook_cook.comp; rtgi_cache.glsl's rtgiRegion).
layout(std430, set = 0, binding = 15) readonly buffer RtgiNearRegions { uint nearRegions[]; };
#define NEAR_REGIONS(i) nearRegions[i]
// The cooked cells' cell sizes by 5 cm cube (rtgi_nearcook.glsl's nearScaleAt; rtgi_cache.glsl's rtgiCellSize).
layout(std430, set = 0, binding = 16) readonly buffer RtgiNearScaleTable { uvec2 nearScaleTable[]; };
#define NEAR_SCALE(i) nearScaleTable[i]
#define RTGI_REGION_OF 1
#include "rtgi_cache.glsl"
#include "rtgi_nearcook.glsl"

// The cell's indirect light at q facing n: its level's cell holding it, else a coarser one (two up at most); 0 none. Its
// sun visibility (the share of its points that saw the sun, rtgi_resolve.comp) in sunVis.
float sunVis = 0.0;
vec3 cellLight(vec3 q, vec3 n) {
    rtgiRegion = nearRegion(q, rtgiSide(n));
    uint level = rtgiLevel(q, u.uCamera.xyz, u.uParams), side = rtgiSide(n);
    uint top = uint(u.uParams.w);
    for (uint l = level; l <= min(level + 2u, top); ++l) {
        uint s = rtgiFind(rtgiCellHash(ivec3(floor((q - RTGI_ORIGIN) / rtgiSize(l, u.uParams))), l, side, u.uParams), u.uParams);
        if (s == 0xFFFFFFFFu) continue;
        uvec4 a = rtgiRecord[2u * s], c = rtgiRecord[2u * s + 1u];
        if (uintBitsToFloat(c.w) < 0.5) continue;
        vec2 rg = unpackHalf2x16(a.x), bs = unpackHalf2x16(a.y);
        sunVis = rtgiResolved[2u * s + 1u].x;
        return vec3(rg, bs.x);
    }
    return vec3(0.0);
}

// The sample into the point's near cell (made if not held), listed once a frame for the resolve.
void nearCellAdd(vec3 p, vec3 n, vec4 sample0, uint slot) {
    uint level = rtgiLevel(p, u.uCamera.xyz, u.uParams);
    ivec3 c = ivec3(floor((p - RTGI_ORIGIN) / (0.25 * rtgiSize(level, u.uParams))));
    uint side = rtgiSide(n);
    rtgiRegion = nearRegion(p, side);
    uvec2 h = rtgiCellHash(c, level + 24u, side, u.uParams);
    uint s = rtgiFind(h, u.uParams);
    for (uint k = 0u; s == 0xFFFFFFFFu && k < RTGI_PROBES; k++) {
        uint t = (h.x + k) & uint(u.uParams.z);
        uint prev = atomicCompSwap(rtgiKeys[t], 0u, h.y);
        if (prev == 0u) { rtgiCells[t] = ivec4(c, int(((level + 24u) * 6u + side) | (rtgiRegionFor(level + 24u) << 8))); rtgiAccum[RTGI_ACC * t + 14u] = 0u; rtgiAccum[RTGI_ACC * t + 15u] = 0u; }
        if (prev == 0u || prev == h.y) { s = t; break; }
    }
    if (s == 0xFFFFFFFFu) return;
    uint frame = uint(u.uNear2.z);
    uint seen = rtgiAccum[RTGI_ACC * s + 14u];
    bool first = (seen & 0xFFFFFFu) != (frame & 0xFFFFFFu)
        && atomicCompSwap(rtgiAccum[RTGI_ACC * s + 14u], seen, (seen & 0xFF000000u) | (frame & 0xFFFFFFu)) == seen;
    if (first) {
        uint k = atomicAdd(dirtyCount, 1u);
        if (k < uint(u.uNear2.w)) dirty[k] = s;
    }
    // Fixed point as the training's, rounded stochastically (rtgi_cache.glsl's RTGI_SCALE).
    uint hd = rtgiHash(slot * 0x9E3779B9u ^ frame * 0x85EBCA77u);
    vec3 d3 = vec3(hd & 0xFFu, (hd >> 8) & 0xFFu, (hd >> 16) & 0xFFu) / 256.0;
    vec3 e = min(max(sample0.rgb, vec3(0.0)), vec3(RTGI_MAX_SAMPLE));
    uvec3 w = uvec3(floor(e * RTGI_SCALE + d3));
    if (w.r > 0u) atomicAdd(rtgiAccum[RTGI_ACC * s + 0u], w.r);
    if (w.g > 0u) atomicAdd(rtgiAccum[RTGI_ACC * s + 1u], w.g);
    if (w.b > 0u) atomicAdd(rtgiAccum[RTGI_ACC * s + 2u], w.b);
    atomicAdd(rtgiAccum[RTGI_ACC * s + 3u], 1u);
    float l = min(dot(e, vec3(0.2126, 0.7152, 0.0722)), RTGI_LUM2_MAX);
    uint l2 = uint(l * l * RTGI_LUM2_SCALE);
    if (l2 > 0u) atomicAdd(rtgiAccum[RTGI_ACC * s + 7u], l2);
    if (sample0.w > 0.5) atomicAdd(rtgiAccum[RTGI_ACC * s + 11u], 256u);
}

void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= uint(u.uNear.z)) return;
    vec4 info = nearInfo[2u * slot];
    uint pix = floatBitsToUint(info.w);
    if (pix >= uint(u.uNear.w)) return;
    uvec4 h0 = nearHits[3u * slot];
    float dist = uintBitsToFloat(h0.x);
    vec4 sample0 = vec4(0.0, 0.0, 0.0, 1.0);   // left: the far light's share, weight 1
    if ((h0.w & 1u) != 0u && dist <= u.uNear.x) {
        sample0 = vec4(0.0);                    // met near: a back face (inside something) dark
        if ((h0.w & 2u) != 0u) {
            uvec4 h2 = nearHits[3u * slot + 2u];
            vec3 nq = vec3(uintBitsToFloat(h2.x), uintBitsToFloat(h2.y), uintBitsToFloat(h2.z));
            if (dot(nq, nq) > 1e-12) {
                vec3 o = nearRays[2u * slot].xyz, d = nearRays[2u * slot + 1u].xyz;
                nq = normalize(nq);
                if (dot(nq, d) > 0.0) nq = -nq;
                vec3 q = o + d * dist;
                // The sun at the hit: its cell's visibility (the default) -- a near ray from a dark corridor's wall onto the
                // sunlit strip on its floor brought the sun whole, one in many: those rare bright samples crawled in the dark
                // (the user, Crytek Sponza, 2026-10-29) -- or (uNear2.x) the hit's own ray.
                vec3 light = cellLight(q, nq);
                float vis = u.uNear2.x > 0.5 ? ((h0.w & 8u) != 0u ? 1.0 : 0.0) : sunVis;
                sample0 = vec4(unpackUnorm4x8(h2.w).rgb * (light + u.uSunIrradiance.rgb * max(dot(nq, u.uSun.xyz), 0.0) * vis), 0.0);
            }
        }
    }
    if (u.uNear2.y > 0.5) nearCellAdd(info.xyz, nearInfo[2u * slot + 1u].xyz, sample0, slot);
    nearSamples[3u * pix] = sample0;
    nearSamples[3u * pix + 1u] = vec4(info.xyz, u.uNear.y);
    nearSamples[3u * pix + 2u] = nearInfo[2u * slot + 1u];
}
