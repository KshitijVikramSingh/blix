#version 450

// --rtgi (S1, SponzaLoop.Rtgi.cs): this frame's training points and their rays. The first uCounts.x are visible: one per
// tile of a grid over the screen, at a pixel of its tile (a new one each frame), from the pre-pass's depth and normal.
// The rest are where last frame's training rays landed (a different share each frame), so the cells one bounce from
// the screen -- and, through those, the next -- are trained too: a path grows a vertex a frame through the cache.
// Each point gets a ray (CLOSEST: what it sees) and a sun shadow ray (none where it faces away from the sun).
//
// Guided: the ray is cosine-distributed, or -- with probability uGuide.x where the point's cell has learnt which way its
// light comes from (its irradiance vector, rtgi_resolve.comp: one-sided enough, uGuide.y samples held) -- drawn from a
// von Mises-Fisher lobe around that way, tighter the more one-sided. Its weight against cosine sampling (cos / (PI x the
// mixture's pdf), 0 below the surface) goes with the point for the training to scale its sample by: unbiased. In a room
// lit through an arch most cosine rays find the walls; the guided ones the arch (San Miguel settled over a long time).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiRays {
    mat4 uInvViewProj;   // inverse of the view-projection the pre-pass drew with
    vec4 uSize;          // xy full-res pixels; zw tiles across and down
    vec4 uCamera;        // xyz position
    vec4 uCounts;        // x visible points, y points from last frame's hits, z the frame's number, w how far a ray goes
    vec4 uSun;           // xyz toward the sun; w 1 when last frame's rays and hits are there to read
    vec4 uParams;        // rtgiParams (rtgi_cache.glsl)
    vec4 uNearField;     // x the near field's radius (RTGI_NEAR)
    vec4 uGuide;         // x the share of rays guided where a cell has learnt its light's way (0: none); y samples it must hold;
                         // z the lobe's concentration at most; w the guide table's slots - 1 (0: the lobe, no table)
    vec4 uAdapt;         // x the share of visible points placed by uncertainty (0: every tile its own); y tiles weighed for each;
                         // z the relative error a cell is done under (the blend's, rtgi_filter.comp); w 1 in this many of a
                         // done cell's points keeps its ray (the validation trickle)
    vec4 uSeq;           // x 1: a point's cosine direction from its cell's own low-discrepancy sequence (else hashed); y 1: a
                         // point that picked a done cell draws again rather than giving its ray back
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) readonly buffer RtgiPrevRays { vec4 prevRays[]; };
layout(std430, set = 0, binding = 4) readonly buffer RtgiPrevHits { uvec4 prevHits[]; };
layout(std430, set = 0, binding = 5) writeonly buffer RtgiPoints { vec4 points[]; };   // 2 a point: position and 1 (0: none); normal
layout(std430, set = 0, binding = 6) writeonly buffer RtgiRayBuffer { vec4 rays[]; };
layout(std430, set = 0, binding = 7) writeonly buffer RtgiShadowOrigins { vec4 origins[]; };
// Last frame's landings in untrained cells (rtgi_train.comp, this frame's train): the first points from hits take them.
layout(std430, set = 0, binding = 8) readonly buffer RtgiRequests { uint requestCount; uint requestPad[3]; vec4 requests[]; };
// The other parity's requests: its count zeroed here for the next frame's train.
layout(std430, set = 0, binding = 9) buffer RtgiNextRequests { uint nextRequestCount; uint nextPad[3]; vec4 nextRequests[]; };
// Per point: a deferred landing's origin, copied from its request (rtgi_train.comp reads it next frame); w 0 for the rest.
layout(std430, set = 0, binding = 17) writeonly buffer RtgiPointOrigins { vec4 pointOrigins[]; };
// Per slot: how far along its direction sequence the cell is (the next index), bumped by each point in it.
layout(std430, set = 0, binding = 18) buffer RtgiSeq { uint rtgiSeq[]; };
layout(std430, set = 0, binding = 10) readonly buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 11) readonly buffer RtgiResolved { vec4 rtgiResolved[]; };
layout(std430, set = 0, binding = 12) readonly buffer RtgiDirection { vec4 rtgiDirection[]; };
layout(std430, set = 0, binding = 13) readonly buffer RtgiMoments { vec4 rtgiMoments[]; };
layout(std430, set = 0, binding = 14) readonly buffer RtgiConfidence { vec4 rtgiConfidence[]; };
layout(std430, set = 0, binding = 15) readonly buffer GuideKeys { uint guideKeys[]; };
layout(std430, set = 0, binding = 16) readonly buffer GuideDist { vec4 guideDist[]; };

#define RTGI_KEYS(i) rtgiKeys[i]
#define RTGI_NEAR u.uNearField.x
#include "rtgi_cache.glsl"
#define GUIDE_KEYS(i) guideKeys[i]
#include "rtgi_guide.glsl"

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void none(uint i) {
    points[2u * i] = vec4(0.0);
    points[2u * i + 1u] = vec4(0.0);
    rays[2u * i] = vec4(0.0);
    rays[2u * i + 1u] = vec4(0.0, 1.0, 0.0, 0.0);
    origins[i] = vec4(0.0);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i == 0u) nextRequestCount = 0u;
    uint visible = uint(u.uCounts.x), total = visible + uint(u.uCounts.y);
    if (i >= total) return;
    pointOrigins[3u * i + 2u] = vec4(0.0);
    uint frame = uint(u.uCounts.z);
    uint h = hash(i * 0x9E3779B9u ^ hash(frame));
    vec3 p, n;
    if (i < visible) {
        uint tilesX = uint(u.uSize.z);
        vec2 tileSize = u.uSize.xy / u.uSize.zw;
        // Adaptive (uAdapt.x of the points): this point goes where the cache is least sure -- of uAdapt.y tiles (its own
        // and others drawn at random), one in proportion to its cell's uncertainty: the samples' spread over their count's
        // root, relative to the light (1 where it holds under 4). Rays spread evenly kept feeding cells settled long ago
        // while the unsettled waited their turn -- the long tail (the user, Cornell, 2026-10-26). The rest stay a tile
        // each: every place refreshed, a change seen. Which cell a sample goes to never changes what it measures.
        bool adaptive = float(rtgiHash(i ^ 0x7F4A7C15u ^ uint(u.uCounts.z) * 0x9E3779B9u) & 0xFFFFu) / 65536.0 < u.uAdapt.x;
        uint candidates = adaptive ? uint(u.uAdapt.y) : 1u;
        float wsum = 0.0;
        bool found = false, chosenDone = false;
        uint hc = h;
        // Frozen (uSeq.y): a point whose pick was a done cell, its ray not kept for the trickle, draws again from as many
        // more tiles, done cells out -- the ray spent where the light is still open, not given back.
        for (uint round = 0u; round < 2u; round++) {
            for (uint c = 0u; c < candidates; c++) {
                uint tile = (c == 0u && round == 0u) ? i : (rtgiHash(hc) % visible);
                hc = rtgiHash(hc ^ 0x2545F491u);
                vec2 jitter = vec2(hc & 0xFFFFu, hc >> 16) / 65536.0;
                ivec2 qc = min(ivec2((vec2(tile % tilesX, tile / tilesX) + jitter) * tileSize), ivec2(u.uSize.xy) - 1);
                float rawc = texelFetch(uSceneDepth, qc, 0).r;
                vec4 nsc = texelFetch(uPrepassNormal, qc, 0);
                if (rawc >= 1.0 - 1e-6 || dot(nsc.xyz, nsc.xyz) < 1e-6) continue;
                vec2 ndcc = (vec2(qc) + 0.5) / u.uSize.xy * 2.0 - 1.0;
                vec4 wc = u.uInvViewProj * vec4(ndcc, rawc, 1.0);
                vec3 pc = wc.xyz / wc.w, nc = normalize(nsc.xyz);
                // How unsure its cell is: the blend's relative error (rtgi_filter.comp), at least the done threshold; a
                // done cell an eighth of that (a new or unheld one: 1).
                float unsure = 1.0;
                bool done = false;
                if (adaptive) {
                    uint lc = rtgiLevel(pc, u.uCamera.xyz, u.uParams);
                    uint sc = rtgiFind(rtgiCellHash(ivec3(floor(pc / rtgiSize(lc, u.uParams))), lc, rtgiSide(nc), u.uParams), u.uParams);
                    if (sc != 0xFFFFFFFFu && rtgiResolved[2u * sc + 1u].y >= 4.0) {
                        vec4 conf = rtgiConfidence[sc];
                        done = conf.w > 0.5;
                        unsure = done ? 0.125 * u.uAdapt.z : clamp(conf.x, u.uAdapt.z, 1.0);
                    }
                }
                if (round == 1u && done) continue;
                wsum += unsure;
                hc = rtgiHash(hc ^ 0x68E31DA4u);
                if (float(hc & 0xFFFFFFu) / 16777216.0 * wsum < unsure) { p = pc; n = nc; found = true; chosenDone = done; }
            }
            // Every candidate done: the GPU's rays given back (or drawn again), one in uAdapt.w kept to notice what
            // changes.
            bool giveBack = chosenDone && rtgiHash(hc ^ 0x1B873593u) % uint(u.uAdapt.w) != 0u;
            if (!giveBack) break;
            if (round == 1u || u.uSeq.y < 0.5) { none(i); return; }
            wsum = 0.0;
            found = false;
            chosenDone = false;
        }
        if (!found) { none(i); return; }
    } else {
        if (u.uSun.w < 0.5) { none(i); return; }
        uint j = i - visible;
        if (j < min(requestCount, uint(u.uCounts.y))) {
            p = requests[5u * j].xyz;
            n = requests[5u * j + 1u].xyz;
            pointOrigins[3u * i] = requests[5u * j + 2u];
            pointOrigins[3u * i + 1u] = requests[5u * j + 3u];
            pointOrigins[3u * i + 2u] = requests[5u * j + 4u];
        } else {
            // A share of last frame's training rays, spread over all of them and turning each frame.
            uint k = (hash(i ^ frame * 0x632BE5ABu)) % total;
            uvec4 h0 = prevHits[3u * k];
            // A hit on a surface's front (bit 2): a back face is inside something, nothing to train.
            if ((h0.w & 3u) != 3u) { none(i); return; }
            uvec4 h2 = prevHits[3u * k + 2u];
            vec4 o = prevRays[2u * k], d = prevRays[2u * k + 1u];
            p = o.xyz + d.xyz * uintBitsToFloat(h0.x);
            n = vec3(uintBitsToFloat(h2.x), uintBitsToFloat(h2.y), uintBitsToFloat(h2.z));
            // A degenerate triangle's normal is zero: normalized, a NaN that spread through every cell reading it (2026-10-25).
            if (!(dot(n, n) > 1e-12) || any(isnan(p))) { none(i); return; }
            n = normalize(n);
            if (dot(n, d.xyz) > 0.0) n = -n;
        }
    }
    float lift = 0.01 + 0.001 * length(p - u.uCamera.xyz);
    vec3 o = p + n * lift;
    uint h2 = hash(h);
    float r1 = float(h2 & 0xFFFFu) / 65536.0, r2 = float(h2 >> 16) / 65536.0;
    // Spread (uSeq.x): the cell's own sequence -- R2, the plastic constant's Kronecker sequence, offset by the cell's hash
    // so neighbours do not line up -- each point in the cell the next index. A cell's directions cover its hemisphere
    // evenly over frames instead of clumping by chance: smooth light's error falls faster than 1 / sqrt(samples). NRD
    // assumes its input sampled so (blue noise, a sequence shorter than its history).
    if (u.uSeq.x > 0.5) {
        uint lv = rtgiLevel(p, u.uCamera.xyz, u.uParams);
        uvec2 ch = rtgiCellHash(ivec3(floor(p / rtgiSize(lv, u.uParams))), lv, rtgiSide(n), u.uParams);
        uint sc = rtgiFind(ch, u.uParams);
        if (sc != 0xFFFFFFFFu) {
            uint k = atomicAdd(rtgiSeq[sc], 1u);
            // In 0.32 fixed point, wrapping: exact however long the sequence (a float's fraction lost it past ~10^5).
            uint a = k * 3242174889u + ch.y, b = k * 2447445413u + hash(ch.y);
            r1 = float(a >> 8) / 16777216.0;
            r2 = float(b >> 8) / 16777216.0;
        }
    }
    float phi = 6.28318530718 * r1, s = sqrt(r2);
    vec3 t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
    vec3 b = cross(n, t);
    vec3 d = normalize(t * (cos(phi) * s) + b * (sin(phi) * s) + n * sqrt(max(0.0, 1.0 - r2)));
    // The guide: the learnt distribution of the point's guide cell (rtgi_guide.glsl: 32 bins by the light through them),
    // where it holds uGuide.y samples -- a bin drawn by its light, a direction uniformly within it, with probability
    // uGuide.x, else cosine. A single lobe about the cell's mean light direction aimed between a room's openings and its
    // sunlit floor, never at either (Cornell's noise 1.50% against 1.57% unguided, 2026-10-26).
    float pg = 0.0;
    uint gslot = 0xFFFFFFFFu, gside = rtgiSide(n);
    float gsum = 0.0;
    if (u.uGuide.x > 0.0 && u.uGuide.w > 0.0) {
        uint gl = min(rtgiLevel(p, u.uCamera.xyz, u.uParams) + 2u, uint(u.uParams.w));
        gslot = guideFind(guideHash(ivec3(floor(p / rtgiSize(gl, u.uParams))), gl, gside, uint(u.uGuide.w)), uint(u.uGuide.w));
        if (gslot != 0xFFFFFFFFu) {
            vec4 meta = guideDist[9u * gslot + 8u];
            gsum = meta.y;
            if (meta.x >= u.uGuide.y && gsum > 1e-7) pg = u.uGuide.x;
        }
    }
    uint h3 = hash(h2 ^ 0xA511E9B3u);
    if (pg > 0.0 && float(h3 & 0xFFFFu) / 65536.0 < pg) {
        // A bin by its light, then a direction uniform within it.
        float pick = float(hash(h3) & 0xFFFFFFu) / 16777216.0 * gsum;
        uint k = GUIDE_BINS - 1u;
        float acc = 0.0;
        for (uint v = 0u; v < 8u; v++) {
            vec4 bins = guideDist[9u * gslot + v];
            for (uint c = 0u; c < 4u; c++) {
                acc += bins[c];
                if (pick < acc) { k = 4u * v + c; v = 8u; break; }
            }
        }
        uint h4 = hash(h3 ^ 0x68E31DA4u);
        d = guideSample(k, gside, float(h4 & 0xFFFFu) / 65536.0, float(h4 >> 16) / 65536.0);
    }
    float cosd = dot(d, n);
    float weight = 1.0;
    if (pg > 0.0) {
        float pdfCos = max(cosd, 0.0) / 3.14159265359;
        int bin = guideBin(d, gside);
        float pdfGuide = 0.0;
        if (bin >= 0) pdfGuide = guideDist[9u * gslot + uint(bin) / 4u][uint(bin) % 4u] / gsum / GUIDE_BIN_SOLID_ANGLE;
        float pdf = (1.0 - pg) * pdfCos + pg * pdfGuide;
        weight = cosd > 0.0 && pdf > 0.0 ? pdfCos / pdf : 0.0;
    }
    points[2u * i] = vec4(p, 1.0);
    points[2u * i + 1u] = vec4(n, weight);
    rays[2u * i] = vec4(o, 0.0);
    rays[2u * i + 1u] = vec4(d, u.uCounts.w);
    origins[i] = vec4(o, dot(n, u.uSun.xyz) > 0.0 ? u.uCounts.w : 0.0);
}
