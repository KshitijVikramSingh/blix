#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

// --rtgi (S1, SponzaLoop.Rtgi.cs): this frame's training points and their rays. The first uCounts.x are visible: one per
// tile of a grid over the screen, at a pixel of its tile (a new one each frame), from the pre-pass's depth and normal.
// The rest are where last frame's training rays landed (a different share each frame), so the cells one bounce from
// the screen -- and, through those, the next -- are trained too: a path grows a vertex a frame through the cache.
// Each point gets a ray (CLOSEST: what it sees) and a sun shadow ray (none where it faces away from the sun).
//
// Guided: the ray is cosine-distributed, or -- with probability uGuide.x where the point's cell has learnt which way its
// light comes from (its irradiance vector, rtgi_resolve.comp: one-sided enough, uGuide.y samples held) -- drawn from a
// von Mises-Fisher lobe around that way, tighter the more one-sided. Its weight against cosine sampling (cos / (PI x the
// mixture's pdf), 0 below the surface) goes with the point for the training to scale its sample by: unbiased. In a room
// lit through an arch most cosine rays find the walls; the guided ones the arch (San Miguel settled over a long time).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform RtgiRays {
    mat4 uInvViewProj;   // inverse of the view-projection the pre-pass drew with
    vec4 uSize;          // xy full-res pixels; zw tiles across and down
    vec4 uCamera;        // xyz position
    vec4 uCounts;        // x visible points, y points from last frame's hits, z the frame's number, w how far a ray goes
    vec4 uSun;           // xyz toward the sun; w 1 when last frame's rays and hits are there to read
    vec4 uParams;        // rtgiParams (rtgi_cache.glsl)
    vec4 uNearField;     // x the near field's radius (RTGI_NEAR)
    vec4 uGuide;         // x the share of rays guided where a cell has learnt its light's way (0: none); y samples it must hold;
                         // z the lobe's concentration at most; w the guide table's slots - 1 (0: the lobe, no table)
    vec4 uAdapt;         // x the share of visible points placed by uncertainty (0: every tile its own); y tiles weighed for each;
                         // z the relative error a cell is done under (the blend's, rtgi_filter.comp); w 1 in this many of a
                         // done cell's points keeps its ray (the validation trickle)
    vec4 uBlock;         // x 1: placement in blocks (a subgroup's 32 points own an 8 x 4 block of tiles, their candidates
                         // within uBlock.z tiles but for a uBlock.y share drawn anywhere; hit points in strides); y the
                         // global share; z the window (tiles)
    vec4 uUnsureMap;     // x the uncertainty map's row (half-res pixels); y 1: written last frame (else depth asked); z its size
    vec4 uSkip;          // x measurement bits (the bench, SponzaLoop.RtgiBench.cs; each changes the points): 1 no adaptive
                         // candidates (the own tile only), 2 no cell lookup (no sun skip, no sequence), 4 no guide, 8 no hit
                         // points, 16 each candidate read by its own lane (no pool; also --rtgi-no-pool), 64 no settled
                         // sun (every point traces its sun)
    vec4 uBudget;        // x the relative error a visible point is spent toward (0: every point kept); y the share kept at least;
                         // z the samples past which a visible point's cell is settled (0: off); w the share of its points kept
    vec4 uSeq;           // x 1: a point's cosine direction from its cell's own low-discrepancy sequence (else hashed); y 1: a
                         // point that picked a done cell draws again rather than giving its ray back; z 1: a settled cell's points
                         // trace the sun 1 in 8
} u;

layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 2) uniform sampler2D uPrepassNormal;
layout(std430, set = 0, binding = 3) readonly buffer RtgiPrevRays { vec4 prevRays[]; };
layout(std430, set = 0, binding = 4) readonly buffer RtgiPrevHits { uvec4 prevHits[]; };
layout(std430, set = 0, binding = 5) writeonly buffer RtgiPoints { vec4 points[]; };   // 2 a point: position and 1 (0: none); normal
layout(std430, set = 0, binding = 6) writeonly buffer RtgiRayBuffer { vec4 rays[]; };
layout(std430, set = 0, binding = 7) writeonly buffer RtgiShadowOrigins { vec4 origins[]; };
// Last frame's landings in untrained cells (rtgi_train.comp, this frame's train): the first points from hits take them.
layout(std430, set = 0, binding = 8) readonly buffer RtgiRequests { uint requestCount; uint requestPad[3]; vec4 requests[]; };
// The other parity's requests: its count zeroed here for the next frame's train.
layout(std430, set = 0, binding = 9) buffer RtgiNextRequests { uint nextRequestCount; uint nextPad[3]; vec4 nextRequests[]; };
// Per point: a deferred landing's origin, copied from its request (rtgi_train.comp reads it next frame); w 0 for the rest.
layout(std430, set = 0, binding = 17) writeonly buffer RtgiPointOrigins { vec4 pointOrigins[]; };
// Per slot: how far along its direction sequence the cell is (the next index), bumped by each point in it.
layout(std430, set = 0, binding = 18) buffer RtgiSeq { uint rtgiSeq[]; };
// Per half-res pixel, how unsure its cell is (rtgi_readout.frag, last frame).
layout(std430, set = 0, binding = 19) readonly buffer RtgiUnsure { float rtgiUnsure[]; };
layout(std430, set = 0, binding = 10) readonly buffer RtgiKeys { uint rtgiKeys[]; };
layout(std430, set = 0, binding = 11) readonly buffer RtgiResolved { vec4 rtgiResolved[]; };
layout(std430, set = 0, binding = 12) readonly buffer RtgiDirection { vec4 rtgiDirection[]; };
layout(std430, set = 0, binding = 13) readonly buffer RtgiMoments { vec4 rtgiMoments[]; };
layout(std430, set = 0, binding = 14) readonly buffer RtgiConfidence { vec4 rtgiConfidence[]; };
layout(std430, set = 0, binding = 15) readonly buffer GuideKeys { uint guideKeys[]; };
layout(std430, set = 0, binding = 16) readonly buffer GuideDist { vec4 guideDist[]; };

#define RTGI_KEYS(i) rtgiKeys[i]
#define RTGI_NEAR u.uNearField.x
#include "rtgi_cache.glsl"
#define GUIDE_KEYS(i) guideKeys[i]
#include "rtgi_guide.glsl"

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void none(uint i) {
    points[2u * i] = vec4(0.0);
    points[2u * i + 1u] = vec4(0.0);
    rays[2u * i] = vec4(0.0);
    rays[2u * i + 1u] = vec4(0.0, 1.0, 0.0, 0.0);
    origins[i] = vec4(0.0);
}

// Point i's own tile in its subgroup's 8 x 4 block (uBlock.x); false past the grid.
bool blockTile(uint i, uint tilesX, uint tilesY, out uint own) {
    uint blocksX = (tilesX + 7u) / 8u, b = i / 32u, w = i % 32u;
    uint tx = (b % blocksX) * 8u + w % 8u, ty = (b / blocksX) * 4u + w / 8u;
    own = ty * tilesX + tx;
    return tx < tilesX && ty < tilesY;
}

// A candidate's tile other than the point's own: within uBlock.z tiles of it, but for a uBlock.y share anywhere.
uint drawTile(uint hc, uint own, uint tilesX, uint tilesY, uint visible) {
    uint hl = rtgiHash(hc ^ 0x3C6EF372u);
    if (u.uBlock.x > 0.5 && float(hl & 0xFFFFu) / 65536.0 >= u.uBlock.y) {
        int win = int(u.uBlock.z);
        int tx = clamp(int(own % tilesX) + int((hl >> 16) % uint(2 * win + 1)) - win, 0, int(tilesX) - 1);
        int ty = clamp(int(own / tilesX) + int(rtgiHash(hl) % uint(2 * win + 1)) - win, 0, int(tilesY) - 1);
        return uint(ty) * tilesX + uint(tx);
    }
    return rtgiHash(hc) % visible;
}

// A pixel of the tile, jittered.
ivec2 tilePixel(uint tile, uint hc, uint tilesX, vec2 tileSize) {
    vec2 jitter = vec2(hc & 0xFFFFu, hc >> 16) / 65536.0;
    return min(ivec2((vec2(tile % tilesX, tile / tilesX) + jitter) * tileSize), ivec2(u.uSize.xy) - 1);
}

// The subgroup's pool (uBlock.x, the map written, not uSkip 16): each lane reads one candidate besides its own tile, and
// a point weighs the others' -- drawn as its own were, about a tile of the same 8 x 4 block -- by shuffle. Each point read
// its uAdapt.y candidates and as many again on a redraw, scattered over the map: placement 1.78 ms a dispatch, 0.62 of it
// the candidates (Crytek Sponza 1080p, the bench, 2026-10-28).
#define POOL 8u
uint poolQ[POOL];
float poolU[POOL];

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i == 0u) nextRequestCount = 0u;
    uint visible = uint(u.uCounts.x), total = visible + uint(u.uCounts.y);
    bool pooled = u.uBlock.x > 0.5 && u.uUnsureMap.y > 0.5 && u.uAdapt.x > 0.0 && (uint(u.uSkip.x) & 16u) == 0u;
    if (pooled) {
        // Every lane here (none returned yet): a lane with no candidate offers the sky's -1.
        uint tilesX = uint(u.uSize.z), tilesY = uint(u.uSize.w), own;
        uint hp = hash(i * 0x2C1B3C6Du ^ hash(uint(u.uCounts.z) ^ 0x297A2D39u));
        float mine = -1.0;
        ivec2 qc = ivec2(0);
        if (i < visible && blockTile(i, tilesX, tilesY, own)) {
            qc = tilePixel(drawTile(hp, own, tilesX, tilesY, visible), rtgiHash(hp ^ 0x2545F491u), tilesX, u.uSize.xy / u.uSize.zw);
            uint at = uint(qc.y / 2) * uint(u.uUnsureMap.x) + uint(qc.x / 2);
            if (qc.x / 2 < int(u.uUnsureMap.x) && at < uint(u.uUnsureMap.z)) mine = rtgiUnsure[at];
        }
        uint myQ = uint(qc.x) | (uint(qc.y) << 16);
        for (uint e = 0u; e < POOL; e++) {
            uint from = rtgiHash(hp ^ (e + 1u) * 0x9E3779B9u) % gl_SubgroupSize;
            poolQ[e] = subgroupShuffle(myQ, from);
            poolU[e] = subgroupShuffle(mine, from);
        }
    }
    if (i >= total) return;
    pointOrigins[3u * i + 2u] = vec4(0.0);
    uint frame = uint(u.uCounts.z);
    uint h = hash(i * 0x9E3779B9u ^ hash(frame));
    vec3 p, n;
    bool requestPoint = false;
    if (i < visible) {
        uint tilesX = uint(u.uSize.z), tilesY = uint(u.uSize.w);
        vec2 tileSize = u.uSize.xy / u.uSize.zw;
        // In blocks (uBlock.x): point i's own tile in its subgroup's 8 x 4 block, and its candidates near it -- so the
        // subgroup's points land in the same coarse cells (rtgi_train.comp sums their words before writing), their hash
        // lookups in the same memory, their rays from nearby origins. Row by row, a subgroup's 32 points were a strip,
        // their candidates anywhere on the screen: 32 different cells.
        uint own = i;
        if (u.uBlock.x > 0.5 && !blockTile(i, tilesX, tilesY, own)) { none(i); return; }
        // Adaptive (uAdapt.x of the points): this point goes where the cache is least sure -- of uAdapt.y tiles (its own
        // and others drawn at random), one in proportion to its cell's uncertainty: the samples' spread over their count's
        // root, relative to the light (1 where it holds under 4). Rays spread evenly kept feeding cells settled long ago
        // while the unsettled waited their turn -- the long tail (the user, Cornell, 2026-10-26). The rest stay a tile
        // each: every place refreshed, a change seen. Which cell a sample goes to never changes what it measures.
        bool adaptive = (uint(u.uSkip.x) & 1u) == 0u && float(rtgiHash(i ^ 0x7F4A7C15u ^ uint(u.uCounts.z) * 0x9E3779B9u) & 0xFFFFu) / 65536.0 < u.uAdapt.x;
        uint candidates = adaptive ? uint(u.uAdapt.y) : 1u;
        float wsum = 0.0;
        bool found = false, chosenDone = false;
        ivec2 pick = ivec2(0);
        uint hc = h;
        // Frozen (uSeq.y): a point whose pick was a done cell, its ray not kept for the trickle, draws again from as many
        // more tiles, done cells out -- the ray spent where the light is still open, not given back.
        for (uint round = 0u; round < 2u; round++) {
            for (uint c = 0u; c < candidates; c++) {
                // The pool's: every candidate but the first round's own tile.
                uint e = round == 0u ? c - 1u : candidates - 1u + c;
                if (pooled && adaptive && (c != 0u || round != 0u) && e < POOL) {
                    if (poolU[e] < 0.0) continue;
                    float unsure = poolU[e];
                    bool done = unsure < 0.5 * u.uAdapt.z;
                    if (round == 1u && done) continue;
                    wsum += unsure;
                    hc = rtgiHash(hc ^ 0x68E31DA4u);
                    if (float(hc & 0xFFFFFFu) / 16777216.0 * wsum < unsure) {
                        pick = ivec2(poolQ[e] & 0xFFFFu, poolQ[e] >> 16); found = true; chosenDone = done;
                    }
                    continue;
                }
                uint tile = own;
                if (c != 0u || round != 0u) tile = drawTile(hc, own, tilesX, tilesY, visible);
                hc = rtgiHash(hc ^ 0x2545F491u);
                // How unsure its cell is: last frame's readout's map (rtgi_readout.frag) at its half-res pixel -- the
                // blend's relative error, at least the done threshold; a done cell an eighth of that; the sky -1. Read
                // for a texel's price, where each candidate found its cell in the hash itself (5.8 ms a frame at 4x the
                // rays, Crytek Sponza). Not adaptive, or off the map: 1, its depth asked.
                ivec2 qc = tilePixel(tile, hc, tilesX, tileSize);
                float unsure = 1.0;
                bool done = false;
                uint at = uint(qc.y / 2) * uint(u.uUnsureMap.x) + uint(qc.x / 2);
                if (adaptive && u.uUnsureMap.y > 0.5 && qc.x / 2 < int(u.uUnsureMap.x) && at < uint(u.uUnsureMap.z)) {
                    unsure = rtgiUnsure[at];
                    if (unsure < 0.0) continue;
                    done = unsure < 0.5 * u.uAdapt.z;
                } else {
                    float rawc = texelFetch(uSceneDepth, qc, 0).r;
                    vec4 nsc = texelFetch(uPrepassNormal, qc, 0);
                    if (rawc >= 1.0 - 1e-6 || dot(nsc.xyz, nsc.xyz) < 1e-6) continue;
                }
                if (round == 1u && done) continue;
                wsum += unsure;
                hc = rtgiHash(hc ^ 0x68E31DA4u);
                if (float(hc & 0xFFFFFFu) / 16777216.0 * wsum < unsure) { pick = qc; found = true; chosenDone = done; }
            }
            // Every candidate done: the GPU's rays given back (or drawn again), one in uAdapt.w kept to notice what
            // changes.
            bool giveBack = chosenDone && rtgiHash(hc ^ 0x1B873593u) % uint(u.uAdapt.w) != 0u;
            if (!giveBack) break;
            if (round == 1u || u.uSeq.y < 0.5) { none(i); return; }
            wsum = 0.0;
            found = false;
            chosenDone = false;
        }
        if (!found) { none(i); return; }
        // Spent by what it buys (uBudget.x): kept with probability (its pixel's relative error over the target)^2, at least
        // uBudget.y -- each halving of a cell's error costs 4x the samples, so where the light is already within the
        // target a ray buys little. Settled, a still Crytek Sponza view's visible light sat at 3-10% (22% of it under
        // 3% after 50 s, 2026-10-27) and every point traced, trained and placed at ~20 ns each: 9 ms a frame at 4x the
        // rays. Where the view opens up, a disocclusion, a sun turn, the error is high and every point kept.
        if (u.uBudget.x > 0.0 && u.uUnsureMap.y > 0.5) {
            uint at = uint(pick.y / 2) * uint(u.uUnsureMap.x) + uint(pick.x / 2);
            if (pick.x / 2 < int(u.uUnsureMap.x) && at < uint(u.uUnsureMap.z)) {
                float rel = rtgiUnsure[at];
                float keep = rel < 0.0 ? 1.0 : clamp((rel / u.uBudget.x) * (rel / u.uBudget.x), u.uBudget.y, 1.0);
                if (float(rtgiHash(hc ^ 0x5BD1E995u) & 0xFFFFu) / 65536.0 >= keep) { none(i); return; }
            }
        }
        // The chosen candidate's point and normal (a map's read may name a pixel whose depth turned to sky).
        float rawp = texelFetch(uSceneDepth, pick, 0).r;
        vec4 nsp = texelFetch(uPrepassNormal, pick, 0);
        if (rawp >= 1.0 - 1e-6 || dot(nsp.xyz, nsp.xyz) < 1e-6) { none(i); return; }
        vec2 ndcp = (vec2(pick) + 0.5) / u.uSize.xy * 2.0 - 1.0;
        vec4 wp = u.uInvViewProj * vec4(ndcp, rawp, 1.0);
        p = wp.xyz / wp.w;
        n = normalize(nsp.xyz);
    } else {
        if (u.uSun.w < 0.5) { none(i); return; }
        uint j = i - visible;
        if (j < min(requestCount, uint(u.uCounts.y))) {
            requestPoint = true;
            p = requests[5u * j].xyz;
            n = requests[5u * j + 1u].xyz;
            pointOrigins[3u * i] = requests[5u * j + 2u];
            pointOrigins[3u * i + 1u] = requests[5u * j + 3u];
            pointOrigins[3u * i + 2u] = requests[5u * j + 4u];
        } else {
            if ((uint(u.uSkip.x) & 8u) != 0u) { none(i); return; }
            // A share of last frame's training rays, spread over all of them and turning each frame.
            // In blocks, in strides from a turning offset: neighbouring points take neighbouring rays (theirs came from one
            // block), so stay together.
            uint k = (hash(i ^ frame * 0x632BE5ABu)) % total;
            if (u.uBlock.x > 0.5) {
                uint stride = max(1u, total / max(uint(u.uCounts.y), 1u));
                k = (j * stride + hash(frame ^ 0x632BE5ABu) % stride) % total;
            }
            uvec4 h0 = prevHits[3u * k];
            // A hit on a surface's front (bit 2): a back face is inside something, nothing to train.
            if ((h0.w & 3u) != 3u) { none(i); return; }
            uvec4 h2 = prevHits[3u * k + 2u];
            vec4 o = prevRays[2u * k], d = prevRays[2u * k + 1u];
            p = o.xyz + d.xyz * uintBitsToFloat(h0.x);
            n = vec3(uintBitsToFloat(h2.x), uintBitsToFloat(h2.y), uintBitsToFloat(h2.z));
            // A degenerate triangle's normal is zero: normalized, a NaN that spread through every cell reading it (2026-10-25).
            if (!(dot(n, n) > 1e-12) || any(isnan(p))) { none(i); return; }
            n = normalize(n);
            if (dot(n, d.xyz) > 0.0) n = -n;
        }
    }
    float lift = 0.01 + 0.001 * length(p - u.uCamera.xyz);
    vec3 o = p + n * lift;
    uint h2 = hash(h);
    float r1 = float(h2 & 0xFFFFu) / 65536.0, r2 = float(h2 >> 16) / 65536.0;
    // Spread (uSeq.x): the cell's own sequence -- R2, the plastic constant's Kronecker sequence, offset by the cell's hash
    // so neighbours do not line up -- each point in the cell the next index. A cell's directions cover its hemisphere
    // evenly over frames instead of clumping by chance: smooth light's error falls faster than 1 / sqrt(samples). NRD
    // assumes its input sampled so (blue noise, a sequence shorter than its history).
    // The point's own cell: its direction sequence (below) and whether its sun is settled (uSeq.z).
    uvec2 ch = uvec2(0u);
    uint sc = 0xFFFFFFFFu;
    if ((u.uSeq.x > 0.5 || u.uSeq.z > 0.5) && (uint(u.uSkip.x) & 2u) == 0u) {
        uint lv = rtgiLevel(p, u.uCamera.xyz, u.uParams);
        ch = rtgiCellHash(ivec3(floor(p / rtgiSize(lv, u.uParams))), lv, rtgiSide(n), u.uParams);
        sc = rtgiFind(ch, u.uParams);
    }
    // The cell's sequence index (uSeq.x, below), its counter's old value: the top bit its sun settled (rtgi_resolve.comp
    // keeps it), the rest the next index.
    uint seq = 0xFFFFFFFFu;
    if (u.uSeq.x > 0.5 && sc != 0xFFFFFFFFu) seq = atomicAdd(rtgiSeq[sc], 1u);
    // Settled sun (uSeq.z): a cell whose sun visibility is known within 0.02 (binomial, from 64 rays at least) gets 1 sun
    // ray in 8 -- the rest told so (points' w 2: rtgi_train.comp adds no sun word). Every training point traced its sun:
    // the shadow traces 9.3 -> 13.7 ms a frame from 1x to 4x the rays (Crytek Sponza, 2026-10-26), on cells long since
    // known lit or shadowed. A sun turn cuts a cell's sun history to 4 rays (rtgi_resolve.comp), and it traces again. A
    // request's point (a deferred landing's light needs its sun) always traces. Settled from the sequence's counter, read
    // by its atomic anyway: the cell's record read for it was 0.18 of placement's 1.63 ms a dispatch (Crytek Sponza 1080p,
    // the bench, 2026-10-28).
    bool skipSun = false;
    if (u.uSeq.z > 0.5 && sc != 0xFFFFFFFFu && !requestPoint && (uint(u.uSkip.x) & 64u) == 0u) {
        bool settled;
        if (seq != 0xFFFFFFFFu) settled = (seq >> 31) != 0u;
        else {
            vec4 rc = rtgiResolved[2u * sc + 1u];
            settled = rtgiSunSettled(rc.x, rc.w);
        }
        skipSun = settled && hash(h ^ 0x51ED27A3u) % 8u != 0u;
    }
    // Settled (uBudget.z): a visible point whose cell holds uBudget.z samples kept 1 in 1 / uBudget.w -- its light long
    // since converged on its own (and its neighbours' and parents'), more samples moving it by a fraction of its noise
    // while the screen's young cells wait; the rays it gives back are the hit points' too (drawn from this frame's rays).
    if (u.uBudget.z > 0.0 && sc != 0xFFFFFFFFu && !requestPoint && i < visible
        && rtgiResolved[2u * sc + 1u].y >= u.uBudget.z && float(hash(h ^ 0x2F0B3C1Du) & 0xFFFFu) / 65536.0 >= u.uBudget.w) {
        none(i);
        return;
    }
    if (seq != 0xFFFFFFFFu) {
        // In 0.32 fixed point, wrapping: exact however long the sequence (a float's fraction lost it past ~10^5).
        uint k = seq & 0x7FFFFFFFu;
        uint a = k * 3242174889u + ch.y, b = k * 2447445413u + hash(ch.y);
        r1 = float(a >> 8) / 16777216.0;
        r2 = float(b >> 8) / 16777216.0;
    }
    float phi = 6.28318530718 * r1, s = sqrt(r2);
    vec3 t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
    vec3 b = cross(n, t);
    vec3 d = normalize(t * (cos(phi) * s) + b * (sin(phi) * s) + n * sqrt(max(0.0, 1.0 - r2)));
    // The guide: the learnt distribution of the point's guide cell (rtgi_guide.glsl: 32 bins by the light through them),
    // where it holds uGuide.y samples -- a bin drawn by its light, a direction uniformly within it, with probability
    // uGuide.x, else cosine. A single lobe about the cell's mean light direction aimed between a room's openings and its
    // sunlit floor, never at either (Cornell's noise 1.50% against 1.57% unguided, 2026-10-26).
    float pg = 0.0;
    uint gslot = 0xFFFFFFFFu, gside = rtgiSide(n);
    float gsum = 0.0;
    if (u.uGuide.x > 0.0 && u.uGuide.w > 0.0 && (uint(u.uSkip.x) & 4u) == 0u) {
        uint gl = min(rtgiLevel(p, u.uCamera.xyz, u.uParams) + 2u, uint(u.uParams.w));
        gslot = guideFind(guideHash(ivec3(floor(p / rtgiSize(gl, u.uParams))), gl, gside, uint(u.uGuide.w)), uint(u.uGuide.w));
        if (gslot != 0xFFFFFFFFu) {
            vec4 meta = guideDist[9u * gslot + 8u];
            gsum = meta.y;
            if (meta.x >= u.uGuide.y && gsum > 1e-7) pg = u.uGuide.x;
        }
    }
    uint h3 = hash(h2 ^ 0xA511E9B3u);
    if (pg > 0.0 && float(h3 & 0xFFFFu) / 65536.0 < pg) {
        // A bin by its light, then a direction uniform within it.
        float pick = float(hash(h3) & 0xFFFFFFu) / 16777216.0 * gsum;
        uint k = GUIDE_BINS - 1u;
        float acc = 0.0;
        for (uint v = 0u; v < 8u; v++) {
            vec4 bins = guideDist[9u * gslot + v];
            for (uint c = 0u; c < 4u; c++) {
                acc += bins[c];
                if (pick < acc) { k = 4u * v + c; v = 8u; break; }
            }
        }
        uint h4 = hash(h3 ^ 0x68E31DA4u);
        d = guideSample(k, gside, float(h4 & 0xFFFFu) / 65536.0, float(h4 >> 16) / 65536.0);
    }
    float cosd = dot(d, n);
    float weight = 1.0;
    if (pg > 0.0) {
        float pdfCos = max(cosd, 0.0) / 3.14159265359;
        int bin = guideBin(d, gside);
        float pdfGuide = 0.0;
        if (bin >= 0) pdfGuide = guideDist[9u * gslot + uint(bin) / 4u][uint(bin) % 4u] / gsum / GUIDE_BIN_SOLID_ANGLE;
        float pdf = (1.0 - pg) * pdfCos + pg * pdfGuide;
        weight = cosd > 0.0 && pdf > 0.0 ? pdfCos / pdf : 0.0;
    }
    points[2u * i] = vec4(p, skipSun ? 2.0 : 1.0);
    points[2u * i + 1u] = vec4(n, weight);
    rays[2u * i] = vec4(o, 0.0);
    rays[2u * i + 1u] = vec4(d, u.uCounts.w);
    origins[i] = vec4(o, dot(n, u.uSun.xyz) > 0.0 && !skipSun ? u.uCounts.w : 0.0);
}
