<Project Sdk="Microsoft.NET.Sdk">

  <!-- Heavy-scene rendering and measurement application. It deliberately owns
       the current Sponza graph, scene-specific draw policy, A/B modes, and
       research tuning; reusable mechanisms graduate to engine projects only
       after their contract and another consumer are clear. See docs/renderer.md. -->

  <ItemGroup>
    <ProjectReference Include="..\..\Blix\Blix.csproj" />
    <ProjectReference Include="..\..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\..\Blix.Geometry\Blix.Geometry.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics.Images\Blix.Graphics.Images.csproj" />
    <!-- The ray check and bench on Apple's ray tracing hardware, ray-backend hw or both (SponzaLoop.HardwareRays). -->
    <ProjectReference Include="..\..\Blix.Graphics.MetalHWX\Blix.Graphics.MetalHWX.csproj" />
    <ProjectReference Include="..\..\Blix.Render\Blix.Render.csproj" />
    <ProjectReference Include="..\..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
    <ProjectReference Include="..\..\Blix.Tools.Shader\Blix.Tools.Shader.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Not the server collector: a heap a core held more memory than this 16 GB machine could spare beside Sponza's
         split cook (2026-10-13), for a few seconds' gain in the cook. -->
    <!-- Reflects its binding model out of the SPIR-V; the shared targets do both. -->
    <BlixShaderReflect>true</BlixShaderReflect>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Demos.VulkanSponza</RootNamespace>
  </PropertyGroup>

  <!-- Tool lookup mirrors the other shader-bearing applications. Shared GLSL
       includes are resolved by the repository shader build target. -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
    <!-- spirv-cross is located the same way as glslc (both ship in the Vulkan
         SDK / Homebrew). It emits a per-shader reflection sidecar the runtime
         loads instead of hand-authored binding tables; see the Shaders section
         of docs/renderer.md. Install with: brew install spirv-cross. -->
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/opt/homebrew/bin/spirv-cross')">/opt/homebrew/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/usr/local/bin/spirv-cross')">/usr/local/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == ''">spirv-cross</SpirvCross>
  </PropertyGroup>

