<Project Sdk="Microsoft.NET.Sdk">

  <!-- Heavy-scene rendering and measurement application. It deliberately owns
       the current Sponza graph, scene-specific draw policy, A/B modes, and
       research tuning; reusable mechanisms graduate to engine projects only
       after their contract and another consumer are clear. See docs/renderer.md. -->

  <ItemGroup>
    <ProjectReference Include="..\..\Blix\Blix.csproj" />
    <ProjectReference Include="..\..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\..\Blix.Geometry\Blix.Geometry.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics.Images\Blix.Graphics.Images.csproj" />
    <ProjectReference Include="..\..\Blix.Render\Blix.Render.csproj" />
    <ProjectReference Include="..\..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
    <ProjectReference Include="..\..\Blix.Tools.Shader\Blix.Tools.Shader.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Reflects its binding model out of the SPIR-V; the shared targets do both. -->
    <BlixShaderReflect>true</BlixShaderReflect>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Demos.VulkanSponza</RootNamespace>
  </PropertyGroup>

  <!-- Tool lookup mirrors the other shader-bearing applications. Shared GLSL
       includes are resolved by the repository shader build target. -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
    <!-- spirv-cross is located the same way as glslc (both ship in the Vulkan
         SDK / Homebrew). It emits a per-shader reflection sidecar the runtime
         loads instead of hand-authored binding tables; see the Shaders section
         of docs/renderer.md. Install with: brew install spirv-cross. -->
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/opt/homebrew/bin/spirv-cross')">/opt/homebrew/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/usr/local/bin/spirv-cross')">/usr/local/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == ''">spirv-cross</SpirvCross>
  </PropertyGroup>

  <ItemGroup>
    <GlslShader Include="Shaders\taa.frag" />
    <GlslShader Include="Shaders\lit.vert" />
    <GlslShader Include="Shaders\lit.frag" />
    <GlslShader Include="Shaders\shadow.vert" />
    <GlslShader Include="Shaders\shadow.frag" />
    <GlslShader Include="Shaders\shadow_mask.vert" />
    <GlslShader Include="Shaders\shadow_mask.frag" />
    <GlslShader Include="Shaders\depth_prepass.frag" />
    <GlslShader Include="Shaders\flat.frag" />
    <GlslShader Include="Shaders\depth_prepass_mask.frag" />
    <GlslShader Include="Shaders\skybox.vert" />
    <GlslShader Include="Shaders\skybox.frag" />
    <GlslShader Include="Shaders\probe_debug.vert" />
    <GlslShader Include="Shaders\probe_debug.frag" />
    <GlslShader Include="Shaders\probe_usage.comp" />
    <GlslShader Include="Shaders\scene_cull.comp" />
    <GlslShader Include="Shaders\scene_occlusion.comp" />
    <GlslShader Include="Shaders\ray_check.comp" />
    <GlslShader Include="Shaders\present.vert" />
    <GlslShader Include="Shaders\incident.frag" />
    <GlslShader Include="Shaders\incident_resolve.frag" />
    <GlslShader Include="Shaders\present.frag" />
    <GlslShader Include="Shaders\hiz_build.frag" />
    <GlslShader Include="Shaders\gtao.frag" />
    <GlslShader Include="Shaders\gtao_denoise.frag" />
    <GlslShader Include="Shaders\froxel.comp" />
    <GlslShader Include="Shaders\sky_inject.comp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared GLSL library (src/Blix.Shaders), resolved by the shared shader
         build target. Listed so edits retrigger compilation. -->
    <!-- Every .glsl these shaders can reach, globbed rather than listed.
         A missing entry here is a shader that does not rebuild. Only fullscreen.glsl was listed,
         while lit.frag alone includes shadow, sheen, probe_volume and sky_visibility, so editing
         any of those left the .spv and its //@tune sidecar stale, with a clean build and no
         warning. Found the hard way: changing a tunable's default in frame.glsl and watching the
         overlay come up with the old value.
         Globbing can only over-invalidate, which costs a rebuild. Listing can under-invalidate,
         which costs a wrong picture you have no reason to distrust. -->
    <GlslInclude Include="..\..\Blix.Shaders\*.glsl" />
    <GlslInclude Include="Shaders\**\*.glsl" />
  </ItemGroup>


</Project>
