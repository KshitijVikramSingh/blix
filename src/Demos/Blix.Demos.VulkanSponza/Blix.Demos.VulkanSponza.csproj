<Project Sdk="Microsoft.NET.Sdk">

  <!-- Step 7 of the Vulkan reshape (see docs/vulkan-reshape-shaderlab-target.md):
       the Khronos Intel Sponza port to the new engine surface (Vector A
       binding model + Vector B render graph). VulkanLit ships the shape
       diversity story (many distinct shaders); VulkanSponza ships the
       volume story (many materials, double-sided foliage, alpha-test
       cutouts).

       Scaffold scope: window + 2-pass graph (scene HDR -> present) +
       glTF load. PBR/IBL/cascade-shadows/post-process land in follow-up
       pushes; the existing OpenGL Blix.Demos.SponzaModern is the
       reference for "what eventually goes here." -->

  <ItemGroup>
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\..\Blix.Geometry\Blix.Geometry.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics.Images\Blix.Graphics.Images.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\..\Blix.Render\Blix.Render.csproj" />
    <ProjectReference Include="..\..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
    <ProjectReference Include="..\..\Blix.Tools.Shader\Blix.Tools.Shader.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Reflects its binding model out of the SPIR-V; the shared targets do both. -->
    <BlixShaderReflect>true</BlixShaderReflect>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Demos.VulkanSponza</RootNamespace>
  </PropertyGroup>

  <!-- Reuse the existing SponzaModern asset tree (populated by
       tools/setup-sponza-modern.sh). Linked in, not copied, so a single
       checkout sources both the GL and Vulkan demos from one ~2GB pack
       set. CopyToOutputDirectory="PreserveNewest" mirrors what the GL
       demo does so the Vulkan bin/ ends up self-contained at runtime.

       When BLIX_SPONZA_ASSETS is set (pack set kept on an external SSD
       shared across machines), skip the copy entirely — the runtime
       reads straight from that path. See Program.cs OnLoad(). -->
  <ItemGroup Condition="'$(BLIX_SPONZA_ASSETS)' == ''">
    <None Include="..\..\Blix.Demos.SponzaModern\Assets\**\*"
          Exclude="..\Blix.Demos.SponzaModern\Assets\.gitignore;..\Blix.Demos.SponzaModern\Assets\.gitkeep"
          Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- glslc lookup mirrors VulkanLit's. The shader library #include path
       isn't wired up in the scaffold — these shaders are intentionally
       self-contained until the step-6 shader library settles. -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
    <!-- spirv-cross is located the same way as glslc (both ship in the Vulkan
         SDK / Homebrew). It emits a per-shader reflection sidecar the runtime
         loads instead of hand-authored binding tables; see docs/renderer.md
         "SPIR-V reflection". Install with: brew install spirv-cross. -->
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/opt/homebrew/bin/spirv-cross')">/opt/homebrew/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/usr/local/bin/spirv-cross')">/usr/local/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == ''">spirv-cross</SpirvCross>
  </PropertyGroup>

  <!-- Ship the GLSL source next to the compiled .spv. The diagnostics overlay
       scans it at load for //@tune decorators (live-tunable shader vars) — the
       intent that the compiled SPIR-V doesn't carry. See ShaderTunables. -->
  <ItemGroup>
    <None Include="Shaders\**\*.vert;Shaders\**\*.frag;Shaders\**\*.comp"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <GlslShader Include="Shaders\lit.vert" />
    <GlslShader Include="Shaders\lit.frag" />
    <GlslShader Include="Shaders\shadow.vert" />
    <GlslShader Include="Shaders\shadow.frag" />
    <GlslShader Include="Shaders\shadow_mask.vert" />
    <GlslShader Include="Shaders\shadow_mask.frag" />
    <GlslShader Include="Shaders\depth_prepass.frag" />
    <GlslShader Include="Shaders\flat.frag" />
    <GlslShader Include="Shaders\depth_prepass_mask.frag" />
    <GlslShader Include="Shaders\skybox.vert" />
    <GlslShader Include="Shaders\skybox.frag" />
    <GlslShader Include="Shaders\probe_debug.vert" />
    <GlslShader Include="Shaders\probe_debug.frag" />
    <GlslShader Include="Shaders\probe_usage.comp" />
    <GlslShader Include="Shaders\present.vert" />
    <GlslShader Include="Shaders\present.frag" />
    <GlslShader Include="Shaders\hiz_build.frag" />
    <GlslShader Include="Shaders\gtao.frag" />
    <GlslShader Include="Shaders\gtao_denoise.frag" />
    <GlslShader Include="Shaders\froxel.comp" />
    <GlslShader Include="Shaders\sky_inject.comp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared GLSL library (src/Blix.Shaders), resolved via the -I path in the
         CompileSpirV Exec below. Listed so edits retrigger the cook. -->
    <GlslInclude Include="..\..\Blix.Shaders\fullscreen.glsl" />
  </ItemGroup>


</Project>
