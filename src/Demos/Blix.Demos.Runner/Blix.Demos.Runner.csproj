<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Blix\Blix.csproj" />
    <ProjectReference Include="..\..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\..\Blix.Audio\Blix.Audio.csproj" />
    <ProjectReference Include="..\..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <!-- InstancedBatch + SpriteBatch + their .spv ship from Blix.Render via
         content propagation. -->
    <ProjectReference Include="..\..\Blix.Render\Blix.Render.csproj" />
    <ProjectReference Include="..\..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
    <ProjectReference Include="..\..\Blix.Tools.Shader\Blix.Tools.Shader.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <BlixShaderReflect>true</BlixShaderReflect>
    <!-- Declares its own CompileSpirV below; the shared one stands aside. -->
    <BlixShaderCustomTarget>true</BlixShaderCustomTarget>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Demos.Runner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What this project cooks. Declared, so it cannot drift: before this, Rogue.glb
       had a .blixmesh and barrel.glb and coin.glb did not, and nothing recorded why.
       The answer was that somebody once cooked one file. -->
  <ItemGroup>
    <CookMesh Include="Assets/models/*.glb" />
    <CookFont Include="Assets/fonts/*.font.json" />
  </ItemGroup>

  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
  </PropertyGroup>

  <!--
    Shader cook list. Optional per-item metadata declares a #define variant:
      Variant - filename infix (world.frag -> world.FOG.frag.spv); empty = base.
      Defines - the macro Blix injects after #version for that variant.
    A base entry (no Variant) plus one entry per variant cooks every permutation.
    Variants MUST expand here: the Vulkan backend consumes precompiled SPIR-V only
    (no runtime glslc). Runtime selects a variant by ShaderVariantPath.
  -->
  <ItemGroup>
    <GlslShader Include="Shaders\sky.vert" />
    <GlslShader Include="Shaders\sky.frag" />
    <GlslShader Include="Shaders\world.vert" />
    <GlslShader Include="Shaders\world.frag" />
    <GlslShader Include="Shaders\world.frag" Variant="FOG" Defines="ENABLE_FOG" />
    <GlslShader Include="Shaders\skinned.vert" />
    <GlslShader Include="Shaders\skinned.frag" />
  </ItemGroup>

  <!--
    Compiles BEFORE AssignTargetPaths and into the intermediate directory, then stages the result
    as content, which is what the shared BlixCompileSpirV does for every other project.

    It used to run after CopyFilesToOutputDirectory and write straight into $(OutDir)Shaders.
    Those files appeared in the build output and were never MSBuild items, so `dotnet publish`
    carried none of them and this demo's launcher mirrored them by hand afterwards. The variant
    algorithm here is genuinely this project's own (one entry per permutation, filename infix
    from metadata), which is why BlixShaderCustomTarget exists. WHERE the output goes is not.
  -->
  <Target Name="CompileSpirV" BeforeTargets="AssignTargetPaths">
    <!-- Derive each item's output stem + -D flags from its optional metadata. -->
    <ItemGroup>
      <GlslShader Condition="'%(GlslShader.Variant)' == ''">
        <VariantStem>%(GlslShader.Filename)</VariantStem>
      </GlslShader>
      <GlslShader Condition="'%(GlslShader.Variant)' != ''">
        <VariantStem>%(GlslShader.Filename).%(GlslShader.Variant)</VariantStem>
      </GlslShader>
    </ItemGroup>
    <MakeDir Directories="$(BlixShaderOutDir)" />
    <Message Text="Compiling SPIR-V: %(GlslShader.Identity) [%(GlslShader.VariantStem)]" Importance="high" />
    <Exec Command="dotnet &quot;$(BlixShaderCompilerDll)&quot; --glslc &quot;$(Glslc)&quot; --input &quot;%(GlslShader.FullPath)&quot; --output &quot;$(BlixShaderOutDir)%(GlslShader.VariantStem)%(GlslShader.Extension).spv&quot; --include &quot;$(MSBuildProjectDirectory)/../Blix.Shaders&quot; --define &quot;%(GlslShader.Defines)&quot;" />

    <!-- Reflect too, for the same reason every other project does: the interface a program
         declares is read from here rather than restated in C#. The shared BlixReflectSpirV
         cannot do it, because it derives names from %(Filename) and these have variant stems. -->
    <Exec Condition="'$(BlixShaderReflect)' == 'true'"
          Command="&quot;$(SpirvCross)&quot; &quot;$(BlixShaderOutDir)%(GlslShader.VariantStem)%(GlslShader.Extension).spv&quot; --reflect --output &quot;$(BlixShaderOutDir)%(GlslShader.VariantStem)%(GlslShader.Extension).spv.refl.json&quot;" />

    <!-- Globbed rather than derived from @(GlslShader): only this target knows the variant
         stems. Safe as a glob because it runs after the Exec above, in the same target. -->
    <ItemGroup>
      <_RunnerShaderOut Include="$(BlixShaderOutDir)*.spv;$(BlixShaderOutDir)*.spv.tune.json;$(BlixShaderOutDir)*.spv.samplers.json;$(BlixShaderOutDir)*.spv.refl.json" />
    </ItemGroup>
    <ItemGroup>
      <!-- Metadata qualified to the SOURCE item, and read in a second ItemGroup so it is already
           materialised. Unqualified %(Filename) here batches over ContentWithTargetPath, which
           other targets also add to, and evaluates empty. -->
      <ContentWithTargetPath Include="@(_RunnerShaderOut)">
        <TargetPath>Shaders\%(_RunnerShaderOut.Filename)%(_RunnerShaderOut.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

</Project>
