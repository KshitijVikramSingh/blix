<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Blix.Recipes\Blix.Recipes.csproj" />
    <ProjectReference Include="..\\Blix.Verify\\Blix.Verify.csproj" />
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\Blix.Render\Blix.Render.csproj" />
    <!-- Section BL runs the shader generator through Roslyn's own driver, so it references the
         generator as an ordinary assembly and the compiler it runs inside. -->
    <ProjectReference Include="..\Blix.Shaders.Generator\Blix.Shaders.Generator.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <!-- Golden reflection fixtures: spirv-cross reflect output for VulkanSponza's
       lit.vert/frag, checked in so Section P can assert the managed reflector
       reproduces the hand-authored binding tables. Regenerate by running
       spirv-cross with the reflect flag if those shaders' interfaces change. -->
  <ItemGroup>
    <Content Include="fixtures\*.refl.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- The suite's own glTF library, declared because this project uses it, not reached through the cook
       (Blix.Recipes): Toolkit, because the fixtures are AUTHORED here (MeshBuilder, MaterialBuilder,
       SceneBuilder), and Toolkit carries the parser. The runtime references none (Section BT). -->
  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
  </ItemGroup>

</Project>
