<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Blix.Render\Blix.Render.csproj" />
    <ProjectReference Include="..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
    <ProjectReference Include="..\Blix.Audio\Blix.Audio.csproj" />
    <ProjectReference Include="..\Blix.Assets\Blix.Assets.csproj" />
  </ItemGroup>

  <!-- SpriteBatch's sprite.*.spv ship from Blix.Render via content propagation;
       no per-demo shader compile needed. Only the font + manifest are local. -->
  <ItemGroup>
    <None Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Demos.Pong</RootNamespace>
  </PropertyGroup>

</Project>
