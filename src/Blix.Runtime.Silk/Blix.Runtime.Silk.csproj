<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\Blix.Diagnostics.Overlay\Blix.Diagnostics.Overlay.csproj" />
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Blix.Render\Blix.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.22.0" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Pre-compile debug-line shaders to SPIR-V at build time and ship them
       as content next to the assembly. Consumers (demo executables) pick
       them up via CopyToOutputDirectory propagation. -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
  </PropertyGroup>

  <ItemGroup>
    <GlslShader Include="Shaders\debugline.vert" />
    <GlslShader Include="Shaders\debugline.frag" />
    <GlslShader Include="Shaders\imgui.vert" />
    <GlslShader Include="Shaders\imgui.frag" />
  </ItemGroup>

  <Target Name="CompileSpirV"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(GlslShader)"
          Outputs="@(GlslShader -> '$(MSBuildThisFileDirectory)Shaders\%(Filename)%(Extension).spv')">
    <Message Text="Compiling SPIR-V (lib): %(GlslShader.Identity)" Importance="high" />
    <Exec Command="&quot;$(Glslc)&quot; -o &quot;$(MSBuildThisFileDirectory)Shaders\%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; &quot;$(MSBuildThisFileDirectory)%(GlslShader.Identity)&quot;" />
  </Target>

  <ItemGroup>
    <None Include="Shaders\*.spv">
      <Pack>false</Pack>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Shaders\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
