<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared reference scene and renderer for model/rig inspection and deterministic
    capture. BlixShaderMode=Library builds this project's SPIR-V and propagates it,
    with reflection sidecars, to each consuming executable.
  -->
  <PropertyGroup>
    <BlixShaderMode>Library</BlixShaderMode>
    <BlixShaderReflect>true</BlixShaderReflect>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Blix.Render\Blix.Render.csproj" />
    <ProjectReference Include="..\Blix.Tools.Shader\Blix.Tools.Shader.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <GlslShader Include="Shaders\studio_lit.vert" />
    <GlslShader Include="Shaders\studio_lit.frag" />
    <GlslShader Include="Shaders\studio_shadow.vert" />
    <GlslShader Include="Shaders\studio_shadow.frag" />
    <!--
      The skinned pair. Both borrow the UNSKINNED fragment stages (studio_lit.frag /
      studio_shadow.frag): skinning is a vertex-stage concern, so there are two vertex
      shaders here and no new fragment shader at all.
    -->
    <GlslShader Include="Shaders\studio_skinned.vert" />
    <GlslShader Include="Shaders\studio_skinned_shadow.vert" />
    <GlslShader Include="Shaders\studio_skinned_shadow.frag" />
    <GlslShader Include="Shaders\studio_present.vert" />
    <GlslShader Include="Shaders\studio_present.frag" />
    <!-- Globbed, not listed: ibl.glsl was used and not declared, so editing it never rebuilt
         these shaders. Over-invalidating costs a rebuild; under-invalidating costs a stale
         shader that a clean build and a green gate both report as fine. -->
    <GlslInclude Include="..\Blix.Shaders\*.glsl" />
  </ItemGroup>


  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Tools.Studio</RootNamespace>
  </PropertyGroup>

</Project>
