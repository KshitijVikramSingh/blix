<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A thin entry point onto the character lab. It declares NO shaders: they are compiled once by
    Blix.Labs.Character and arrive here through that project's content propagation.
  -->
  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\Blix.Diagnostics\Blix.Diagnostics.csproj" />
    <ProjectReference Include="..\Blix.Geometry\Blix.Geometry.csproj" />
    <ProjectReference Include="..\Blix.Graphics\Blix.Graphics.csproj" />
    <ProjectReference Include="..\Blix.Graphics.Vulkan\Blix.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Blix.Labs.Character\Blix.Labs.Character.csproj" />
    <ProjectReference Include="..\Blix.Runtime.Silk\Blix.Runtime.Silk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Labs.Character.MotionApp</RootNamespace>
    <AssemblyName>Blix.Labs.Character.Motion</AssemblyName>
  </PropertyGroup>

</Project>
