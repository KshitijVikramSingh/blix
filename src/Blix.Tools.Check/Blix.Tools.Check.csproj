<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless engine asset/load judge. Application renderer limits stay with their consumers. -->
  <ItemGroup>
    <ProjectReference Include="..\Blix\Blix.csproj" />
    <ProjectReference Include="..\Blix.Core\Blix.Core.csproj" />
    <ProjectReference Include="..\Blix.Assets\Blix.Assets.csproj" />
    <ProjectReference Include="..\Blix.Cooked\Blix.Cooked.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blix.Tools.Check</RootNamespace>
    <AssemblyName>Blix.Tools.Check</AssemblyName>
  </PropertyGroup>

</Project>
