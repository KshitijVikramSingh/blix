<Project>

  <!--
    Shader-bearing projects reference Blix.Tools.Shader as a build-only project.
    This shared path keeps their Exec targets identical without shipping the
    compiler tool alongside a game.
  -->
  <PropertyGroup>
    <BlixShaderCompilerDll>$(MSBuildThisFileDirectory)src/Blix.Tools.Shader/bin/$(Configuration)/net8.0/Blix.Tools.Shader.dll</BlixShaderCompilerDll>
  </PropertyGroup>

  <!--
    glslc: ship pre-compiled .spv at build time. Homebrew installs into
    /opt/homebrew/bin (Apple Silicon) or /usr/local/bin (Intel); fall back to
    PATH on Linux/Windows. Override with -p:Glslc=/path/to/glslc.
  -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
  </PropertyGroup>

  <!--
    Shared SPIR-V compile contract. Projects declare @(GlslShader) and
    @(GlslInclude); this target owns the common mechanism.

      BlixShaderMode         App (default) writes to $(OutDir)Shaders; Library
                             writes to the project's Shaders directory.
      BlixShaderCustomTarget true lets a project supply a genuinely different
                             compile algorithm.

    The BlixCompileSpirV name must remain distinct from project-local
    CompileSpirV targets: Directory.Build.targets is imported after the project
    body, so a same-named target would replace the local one.
  -->
  <PropertyGroup>
    <!-- Absolute from this repository-root file; projects may be nested at any depth. -->
    <BlixShaderIncludeDir Condition="'$(BlixShaderIncludeDir)' == ''">$(MSBuildThisFileDirectory)src/Blix.Shaders</BlixShaderIncludeDir>

    <BlixShaderMode Condition="'$(BlixShaderMode)' == ''">App</BlixShaderMode>

    <!-- Library output is project-relative; this file itself lives at the repository root. -->
    <BlixShaderOutDir Condition="'$(BlixShaderMode)' == 'Library'">$(MSBuildProjectDirectory)\Shaders\</BlixShaderOutDir>
    <BlixShaderOutDir Condition="'$(BlixShaderOutDir)' == ''">$(OutDir)Shaders\</BlixShaderOutDir>

    <BlixShaderAfterTargets Condition="'$(BlixShaderMode)' == 'App'">CopyFilesToOutputDirectory</BlixShaderAfterTargets>
    <BlixShaderBeforeTargets Condition="'$(BlixShaderMode)' == 'Library'">AssignTargetPaths</BlixShaderBeforeTargets>
  </PropertyGroup>

  <!-- spirv-cross emits the runtime binding sidecar for reflected programs. -->
  <PropertyGroup>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/opt/homebrew/bin/spirv-cross')">/opt/homebrew/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/usr/local/bin/spirv-cross')">/usr/local/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == ''">spirv-cross</SpirvCross>
  </PropertyGroup>

  <Target Name="BlixCompileSpirV"
          Condition="'@(GlslShader)' != '' AND '$(BlixShaderCustomTarget)' != 'true'"
          AfterTargets="$(BlixShaderAfterTargets)"
          BeforeTargets="$(BlixShaderBeforeTargets)"
          Inputs="@(GlslShader);@(GlslInclude);$(BlixShaderCompilerDll)"
          Outputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(BlixShaderOutDir)" />
    <Message Text="Compiling SPIR-V ($(BlixShaderMode)): %(GlslShader.Identity)" Importance="high" />
    <Exec Command="dotnet &quot;$(BlixShaderCompilerDll)&quot; --glslc &quot;$(Glslc)&quot; --input &quot;%(GlslShader.FullPath)&quot; --output &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; --include &quot;$(BlixShaderIncludeDir)&quot;" />
  </Target>

  <!--
    The app index is generated beside every runnable assembly. [BlixApp] remains
    the source of truth; the sidecar makes discovery cheap and records the apphost.
    The Exists() guard permits a fresh-clone bootstrap. `blix` builds the indexer
    before discovery and rejects a missing or stale index.
  -->
  <PropertyGroup>
    <BlixAppIndexerDll>$(MSBuildThisFileDirectory)src/Blix.Tools.Apps/bin/$(Configuration)/net8.0/Blix.Tools.Apps.dll</BlixAppIndexerDll>
  </PropertyGroup>


  <!-- Cooking assets at build. A project declares what it cooks; the recipe
       decides how.

         <ItemGroup>
           <CookMesh    Include="Assets/models/**/*.glb" />
           <CookTexture Include="Assets/textures/**/*.png" />
           <CookProbe   Include="Assets/sky.hdr" Options="env=512" />
         </ItemGroup>

       Set BlixCookCustomTarget=true only when a project supplies a different
       build algorithm. Recipe settings belong in Options.

       A project's own recipe needs no new target — it adds BlixCook directly:
         <BlixCook Include="Maps/**/*.hmap" Recipe="hmap" Cooked=".blixterrain" />
       Blix recipes and project-owned recipes use the same path. See docs/assets.md.
  -->

  <PropertyGroup>
    <BlixCookDll>$(MSBuildThisFileDirectory)src/Blix.Tools.Cook/bin/$(Configuration)/net8.0/Blix.Tools.Cook.dll</BlixCookDll>
  </PropertyGroup>

  <!-- Sugar for the recipes Blix ships. This file is imported after the project body,
       so the item groups it maps from are already populated. Recipe and Cooked are
       stated here rather than looked up, because MSBuild needs the output path at
       evaluation time to be incremental at all — and incrementality is the entire
       reason this is a build rule instead of a command. -->
  <ItemGroup>
    <BlixCook Include="@(CookMesh)"    Recipe="gmsh" Cooked=".blixmesh" />
    <BlixCook Include="@(CookTexture)" Recipe="gtex" Cooked=".blixtex" />
    <BlixCook Include="@(CookProbe)"   Recipe="gpro" Cooked=".blixprobe" />
    <BlixCook Include="@(CookFont)"    Recipe="fnt1" Cooked=".blixfont" />
  </ItemGroup>

  <!-- Item transforms let MSBuild invoke the target only for out-of-date assets.
       The cook host and project recipe assemblies are also inputs, so rebuilding
       either invalidates prior output. A project-owned recipe lists its assembly:
         <BlixCookRecipeAssembly Include="../RTSGame.Cooking/bin/$(Configuration)/net8.0/RTSGame.Cooking.dll" />

       This invokes a pre-built cook host. A solution build rebuilds it; a single
       consumer-project build uses the host already on disk. -->
  <Target Name="BlixCookAssets"
          Condition="'@(BlixCook)' != '' AND '$(BlixCookCustomTarget)' != 'true' AND Exists('$(BlixCookDll)')"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(BlixCook);$(BlixCookDll);@(BlixCookRecipeAssembly)"
          Outputs="@(BlixCook -> '%(RootDir)%(Directory)%(Filename)%(Cooked)')">
    <PropertyGroup>
      <BlixCookList>$(IntermediateOutputPath)blixcook.txt</BlixCookList>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile
        File="$(BlixCookList)"
        Lines="@(BlixCook -> '%(Recipe)%09%(FullPath)%09%(RootDir)%(Directory)%(Filename)%(Cooked)%09%(Options)')"
        Overwrite="true" WriteOnlyWhenDifferent="false" />
    <Message Text="Cooking @(BlixCook->Count()) asset(s)" Importance="high" />
    <Exec Command="dotnet &quot;$(BlixCookDll)&quot; batch &quot;$(BlixCookList)&quot;" />
  </Target>

  <!-- Declare staged outputs inside the target: project globs are evaluated
       before cooking, while this item group sees files produced by this build. -->
  <Target Name="BlixStageCookedAssets"
          Condition="'@(BlixCook)' != '' AND '$(BlixCookCustomTarget)' != 'true'"
          DependsOnTargets="BlixCookAssets"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <ContentWithTargetPath
          Include="@(BlixCook -> '%(RootDir)%(Directory)%(Filename)%(Cooked)')"
          Condition="Exists('%(RootDir)%(Directory)%(Filename)%(Cooked)')"
          TargetPath="@(BlixCook -> '%(RelativeDir)%(Filename)%(Cooked)')"
          CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="BlixIndexApps"
          Condition="'$(BlixSkipAppIndex)' != 'true' AND '$(OutputType)' != '' AND Exists('$(BlixAppIndexerDll)')"
          AfterTargets="CopyFilesToOutputDirectory"
          Inputs="@(IntermediateAssembly);$(BlixAppIndexerDll)"
          Outputs="$(OutDir)$(AssemblyName).blixapps.json">
    <Exec Command="dotnet &quot;$(BlixAppIndexerDll)&quot; --assembly &quot;$(OutDir)$(AssemblyName).dll&quot; --output &quot;$(OutDir)$(AssemblyName).blixapps.json&quot;" />
  </Target>

  <Target Name="BlixReflectSpirV"
          Condition="'@(GlslShader)' != '' AND '$(BlixShaderReflect)' == 'true'"
          AfterTargets="BlixCompileSpirV"
          Inputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv')"
          Outputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.refl.json')">
    <Message Text="Reflecting SPIR-V: %(GlslShader.Identity)" Importance="high" />
    <Exec Command="&quot;$(SpirvCross)&quot; &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; --reflect --output &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv.refl.json&quot;" />
  </Target>

</Project>
