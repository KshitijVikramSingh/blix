<Project>

  <!--
    Shader-bearing projects reference Blix.Tools.Shader as a build-only project.
    This shared path keeps their Exec targets identical without shipping the
    compiler tool alongside a game.
  -->
  <PropertyGroup>
    <BlixShaderCompilerDll>$(MSBuildThisFileDirectory)src/Blix.Tools.Shader/bin/$(Configuration)/net8.0/Blix.Tools.Shader.dll</BlixShaderCompilerDll>
  </PropertyGroup>

  <!--
    glslc: ship pre-compiled .spv at build time. Homebrew installs into
    /opt/homebrew/bin (Apple Silicon) or /usr/local/bin (Intel); fall back to
    PATH on Linux/Windows. Override with -p:Glslc=/path/to/glslc.
  -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
  </PropertyGroup>

  <!--
    ONE SPIR-V COMPILE TARGET, declared once.

    Named BlixCompileSpirV, NOT CompileSpirV, and that is load-bearing. A
    Directory.Build.targets is imported AFTER the project body, and a target
    redefined under the same name REPLACES the earlier one — so calling this
    CompileSpirV silently overrode the two projects that kept their own, and the
    opt-out condition below then turned the replacement into a no-op. They built
    clean and shipped no shaders: 20 modules to 6 for Sponza, 13 to 6 for Runner,
    with a "Build succeeded" over the top of it. A distinct name cannot collide.

    Thirteen projects carried a copy of this. Eight were byte-identical, and the
    argument for pulling them together is not that copies are untidy — it is that
    copies DRIFT, and one already had: Blix.Demos.VulkanInstanced omits
    @(GlslInclude) from its Inputs, so an edit to a shared .glsl would not have
    retriggered its compile. Harmless today only because that project happens to
    include nothing. The next project to add an #include inherits a silent
    staleness bug, and nothing about a stale shader announces itself.

    A project declares WHAT it compiles (@(GlslShader), @(GlslInclude)) and, if it
    is unusual, HOW (the properties below). It no longer restates the mechanism.

      BlixShaderMode        App (default) — build into $(OutDir)Shaders, after the
                            output copy. Library — build into the project's own
                            Shaders folder, before content paths are assigned, so
                            the .spv can ship as embedded/copied content.
      BlixShaderCustomTarget
                            true — this project declares its own CompileSpirV and
                            this one stands aside. Two do: VulkanSponza reflects
                            each module into a sidecar, Runner compiles #define
                            variants from item metadata. Those are different
                            algorithms, not different settings, and folding them in
                            would make this a shader build SYSTEM — which is policy,
                            and policy waits for a third consumer to want it.
  -->
  <PropertyGroup>
    <BlixShaderMode Condition="'$(BlixShaderMode)' == ''">App</BlixShaderMode>

    <!-- MSBuildPROJECTDirectory, not MSBuildThisFileDirectory. In a .csproj those
         two agree, which is why the library copies used the latter; here, in a file
         that lives at the repo root, the latter would quietly write every library's
         shaders into /Shaders. -->
    <BlixShaderOutDir Condition="'$(BlixShaderMode)' == 'Library'">$(MSBuildProjectDirectory)\Shaders\</BlixShaderOutDir>
    <BlixShaderOutDir Condition="'$(BlixShaderOutDir)' == ''">$(OutDir)Shaders\</BlixShaderOutDir>

    <BlixShaderAfterTargets Condition="'$(BlixShaderMode)' == 'App'">CopyFilesToOutputDirectory</BlixShaderAfterTargets>
    <BlixShaderBeforeTargets Condition="'$(BlixShaderMode)' == 'Library'">AssignTargetPaths</BlixShaderBeforeTargets>
  </PropertyGroup>

  <!--
    spirv-cross, for projects that reflect their binding model out of the compiled
    SPIR-V rather than hand-declaring a ShaderInterface. Hand-declaration is fine for a
    small demo and does not scale: the interface has to be restated every time a shader
    gains a binding, and nothing checks the restatement against the shader.
  -->
  <PropertyGroup>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/opt/homebrew/bin/spirv-cross')">/opt/homebrew/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/usr/local/bin/spirv-cross')">/usr/local/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == ''">spirv-cross</SpirvCross>
  </PropertyGroup>

  <Target Name="BlixCompileSpirV"
          Condition="'@(GlslShader)' != '' AND '$(BlixShaderCustomTarget)' != 'true'"
          AfterTargets="$(BlixShaderAfterTargets)"
          BeforeTargets="$(BlixShaderBeforeTargets)"
          Inputs="@(GlslShader);@(GlslInclude);$(BlixShaderCompilerDll)"
          Outputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(BlixShaderOutDir)" />
    <Message Text="Compiling SPIR-V ($(BlixShaderMode)): %(GlslShader.Identity)" Importance="high" />
    <Exec Command="dotnet &quot;$(BlixShaderCompilerDll)&quot; --glslc &quot;$(Glslc)&quot; --input &quot;%(GlslShader.FullPath)&quot; --output &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; --include &quot;$(MSBuildProjectDirectory)/../Blix.Shaders&quot;" />
  </Target>

  <!--
    Reflect each compiled module into a sidecar the runtime loads at program creation
    (descriptor sets + std140 UBO offsets + push ranges), for projects that set
    BlixShaderReflect.

    A SEPARATE target rather than another Exec inside the compile, which matters for
    two reasons: its Inputs are the .spv files and its Outputs the sidecars, so
    incrementality is right without the compile target having to claim outputs it does
    not write; and a project can be moved onto reflection without touching how its
    shaders compile.

    Extracted when a second consumer wanted it (conventions §4) — VulkanSponza had
    carried a bespoke copy since it was written, and the toolchain lab is the second.
  -->
  <!--
    THE APP INDEX.

    Every assembly in the tree gets a sidecar listing the [BlixApp] methods it
    declares, written next to its output. No opt-in: a project that declares none
    gets an index saying so, which is itself the answer `blix ls` needs.

    The attribute is the source of truth because it lives with the code it names and
    cannot drift from it. But discovery must be instant and must not require a build —
    the moment you most want to know what a project holds is often the moment its build
    is broken. Generating the index from the attribute gets both properties: it is
    regenerated rather than maintained, so it cannot drift, and it is a file, so reading
    it costs nothing. It is also the only place that can record WHICH APPHOST runs which
    app, which an attribute cannot say about itself and the launcher needs the moment a
    project has more than one assembly.

    Same shape as BlixReflectSpirV below, deliberately: Inputs are the assembly, Outputs
    the sidecar, so incrementality is right and nothing re-runs for an unchanged build.

    The Exists() guard is the bootstrap. Unlike the shader compiler, nothing references
    this tool — a reference in all 39 projects would be a worse cure than the disease —
    so on a fresh clone the first few assemblies may build before the indexer does. That
    is why `blix` builds the indexer before it reads anything: by the time an index is
    ASKED for it is correct, and a missing or stale one is reported rather than believed.
  -->
  <PropertyGroup>
    <BlixAppIndexerDll>$(MSBuildThisFileDirectory)src/Blix.Tools.Apps/bin/$(Configuration)/net8.0/Blix.Tools.Apps.dll</BlixAppIndexerDll>
  </PropertyGroup>

  <Target Name="BlixIndexApps"
          Condition="'$(BlixSkipAppIndex)' != 'true' AND '$(OutputType)' != '' AND Exists('$(BlixAppIndexerDll)')"
          AfterTargets="CopyFilesToOutputDirectory"
          Inputs="@(IntermediateAssembly);$(BlixAppIndexerDll)"
          Outputs="$(OutDir)$(AssemblyName).blixapps.json">
    <Exec Command="dotnet &quot;$(BlixAppIndexerDll)&quot; --assembly &quot;$(OutDir)$(AssemblyName).dll&quot; --output &quot;$(OutDir)$(AssemblyName).blixapps.json&quot;" />
  </Target>

  <Target Name="BlixReflectSpirV"
          Condition="'@(GlslShader)' != '' AND '$(BlixShaderReflect)' == 'true'"
          AfterTargets="BlixCompileSpirV"
          Inputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv')"
          Outputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.refl.json')">
    <Message Text="Reflecting SPIR-V: %(GlslShader.Identity)" Importance="high" />
    <Exec Command="&quot;$(SpirvCross)&quot; &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; --reflect --output &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv.refl.json&quot;" />
  </Target>

</Project>
