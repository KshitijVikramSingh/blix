<Project>

  <!-- Set by this file itself so build/Blix.Source.targets can safely import the
       same mechanisms into a project outside this repository without ever
       applying them twice to projects that already live below the Blix root. -->
  <PropertyGroup>
    <BlixBuildTargetsImported>true</BlixBuildTargetsImported>
  </PropertyGroup>

  <!--
    Shader-bearing projects reference Blix.Tools.Shader as a build-only project.
    This shared path keeps their Exec targets identical without shipping the
    compiler tool alongside a game.
  -->
  <PropertyGroup>
    <BlixShaderCompilerDll>$(MSBuildThisFileDirectory)src/Blix.Tools.Shader/bin/$(Configuration)/net8.0/Blix.Tools.Shader.dll</BlixShaderCompilerDll>
  </PropertyGroup>

  <!--
    glslc: ship pre-compiled .spv at build time. Homebrew installs into
    /opt/homebrew/bin (Apple Silicon) or /usr/local/bin (Intel); fall back to
    PATH on Linux/Windows. Override with -p:Glslc=/path/to/glslc.
  -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/opt/homebrew/bin/glslc')">/opt/homebrew/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == '' AND Exists('/usr/local/bin/glslc')">/usr/local/bin/glslc</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
  </PropertyGroup>

  <!--
    Shared SPIR-V compile contract. Projects declare @(GlslShader) and
    @(GlslInclude); this target owns the common mechanism.

      BlixShaderMode         App (default) writes to $(OutDir)Shaders; Library
                             writes to the project's Shaders directory.
      BlixShaderCustomTarget true lets a project supply a genuinely different
                             compile algorithm.

    The BlixCompileSpirV name must remain distinct from project-local
    CompileSpirV targets: Directory.Build.targets is imported after the project
    body, so a same-named target would replace the local one.
  -->
  <PropertyGroup>
    <!-- Absolute from this repository-root file; projects may be nested at any depth. -->
    <BlixShaderIncludeDir Condition="'$(BlixShaderIncludeDir)' == ''">$(MSBuildThisFileDirectory)src/Blix.Shaders</BlixShaderIncludeDir>

    <BlixShaderMode Condition="'$(BlixShaderMode)' == ''">App</BlixShaderMode>

    <!-- Library output is project-relative, because a consumer picks it up through the project
         reference; this file itself lives at the repository root. -->
    <BlixShaderOutDir Condition="'$(BlixShaderMode)' == 'Library'">$(MSBuildProjectDirectory)\Shaders\</BlixShaderOutDir>
    <!-- App output is INTERMEDIATE, not $(OutDir). Writing into the output directory is what made
         these invisible to publish; from obj they are staged as content and both build and
         publish carry them. -->
    <BlixShaderOutDir Condition="'$(BlixShaderOutDir)' == ''">$(IntermediateOutputPath)Shaders\</BlixShaderOutDir>

    <!-- Both modes now compile before AssignTargetPaths and stage as CONTENT, which is what
         makes an app's shaders survive `dotnet publish`. App mode used to write straight into
         $(OutDir)Shaders after CopyFilesToOutputDirectory: the files appeared in the build
         output and were never MSBuild items, so publish, which copies items rather than whatever
         it finds in a directory, carried none of them. That is why every launcher script hand
         copies *.spv, and then had to learn *.spv.refl.json and *.spv.tune.json as well. -->
    <BlixShaderBeforeTargets>AssignTargetPaths</BlixShaderBeforeTargets>
  </PropertyGroup>

  <!-- spirv-cross emits the runtime binding sidecar for reflected programs. -->
  <PropertyGroup>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/opt/homebrew/bin/spirv-cross')">/opt/homebrew/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == '' AND Exists('/usr/local/bin/spirv-cross')">/usr/local/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == ''">spirv-cross</SpirvCross>
  </PropertyGroup>

  <!-- <b>The compiler is its whole output directory, not its own dll.</b> What a compile writes
       beside each .spv (the //@tune and //@sampler sidecars) is decided by code in Blix.Graphics,
       which the tool references rather than contains, so the tool's own dll does not change when
       that code does, and every shader went on carrying the sidecar the old code wrote until it was
       touched. Seen once: a [JsonIgnore] on ShaderSampler that did not reach a single sidecar.

       Every dll beside the tool, rather than Blix.Graphics.dll by name, so a dependency the tool
       gains later is covered too; a list of names is how BG.1's missing includes happened. Globbed
       in a target, so it runs after this build has rebuilt the tool. The cost is a recompile of a
       project's shaders when Blix.Graphics changes: measured at 4 s for Sponza's 24, beside a C#
       rebuild of every dependent that the same change already causes. -->
  <Target Name="BlixShaderCompilerClosure">
    <ItemGroup>
      <BlixShaderCompilerFile Include="$([System.IO.Path]::GetDirectoryName('$(BlixShaderCompilerDll)'))/*.dll" />
    </ItemGroup>
  </Target>

  <Target Name="BlixCompileSpirV"
          Condition="'@(GlslShader)' != '' AND '$(BlixShaderCustomTarget)' != 'true'"
          DependsOnTargets="BlixShaderCompilerClosure"
          AfterTargets="$(BlixShaderAfterTargets)"
          BeforeTargets="$(BlixShaderBeforeTargets)"
          Inputs="@(GlslShader);@(GlslInclude);$(BlixShaderCompilerDll);@(BlixShaderCompilerFile)"
          Outputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv');@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.tune.json');@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.samplers.json')">
    <!-- The two sidecars every compile writes are outputs too, not just the .spv: the sampler one
         decides a program's layout, and a compile that reported itself up to date with it missing
         could not heal. Reflection is its own target, conditional on BlixShaderReflect. -->
    <MakeDir Directories="$(BlixShaderOutDir)" />
    <Message Text="Compiling SPIR-V ($(BlixShaderMode)): %(GlslShader.Identity)" Importance="high" />
    <Exec Command="dotnet &quot;$(BlixShaderCompilerDll)&quot; --glslc &quot;$(Glslc)&quot; --input &quot;%(GlslShader.FullPath)&quot; --output &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; --include &quot;$(BlixShaderIncludeDir)&quot;" />
  </Target>

  <!--
    The app index is generated beside every runnable assembly. [BlixApp] remains
    the source of truth; the sidecar makes discovery cheap and records the apphost.
    The Exists() guard permits a fresh-clone bootstrap. `blix` builds the indexer
    before discovery and rejects a missing or stale index.
  -->
  <PropertyGroup>
    <BlixAppIndexerDll>$(MSBuildThisFileDirectory)src/Blix.Tools.Apps/bin/$(Configuration)/net8.0/Blix.Tools.Apps.dll</BlixAppIndexerDll>
  </PropertyGroup>

  <!-- Build-only: the indexer is built before any executable that is indexed with it. Without
       this, the index step ran whatever Blix.Tools.Apps.dll already sat in bin: building one
       project alone after an indexer change indexed it with the previous indexer, which then
       refused a signature the new one accepts. It adds no assembly reference and ships nothing. -->
  <ItemGroup Condition="'$(OutputType)' == 'Exe' AND '$(MSBuildProjectName)' != 'Blix.Tools.Apps' AND '$(BlixSkipAppIndex)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Blix.Tools.Apps/Blix.Tools.Apps.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>


  <!-- Cooking assets at build. A project declares what it cooks; the recipe
       decides how.

         <ItemGroup>
           <CookMesh    Include="Assets/models/**/*.glb" />
           <CookTexture Include="Assets/textures/**/*.png" />
           <CookProbe   Include="Assets/sky.hdr" Options="env=512" />
         </ItemGroup>

       Set BlixCookCustomTarget=true only when a project supplies a different
       build algorithm. Recipe settings belong in Options.

       A project's own recipe needs no new target — it adds BlixCook directly:
         <BlixCook Include="Maps/**/*.hmap" Recipe="hmap" Cooked=".blixterrain" />
       Blix recipes and project-owned recipes use the same path. See docs/assets.md.
  -->

  <PropertyGroup>
    <BlixCookDll>$(MSBuildThisFileDirectory)src/Blix.Tools.Cook/bin/$(Configuration)/net8.0/Blix.Tools.Cook.dll</BlixCookDll>
  </PropertyGroup>

  <!-- Build-only, for the same reason as the indexer above: a project that cooks runs the cook
       tool's dll, and nothing ordered that dll's build before it. On a fresh clone a parallel
       solution build could reach a demo's cook step while the tool was still compiling, and five
       demos failed the first build and passed the second. -->
  <ItemGroup Condition="('@(BlixCook)' != '' OR '@(CookMesh)' != '' OR '@(CookTexture)' != '' OR '@(CookProbe)' != '' OR '@(CookFont)' != '') AND '$(BlixCookCustomTarget)' != 'true' AND '$(MSBuildProjectName)' != 'Blix.Tools.Cook'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Blix.Tools.Cook/Blix.Tools.Cook.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <!-- Sugar for the recipes Blix ships. This file is imported after the project body,
       so the item groups it maps from are already populated. Recipe and Cooked are
       stated here rather than looked up, because MSBuild needs the output path at
       evaluation time to be incremental at all — and incrementality is the entire
       reason this is a build rule instead of a command. -->
  <ItemGroup>
    <BlixCook Include="@(CookMesh)"    Recipe="gmsh" Cooked=".blixmesh" />
    <BlixCook Include="@(CookTexture)" Recipe="gtex" Cooked=".blixtex" />
    <BlixCook Include="@(CookProbe)"   Recipe="gpro" Cooked=".blixprobe" />
    <BlixCook Include="@(CookFont)"    Recipe="fnt1" Cooked=".blixfont" />
  </ItemGroup>

  <!-- Item transforms let MSBuild invoke the target only for out-of-date assets.
       The cook host and project recipe assemblies are also inputs, so rebuilding
       either invalidates prior output. A project-owned recipe lists its assembly:
         <BlixCookRecipeAssembly Include="../Game.Cooking/bin/$(Configuration)/net8.0/Game.Cooking.dll" />

       This invokes the cook host after project references have been resolved.
       A project that declares cooked assets references Blix.Tools.Cook as a
       build-only project, making the host available on the first build. -->
  <!-- What to cook, written every build, because two targets need it and only one of them is
       incremental. It used to live inside BlixCookAssets, which is skipped wholesale when every
       cooked output is current — and BlixStageCookedAssets, which is not skipped, then had no list
       to ask about. `dotnet clean` reaches that state exactly: obj goes, the cooked assets beside
       the sources stay, so the cook has nothing to do and the staging had nothing to read. -->
  <Target Name="BlixCookList"
          Condition="'@(BlixCook)' != '' AND '$(BlixCookCustomTarget)' != 'true'">
    <PropertyGroup>
      <BlixCookList>$(IntermediateOutputPath)blixcook.txt</BlixCookList>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile
        File="$(BlixCookList)"
        Lines="@(BlixCook -> '%(Recipe)%09%(FullPath)%09%(RootDir)%(Directory)%(Filename)%(Cooked)%09%(Options)')"
        Overwrite="true" WriteOnlyWhenDifferent="false" />
  </Target>

  <Target Name="BlixCookAssets"
          Condition="'@(BlixCook)' != '' AND '$(BlixCookCustomTarget)' != 'true' AND Exists('$(BlixCookDll)')"
          DependsOnTargets="BlixCookList"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(BlixCook);$(BlixCookDll);@(BlixCookRecipeAssembly)"
          Outputs="@(BlixCook -> '%(RootDir)%(Directory)%(Filename)%(Cooked)')">
    <Message Text="Cooking @(BlixCook->Count()) asset(s)" Importance="high" />
    <Exec Command="dotnet &quot;$(BlixCookDll)&quot; batch &quot;$(BlixCookList)&quot;" />
  </Target>

  <!-- Declare staged outputs inside the target: project globs are evaluated
       before cooking, while this item group sees files produced by this build. -->
  <Target Name="BlixStageCookedAssets"
          Condition="'@(BlixCook)' != '' AND '$(BlixCookCustomTarget)' != 'true'"
          DependsOnTargets="BlixCookList;BlixCookAssets"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- Metadata QUALIFIED with the item type it belongs to. Unqualified %(Cooked) batches
           over the item being created, ContentWithTargetPath, and was only ever safe because
           nothing else had added to that list yet. The moment a project stages its own shaders
           into it, the build fails with "does not define a value for metadata Cooked". -->
      <ContentWithTargetPath
          Include="@(BlixCook -> '%(RootDir)%(Directory)%(Filename)%(Cooked)')"
          Condition="Exists('%(BlixCook.RootDir)%(BlixCook.Directory)%(BlixCook.Filename)%(BlixCook.Cooked)')"
          TargetPath="@(BlixCook -> '%(RelativeDir)%(Filename)%(Cooked)')"
          CopyToOutputDirectory="PreserveNewest" />

    </ItemGroup>

    <!-- The cook's OTHER output: a mesh carrying embedded images writes them to a
         `<name>.textures/` directory beside the .blixmesh. Nothing declared that, so nothing
         staged it, and on a clean build the cooked textures never reached the application at all —
         GltfShared found no cooked sibling and silently fell back to decoding the embedded PNG at
         runtime. Wasted work that looks exactly like working.

         This used to be a literal glob for `**\*.textures\**\*`. It was correct, because it ran
         after the cook — but it put a fact about ONE recipe into a file that stages every recipe,
         and a second sidecar convention would have needed a second glob here. The recipe declares
         its sidecar folder now (RecipeAttribute.SidecarFolder), and `blix cook outputs` reports
         the whole closure, so this asks rather than assumes.

         A QUERY, not a by-product of cooking: BlixCookAssets is incremental and skips entirely
         when everything is current, so anything written only while cooking would be missing on
         exactly the builds that cook nothing. Paths come back relative to the project, which makes
         them in-cone items whose target paths AssignTargetPaths derives — the same treatment the
         glob's matches got. -->
    <PropertyGroup>
      <BlixCookOutputs>$(IntermediateOutputPath)blixcook.outputs.txt</BlixCookOutputs>
    </PropertyGroup>
    <Exec Condition="Exists('$(BlixCookList)')"
          Command="dotnet &quot;$(BlixCookDll)&quot; outputs &quot;$(BlixCookList)&quot; --relative-to &quot;$(MSBuildProjectDirectory)&quot; --out &quot;$(BlixCookOutputs)&quot;" />
    <ReadLinesFromFile Condition="Exists('$(BlixCookOutputs)')" File="$(BlixCookOutputs)">
      <Output TaskParameter="Lines" ItemName="_BlixCookProduced" />
    </ReadLinesFromFile>
    <ItemGroup>
      <None Include="@(_BlixCookProduced)"
            Condition="Exists('%(Identity)')"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Stage a project's compiled shader output, in either mode.

    <b>Declared inside a target, for the same reason BlixStageCookedAssets is: a project's item
    globs are evaluated at LOAD, before this build produces anything.</b> Four projects used to
    carry `<None Include="Shaders\*.spv">` to stage their own output, and that glob can only
    match what a PREVIOUS build left on disk. On a clean tree it matches nothing, the compiler
    writes the files moments later, and the project's own output never receives them — let alone
    a consumer's.

    It survived unnoticed because the .spv.refl.json sidecars beside them were committed: the
    *.spv ignore does not match a name ending in .json, so one accidentally-tracked artifact was
    holding up the staging for every library project at once. Untracking them broke CI, which is
    the only machine here that ever builds from a clean tree.

    Both Include and TargetPath are transforms over @(GlslShader), which is what makes this work
    where a directory glob cannot: the file names are DERIVED from the declared shaders rather
    than discovered on disk, so they are correct before the compiler has run, and the files exist
    by the time the copy happens. A bare %(Filename) in the TargetPath ATTRIBUTE would read as
    task batching and evaluate empty, landing every file on the directory itself.
  -->
  <Target Name="BlixStageShaders"
          Condition="'@(GlslShader)' != '' AND '$(BlixShaderCustomTarget)' != 'true'"
          DependsOnTargets="BlixCompileSpirV"
          BeforeTargets="AssignTargetPaths">
    <!-- Materialised first, in its own ItemGroup, so the second can self-reference their
         metadata. A transform in a TargetPath ATTRIBUTE does not pair with Include item by
         item: it expands to the whole joined list, and every file lands under a name with
         semicolons in it. -->
    <ItemGroup>
      <_BlixLibShader Include="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv')" />
      <_BlixLibShader Include="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.tune.json')" />
      <_BlixLibShader Include="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.samplers.json')" />
      <!-- Only where reflection is switched on; elsewhere the file is never written. -->
      <_BlixLibShader Condition="'$(BlixShaderReflect)' == 'true'"
                      Include="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.refl.json')" />
    </ItemGroup>
    <ItemGroup>
      <ContentWithTargetPath Include="@(_BlixLibShader)">
        <!-- %(Filename) is everything before the LAST dot, so a .spv.refl.json rebuilds whole. -->
        <TargetPath>Shaders\%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <Target Name="BlixIndexApps"
          Condition="'$(BlixSkipAppIndex)' != 'true' AND '$(OutputType)' != '' AND Exists('$(BlixAppIndexerDll)')"
          AfterTargets="CopyFilesToOutputDirectory"
          Inputs="@(IntermediateAssembly);$(BlixAppIndexerDll)"
          Outputs="$(OutDir)$(AssemblyName).blixapps.json">
    <Exec Command="dotnet &quot;$(BlixAppIndexerDll)&quot; --assembly &quot;$(OutDir)$(AssemblyName).dll&quot; --output &quot;$(OutDir)$(AssemblyName).blixapps.json&quot; --project &quot;$(MSBuildProjectFullPath)&quot;" />
    <!-- The index is a build output, so the build should own its removal. Without this it
         is invisible to MSBuild: not in FileListAbsolute, so `dotnet clean` leaves it and
         the incremental clean that removes a renamed AssemblyName's dll leaves its index
         sitting beside the new one. Measured both ways: with this line, renaming W to W2
         takes W.blixapps.json with it; without it, the file stays and names an app that
         cannot start.

         This does NOT replace the resolver's guard against an index whose assembly is gone.
         Filesystem hygiene and correct discovery are different jobs, and discovery must not
         depend on a clean having behaved. An index left by another configuration, carried
         along by `git mv` of a folder, or belonging to a project deleted outright is one no
         clean ever runs for, and that last pair is how the ghost was found. -->
    <ItemGroup><FileWrites Include="$(OutDir)$(AssemblyName).blixapps.json" /></ItemGroup>
  </Target>

  <Target Name="BlixReflectSpirV"
          Condition="'@(GlslShader)' != '' AND '$(BlixShaderReflect)' == 'true'"
          AfterTargets="BlixCompileSpirV"
          Inputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv')"
          Outputs="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.refl.json')">
    <Message Text="Reflecting SPIR-V: %(GlslShader.Identity)" Importance="high" />
    <Exec Command="&quot;$(SpirvCross)&quot; &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; --reflect --output &quot;$(BlixShaderOutDir)%(GlslShader.Filename)%(GlslShader.Extension).spv.refl.json&quot;" />
  </Target>

  <!-- The reflection reaches C# as well as the runtime. Blix.Shaders.Generator reads it to write
       the fields of [PushConstants] structs (Blix.Graphics.PushConstantsAttribute), so the C#
       face of a block is the bytes the shader reads, and checks [ShaderEnum] enums against the
       //@tune enum{} names the shader declares.

       The files are declared HERE, at evaluation time, from the GlslShader items, and not from a
       target. The shader targets run before CoreCompile in a real build, so the files exist when
       the generator reads them; a design-time build never runs those targets, and still sees the
       files the last build wrote. A file that does not exist yet is simply absent. -->
  <ItemGroup Condition="'@(GlslShader)' != '' AND '$(MSBuildProjectName)' != 'Blix.Shaders.Generator'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Blix.Shaders.Generator/Blix.Shaders.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- The //@tune sidecar is written for every shader; [ShaderEnum] checks against it. -->
    <AdditionalFiles Include="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.tune.json')" />
  </ItemGroup>
  <ItemGroup Condition="'@(GlslShader)' != '' AND '$(BlixShaderReflect)' == 'true' AND '$(MSBuildProjectName)' != 'Blix.Shaders.Generator'">
    <AdditionalFiles Include="@(GlslShader -> '$(BlixShaderOutDir)%(Filename)%(Extension).spv.refl.json')" />
  </ItemGroup>

</Project>
