<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HelloBlix</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The application chooses the layers it uses. The imports add none. The game loop lives in
         Blix.Core, so this needs neither the Blix library nor its renderer to be a game. -->
    <ProjectReference Include="$(BlixSourceRoot)/Blix.Core/Blix.Core.csproj" />
    <ProjectReference Include="$(BlixSourceRoot)/Blix.Graphics/Blix.Graphics.csproj" />
    <ProjectReference Include="$(BlixSourceRoot)/Blix.Runtime.Silk/Blix.Runtime.Silk.csproj" />
    <ProjectReference Include="$(BlixSourceRoot)/Blix.Runtime.Headless/Blix.Runtime.Headless.csproj" />
  </ItemGroup>

</Project>
